-+CREATE OR REPLACE FUNCTION public.groups_workspace_match_biu()
-+ RETURNS trigger
-+ LANGUAGE plpgsql
-+AS $function$
-+DECLARE
-+    v_principal_ws uuid;
-+BEGIN
-+    SELECT workspace_id INTO v_principal_ws FROM principals WHERE id = NEW.id;
-+    IF v_principal_ws IS NULL OR NEW.workspace_id <> v_principal_ws THEN
