-+CREATE OR REPLACE FUNCTION validate_view_wip_limits_json(p_doc jsonb)
-+RETURNS boolean
-+LANGUAGE plpgsql
-+IMMUTABLE PARALLEL SAFE AS $$
-+DECLARE
-+    v_k text;
-+    v_v jsonb;
-+    v_prop_k text;
-+    v_soft_present boolean;
-+    v_hard_present boolean;
-+    v_soft_val int;
-+    v_hard_val int;
-+    v_num_val numeric;
