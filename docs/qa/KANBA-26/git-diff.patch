-    IF v_object_ws IS NULL OR NEW.workspace_id <> v_object_ws THEN
-        RAISE EXCEPTION USING ERRCODE = 'P0001', MESSAGE = 'PRINCIPAL_WORKSPACE_MISMATCH';
-    END IF;
-
-    RETURN NEW;
-END $$;
