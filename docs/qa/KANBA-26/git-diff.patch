-+            RETURN QUERY SELECT false, 0::bigint, 1::bigint, NULL::uuid, 'HEAD_MISMATCH'::text;
-+            RETURN;
-+        END IF;
-+        RETURN QUERY SELECT true, 0::bigint, NULL::bigint, NULL::uuid, NULL::text;
-+        RETURN;
-+    END IF;
