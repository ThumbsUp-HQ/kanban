+  --bg-surface: #ffffff;
+  --bg-surface-raised: #ffffff;
+  --bg-hover: #f1f3f5;
+  --fg-primary: #111827;
+  --fg-secondary: #4b5563;
+  --fg-muted: #525866;
+  --border-subtle: #e5e7eb;
+  --border-strong: #d1d5db;
+  --accent-primary: #1d4ed8;
+  --accent-primary-fg: #ffffff;
+  --focus-ring: #2563eb;
+  --warn-bg: #fef3c7;
+  --warn-fg: #78350f;
+  --danger-bg: #ffe4e6;
+  --danger-fg: #881337;
+  --ok-fg: #059669;
+
+  /* Sticky Palette (6 Colors per S8.1) */
