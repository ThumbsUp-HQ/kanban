+  { name: '--font-sans', raw: "'Inter Variable', -apple-system, BlinkMacSystemFont, sans-serif" },
+  { name: '--font-mono', raw: "'JetBrains Mono Variable', ui-monospace, monospace" },
+  { name: '--text-body', raw: '0.9375rem' },
