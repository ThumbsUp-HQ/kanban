-    IF p_months_back < 0 OR p_months_back > 24 OR p_months_ahead < 0 OR p_months_ahead > 36 THEN
-        RAISE EXCEPTION USING ERRCODE = 'P0001', MESSAGE = 'PARTITION_RANGE_INVALID';
