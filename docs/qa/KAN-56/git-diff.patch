+        r"export const WIKI_CHAPTERS: WikiChapter\[\] = (\[.*?\]);\n\nexport const WIKI_CATEGORIES",
+        content,
+        re.DOTALL,
+    )
+    assert match is not None, f"Could not find WIKI_CHAPTERS in {manifest_path}"
+    return cast("list[dict[str, Any]]", json.loads(match.group(1)))
+
