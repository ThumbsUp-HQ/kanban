-+        "dist",
-+        "build",
-+        ".pytest_cache",
-+        ".ruff_cache",
-+        ".mypy_cache",
-+    }
-+
-+    for path in repo_root.rglob("*"):
-+        if not path.is_file():
-+            continue
-+        if any(part in ignore_dirs for part in path.parts):
-+            continue
-+        if path.suffix in target_exts:
-+            yield path
-+
