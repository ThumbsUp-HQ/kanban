+/**
+ * Breathable Enterprise Typography and ProseMirror Styling (KB-P3-45, S5.1, S6.1, S6.2).
+ * Strictly compliant with Content-Security-Policy: zero inline styles, zero dynamic style tags.
+ */
+
+.kb-editor {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  box-sizing: border-box;
+  background-color: var(--bg-surface);
+  color: var(--fg-primary);
+  border: 1px solid var(--border-subtle);
+  border-radius: 8px;
+}
+
+.kb-editor--editorial {
+  padding: var(--prose-pad);
+}
+
+.kb-editor--compact {
+  padding: 12px 16px;
+}
+
+.kb-editor:focus-within {
+  border-color: var(--focus-ring);
+}
+
+/* Corner Action Pill for Raw Markdown Toggle (📝) */
+.kb-editor__hint-corner {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+  z-index: 10;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity 150ms ease;
+}
+
+.kb-editor:hover .kb-editor__hint-corner,
+.kb-editor:focus-within .kb-editor__hint-corner,
+.kb-editor__hint-corner.is-active {
+  opacity: 1;
+  pointer-events: auto;
+}
+
+.kb-editor__hint-corner.is-active .emoji-hint {
+  outline: 2px solid var(--focus-ring);
+  outline-offset: 1px;
+}
+
+/* ProseMirror WYSIWYG Editable Surface */
+.kb-editor__surface {
+  width: 100%;
+  box-sizing: border-box;
+}
+
+.ProseMirror {
+  outline: none;
+  font-family: var(--font-sans);
+  font-size: var(--text-body);
+  line-height: var(--leading-prose);
+  color: var(--fg-primary);
+  min-height: 140px;
+  word-wrap: break-word;
