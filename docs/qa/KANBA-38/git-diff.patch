+}
+
+.ProseMirror th[data-align='center'],
+.ProseMirror td[data-align='center'] {
+  text-align: center;
+}
+
+.ProseMirror th[data-align='right'],
+.ProseMirror td[data-align='right'] {
+  text-align: right;
+}
+
+.ProseMirror ul,
+.ProseMirror ol {
+  margin: 8px 0 16px 24px;
+  padding: 0;
+}
+
+.ProseMirror li {
+  margin-bottom: 4px;
+}
+
+.ProseMirror ul.kb-task-list {
+  list-style: none;
+  margin-left: 0;
+  padding-left: 0;
+}
+
+.ProseMirror li.kb-task-item {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  margin-bottom: 4px;
+}
+
+.ProseMirror li.kb-task-item.is-checked {
+  color: var(--fg-muted);
+  text-decoration: line-through;
+}
+
+.ProseMirror input.kb-task-checkbox {
+  margin-top: 4px;
+  cursor: pointer;
+}
+
+.ProseMirror .kb-task-item__content {
+  flex: 1;
+}
+
+.ProseMirror hr.kb-hr {
+  border: none;
+  border-top: 1px solid var(--border-subtle);
+  margin: 24px 0;
+}
+
+.ProseMirror a.kb-link {
+  color: var(--accent-primary);
+  text-decoration: underline;
+}
+
+.ProseMirror a.kb-link:hover {
+  text-decoration: none;
+}
+
+.ProseMirror .kb-editor__definition {
+  font-family: var(--font-mono);
+  font-size: 0.8125rem;
+  color: var(--fg-muted);
+  margin: 8px 0;
+  padding: 4px 8px;
+  background-color: var(--bg-hover);
+  border-radius: 4px;
+}
+
+.ProseMirror img.kb-inline-image,
+.ProseMirror .kb-editor__image-block img {
+  max-width: 100%;
+  height: auto;
+  border-radius: 4px;
+}
+
+/* Raw Canonical Markdown Monospace Textarea */
+.kb-editor__raw {
+  width: 100%;
+  min-height: 240px;
+  font-family: var(--font-mono);
+  font-size: var(--text-body);
+  line-height: var(--leading-prose);
+  color: var(--fg-primary);
+  background-color: var(--bg-canvas);
+  border: 1px solid var(--border-subtle);
+  border-radius: 6px;
+  padding: 16px;
