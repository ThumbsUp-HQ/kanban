+
+.ProseMirror table.kb-table {
+  width: 100%;
+  border-collapse: collapse;
+  margin: 16px 0;
+  font-size: var(--text-body);
+}
+
+.ProseMirror th,
+.ProseMirror td {
+  padding: 8px 14px;
+  border: 1px solid var(--border-subtle);
