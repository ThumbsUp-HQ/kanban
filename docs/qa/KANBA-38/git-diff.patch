+
+/* Byte Limit Warning Strip */
+.kb-editor__byte-warning {
+  margin-top: 8px;
+  padding: 8px 12px;
+  font-size: 0.875rem;
+  color: var(--danger-fg);
+  background-color: var(--danger-bg);
+  border: 1px solid var(--danger-fg);
