+
+/* Standalone Guidance Callout and Pre-existing nsjail Warning */
+.custom-field-standalone-callout {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-2);
+  padding: var(--space-2) var(--space-3);
+  background-color: var(--bg-surface-raised);
+  border: 1px solid var(--border-subtle);
+  border-left: 3px solid var(--accent-primary);
+  border-radius: var(--radius-sm);
+  font-size: var(--text-xs);
+  color: var(--fg-primary);
+  margin-bottom: var(--space-3);
+  line-height: var(--leading-prose);
+}
+
+.custom-field-standalone-callout-icon {
+  font-size: var(--text-sm);
+  flex-shrink: 0;
+  margin-top: 1px;
+}
+
+.custom-field-standalone-callout-text {
+  flex: 1;
+}
+
+.custom-field-callout-link {
+  color: var(--accent-primary);
+  text-decoration: underline;
+  font-weight: var(--font-semibold);
+  margin-left: var(--space-1);
+}
+
+.custom-field-warning-banner {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-2);
+  padding: var(--space-2) var(--space-3);
+  background-color: var(--warn-bg);
+  border: 1px solid var(--border-warning);
+  border-radius: var(--radius-sm);
+  font-size: var(--text-xs);
+  color: var(--warn-fg);
+  margin-bottom: var(--space-3);
+  line-height: var(--leading-prose);
+}
+
+.custom-field-warning-banner-icon {
+  font-size: var(--text-sm);
+  flex-shrink: 0;
+  margin-top: 1px;
+}
+
+.custom-field-warning-banner-text {
+  flex: 1;
+}
+
+.custom-field-badge--warning {
+  display: inline-block;
+  margin-top: var(--space-1);
+  padding: 2px var(--space-2);
+  background-color: var(--warn-bg);
+  border: 1px solid var(--border-warning);
+  color: var(--warn-fg);
+  font-size: var(--text-xs);
+  font-weight: var(--font-semibold);
+  border-radius: var(--radius-sm);
+}
+
+.preset-badge--unavailable {
+  background-color: var(--warn-bg);
+  border-color: var(--border-warning);
+  color: var(--warn-fg);
+}
+
+.preset-card--disabled {
+  opacity: 0.85;
+  border-color: var(--border-warning);
+}
+
+.flavor-matrix-unavailable-badge {
+  display: inline-block;
+  font-size: var(--text-xs);
+  padding: 2px var(--space-1);
+  background-color: var(--warn-bg);
+  border: 1px solid var(--border-warning);
+  color: var(--warn-fg);
+  border-radius: var(--radius-sm);
+  margin-left: auto;
+}
