+        s.add(hook2)
+        await s.flush()
+
+        # 9. TOTP Setup
+        with contextlib.suppress(Exception):
+            await s.execute(
+                text("SELECT kb_auth.totp_enroll(:p_id, :blob, :dek, 'test-kid-1')"),
