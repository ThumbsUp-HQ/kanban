+
+    // -------------------------------------------------------------------------
+    // Screenshot 6: Desktop 1440x900 Light McpConfigSnippetModal
+    // -------------------------------------------------------------------------
+    {
+      const context = await createContext(browser, 1440, 1100, 'light');
