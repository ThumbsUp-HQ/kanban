+                text("SELECT id FROM kb_auth.totp_get_pending(:p_id)"),
+                {"p_id": p_id},
+            )
+            totp_row = res_totp.first()
+            if totp_row:
+                await s.execute(
+                    text("SELECT kb_auth.totp_confirm(:p_fid, 100)"),
+                    {"p_fid": totp_row[0]},
