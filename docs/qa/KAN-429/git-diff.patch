+        await s.commit()
+
+    await engine.dispose()
+    return {
+        "cookie_val": issued.cookie_val,
+        "csrf_token": issued.csrf_token,
+    }
+
+
+def main() -> None:
+    seed_info = asyncio.run(prepare_database())
+    env = os.environ.copy()
+    env["KANBAN_DEPLOYMENT_MODE"] = "standalone"
