+                        ready = True
+                        break
+            except Exception:
+                time.sleep(0.5)
+
+        if not ready:
+            raise RuntimeError(f"Server on port {PORT} failed to become ready.")
+
+        print("[KAN-431] Executing Playwright screenshot capture...")
