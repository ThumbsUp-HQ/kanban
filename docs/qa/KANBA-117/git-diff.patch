+/**
+ * Standalone Status Panel & Compose Export Styles (KB-P3-52, S2.2, S6.1).
+ * Breathable, accessible layout with strict CSP compliance (zero inline styles).
+ */
+
+.standalone-panel__backdrop {
+  position: fixed;
+  inset: 0;
+  background-color: rgba(0, 0, 0, 0.45);
+  backdrop-filter: blur(2px);
+  z-index: 1000;
+}
+
+.standalone-panel {
+  position: fixed;
+  top: 50%;
+  left: 50%;
+  transform: translate(-50%, -50%);
+  width: min(640px, 100vw - 32px);
+  max-height: min(720px, 90vh);
+  background-color: var(--bg-surface-raised, #ffffff);
+  color: var(--fg-primary, #111827);
+  border: 1px solid var(--border-subtle, #e5e7eb);
+  border-radius: var(--radius-lg, 10px);
+  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.05);
+  padding: var(--space-6, 24px);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6, 24px);
+  overflow-y: auto;
+  z-index: 1001;
+  box-sizing: border-box;
+}
+
+/* Header & Close */
+.standalone-panel__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border-bottom: 1px solid var(--border-subtle, #e5e7eb);
+  padding-bottom: var(--space-4, 16px);
+}
+
+.standalone-panel__title {
+  margin: 0;
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: var(--fg-primary, #111827);
+}
+
+.standalone-panel__close {
+  background: none;
+  border: none;
+  font-size: 1.5rem;
+  line-height: 1;
+  color: var(--fg-muted, #525866);
+  cursor: pointer;
+  padding: var(--space-1, 4px) var(--space-2, 8px);
+  border-radius: var(--radius-sm, 4px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.standalone-panel__close:hover,
+.standalone-panel__close:focus-visible {
+  background-color: var(--bg-hover, #f1f3f5);
+  color: var(--fg-primary, #111827);
+  outline: 2px solid var(--focus-ring, #2563eb);
+}
+
+/* Section 1: Warning Banner & Storage Health */
+.standalone-panel__section {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3, 12px);
+}
+
+.standalone-panel__warn-banner {
+  background-color: var(--warn-bg, #fef3c7);
+  color: var(--warn-fg, #78350f);
+  border: 1px solid rgba(120, 53, 15, 0.2);
+  border-radius: var(--radius-md, 6px);
+  padding: var(--space-4, 16px);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3, 12px);
+  font-size: var(--text-body, 0.9375rem);
+  line-height: var(--leading-prose, 1.73);
+}
+
+.standalone-panel__warn-text {
+  font-weight: 500;
+}
+
+.standalone-panel__code-block {
+  background-color: rgba(0, 0, 0, 0.06);
+  border-radius: var(--radius-sm, 4px);
+  padding: var(--space-2, 8px) var(--space-3, 12px);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3, 12px);
+  overflow-x: auto;
