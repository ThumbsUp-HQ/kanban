+def _strip_outer_parens(s: str) -> str:
+    """Strip redundant outer matching parentheses from an expression."""
+    s = s.strip()
+    while s.startswith("(") and s.endswith(")"):
+        depth = 0
+        matches = True
+        for ch in s[:-1]:
+            if ch == "(":
+                depth += 1
+            elif ch == ")":
+                depth -= 1
+                if depth == 0:
+                    matches = False
+                    break
+        if matches:
+            s = s[1:-1].strip()
+        else:
+            break
+    return s
+
