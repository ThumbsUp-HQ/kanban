diff --git a/kanban/web/src/features/custom-fields/FlavorDecisionMatrix.tsx b/kanban/web/src/features/custom-fields/FlavorDecisionMatrix.tsx
new file mode 100644
index 0000000..fd07269
--- /dev/null
+++ b/kanban/web/src/features/custom-fields/FlavorDecisionMatrix.tsx
@@ -0,0 +1,185 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, type JSX } from 'react';
+import type { FieldFlavor } from './api';
+
+export interface FlavorInfo {
+  flavor: FieldFlavor;
+  title: string;
+  latency: string;
+  engine: string;
+  scope: string;
+  security: string;
+  bestFor: string;
+  example: string;
+}
+
+export const FLAVOR_DETAILS: FlavorInfo[] = [
+  {
+    flavor: 'scalar',
+    title: 'Scalar Value',
+    latency: '<1ms',
+    engine: 'Static literal or JSON constant',
+    scope: 'Single Issue (Static)',
+    security: 'In-memory constant, zero compute overhead',
+    bestFor: 'Environment pins, static labels, static SLA categories',
+    example: 'scalar: "Verified"',
+  },
+  {
+    flavor: 'formula',
+    title: 'Formula Expression',
+    latency: '<5ms',
+    engine: 'Single-issue AST math on issue.*',
+    scope: 'Single Issue',
+    security: 'Pure AST sandbox, zero network/filesystem/dunder access',
+    bestFor: 'SLA breach calculation, blocker count, completion %, priority multipliers',
+    example: 'formula: issue.state === "DONE" ? "Completed" : "Active"',
+  },
+  {
+    flavor: 'wasm',
+    title: 'WebAssembly',
+    latency: '<25ms',
+    engine: 'Compiled bytecode module (Tier A)',
+    scope: 'Single Issue',
+    security: 'Strict Wasmtime memory and fuel limits, zero network egress',
+    bestFor: 'CVSS 3.1 and 4.0 scoring, deterministic algorithms, cryptographic hashes',
+    example: '// WebAssembly Tier A Module (Base64)...',
+  },
+  {
+    flavor: 'nsjail',
+    title: 'Project Rollup / nsjail',
+    latency: '<=3,000ms',
+    engine: 'Isolated Linux namespace process (Tier B)',
+    scope: 'Cross-issue aggregation via /api/v1/ egress proxy or external PR metadata',
+    security: 'Isolated Linux namespaces, cgroups, allowlisted egress',
+    bestFor: 'Total project issues rollup, external Git PR status badges, complex aggregation',
+    example: '# Tier B nsjail container Python script...',
+  },
+];
+
+export interface FlavorDecisionMatrixProps {
+  selectedFlavor?: FieldFlavor;
+  onSelectFlavor?: (flavor: FieldFlavor) => void;
+  isOpen?: boolean;
+  onToggle?: () => void;
+}
+
+/**
+ * 4-Flavor Decision Matrix ("Which Flavor Should I Use?") (KAN-15, KB-P3-AUDIT-09).
+ * Compares Scalar (<1ms), Formula (<5ms), WebAssembly (<25ms), and nsjail (<=3,000ms).
+ */
+export function FlavorDecisionMatrix({
+  selectedFlavor,
+  onSelectFlavor,
+  isOpen: controlledIsOpen,
+  onToggle,
+}: FlavorDecisionMatrixProps): JSX.Element {
+  const [internalIsOpen, setInternalIsOpen] = useState(false);
+  const isOpen = controlledIsOpen ?? internalIsOpen;
+
+  const handleToggle = () => {
+    if (onToggle) {
+      onToggle();
+    } else {
+      setInternalIsOpen((prev) => !prev);
+    }
+  };
+
+  return (
+    <section
+      className="flavor-matrix-section"
+      aria-label="Which Flavor Should I Use?"
+      data-testid="flavor-decision-matrix"
+    >
+      <div className="flavor-matrix-header">
+        <div className="flavor-matrix-header-title-row">
+          <span className="flavor-matrix-header-icon" aria-hidden="true">
+            🧭
+          </span>
+          <h4 className="flavor-matrix-title">Which Flavor Should I Use?</h4>
+          <span className="flavor-matrix-badge-count">4 Flavors Compared</span>
+        </div>
+        <button
+          type="button"
+          className="custom-field-btn custom-field-btn--secondary custom-field-btn--sm"
+          onClick={handleToggle}
+          aria-expanded={isOpen}
+          data-testid="toggle-flavor-matrix-btn"
+        >
+          {isOpen ? 'Hide Matrix' : 'Compare Flavors'}
+        </button>
+      </div>
+
+      {isOpen && (
+        <div className="flavor-matrix-content" data-testid="flavor-matrix-content">
+          <p className="flavor-matrix-subtitle">
+            Choose the right execution model based on performance budgets, data scope, and isolation requirements.
+          </p>
+
+          <div className="flavor-matrix-grid" role="list">
+            {FLAVOR_DETAILS.map((item) => {
+              const isSelected = selectedFlavor === item.flavor;
+              return (
+                <div
+                  key={item.flavor}
+                  className={`flavor-matrix-card ${isSelected ? 'flavor-matrix-card--selected' : ''}`}
+                  role="listitem"
+                  data-testid={`flavor-card-${item.flavor}`}
+                >
+                  <div className="flavor-matrix-card-top">
+                    <span className="flavor-matrix-card-title">{item.title}</span>
+                    <span
+                      className={`flavor-matrix-latency-pill flavor-matrix-latency-pill--${item.flavor}`}
+                      data-testid={`flavor-latency-${item.flavor}`}
+                    >
+                      {item.latency}
+                    </span>
+                  </div>
+
+                  <dl className="flavor-matrix-card-dl">
+                    <dt className="flavor-matrix-card-dt">Engine:</dt>
+                    <dd className="flavor-matrix-card-dd">{item.engine}</dd>
+
+                    <dt className="flavor-matrix-card-dt">Scope:</dt>
+                    <dd className="flavor-matrix-card-dd">{item.scope}</dd>
+
+                    <dt className="flavor-matrix-card-dt">Security:</dt>
+                    <dd className="flavor-matrix-card-dd">{item.security}</dd>
+
+                    <dt className="flavor-matrix-card-dt">Best For:</dt>
+                    <dd className="flavor-matrix-card-dd flavor-matrix-card-dd--highlight">
+                      {item.bestFor}
+                    </dd>
+                  </dl>
+
+                  <div className="flavor-matrix-example">
+                    <span className="flavor-matrix-example-label">Example:</span>
+                    <code className="flavor-matrix-example-code mono">{item.example}</code>
+                  </div>
+
+                  {onSelectFlavor && (
+                    <button
+                      type="button"
+                      className={`custom-field-btn ${
+                        isSelected
+                          ? 'custom-field-btn--primary'
+                          : 'custom-field-btn--secondary'
+                      } custom-field-btn--sm flavor-matrix-select-btn`}
+                      onClick={() => {
+                        onSelectFlavor(item.flavor);
+                      }}
+                      data-testid={`select-flavor-btn-${item.flavor}`}
+                    >
+                      {isSelected ? 'Selected' : `Use ${item.title}`}
+                    </button>
+                  )}
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/kanban/web/src/features/custom-fields/PresetGallery.tsx b/kanban/web/src/features/custom-fields/PresetGallery.tsx
new file mode 100644
index 0000000..c2bf02a
--- /dev/null
+++ b/kanban/web/src/features/custom-fields/PresetGallery.tsx
@@ -0,0 +1,220 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, type JSX } from 'react';
+import type { FieldFlavor } from './api';
+import { STARTER_PRESETS, type CustomFieldPreset } from './presets';
+
+export interface PresetGalleryProps {
+  onApplyPreset: (preset: CustomFieldPreset) => void;
+  isDirty?: boolean;
+  onUndo?: () => void;
+  appliedPresetName?: string | null;
+  onDismissUndo?: () => void;
+}
+
+/**
+ * 6-Preset Starter Gallery (KAN-15, KB-P3-AUDIT-09).
+ * Provides 1-click starter templates, when-to-use guidance,
+ * and a non-destructive dirty-form confirmation and undo strip.
+ */
+export function PresetGallery({
+  onApplyPreset,
+  isDirty = false,
+  onUndo,
+  appliedPresetName,
+  onDismissUndo,
+}: PresetGalleryProps): JSX.Element {
+  const [filter, setFilter] = useState<FieldFlavor | 'all'>('all');
+  const [pendingPreset, setPendingPreset] = useState<CustomFieldPreset | null>(null);
+
+  const filteredPresets = STARTER_PRESETS.filter((p) => {
+    if (filter === 'all') return true;
+    return p.flavor === filter;
+  });
+
+  const handlePresetClick = (preset: CustomFieldPreset) => {
+    if (isDirty) {
+      setPendingPreset(preset);
+    } else {
+      onApplyPreset(preset);
+    }
+  };
+
+  const handleConfirmApply = () => {
+    if (pendingPreset) {
+      onApplyPreset(pendingPreset);
+      setPendingPreset(null);
+    }
+  };
+
+  const handleCancelApply = () => {
+    setPendingPreset(null);
+  };
+
+  return (
+    <section
+      className="preset-gallery-section"
+      aria-label="Starter Presets Gallery"
+      data-testid="preset-gallery-section"
+    >
+      <div className="preset-gallery-header">
+        <div className="preset-gallery-title-row">
+          <span className="preset-gallery-icon" aria-hidden="true">
+            📦
+          </span>
+          <h4 className="preset-gallery-title">1-Click Starter Presets</h4>
+          <span className="preset-gallery-count">{STARTER_PRESETS.length} Presets Available</span>
+        </div>
+
+        {/* Filter Bar */}
+        <div className="preset-gallery-filters" role="group" aria-label="Filter presets by flavor">
+          {(['all', 'formula', 'wasm', 'nsjail'] as const).map((flavorOption) => (
+            <button
+              key={flavorOption}
+              type="button"
+              className={`preset-gallery-filter-btn ${
+                filter === flavorOption ? 'preset-gallery-filter-btn--active' : ''
+              }`}
+              onClick={() => {
+                setFilter(flavorOption);
+              }}
+              data-testid={`preset-filter-${flavorOption}`}
+            >
+              {flavorOption === 'all'
+                ? 'All Presets'
+                : flavorOption === 'wasm'
+                  ? 'WebAssembly'
+                  : flavorOption.charAt(0).toUpperCase() + flavorOption.slice(1)}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      {/* Undo Strip */}
+      {appliedPresetName && (
+        <div
+          className="preset-undo-strip"
+          role="status"
+          data-testid="preset-undo-strip"
+        >
+          <span className="preset-undo-text">
+            Applied preset <strong>{appliedPresetName}</strong>.
+          </span>
+          <div className="preset-undo-actions">
+            {onUndo && (
+              <button
+                type="button"
+                className="custom-field-btn custom-field-btn--secondary custom-field-btn--sm preset-undo-btn"
+                onClick={onUndo}
+                data-testid="preset-undo-btn"
+              >
+                Undo
+              </button>
+            )}
+            {onDismissUndo && (
+              <button
+                type="button"
+                className="preset-undo-dismiss-btn"
+                onClick={onDismissUndo}
+                aria-label="Dismiss undo notification"
+                data-testid="preset-dismiss-undo-btn"
+              >
+                ✕
+              </button>
+            )}
+          </div>
+        </div>
+      )}
+
+      {/* Grid of 6 Presets */}
+      <div className="preset-gallery-grid" role="list">
+        {filteredPresets.map((preset) => (
+          <div
+            key={preset.id}
+            className="preset-card"
+            role="listitem"
+            data-testid={`preset-card-${preset.slug}`}
+          >
+            <div className="preset-card-header">
+              <h5 className="preset-card-title">{preset.name}</h5>
+              <div className="preset-card-badges">
+                <span className={`preset-badge preset-badge--${preset.flavor}`}>
+                  {preset.flavor}
+                </span>
+                <span className="preset-badge preset-badge--latency">
+                  {preset.latency}
+                </span>
+              </div>
+            </div>
+
+            <p className="preset-card-desc">{preset.description}</p>
+
+            <div className="preset-card-when">
+              <span className="preset-card-when-label">When to use:</span>
+              <p className="preset-card-when-text">{preset.whenToUse}</p>
+            </div>
+
+            <div className="preset-card-meta">
+              <span className="preset-card-format-pill">
+                Format: <strong className="mono">{preset.outputFormat}</strong>
+              </span>
+              <span className="preset-card-tier-pill">
+                Tier: <strong className="mono">{preset.tier}</strong>
+              </span>
+            </div>
+
+            <div className="preset-card-footer">
+              <button
+                type="button"
+                className="custom-field-btn custom-field-btn--primary custom-field-btn--sm preset-card-apply-btn"
+                onClick={() => {
+                  handlePresetClick(preset);
+                }}
+                data-testid={`use-preset-btn-${preset.slug}`}
+              >
+                Use Preset
+              </button>
+            </div>
+          </div>
+        ))}
+      </div>
+
+      {/* Dirty Form Confirmation Dialog */}
+      {pendingPreset && (
+        <div
+          className="custom-field-modal-overlay"
+          role="dialog"
+          aria-modal="true"
+          data-testid="preset-dirty-confirm-dialog"
+        >
+          <div className="custom-field-modal">
+            <h4 className="custom-field-modal-title">Confirm Overwrite Unsaved Changes</h4>
+            <p className="custom-field-modal-warning-text" data-testid="preset-dirty-warning-text">
+              You have unsaved changes in the editor. Applying the preset{' '}
+              <strong>{pendingPreset.name}</strong> will overwrite your current edits.
+            </p>
+            <div className="custom-field-modal-actions">
+              <button
+                type="button"
+                className="custom-field-btn custom-field-btn--secondary"
+                onClick={handleCancelApply}
+                data-testid="preset-cancel-overwrite-btn"
+              >
+                Cancel
+              </button>
+              <button
+                type="button"
+                className="custom-field-btn custom-field-btn--primary"
+                onClick={handleConfirmApply}
+                data-testid="preset-confirm-overwrite-btn"
+              >
+                Apply Preset
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+    </section>
+  );
+}
