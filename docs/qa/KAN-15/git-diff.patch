+        return expr
+
+    depth_brace = 0
+    depth_bracket = 0
+    depth_paren = 0
+    in_quote: str | None = None
+    escaped = False
+
+    question_idx = -1
+    colon_idx = -1
+    ternary_balance = 0
+
+    for i, ch in enumerate(expr):
+        if escaped:
+            escaped = False
+            continue
+        if ch == "\\":
+            escaped = True
+            continue
+        if in_quote:
+            if ch == in_quote:
+                in_quote = None
+            continue
+        if ch in ("'", '"'):
+            in_quote = ch
+            continue
+
+        if ch == "{":
+            depth_brace += 1
+        elif ch == "}":
+            depth_brace = max(0, depth_brace - 1)
+        elif ch == "[":
+            depth_bracket += 1
+        elif ch == "]":
+            depth_bracket = max(0, depth_bracket - 1)
+        elif ch == "(":
+            depth_paren += 1
+        elif ch == ")":
+            depth_paren = max(0, depth_paren - 1)
+        elif depth_brace == 0 and depth_bracket == 0 and depth_paren == 0:
+            if ch == "?":
+                if question_idx == -1:
+                    question_idx = i
+                ternary_balance += 1
+            elif ch == ":" and question_idx != -1:
+                ternary_balance -= 1
+                if ternary_balance == 0:
