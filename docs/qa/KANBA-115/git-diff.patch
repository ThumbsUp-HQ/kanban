+    });
+
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }));
+
+    // Expand root node to reveal child-1
+    fireEvent.click(screen.getByRole('button', { name: 'Expand 🔒 Restricted Page' }));
