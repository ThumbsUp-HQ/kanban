-        old.filter((item) => item.id !== deletedId),
-      );
-    },
-  });
-
-  const promoteMutation = useMutation({
-    mutationFn: (stickyId: string) => promoteStickyToDoc(stickyId),
-    onSuccess: (promoted) => {
