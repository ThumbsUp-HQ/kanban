+            {errorMessage && (
+              <div className="docs-modal__error" role="alert">
+                {errorMessage}
+              </div>
+            )}
+            <form onSubmit={handleSubmitCreate}>
+              <label htmlFor="new-page-title" className="docs-modal__label">
+                Title
+              </label>
+              <input
+                id="new-page-title"
+                type="text"
+                className="docs-modal__input"
+                value={newPageTitle}
+                onChange={(e) => {
