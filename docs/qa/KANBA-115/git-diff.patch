+/* --------------------------------------------------------------------------
+   RESPONSIVE BREAKPOINTS (Desktop >= 1280, Tablet 768..1279, Mobile <= 767)
+   -------------------------------------------------------------------------- */
+@media (min-width: 1280px) {
+  .docs-tree-pane {
+    width: 240px;
+    flex: 0 0 240px;
+  }
+  .docs-center-pane {
+    flex: 1 1 0;
+    min-width: 0;
+  }
+  .docs-rail-pane {
+    width: 240px;
+    flex: 0 0 240px;
+  }
+}
+
+@media (min-width: 768px) and (max-width: 1279px) {
+  .docs-tree-pane {
+    width: 220px;
+    flex: 0 0 220px;
+  }
+  .docs-center-pane {
+    flex: 1 1 0;
+  }
+  .docs-rail-pane {
+    position: fixed;
+    top: var(--topbar-h, 48px);
+    right: 0;
+    bottom: 0;
+    width: 280px;
+    z-index: 50;
+    box-shadow: -4px 0 16px rgba(0, 0, 0, 0.1);
+    transform: translateX(100%);
+    transition: transform 200ms ease;
+  }
+  .docs-rail-wrapper.docs-rail-pane--open .docs-rail-pane {
+    transform: translateX(0);
+  }
+}
+
+@media (max-width: 767px) {
+  .docs-mobile-bar {
+    display: flex;
+  }
+
+  .docs-prose {
+    padding: 24px 20px;
+  }
+
+  .docs-tree-wrapper {
+    position: relative;
+    z-index: 100;
+  }
+
+  .docs-rail-wrapper {
+    position: relative;
+    z-index: 100;
+  }
+
+  .docs-tree-pane {
+    position: fixed;
