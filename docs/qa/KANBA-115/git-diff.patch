+              {
+                id: 'page-d4',
+                title: 'D4',
+                restricted: false,
+                children: [
+                  {
+                    id: 'page-d5',
+                    title: 'D5',
+                    restricted: false,
+                    children: [
+                      {
+                        id: 'page-d6',
+                        title: 'D6',
+                        restricted: false,
+                        children: [
+                          {
+                            id: 'page-d7',
+                            title: 'D7',
+                            restricted: false,
+                            children: [
+                              {
+                                id: 'page-d8',
+                                title: 'D8',
+                                restricted: false,
+                                children: [
+                                  {
+                                    id: 'page-d9',
+                                    title: 'D9',
+                                    restricted: false,
+                                    children: [
