-    aesgcm = AESGCM(derived_key)
-    try:
-        return aesgcm.decrypt(nonce, ciphertext, header)
-    except Exception as exc:
-        msg = "Decryption failed: invalid passphrase or corrupted payload"
-        raise RestoreError(msg) from exc
