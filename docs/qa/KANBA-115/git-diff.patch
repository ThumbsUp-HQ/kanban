-+    } catch (err) {
-+      const msg = err instanceof Error ? err.message : 'Failed to load export data';
-+      setError(msg);
-+      return null;
-+    } finally {
-+      setIsLoading(false);
-+    }
-+  }, []);
-+
-+  useEffect(() => {
-+    if (!initialData) {
-+      void (async () => {
-+        await fetchExportData();
-+      })();
-+    }
-+  }, [initialData, fetchExportData]);
-+
-+  const handleDownload = async (): Promise<void> => {
