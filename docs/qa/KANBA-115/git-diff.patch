-                f"{unprotected_tables}."
-            )
-        elif not role_ok:
-            c6_detail = role_detail
-        else:
-            c6_detail = (
-                f"Row-Level Security active across all {len(rls_rows)} public tenant tables "
-                f"and partitions. {role_detail}."
-            )
-
-        return CheckResult(
