+                  }}
+                >
+                  +
+                </button>
+
+                {!item.restricted && (
+                  <button
+                    type="button"
+                    className="docs-tree-item__action-btn"
+                    title="Move page"
+                    aria-label={`Move page ${item.title}`}
+                    data-testid={`move-page-${item.node.slug ?? item.id}`}
+                    onClick={() => {
