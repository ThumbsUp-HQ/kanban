-  }
-
-  // Trigger 5: Outbound links outside code fence >= 3
-  if (analysis.outboundLinkCount >= MIN_OUTBOUND_LINKS) {
-    reasons.push(`${String(analysis.outboundLinkCount)} links (>= 3)`);
-  }
