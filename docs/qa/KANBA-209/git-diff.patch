+      'GET /api/v1/issues/QAVIEW-1': { json: mockIssuesViewer.items[0] },
+      'GET /api/v1/issues/QAVIEW-1/activity': { json: [] },
+      'GET /api/v1/issues/QAVIEW-1/comments': { json: [] },
+    });
+
+    await page.goto('/projects/QAVIEW/issues');
