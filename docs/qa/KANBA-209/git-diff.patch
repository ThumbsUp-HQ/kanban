+export function AdminRouteGuard(): JSX.Element {
+  const { data: user, isLoading } = useQuery<{
+    is_server_admin?: boolean;
+    aal_level?: number | string;
+    auth_aal?: string;
+  } | null>({
+    queryKey: qk.me(),
