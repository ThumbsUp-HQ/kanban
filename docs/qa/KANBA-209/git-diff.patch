+  }
+
+  const isViewer = user?.workspace_role === 'VIEWER' || user?.workspace_role === 'WORKSPACE_GUEST';
+  if (isViewer) {
+    return <NotFoundView />;
+  }
+
+  return <DraftsWorkspaceView />;
+}
