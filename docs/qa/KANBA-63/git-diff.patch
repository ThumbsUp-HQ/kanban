+        {"p_id": admin_id, "ws_id": ws_id},
+    )
+
+    # Reader user
+    reader_id = uuid.uuid4()
+    await session.scalar(
+        text(
+            "SELECT register_object("
+            "  'user'::object_kind, :ws_id, NULL, :ckey, 'Reader User', :uid, :id"
+            ")"
+        ),
