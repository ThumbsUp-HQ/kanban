+    await session.execute(
+        text(
+            "INSERT INTO role_bindings (principal_id, workspace_id, role, scope_type, project_id) "
+            "VALUES (:p_id, :ws_id, 'WORKSPACE_ADMIN', 'workspace', NULL)"
