+                    </span>
+                  </div>
+                </label>
+              </div>
+            </div>
+          </div>
+
+          <div className="kb-passkey-enroll-footer">
+            <button
+              type="button"
+              className="kb-personal-settings-btn kb-personal-settings-btn-secondary"
+              data-testid="passkey-enroll-cancel-btn"
