+      const res = createSafeSvgBlobUrl('<svg xmlns="http://www.w3.org/2000/svg"><rect width="10" height="10"/></svg>');
+      expect(res.ok).toBe(true);
+      if (res.ok) {
+        expect(res.blobUrl).toMatch(/^blob:http:\/\/localhost\//);
