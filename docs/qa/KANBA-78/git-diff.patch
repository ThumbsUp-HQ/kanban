+
+      const canvas = screen.getByTestId('test-rerender-bg-canvas');
+      expect(canvas.className).toContain('media-bg--theme');
+
+      // Change initialBackdrop prop
+      rerender(
+        <MediaViewport
+          src={SAMPLE_BLOB}
+          rawSource={RAW_SVG}
+          initialBackdrop="dark"
+          testId="test-rerender-bg"
+        />,
+      );
+      expect(canvas.className).toContain('media-bg--dark');
+
+      // Test copy announcement timer
+      const copyBtn = screen.getByTestId('test-rerender-bg-copy-source');
+      fireEvent.click(copyBtn);
+      await vi.advanceTimersByTimeAsync(2600);
+      expect(copyBtn.textContent).toBe('Copy');
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('handles wheel zoom inside lightbox mode without modifier keys', () => {
+    render(
+      <MediaViewport
+        src={SAMPLE_BLOB}
+        alt="Lightbox Wheel Test"
+        isLightbox={true}
+        testId="test-lightbox-wheel"
+      />,
+    );
+
+    const canvas = screen.getByTestId('test-lightbox-wheel-canvas');
+    fireEvent.wheel(canvas, {
+      deltaY: -100,
+      clientX: 50,
+      clientY: 50,
+      ctrlKey: false,
+      metaKey: false,
+    });
+
+    const readout = screen.getByTestId('test-lightbox-wheel-zoom-readout');
+    expect(readout.textContent).toBe('125%');
+  });
+});
diff --git a/kanban/web/src/editor/media/MediaViewport.tsx b/kanban/web/src/editor/media/MediaViewport.tsx
new file mode 100644
index 0000000..722485b
--- /dev/null
+++ b/kanban/web/src/editor/media/MediaViewport.tsx
@@ -0,0 +1,384 @@
+/**
+ * Media Viewport Component (KB-P3-48, S5.4, S6.2).
+ * Interactive viewport for vector SVGs and raster pictures with 10% - 800%
+ * pan/zoom, contrast backdrop cycle, external media shield badge, and lightbox.
+ * Strictly compliant with CSP style-src 'self' (zero inline style attributes).
+ */
+
+import React, {
+  useCallback,
+  useEffect,
+  useRef,
+  useState,
+  type JSX,
+  type PointerEvent as ReactPointerEvent,
+  type WheelEvent as ReactWheelEvent,
+} from 'react';
+import { EmojiHint } from '../../components/emoji/EmojiHint';
+import {
+  zoomAtPoint,
+  panBy,
+  resetTransform,
+  formatZoomPercentage,
+  buildCssomTransform,
+  ZOOM_STEP,
+  type TransformState,
+  INITIAL_TRANSFORM,
+} from './panZoomMath';
+import { resolveMediaUrl } from './mediaUrlResolver';
+import { MediaLightbox } from './MediaLightbox';
+import './MediaViewport.css';
+
+export type MediaBackdropKind = 'theme' | 'light' | 'dark' | 'checkerboard';
+
+const BACKDROP_CYCLE: readonly MediaBackdropKind[] = Object.freeze([
+  'theme',
+  'light',
+  'dark',
+  'checkerboard',
+]);
+
+export interface MediaViewportProps {
+  src: string;
+  alt?: string | undefined;
+  rawSource?: string | undefined;
+  safeFilename?: string | undefined;
+  isLightbox?: boolean | undefined;
+  initialBackdrop?: MediaBackdropKind | undefined;
+  onBackdropChange?: ((next: MediaBackdropKind) => void) | undefined;
+  airGapMode?: boolean | undefined;
+  resolveAttachmentUrl?: ((attachmentId: string) => string) | undefined;
+  testId?: string | undefined;
+}
+
+export function MediaViewport({
+  src,
+  alt = '',
+  rawSource,
+  safeFilename = 'media.svg',
+  isLightbox = false,
+  initialBackdrop = 'theme',
+  onBackdropChange,
+  airGapMode = false,
+  resolveAttachmentUrl,
+  testId = 'media-viewport',
+}: MediaViewportProps): JSX.Element {
+  const [backdrop, setBackdrop] = useState<MediaBackdropKind>(initialBackdrop);
+  const [prevInitial, setPrevInitial] = useState(initialBackdrop);
+  if (initialBackdrop !== prevInitial) {
+    setPrevInitial(initialBackdrop);
+    setBackdrop(initialBackdrop);
+  }
+
+  const [transform, setTransform] = useState<TransformState>(INITIAL_TRANSFORM);
+  const [isLoaded, setIsLoaded] = useState(false);
+  const [isLightboxOpen, setIsLightboxOpen] = useState(false);
+  const [copyAnnounce, setCopyAnnounce] = useState('');
+
+  const canvasRef = useRef<HTMLDivElement | null>(null);
+  const imgRef = useRef<HTMLImageElement | null>(null);
+  const triggerRef = useRef<HTMLButtonElement | null>(null);
+
+  // Drag pan pointer state
+  const isDraggingRef = useRef(false);
+  const lastPointerPosRef = useRef({ x: 0, y: 0 });
+  const hasMovedRef = useRef(false);
+
+  const resolved = resolveMediaUrl(src, { airGapMode, resolveAttachmentUrl });
+
+  // Apply CSSOM transform strictly to maintain CSP style-src 'self'
+  useEffect(() => {
+    if (imgRef.current) {
+      imgRef.current.style.transform = buildCssomTransform(transform);
+    }
+  }, [transform]);
+
+  const handleBackdropCycle = useCallback(() => {
+    const currentIndex = BACKDROP_CYCLE.indexOf(backdrop);
+    const nextIndex = (currentIndex + 1) % BACKDROP_CYCLE.length;
+    const nextBackdrop = BACKDROP_CYCLE[nextIndex] ?? 'theme';
+    setBackdrop(nextBackdrop);
+    onBackdropChange?.(nextBackdrop);
+  }, [backdrop, onBackdropChange]);
+
+  const handleZoomIn = useCallback(() => {
+    const rect = canvasRef.current?.getBoundingClientRect() ?? { width: 400, height: 300 };
+    const focalPoint = { x: rect.width / 2, y: rect.height / 2 };
+    setTransform((prev) => zoomAtPoint(prev, focalPoint, ZOOM_STEP));
+  }, []);
+
+  const handleZoomOut = useCallback(() => {
+    const rect = canvasRef.current?.getBoundingClientRect() ?? { width: 400, height: 300 };
+    const focalPoint = { x: rect.width / 2, y: rect.height / 2 };
+    setTransform((prev) => zoomAtPoint(prev, focalPoint, 1 / ZOOM_STEP));
+  }, []);
+
+  const handleZoomReset = useCallback(() => {
+    setTransform(resetTransform());
+  }, []);
+
+  const handleWheel = useCallback(
+    (e: ReactWheelEvent<HTMLDivElement>) => {
+      // Support Ctrl/Cmd+Wheel or general wheel inside lightbox
+      if (e.ctrlKey || e.metaKey || isLightbox) {
+        e.preventDefault();
+        const rect = canvasRef.current?.getBoundingClientRect() ?? { left: 0, top: 0 };
+        const focalPoint = { x: e.clientX - rect.left, y: e.clientY - rect.top };
+        const factor = e.deltaY < 0 ? ZOOM_STEP : 1 / ZOOM_STEP;
+        setTransform((prev) => zoomAtPoint(prev, focalPoint, factor));
+      }
+    },
+    [isLightbox],
+  );
+
+  const handlePointerDown = useCallback((e: ReactPointerEvent<HTMLDivElement>) => {
+    if (e.button !== 0) return; // Main button only
+    isDraggingRef.current = true;
+    hasMovedRef.current = false;
+    lastPointerPosRef.current = { x: e.clientX, y: e.clientY };
+    try {
+      if ('setPointerCapture' in e.currentTarget) {
+        e.currentTarget.setPointerCapture(e.pointerId);
+      }
+    } catch {
+      // Ignored if pointer capture not supported
+    }
+  }, []);
+
+  const handlePointerMove = useCallback((e: ReactPointerEvent<HTMLDivElement>) => {
+    if (!isDraggingRef.current) return;
+    const dx = e.clientX - lastPointerPosRef.current.x;
+    const dy = e.clientY - lastPointerPosRef.current.y;
+    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
+      hasMovedRef.current = true;
+    }
+    lastPointerPosRef.current = { x: e.clientX, y: e.clientY };
+    setTransform((prev) => panBy(prev, dx, dy));
+  }, []);
+
+  const handlePointerUp = useCallback(
+    (e: ReactPointerEvent<HTMLDivElement>) => {
+      if (!isDraggingRef.current) return;
+      isDraggingRef.current = false;
+      try {
+        if ('releasePointerCapture' in e.currentTarget) {
+          e.currentTarget.releasePointerCapture(e.pointerId);
+        }
+      } catch {
+        // Ignored if pointer capture already lost
+      }
+      // If pointer didn't drag and image was clicked in inline mode, expand to lightbox
+      if (!hasMovedRef.current && !isLightbox) {
+        setIsLightboxOpen(true);
+      }
+    },
+    [isLightbox],
+  );
+
+  const handleCopyRaw = useCallback(async () => {
+    try {
+      await navigator.clipboard.writeText(rawSource ?? '');
+      setCopyAnnounce('Copied source');
+      setTimeout(() => {
+        setCopyAnnounce('');
+      }, 2500);
+    } catch {
+      setCopyAnnounce('Copy failed');
+    }
+  }, [rawSource]);
+
+  // Clean filename for download attribute
+  const cleanedFilename = safeFilename.replace(/[^a-zA-Z0-9._-]/g, '_') || 'media.svg';
+
+  // Render air-gap offline placeholder card if blocked
+  if (resolved.isAirGapBlocked) {
+    return (
+      <div className="media-airgap-placeholder" data-testid={`${testId}-airgap`}>
+        <div className="media-airgap-placeholder__badge">
+          <EmojiHint kind="airGap" />
+          <span>External image blocked in Air-Gap Local-Only Mode</span>
+        </div>
+        <div className="media-airgap-placeholder__host">
+          Host: {resolved.originalHost}
+        </div>
+      </div>
+    );
+  }
+
+  const containerClasses = [
+    'media-viewport',
+    isLightbox ? 'media-viewport--lightbox' : '',
+  ]
+    .filter(Boolean)
+    .join(' ');
+
+  const canvasClasses = [
+    'media-viewport__canvas',
+    `media-bg--${backdrop}`,
+  ].join(' ');
+
+  const imgClasses = [
+    'media-viewport__img',
+    isLoaded ? 'media-viewport__img--loaded' : 'media-viewport__img--loading',
+  ].join(' ');
+
+  return (
+    <div className={containerClasses} data-testid={testId}>
+      {/* Canvas Area */}
+      <div
+        ref={canvasRef}
+        className={canvasClasses}
+        data-testid={`${testId}-canvas`}
+        onWheel={handleWheel}
+        onPointerDown={handlePointerDown}
+        onPointerMove={handlePointerMove}
+        onPointerUp={handlePointerUp}
+        onPointerCancel={handlePointerUp}
+      >
+        {!isLoaded && (
+          <div className="media-viewport__skeleton" data-testid={`${testId}-skeleton`}>
+            Loading media...
+          </div>
+        )}
+
+        <img
+          ref={imgRef}
+          src={resolved.url}
+          alt={alt}
+          loading="lazy"
+          decoding="async"
+          className={imgClasses}
+          data-testid={`${testId}-img`}
+          onLoad={() => {
+            setIsLoaded(true);
+          }}
+        />
+      </div>
+
+      {/* Optional Alt text badge */}
+      {alt && alt.trim().length > 0 && (
+        <div className="media-alt-badge" title={alt} data-testid={`${testId}-alt-badge`}>
+          Alt: {alt.length > 24 ? `${alt.slice(0, 24)}...` : alt}
+        </div>
+      )}
+
+      {/* Floating Controls Bar */}
+      <div className="media-viewport__controls" data-testid={`${testId}-controls`}>
+        {/* Contrast Backdrop Toggle */}
+        <EmojiHint
+          kind="mediaBackdrop"
+          variant="interactive"
+          onActivate={handleBackdropCycle}
+          testId={`${testId}-backdrop-toggle`}
+        />
+
+        {/* Zoom Out Button */}
+        <button
+          type="button"
+          className="media-btn"
+          aria-label="Zoom out"
+          onClick={handleZoomOut}
+          data-testid={`${testId}-zoom-out`}
+        >
+          -
+        </button>
+
+        {/* Zoom Level Indicator / Reset Button */}
+        <button
+          type="button"
+          className="media-btn media-btn--zoom-readout"
+          aria-label="Reset zoom to 100%"
+          onClick={handleZoomReset}
+          data-testid={`${testId}-zoom-readout`}
+        >
+          {formatZoomPercentage(transform.scale)}
+        </button>
+
+        {/* Zoom In Button */}
+        <button
+          type="button"
+          className="media-btn"
+          aria-label="Zoom in"
+          onClick={handleZoomIn}
+          data-testid={`${testId}-zoom-in`}
+        >
+          +
+        </button>
+
+        {/* Proxied External Media Badge */}
+        {resolved.isExternalProxied && (
+          <EmojiHint
+            kind="externalMedia"
+            testId={`${testId}-proxied-badge`}
+          />
+        )}
+
+        {/* Copy Raw Source Button (if SVG / text source available) */}
+        {rawSource && (
+          <button
+            type="button"
+            className="media-btn"
+            aria-label="Copy raw source"
+            onClick={() => {
+              void handleCopyRaw();
+            }}
+            data-testid={`${testId}-copy-source`}
+          >
+            {copyAnnounce || 'Copy'}
+          </button>
+        )}
+
+        {/* Download Media Asset Button */}
+        <a
+          download={cleanedFilename}
+          href={resolved.url}
+          className="media-btn"
+          aria-label="Download media asset"
+          data-testid={`${testId}-download`}
+        >
+          ⬇
+        </a>
+
+        {/* Expand in Lightbox Button */}
+        {!isLightbox && (
+          <button
+            ref={triggerRef}
+            type="button"
+            className="media-btn media-btn--icon"
+            aria-label="Expand in lightbox"
+            onClick={() => {
+              setIsLightboxOpen(true);
+            }}
+            data-testid={`${testId}-expand`}
+          >
+            ⤢
+          </button>
+        )}
+      </div>
+
+      {/* Screen Reader Announcement for Copy */}
+      <span className="sr-only" aria-live="polite">
+        {copyAnnounce}
+      </span>
+
+      {/* Lightbox Dialog Portal */}
+      {!isLightbox && (
+        <MediaLightbox
+          isOpen={isLightboxOpen}
+          onClose={() => {
+            setIsLightboxOpen(false);
+          }}
+          src={resolved.url}
+          alt={alt}
+          rawSource={rawSource}
+          backdrop={backdrop}
+          onBackdropChange={(next) => {
+            setBackdrop(next);
+          }}
+          safeFilename={cleanedFilename}
+          triggerRef={triggerRef}
+        />
+      )}
+    </div>
+  );
+}
diff --git a/kanban/web/src/editor/media/mediaUrlResolver.test.ts b/kanban/web/src/editor/media/mediaUrlResolver.test.ts
new file mode 100644
index 0000000..c2aa8a0
--- /dev/null
+++ b/kanban/web/src/editor/media/mediaUrlResolver.test.ts
@@ -0,0 +1,94 @@
+/**
+ * Unit Tests for Media URL Resolver & Air-Gap Interceptor (KB-P3-48, S5.4).
+ */
+
+import { describe, it, expect } from 'vitest';
+import { resolveMediaUrl } from './mediaUrlResolver';
+
+describe('mediaUrlResolver', () => {
+  it('resolves external https and http URLs to anonymous media-proxy', () => {
+    const raw = 'https://cdn.example.com/assets/arch.png';
+    const result = resolveMediaUrl(raw);
+
+    expect(result.kind).toBe('proxied-external');
+    expect(result.isExternalProxied).toBe(true);
+    expect(result.isAirGapBlocked).toBe(false);
+    expect(result.originalHost).toBe('cdn.example.com');
+    expect(result.url).toBe(`/api/v1/media-proxy?u=${encodeURIComponent(raw)}`);
+    expect(result.originalUrl).toBe(raw);
+  });
+
+  it('preserves URLs already containing /api/v1/media-proxy', () => {
+    const preProxied = '/api/v1/media-proxy?u=https%3A%2F%2Fother.test%2Fa.png&sig=abcd1234';
+    const result = resolveMediaUrl(preProxied);
+
+    expect(result.kind).toBe('proxied-external');
+    expect(result.isExternalProxied).toBe(true);
+    expect(result.url).toBe(preProxied);
+
+    const fullPreProxied = 'https://kanban.hackedyour.info/api/v1/media-proxy?u=abc';
+    const resultFull = resolveMediaUrl(fullPreProxied);
+    expect(resultFull.kind).toBe('proxied-external');
+    expect(resultFull.isExternalProxied).toBe(true);
+    expect(resultFull.url).toBe(fullPreProxied);
+  });
+
+  it('blocks external images with zero network calls in air_gap_mode', () => {
+    const raw = 'https://external-cdn.evil.test/metrics.png';
+    const result = resolveMediaUrl(raw, { airGapMode: true });
+
+    expect(result.kind).toBe('airgap-blocked');
+    expect(result.isAirGapBlocked).toBe(true);
+    expect(result.isExternalProxied).toBe(false);
+    expect(result.url).toBe('');
+    expect(result.originalHost).toBe('external-cdn.evil.test');
+  });
+
+  it('resolves attachment:// URLs with and without attachment map', () => {
+    const raw = 'attachment://att-9988-uuid';
+    const withoutMap = resolveMediaUrl(raw);
+    expect(withoutMap.kind).toBe('attachment');
+    expect(withoutMap.url).toBe('/api/v1/attachments/att-9988-uuid');
+    expect(withoutMap.isExternalProxied).toBe(false);
+    expect(withoutMap.isAirGapBlocked).toBe(false);
+
+    const withMap = resolveMediaUrl(raw, {
+      attachmentMap: {
+        'att-9988-uuid': '/custom/signed/download/url',
+      },
+    });
+    expect(withMap.kind).toBe('attachment');
+    expect(withMap.url).toBe('/custom/signed/download/url');
+  });
+
+  it('handles blob: and data:image/ URIs cleanly', () => {
+    const blobUri = 'blob:http://localhost:3000/1234-uuid';
+    const blobRes = resolveMediaUrl(blobUri);
+    expect(blobRes.kind).toBe('blob');
+    expect(blobRes.url).toBe(blobUri);
+    expect(blobRes.isExternalProxied).toBe(false);
+
+    const dataUri = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY44YAAAAASUVORK5CYII=';
+    const dataRes = resolveMediaUrl(dataUri);
+    expect(dataRes.kind).toBe('data');
+    expect(dataRes.url).toBe(dataUri);
+    expect(dataRes.isExternalProxied).toBe(false);
+  });
+
+  it('handles relative local paths', () => {
+    const relative = '/static/images/logo.png';
+    const result = resolveMediaUrl(relative);
+    expect(result.kind).toBe('relative');
+    expect(result.url).toBe(relative);
+    expect(result.isExternalProxied).toBe(false);
+  });
+
+  it('rejects empty, invalid, and dangerous URI schemes', () => {
+    expect(resolveMediaUrl('').kind).toBe('invalid');
+    expect(resolveMediaUrl('   ').kind).toBe('invalid');
+    expect(resolveMediaUrl('javascript:alert(1)').kind).toBe('invalid');
+    expect(resolveMediaUrl('data:text/html,<script>').kind).toBe('invalid');
+    expect(resolveMediaUrl('file:///etc/passwd').kind).toBe('invalid');
+    expect(resolveMediaUrl('http://[::1]:bad_port').kind).toBe('invalid');
+  });
+});
diff --git a/kanban/web/src/editor/media/mediaUrlResolver.ts b/kanban/web/src/editor/media/mediaUrlResolver.ts
new file mode 100644
index 0000000..d713fef
--- /dev/null
+++ b/kanban/web/src/editor/media/mediaUrlResolver.ts
@@ -0,0 +1,161 @@
+/**
+ * Media URL Resolver & Air-Gap Shield (KB-P3-48, S5.4).
+ * Resolves attachment:// URIs, routes external images through /api/v1/media-proxy,
+ * and intercepts requests when air_gap_mode is active.
+ */
+
+export type ResolvedMediaKind =
+  | 'local'
+  | 'attachment'
+  | 'proxied-external'
+  | 'airgap-blocked'
+  | 'blob'
+  | 'data'
+  | 'relative'
+  | 'invalid';
+
+export interface ResolveMediaOptions {
+  readonly airGapMode?: boolean;
+  readonly attachmentMap?: Readonly<Record<string, string>>;
+  readonly resolveAttachmentUrl?: ((attachmentId: string) => string) | undefined;
+}
+
+export interface ResolvedMediaUrl {
+  readonly kind: ResolvedMediaKind;
+  readonly url: string;
+  readonly originalUrl: string;
+  readonly isExternalProxied: boolean;
+  readonly isAirGapBlocked: boolean;
+  readonly originalHost?: string;
+}
+
+/**
+ * Resolves an arbitrary image source URL against security, proxy, and air-gap policies.
+ */
+export function resolveMediaUrl(
+  rawUrl: string,
+  options: ResolveMediaOptions = {},
+): ResolvedMediaUrl {
+  const trimmed = rawUrl ? rawUrl.trim() : '';
+
+  if (!trimmed) {
+    return {
+      kind: 'invalid',
+      url: '',
+      originalUrl: rawUrl,
+      isExternalProxied: false,
+      isAirGapBlocked: false,
+    };
+  }
+
+  // 1. Handle blob: and data: URIs
+  if (trimmed.startsWith('blob:')) {
+    return {
+      kind: 'blob',
+      url: trimmed,
+      originalUrl: trimmed,
+      isExternalProxied: false,
+      isAirGapBlocked: false,
+    };
+  }
+
+  if (trimmed.startsWith('data:image/')) {
+    return {
+      kind: 'data',
+      url: trimmed,
+      originalUrl: trimmed,
+      isExternalProxied: false,
+      isAirGapBlocked: false,
+    };
+  }
+
+  // 2. Handle attachment://<id> protocol
+  if (trimmed.startsWith('attachment://')) {
+    const attachmentId = trimmed.replace('attachment://', '');
+    const mapped =
+      options.resolveAttachmentUrl?.(attachmentId) ??
+      options.attachmentMap?.[attachmentId];
+    const resolvedUrl = mapped ?? `/api/v1/attachments/${attachmentId}`;
+    return {
+      kind: 'attachment',
+      url: resolvedUrl,
+      originalUrl: trimmed,
+      isExternalProxied: false,
+      isAirGapBlocked: false,
+    };
+  }
+
+  // 3. Handle relative paths
+  if (trimmed.startsWith('/') && !trimmed.startsWith('//')) {
+    const isProxy = trimmed.startsWith('/api/v1/media-proxy');
+    return {
+      kind: isProxy ? 'proxied-external' : 'relative',
+      url: trimmed,
+      originalUrl: trimmed,
+      isExternalProxied: isProxy,
+      isAirGapBlocked: false,
+    };
+  }
+
+  // 4. Handle external HTTP / HTTPS URLs
+  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
+    let parsedHost = 'external-host';
+    try {
+      const parsed = new URL(trimmed);
+      parsedHost = parsed.hostname;
+    } catch {
+      // Invalid URL format
+      return {
+        kind: 'invalid',
+        url: '',
+        originalUrl: trimmed,
+        isExternalProxied: false,
+        isAirGapBlocked: false,
+      };
+    }
+
+    // Air-gap mode check: completely block external media with zero network calls
+    if (options.airGapMode) {
+      return {
+        kind: 'airgap-blocked',
+        url: '',
+        originalUrl: trimmed,
+        isExternalProxied: false,
+        isAirGapBlocked: true,
+        originalHost: parsedHost,
+      };
+    }
+
+    // Already routed through /api/v1/media-proxy?
+    if (trimmed.includes('/api/v1/media-proxy')) {
+      return {
+        kind: 'proxied-external',
+        url: trimmed,
+        originalUrl: trimmed,
+        isExternalProxied: true,
+        isAirGapBlocked: false,
+        originalHost: parsedHost,
+      };
+    }
+
+    // Route through anonymous media-proxy
+    const proxyUrl = `/api/v1/media-proxy?u=${encodeURIComponent(trimmed)}`;
+    return {
+      kind: 'proxied-external',
+      url: proxyUrl,
+      originalUrl: trimmed,
+      isExternalProxied: true,
+      isAirGapBlocked: false,
+      originalHost: parsedHost,
+    };
+  }
+
+  // 5. Unrecognized or disallowed protocol (e.g. javascript:, file:, etc.)
+  return {
+    kind: 'invalid',
+    url: '',
+    originalUrl: trimmed,
+    isExternalProxied: false,
+    isAirGapBlocked: false,
+  };
+}
