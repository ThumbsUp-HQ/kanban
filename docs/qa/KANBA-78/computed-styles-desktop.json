{
  "media-viewport-measurements": {
    ".media-viewport": {
      "width": "1102px",
      "height": "262px",
      "max-height": "520px",
      "position": "relative",
      "border-radius": "10px",
      "overflow": "hidden"
    },
    ".emoji-hint": {
      "width": "24px",
