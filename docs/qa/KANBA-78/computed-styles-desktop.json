      "height": "38px",
      "position": "absolute",
      "display": "flex",
      "border-radius": "9999px"
    },
    ".media-bg--checkerboard": {
      "width": "1100px",
      "height": "260px",
      "background-image": "repeating-conic-gradient(rgb(203, 213, 225) 0%, rgb(203, 213, 225) 25%, rgb(241, 245, 249) 0%, rgb(241, 245, 249) 50%)",
      "background-size": "20px 20px"
    }
