+  };
+
+  const fromLabel = transition.from_state ?? '* Any State';
+  const toLabel = transition.to_state;
+
+  return (
+    <div className="workflow-modal-backdrop" role="presentation" onClick={onClose}>
+      <aside
+        className="dry-run-drawer"
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="dry-run-drawer-title"
+        onClick={(e) => { e.stopPropagation(); }}
+      >
+        <div className="dry-run-header">
+          <h3 id="dry-run-drawer-title">
+            ▶ Dry-Run: [{fromLabel}] ➔ [{toLabel}]
+          </h3>
+          <button
+            type="button"
+            className="workflow-btn workflow-btn-secondary workflow-btn-sm"
+            onClick={onClose}
+            aria-label="Close Dry-Run Drawer"
+          >
+            ✕ Close
+          </button>
+        </div>
+
+        {/* Mode switcher tabs */}
+        <div className="dry-run-mode-tabs" role="tablist" aria-label="Dry-Run Source">
+          <button
+            type="button"
+            role="tab"
+            aria-selected={mode === 'sample'}
+            className={`dry-run-mode-btn ${mode === 'sample' ? 'is-active' : ''}`}
+            onClick={() => { setMode('sample'); }}
+          >
+            Sample ticket
+          </button>
+          <button
+            type="button"
+            role="tab"
+            aria-selected={mode === 'issue'}
+            className={`dry-run-mode-btn ${mode === 'issue' ? 'is-active' : ''}`}
+            onClick={() => { setMode('issue'); }}
+          >
+            Pick existing issue
+          </button>
+        </div>
+
+        {error && (
+          <div className="workflow-alert workflow-alert-danger" role="alert">
+            {error}
+          </div>
+        )}
+
+        <form
+          onSubmit={(e) => {
+            void handleRun(e);
+          }}
+          className="workflow-dialog-form"
+        >
+          {mode === 'issue' ? (
+            <div className="workflow-form-group">
+              <label htmlFor="dry-run-issue-key" className="workflow-form-label">
+                Issue Key
+              </label>
+              <input
+                id="dry-run-issue-key"
+                type="text"
+                className="workflow-form-control"
+                placeholder="e.g. KAN-142"
+                value={issueKey}
+                onChange={(e) => { setIssueKey(e.target.value); }}
+                required
+              />
+            </div>
+          ) : (
+            <>
+              <div className="workflow-form-group">
+                <label htmlFor="dry-run-summary" className="workflow-form-label">
+                  Summary
+                </label>
+                <input
+                  id="dry-run-summary"
+                  type="text"
+                  className="workflow-form-control"
+                  value={summary}
+                  onChange={(e) => { setSummary(e.target.value); }}
+                  required
+                />
+              </div>
+
+              <div className="workflow-form-group">
+                <label htmlFor="dry-run-desc" className="workflow-form-label">
+                  Description Markdown
+                </label>
+                <textarea
+                  id="dry-run-desc"
+                  rows={4}
+                  className="workflow-form-control"
+                  value={description}
+                  onChange={(e) => { setDescription(e.target.value); }}
+                  required
+                />
+              </div>
+
+              <div className="workflow-form-group">
+                <label htmlFor="dry-run-priority" className="workflow-form-label">
+                  Priority
+                </label>
+                <input
+                  id="dry-run-priority"
+                  type="text"
+                  className="workflow-form-control"
+                  value={priority}
+                  onChange={(e) => { setPriority(e.target.value); }}
+                  required
+                />
+              </div>
+
+              <div className="workflow-form-group">
+                <label htmlFor="dry-run-labels" className="workflow-form-label">
+                  Labels (comma-separated)
+                </label>
+                <input
+                  id="dry-run-labels"
+                  type="text"
+                  className="workflow-form-control"
+                  value={labelsStr}
+                  onChange={(e) => { setLabelsStr(e.target.value); }}
+                />
+              </div>
+            </>
+          )}
+
+          <button
+            type="submit"
+            className="workflow-btn workflow-btn-primary"
+            disabled={isLoading}
+          >
+            {isLoading ? 'Running Dry-Run...' : '▶ Run Dry-Run'}
+          </button>
+        </form>
+
+        {/* Results section */}
+        {result && (
+          <div className="dry-run-results-container" data-testid="dry-run-results">
+            {/* would_commit summary banner */}
+            <div
+              className={`dry-run-summary-banner ${
+                result.would_commit ? 'would-commit' : 'blocked'
+              }`}
+              data-testid="would-commit-banner"
+            >
+              <span>{result.would_commit ? '✅' : '🛑'}</span>
+              <span>
+                {result.would_commit
+                  ? 'Transition Allowed: Changes would commit'
+                  : 'Transition Blocked: Changes would not commit (would_commit: false)'}
+              </span>
+            </div>
+
+            {/* Ordered steps */}
+            {result.steps.map((step) => renderStepResult(step))}
+          </div>
+        )}
+      </aside>
+    </div>
+  );
+}
+
+export function DryRunDrawer({
+  isOpen,
+  ...innerProps
+}: DryRunDrawerProps): JSX.Element | null {
+  if (!isOpen) return null;
+  return (
+    <DryRunDrawerInner
+      key={`${innerProps.transition.from_state ?? 'any'}-${innerProps.transition.to_state}`}
+      {...innerProps}
+    />
+  );
+}
diff --git a/kanban/web/src/features/workflows/HookPipelineRow.tsx b/kanban/web/src/features/workflows/HookPipelineRow.tsx
new file mode 100644
index 0000000..0cf9d8f
--- /dev/null
+++ b/kanban/web/src/features/workflows/HookPipelineRow.tsx
@@ -0,0 +1,295 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useEffect, useRef, useState, type JSX } from 'react';
+import {
+  draggable,
+  dropTargetForElements,
+} from '@atlaskit/pragmatic-drag-and-drop/element/adapter';
+import { EmojiHint } from '../../components/emoji/EmojiHint';
+import type { WorkflowHook } from './api';
+
+export interface HookPipelineRowProps {
+  hook: WorkflowHook;
+  index: number;
+  total: number;
+  projectKey: string;
+  onMove?: (hookId: string, direction: 'up' | 'down') => void;
+  onToggle?: (hookId: string, isEnabled: boolean) => void;
+  onEdit?: (hook: WorkflowHook) => void;
+  onDetach?: (hookId: string) => void;
+  onDropReorder?: (sourceId: string, targetId: string) => void;
+  draggableFactory?: typeof draggable;
+  dropTargetFactory?: typeof dropTargetForElements;
+}
+
+export function HookPipelineRow({
+  hook,
+  index,
+  total,
+  projectKey,
+  onMove,
+  onToggle,
+  onEdit,
+  onDetach,
+  onDropReorder,
+  draggableFactory = draggable,
+  dropTargetFactory = dropTargetForElements,
+}: HookPipelineRowProps): JSX.Element {
+  const rowRef = useRef<HTMLDivElement | null>(null);
+  const [isDragging, setIsDragging] = useState(false);
+  const [copiedSha, setCopiedSha] = useState(false);
+
+  useEffect(() => {
+    const el = rowRef.current;
+    if (!el) return undefined;
+
+    const cleanupDraggable = draggableFactory({
+      element: el,
+      getInitialData: () => ({ type: 'hook-row', hookId: hook.id, index }),
+      onDragStart: () => { setIsDragging(true); },
+      onDrop: () => { setIsDragging(false); },
+    });
+
+    const cleanupDropTarget = dropTargetFactory({
+      element: el,
+      getData: () => ({ type: 'hook-row', hookId: hook.id, index }),
+      onDrop: ({ source }) => {
+        setIsDragging(false);
+        const sourceData = source.data as { type?: string; hookId?: string } | undefined;
+        if (sourceData?.type === 'hook-row' && sourceData.hookId && sourceData.hookId !== hook.id) {
+          onDropReorder?.(sourceData.hookId, hook.id);
+        }
+      },
+    });
+
+    return () => {
+      cleanupDraggable();
+      cleanupDropTarget();
+    };
+  }, [hook.id, index, onDropReorder, draggableFactory, dropTargetFactory]);
+
+  const handleCopySha = async () => {
+    try {
+      await navigator.clipboard.writeText(hook.manifest_sha256);
+      setCopiedSha(true);
+      setTimeout(() => { setCopiedSha(false); }, 2000);
+    } catch {
+      // Fallback ignore in test env
+    }
+  };
+
+  // Determine badge text for Agent Gate
+  const getAgentBadgeLabel = (): string => {
+    if (hook.harness_kind === 'cli_pipe') {
+      return '[CLI Agent Gate]';
+    }
+    if (hook.harness_kind === 'in_app_sdk') {
+      if (hook.provider_kind === 'ollama') {
+        return '[Local Ollama Gate]';
+      }
+      return '[SDK Agent Gate]';
+    }
+    if (hook.harness_kind === 'remote_runner') {
+      return '[Remote WSS Gate]';
+    }
+    return '[Agent Gate]';
+  };
+
+  // Command summary string e.g. (`${context} | agy -p`) or (`ollama/qwen2.5-coder`)
+  const getCommandSummary = (): string | null => {
+    if (hook.hook_kind !== 'agent_interceptor') return null;
+    if (hook.harness_kind === 'cli_pipe') {
+      const bin = hook.cli_binary_allowlist_id ?? 'agy';
+      const args = hook.cli_args && hook.cli_args.length > 0 ? ` ${hook.cli_args.join(' ')}` : '';
+      return `(\${context} | ${bin}${args})`;
+    }
+    if (hook.harness_kind === 'in_app_sdk' && hook.model_id) {
+      return `(${hook.model_id})`;
+    }
+    return null;
+  };
+
+  // Truncated SHA-256 for display
+  const truncatedSha = hook.manifest_sha256
+    ? `sha256:${hook.manifest_sha256.slice(0, 8)}...`
+    : 'sha256:none';
+
+  // Format latency or timeout
+  const latencyOrTimeout =
+    hook.hook_kind === 'agent_interceptor'
+      ? `${String(Math.round((hook.timeout_ms ?? 60000) / 1000))}s`
+      : (hook.target_latency_budget ?? '<25ms');
+
+  const isSync = hook.hook_kind === 'sync_validator' || hook.hook_kind === 'sync_mutator';
+  const commandSummary = getCommandSummary();
+
+  const rowClasses = [
+    'hook-pipeline-row',
+    !hook.is_enabled ? 'is-disabled' : '',
+    isDragging ? 'is-dragging' : '',
+  ]
+    .filter(Boolean)
+    .join(' ');
+
+  return (
+    <article
+      ref={rowRef}
+      className={rowClasses}
+      data-testid={`hook-pipeline-row-${hook.id}`}
+      aria-label={`Workflow Hook: ${hook.name}`}
+    >
+      <div className="hook-pipeline-main">
+        <div className="hook-pipeline-left">
+          {/* Drag Handle & Order */}
+          <button
+            type="button"
+            className="hook-drag-handle"
+            aria-label={`Drag to reorder ${hook.name}`}
+            title="Drag to reorder"
+          >
+            ⋮⋮
+          </button>
+          <span className="hook-order-number">{index + 1}.</span>
+
+          {/* Hook Type Badge */}
+          {isSync ? (
+            <span className="hook-type-badge hook-type-sync">
+              ⚡ {hook.hook_kind === 'sync_validator' ? '[Sync Wasm Validator]' : '[Sync Wasm Mutator]'}
+            </span>
+          ) : (
+            <span className="hook-type-badge hook-type-agent">
+              <EmojiHint
+                kind="agent"
+                label={getAgentBadgeLabel()}
+                testId={`emoji-hint-${hook.id}`}
+                content={
+                  <div>
+                    <strong>{hook.name}</strong>
+                    <div>Harness: {hook.harness_kind ?? 'cli_pipe'}</div>
+                    {hook.repo_binding_slug && (
+                      <div>Repo: {hook.repo_binding_slug} (:ro mount)</div>
+                    )}
+                    <div>MCP: {hook.mcp_access_summary ?? `Read-Only (${projectKey})`}</div>
+                  </div>
+                }
+              />
+              <span>{getAgentBadgeLabel()}</span>
+            </span>
+          )}
+
+          {/* Hook Name & Command Summary */}
+          <span className="hook-name">{hook.name}</span>
+          {commandSummary && <span className="hook-command-summary">{commandSummary}</span>}
+        </div>
+
+        <div className="hook-pipeline-right">
+          {/* Latency / Timeout metric pill */}
+          <span className="hook-metric-pill" data-testid={`hook-latency-${hook.id}`}>
+            {latencyOrTimeout}
+          </span>
+
+          {/* Failure Policy badge */}
+          <span
+            className={`hook-policy-badge ${
+              hook.failure_policy === 'fail_closed' ? 'policy-fail-closed' : 'policy-fail-open'
+            }`}
+          >
+            {hook.failure_policy === 'fail_closed' ? 'Fail-Closed' : 'Fail-Open (Warn)'}
+          </span>
+
+          {/* Truncated SHA256 Chip */}
+          <button
+            type="button"
+            className="hook-sha256-chip"
+            onClick={() => {
+              void handleCopySha();
+            }}
+            title={`Click to copy full SHA-256: ${hook.manifest_sha256}`}
+            aria-label={`Copy SHA256: ${truncatedSha}`}
+          >
+            {copiedSha ? 'Copied!' : truncatedSha}
+          </button>
+
+          {/* Keyboard Reordering Buttons */}
+          <div className="hook-actions-group" role="group" aria-label="Reorder actions">
+            <button
+              type="button"
+              className="hook-move-btn"
+              disabled={index === 0}
+              onClick={() => onMove?.(hook.id, 'up')}
+              aria-label={`Move ${hook.name} up`}
+            >
+              Move up
+            </button>
+            <button
+              type="button"
+              className="hook-move-btn"
+              disabled={index === total - 1}
+              onClick={() => onMove?.(hook.id, 'down')}
+              aria-label={`Move ${hook.name} down`}
+            >
+              Move down
+            </button>
+          </div>
+
+          {/* Toggle Switch */}
+          <label className="hook-toggle-switch" htmlFor={`hook-toggle-${hook.id}`} aria-label={`Enable or disable ${hook.name}`}>
+            <input
+              id={`hook-toggle-${hook.id}`}
+              type="checkbox"
+              checked={hook.is_enabled}
+              onChange={(e) => onToggle?.(hook.id, e.target.checked)}
+              aria-label={`Toggle ${hook.name}`}
+            />
+            <span className="hook-toggle-slider" />
+          </label>
+
+          {/* Edit & Detach */}
+          <button
+            type="button"
+            className="workflow-btn workflow-btn-secondary workflow-btn-sm"
+            onClick={() => onEdit?.(hook)}
+            aria-label={`Edit ${hook.name}`}
+          >
+            Edit
+          </button>
+          <button
+            type="button"
+            className="workflow-btn workflow-btn-danger workflow-btn-sm"
+            onClick={() => onDetach?.(hook.id)}
+            aria-label={`Detach ${hook.name}`}
+          >
+            Detach
+          </button>
+        </div>
+      </div>
+
+      {/* Subtitle / Metadata row */}
+      <div className="hook-pipeline-subtitle">
+        {hook.hook_kind === 'agent_interceptor' ? (
+          <>
+            <span>Repo: <code>{hook.repo_binding_slug ?? 'kanban-main'}</code> (:ro mount)</span>
+            <span>|</span>
+            <span>MCP: {hook.mcp_access_summary ?? `Read-Only (${projectKey})`}</span>
+            <span>|</span>
+            <span>Mutable Fields:</span>
+            <div className="mutable-fields-chips">
+              {hook.allowed_mutable_fields && hook.allowed_mutable_fields.length > 0 ? (
+                hook.allowed_mutable_fields.map((field) => (
+                  <span key={field} className="field-chip">
+                    [{field}]
+                  </span>
+                ))
+              ) : (
+                <span className="field-chip">[none]</span>
+              )}
+            </div>
+          </>
+        ) : (
+          <span>{hook.description ?? 'Synchronous Wasm validator executing in isolated runtime.'}</span>
+        )}
+      </div>
+    </article>
+  );
+}
diff --git a/kanban/web/src/features/workflows/TransitionRuleCard.tsx b/kanban/web/src/features/workflows/TransitionRuleCard.tsx
new file mode 100644
index 0000000..fd4fefe
--- /dev/null
+++ b/kanban/web/src/features/workflows/TransitionRuleCard.tsx
@@ -0,0 +1,212 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, type JSX } from 'react';
+import {
+  draggable,
+  dropTargetForElements,
+} from '@atlaskit/pragmatic-drag-and-drop/element/adapter';
+import { HookPipelineRow } from './HookPipelineRow';
+import type { TransitionRule, WorkflowHook } from './api';
+
+export interface TransitionRuleCardProps {
+  rule: TransitionRule;
+  projectKey: string;
+  onReorder: (
+    transition: { from_state: string | null; to_state: string },
+    orderedHookIds: string[],
+  ) => Promise<void>;
+  onToggle: (hookId: string, isEnabled: boolean) => Promise<void>;
+  onEdit: (hook: WorkflowHook) => void;
+  onDetach: (hookId: string) => Promise<void>;
+  onAddHook: (transition: { from_state: string | null; to_state: string }) => void;
+  onDryRun: (transition: { from_state: string | null; to_state: string }) => void;
+  draggableFactory?: typeof draggable;
+  dropTargetFactory?: typeof dropTargetForElements;
+}
+
+export function TransitionRuleCard({
+  rule,
+  projectKey,
+  onReorder,
+  onToggle,
+  onEdit,
+  onDetach,
+  onAddHook,
+  onDryRun,
+  draggableFactory = draggable,
+  dropTargetFactory = dropTargetForElements,
+}: TransitionRuleCardProps): JSX.Element {
+  const [localHooks, setLocalHooks] = useState<WorkflowHook[]>(rule.hooks);
+  const [reorderError, setReorderError] = useState<string | null>(null);
+
+  // Sync when rule.hooks changes from query refetch
+  const effectiveHooks = localHooks.length === rule.hooks.length ? localHooks : rule.hooks;
+
+  const activeCount = effectiveHooks.filter((h) => h.is_enabled).length;
+  const fromLabel = rule.from_state ?? '* Any State';
+  const toLabel = rule.to_state;
+
+  const handleKeyboardMove = async (hookId: string, direction: 'up' | 'down') => {
+    const currentIndex = effectiveHooks.findIndex((h) => h.id === hookId);
+    if (currentIndex === -1) return;
+
+    const targetIndex = direction === 'up' ? currentIndex - 1 : currentIndex + 1;
+    if (targetIndex < 0 || targetIndex >= effectiveHooks.length) return;
+
+    const movedHook = effectiveHooks[currentIndex];
+    if (!movedHook) return;
+    const newHooks = effectiveHooks.filter((h) => h.id !== hookId);
+    newHooks.splice(targetIndex, 0, movedHook);
+
+    // Optimistic update
+    const previousHooks = [...effectiveHooks];
+    setLocalHooks(newHooks);
+    setReorderError(null);
+
+    try {
+      await onReorder(
+        { from_state: rule.from_state, to_state: rule.to_state },
+        newHooks.map((h) => h.id),
+      );
+    } catch (err: unknown) {
+      setLocalHooks(previousHooks);
+      if (err instanceof Error) {
+        setReorderError(err.message);
+      } else {
+        setReorderError('Reorder failed: 422 REORDER_SET_MISMATCH');
+      }
+    }
+  };
+
+  const handleDropReorder = async (sourceId: string, targetId: string) => {
+    const sourceIndex = effectiveHooks.findIndex((h) => h.id === sourceId);
+    const targetIndex = effectiveHooks.findIndex((h) => h.id === targetId);
+    if (sourceIndex === -1 || targetIndex === -1 || sourceIndex === targetIndex) return;
+
+    const movedHook = effectiveHooks[sourceIndex];
+    if (!movedHook) return;
+    const newHooks = effectiveHooks.filter((h) => h.id !== sourceId);
+    newHooks.splice(targetIndex, 0, movedHook);
+
+    // Optimistic update
+    const previousHooks = [...effectiveHooks];
+    setLocalHooks(newHooks);
+    setReorderError(null);
+
+    try {
+      await onReorder(
+        { from_state: rule.from_state, to_state: rule.to_state },
+        newHooks.map((h) => h.id),
+      );
+    } catch (err: unknown) {
+      setLocalHooks(previousHooks);
+      if (err instanceof Error) {
+        setReorderError(err.message);
+      } else {
+        setReorderError('Reorder failed: 422 REORDER_SET_MISMATCH');
+      }
+    }
+  };
+
+  return (
+    <section
+      className="transition-rule-card"
+      data-testid={`transition-card-${rule.from_state ?? 'any'}-${rule.to_state}`}
+      aria-label={`Transition Rule: ${fromLabel} to ${toLabel}`}
+    >
+      {/* Top arrow bar */}
+      <div className="transition-arrow-bar">
+        <div className="transition-states-container">
+          <span>Transition:</span>
+          <span className="state-badge state-badge-from">
+            {fromLabel.includes('Review') ? '🟣 ' : '⚪ '}
+            {fromLabel}
+          </span>
+          <div className="transition-arrow-connector">
+            <span>========(</span>
+            <span className="active-hooks-badge" data-testid="active-hooks-count">
+              {activeCount} Active Hook{activeCount === 1 ? '' : 's'}
+            </span>
+            <span>)========&gt;</span>
+          </div>
+          <span className="state-badge state-badge-to">
+            {toLabel.includes('Done') ? '🟢 ' : '⚪ '}
+            {toLabel}
+          </span>
+        </div>
+
+        <div className="hook-actions-group">
+          <button
+            type="button"
+            className="workflow-btn workflow-btn-secondary workflow-btn-sm"
+            onClick={() => {
+              onAddHook({ from_state: rule.from_state, to_state: rule.to_state });
+            }}
+            aria-label={`Add hook to ${fromLabel} to ${toLabel}`}
+          >
+            + Add Hook
+          </button>
+        </div>
+      </div>
+
+      {/* Accessible Reorder Error Alert */}
+      {reorderError && (
+        <div className="workflow-alert workflow-alert-danger" role="alert">
+          <strong>Reorder Error:</strong> {reorderError}
+        </div>
+      )}
+
+      {/* Ordered hooks or empty state */}
+      {effectiveHooks.length === 0 ? (
+        <div className="empty-hooks-cta" data-testid="empty-hooks-cta">
+          No hooks configured for this transition. Click &apos;+ Add Hook&apos; to attach a validator or agent gate.
+        </div>
+      ) : (
+        <div className="hook-pipeline-list" role="list" aria-label="Hook Pipeline List">
+          {effectiveHooks.map((hook, index) => (
+            <HookPipelineRow
+              key={hook.id}
+              hook={hook}
+              index={index}
+              total={effectiveHooks.length}
+              projectKey={projectKey}
+              onMove={(id, dir) => {
+                void handleKeyboardMove(id, dir);
+              }}
+              onDropReorder={(src, tgt) => {
+                void handleDropReorder(src, tgt);
+              }}
+              onToggle={(id, isEnabled) => {
+                void onToggle(id, isEnabled);
+              }}
+              onEdit={onEdit}
+              onDetach={(id) => {
+                void onDetach(id);
+              }}
+              draggableFactory={draggableFactory}
+              dropTargetFactory={dropTargetFactory}
+            />
+          ))}
+        </div>
+      )}
+
+      {/* Card bottom actions */}
+      <div className="transition-card-footer">
+        <span className="hook-command-summary">
+          Total configured hooks: {effectiveHooks.length}
+        </span>
+        <button
+          type="button"
+          className="workflow-btn workflow-btn-primary"
+          onClick={() => {
+            onDryRun({ from_state: rule.from_state, to_state: rule.to_state });
+          }}
+          aria-label={`Dry-run against sample ticket for ${fromLabel} to ${toLabel}`}
+        >
+          ▶ Dry-Run Against Sample Ticket
+        </button>
+      </div>
+    </section>
+  );
+}
diff --git a/kanban/web/src/features/workflows/WorkflowStudioPage.tsx b/kanban/web/src/features/workflows/WorkflowStudioPage.tsx
new file mode 100644
index 0000000..f7b68b1
--- /dev/null
+++ b/kanban/web/src/features/workflows/WorkflowStudioPage.tsx
@@ -0,0 +1,378 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, useMemo, type JSX } from 'react';
+import { useParams, useSearchParams } from 'react-router';
+import { useQuery, useQueryClient } from '@tanstack/react-query';
+import { qk } from '../../api/queryKeys';
+import { apiFetch } from '../../api/client';
+import { ApiProblem } from '../../api/problem';
+import { NotFoundView } from '../../app/routes';
+import { SecondFactorStep } from '../auth/SecondFactorStep';
+import type { MfaMethod } from '../auth/authApi';
+import { TransitionRuleCard } from './TransitionRuleCard';
+import { AttachHookDialog } from './AttachHookDialog';
+import { DryRunDrawer } from './DryRunDrawer';
+import {
+  fetchWorkflowHooks,
+  createWorkflowHook,
+  updateWorkflowHook,
+  enableWorkflowHook,
+  disableWorkflowHook,
+  deleteWorkflowHook,
+  reorderWorkflowHooks,
+  fetchAgentDefinitions,
+  fetchProjectStates,
+  fetchApprovedWasmModules,
+  type WorkflowHook,
+  type CreateWorkflowHookPayload,
+  type ReorderHooksPayload,
+} from './api';
+import './workflows.css';
+
+export interface WorkflowStudioPageProps {
+  projectKeyOverride?: string;
+  isAdmin?: boolean;
+}
+
+interface PendingMutation {
+  type: 'create' | 'update' | 'reorder' | 'enable' | 'disable' | 'delete';
+  execute: () => Promise<void>;
+}
+
+export function WorkflowStudioPage({
+  projectKeyOverride,
+  isAdmin: propIsAdmin,
+}: WorkflowStudioPageProps): JSX.Element {
+  const params = useParams<{ projectKey?: string }>();
+  const [searchParams] = useSearchParams();
+  const projectKey = projectKeyOverride ?? params.projectKey ?? 'KAN';
+  const queryClient = useQueryClient();
+
+  // Query parameter overrides for non-admin testing
+  const queryNonAdmin =
+    searchParams.get('non_admin') === 'true' ||
+    searchParams.get('role') === 'member' ||
+    searchParams.get('role') === 'viewer';
+
+  // Check project details & capabilities
+  const projectQuery = useQuery({
+    queryKey: qk.project(projectKey),
+    queryFn: async () => {
+      try {
+        const data: unknown = await apiFetch('GET', `/api/v1/projects/${encodeURIComponent(projectKey)}` as never);
+        return data as { name?: string; capabilities?: string[] };
+      } catch {
+        return null;
+      }
+    },
+    enabled: propIsAdmin === undefined && !queryNonAdmin,
+    staleTime: 60000,
+  });
+
+  const isUserAdmin = useMemo(() => {
+    if (queryNonAdmin) return false;
+    if (propIsAdmin !== undefined) return propIsAdmin;
+    const caps = projectQuery.data?.capabilities;
+    if (caps && Array.isArray(caps)) {
+      return caps.includes('ADMIN') || caps.includes('PROJECT_ADMIN');
+    }
+    return true;
+  }, [queryNonAdmin, propIsAdmin, projectQuery.data]);
+
+  // Main rules query
+  const rulesQuery = useQuery({
+    queryKey: ['workflow-hooks', projectKey],
+    queryFn: () => fetchWorkflowHooks(projectKey),
+    enabled: isUserAdmin,
+  });
+
+  const rules = rulesQuery.data ?? [];
+  const isLoading = rulesQuery.isLoading;
+  const generalError = rulesQuery.error ? rulesQuery.error.message : null;
+
+  // Dialog and drawer state
+  const [isAttachDialogOpen, setIsAttachDialogOpen] = useState(false);
+  const [editingHook, setEditingHook] = useState<WorkflowHook | null>(null);
+  const [activeTransition, setActiveTransition] = useState<{
+    from_state: string | null;
+    to_state: string;
+  } | null>(null);
+
+  const [dryRunTransition, setDryRunTransition] = useState<{
+    from_state: string | null;
+    to_state: string;
+  } | null>(null);
+
+  // AAL2 Step-Up state
+  const [aal2Challenge, setAal2Challenge] = useState<{
+    challengeId: string;
+    methods: MfaMethod[];
+  } | null>(null);
+  const [pendingMutation, setPendingMutation] = useState<PendingMutation | null>(null);
+
+  // Auxiliary data queries
+  const statesQuery = useQuery({
+    queryKey: ['project-states', projectKey],
+    queryFn: () => fetchProjectStates(projectKey),
+    enabled: isUserAdmin,
+  });
+
+  const agentsQuery = useQuery({
+    queryKey: ['agent-definitions', 'kanban'],
+    queryFn: () => fetchAgentDefinitions('kanban'),
+    enabled: isUserAdmin,
+  });
+
+  const wasmModulesQuery = useQuery({
+    queryKey: ['approved-wasm-modules'],
+    queryFn: () => fetchApprovedWasmModules(),
+    enabled: isUserAdmin,
+  });
+
+  // If user lacks admin permissions, render uniform Not found or no access view (zero write requests)
+  if (!isUserAdmin) {
+    return <NotFoundView />;
+  }
+
+  // Handle AAL2 403 response intercept
+  const handleAal2Intercept = (err: unknown, mutation: PendingMutation): boolean => {
+    if (err instanceof ApiProblem && err.code === 'AAL2_REQUIRED') {
+      setPendingMutation(mutation);
+      const data = err.data;
+      const challengeId = typeof data.challenge_id === 'string' ? data.challenge_id : 'aal2-stepup';
+      const methods = Array.isArray(data.methods)
+        ? (data.methods as MfaMethod[])
+        : (['webauthn', 'totp'] as MfaMethod[]);
+      setAal2Challenge({ challengeId, methods });
+      return true;
+    }
+    return false;
+  };
+
+  const handleAal2Success = async () => {
+    const mutation = pendingMutation;
+    setAal2Challenge(null);
+    setPendingMutation(null);
+    if (mutation) {
+      await mutation.execute();
+    }
+  };
+
+  // Reorder hooks handler
+  const handleReorder = async (
+    transition: { from_state: string | null; to_state: string },
+    orderedHookIds: string[],
+  ) => {
+    const payload: ReorderHooksPayload = {
+      transition,
+      ordered_hook_ids: orderedHookIds,
+    };
+
+    const action = async () => {
+      await reorderWorkflowHooks(projectKey, payload);
+      await queryClient.invalidateQueries({ queryKey: ['workflow-hooks', projectKey] });
+    };
+
+    try {
+      await action();
+    } catch (err: unknown) {
+      if (handleAal2Intercept(err, { type: 'reorder', execute: action })) {
+        return;
+      }
+      throw err;
+    }
+  };
+
+  // Toggle hook enabled / disabled
+  const handleToggle = async (hookId: string, isEnabled: boolean) => {
+    const action = async () => {
+      if (isEnabled) {
+        await enableWorkflowHook(hookId);
+      } else {
+        await disableWorkflowHook(hookId);
+      }
+      await queryClient.invalidateQueries({ queryKey: ['workflow-hooks', projectKey] });
+    };
+
+    try {
+      await action();
+    } catch (err: unknown) {
+      if (handleAal2Intercept(err, { type: isEnabled ? 'enable' : 'disable', execute: action })) {
+        return;
+      }
+    }
+  };
+
+  // Detach hook
+  const handleDetach = async (hookId: string) => {
+    const action = async () => {
+      await deleteWorkflowHook(hookId);
+      await queryClient.invalidateQueries({ queryKey: ['workflow-hooks', projectKey] });
+    };
+
+    try {
+      await action();
+    } catch (err: unknown) {
+      if (handleAal2Intercept(err, { type: 'delete', execute: action })) {
+        return;
+      }
+    }
+  };
+
+  // Save hook (create or update)
+  const handleSaveHook = async (payload: CreateWorkflowHookPayload) => {
+    const action = async () => {
+      if (editingHook) {
+        await updateWorkflowHook(editingHook.id, {
+          name: payload.name,
+          failure_policy: payload.failure_policy,
+          allowed_mutable_fields: payload.allowed_mutable_fields,
+          wasm_module_sha256: payload.wasm_module_sha256,
+          agent: payload.agent,
+          timeout_ms: payload.timeout_ms,
+        });
+      } else {
+        await createWorkflowHook(projectKey, payload);
+      }
+      await queryClient.invalidateQueries({ queryKey: ['workflow-hooks', projectKey] });
+    };
+
+    try {
+      await action();
+    } catch (err: unknown) {
+      if (handleAal2Intercept(err, { type: editingHook ? 'update' : 'create', execute: action })) {
+        return;
+      }
+      throw err;
+    }
+  };
+
+  return (
+    <main className="workflow-studio" data-testid="workflow-studio-page">
+      {/* Studio Header */}
+      <header className="workflow-studio-header">
+        <h1 className="workflow-studio-title">
+          <span>⚙️ Project</span>
+          <span className="workflow-studio-title-badge">{projectKey}</span>
+          <span>&gt; Workflow &amp; Transition Interceptors</span>
+        </h1>
+        <button
+          type="button"
+          className="workflow-btn workflow-btn-primary"
+          onClick={() => {
+            setEditingHook(null);
+            setActiveTransition(null);
+            setIsAttachDialogOpen(true);
+          }}
+          aria-label="Add Transition Rule"
+        >
+          + Add Transition Rule
+        </button>
+      </header>
+
+      {/* General Alert */}
+      {generalError && (
+        <div className="workflow-alert workflow-alert-danger" role="alert">
+          {generalError}
+        </div>
+      )}
+
+      {/* Loading State */}
+      {isLoading ? (
+        <div className="empty-hooks-cta">Loading workflow interceptor rules...</div>
+      ) : rules.length === 0 ? (
+        <div className="empty-hooks-cta" data-testid="empty-studio-state">
+          No workflow transition rules configured for Project {projectKey}. Click &apos;+ Add Transition Rule&apos; to create one.
+        </div>
+      ) : (
+        rules.map((rule) => (
+          <TransitionRuleCard
+            key={`${rule.from_state ?? 'any'}-${rule.to_state}`}
+            rule={rule}
+            projectKey={projectKey}
+            onReorder={handleReorder}
+            onToggle={handleToggle}
+            onEdit={(hook) => {
+              setEditingHook(hook);
+              setActiveTransition({ from_state: hook.from_state, to_state: hook.to_state });
+              setIsAttachDialogOpen(true);
+            }}
+            onDetach={handleDetach}
+            onAddHook={(transition) => {
+              setEditingHook(null);
+              setActiveTransition(transition);
+              setIsAttachDialogOpen(true);
+            }}
+            onDryRun={(transition) => {
+              setDryRunTransition(transition);
+            }}
+          />
+        ))
+      )}
+
+      {/* Attach / Edit Hook Dialog */}
+      <AttachHookDialog
+        isOpen={isAttachDialogOpen}
+        projectKey={projectKey}
+        initialTransition={activeTransition ?? undefined}
+        editingHook={editingHook}
+        states={statesQuery.data ?? []}
+        agentDefinitions={agentsQuery.data ?? []}
+        wasmModules={wasmModulesQuery.data ?? []}
+        onSave={handleSaveHook}
+        onClose={() => {
+          setIsAttachDialogOpen(false);
+          setEditingHook(null);
+          setActiveTransition(null);
+        }}
+      />
+
+      {/* Dry-Run Drawer */}
+      {dryRunTransition && (
+        <DryRunDrawer
+          isOpen={Boolean(dryRunTransition)}
+          projectKey={projectKey}
+          transition={dryRunTransition}
+          onClose={() => {
+            setDryRunTransition(null);
+          }}
+        />
+      )}
+
+      {/* AAL2 Step-Up Modal */}
+      {aal2Challenge && (
+        <div className="workflow-modal-backdrop" role="presentation">
+          <div
+            className="workflow-dialog"
+            role="dialog"
+            aria-modal="true"
+            aria-labelledby="aal2-stepup-title"
+          >
+            <h2 id="aal2-stepup-title" className="workflow-dialog-title">
+              Admin Verification Required (AAL2)
+            </h2>
+            <SecondFactorStep
+              challengeId={aal2Challenge.challengeId}
+              methods={aal2Challenge.methods}
+              onSuccess={() => {
+                void handleAal2Success();
+              }}
+              onError={() => {
+                // Handled in SecondFactorStep
+              }}
+              onSessionExpired={() => {
+                setAal2Challenge(null);
+                setPendingMutation(null);
+              }}
+              onCancel={() => {
+                setAal2Challenge(null);
+                setPendingMutation(null);
+              }}
+            />
+          </div>
+        </div>
+      )}
+    </main>
+  );
+}
