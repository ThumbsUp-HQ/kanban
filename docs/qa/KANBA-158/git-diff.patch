+            <code className="dry-run-cli-code">{defaultCliCmd}</code>
+            <button
+              type="button"
+              className="workflow-btn workflow-btn-secondary workflow-btn-sm"
+              onClick={() => {
+                void handleCopyCli(defaultCliCmd);
+              }}
+              aria-label={`Copy CLI command for ${step.name}`}
