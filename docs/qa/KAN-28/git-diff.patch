+def verify_same_origin_request(request: Request) -> bool:
+    """Validate Sec-Fetch-Site and Origin/Referer headers against permitted origins."""
+    sec_fetch_site = request.headers.get("sec-fetch-site")
+    if sec_fetch_site and sec_fetch_site.strip().lower() not in ("same-origin", "none"):
+        return False
+
+    public_origin = _resolve_public_origin()
+    allowed_origins = _get_allowed_origins(request, public_origin)
+    origin = request.headers.get("origin")
+    if origin:
+        clean_origin = origin.strip().rstrip("/")
+        if clean_origin.lower() == "null":
+            # WHATWG Fetch spec ("Append a request-origin header"):
+            # When document has Referrer-Policy: no-referrer, native HTML form POST
+            # navigations in Chromium send Origin: null, omit Referer, and send
+            # browser-enforced Sec-Fetch-Site: same-origin.
+            # Accept Origin: null ONLY when Sec-Fetch-Site is explicitly "same-origin".
+            if not sec_fetch_site or sec_fetch_site.strip().lower() != "same-origin":
+                return False
+        elif not allowed_origins or clean_origin not in allowed_origins:
+            return False
+    else:
+        referer = request.headers.get("referer")
+        if referer:
+            err = _check_referer_header(referer, allowed_origins, public_origin)
+            if err:
+                return False
+    return True
+
