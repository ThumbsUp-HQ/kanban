+def test_consent_csrf_token_lifecycle() -> None:
+    """Test HMAC-SHA256 consent CSRF token issuance, validation, and tampering resistance."""
+    hmac_key = b"s" * 32
+    session_id = uuid.uuid4()
+    client_id = "test-client"
+    redirect_uri = "http://127.0.0.1:8080/callback"
+    code_challenge = "chal123"
+    state = "state123"
+    surface = "agent"
+
+    token = generate_consent_csrf_token(
+        session_hmac_key=hmac_key,
+        session_id=session_id,
+        client_id=client_id,
+        redirect_uri=redirect_uri,
+        code_challenge=code_challenge,
+        state=state,
+        surface=surface,
+        ttl_seconds=300,
+    )
+
+    # Valid token passes
+    assert verify_consent_csrf_token(
+        token=token,
+        session_hmac_key=hmac_key,
+        session_id=session_id,
+        client_id=client_id,
+        redirect_uri=redirect_uri,
+        code_challenge=code_challenge,
+        state=state,
+        surface=surface,
+    )
+
+    # Bound parameter mismatch fails
+    assert not verify_consent_csrf_token(
+        token=token,
+        session_hmac_key=hmac_key,
+        session_id=uuid.uuid4(),  # Different session
+        client_id=client_id,
+        redirect_uri=redirect_uri,
+        code_challenge=code_challenge,
+        state=state,
+        surface=surface,
+    )
+    assert not verify_consent_csrf_token(
+        token=token,
+        session_hmac_key=hmac_key,
+        session_id=session_id,
+        client_id="other-client",
+        redirect_uri=redirect_uri,
+        code_challenge=code_challenge,
+        state=state,
+        surface=surface,
+    )
+    assert not verify_consent_csrf_token(
+        token=token,
+        session_hmac_key=hmac_key,
+        session_id=session_id,
+        client_id=client_id,
+        redirect_uri="http://127.0.0.1:8080/other",
+        code_challenge=code_challenge,
+        state=state,
+        surface=surface,
+    )
+    assert not verify_consent_csrf_token(
+        token=token,
+        session_hmac_key=hmac_key,
+        session_id=session_id,
+        client_id=client_id,
+        redirect_uri=redirect_uri,
+        code_challenge="different-challenge",
+        state=state,
+        surface=surface,
+    )
+    assert not verify_consent_csrf_token(
+        token=token,
+        session_hmac_key=hmac_key,
+        session_id=session_id,
+        client_id=client_id,
+        redirect_uri=redirect_uri,
+        code_challenge=code_challenge,
+        state="different-state",
+        surface=surface,
+    )
+    assert not verify_consent_csrf_token(
