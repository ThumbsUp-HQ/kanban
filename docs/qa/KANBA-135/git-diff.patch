+        _validate_complete_work_arguments({"identifier": "KAN-142", "summary_markdown": ""})
+
+    # Oversized summary_markdown
+    with pytest.raises(KbMcpError):
+        _validate_complete_work_arguments(
+            {
+                "identifier": "KAN-142",
+                "summary_markdown": "x" * 65537,
