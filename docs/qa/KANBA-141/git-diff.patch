+# Copyright 2026 Kanban Platform Contributors
+# Apache-2.0 License. See LICENSE for details.
+"""SQLAlchemy model for mcp_read_taint table (KB-P4-07 / S3.5)."""
+
+from __future__ import annotations
+
+import uuid  # noqa: TC003  # Runtime import required for SQLAlchemy mapped_column
+from datetime import datetime  # noqa: TC003  # Runtime import required for SQLAlchemy Mapped[datetime]
+from typing import TYPE_CHECKING, Literal
+
+from sqlalchemy import CheckConstraint, DateTime, ForeignKey, String, func
+from sqlalchemy.dialects.postgresql import BYTEA, UUID
+from sqlalchemy.orm import Mapped, mapped_column, relationship
+
+from database.models.base import Base
+
+if TYPE_CHECKING:
+    from database.models.projects import Project
+    from database.models.spine import Workspace
+
+McpTaintKeyKind = Literal["session", "credential"]
+
+
+class McpReadTaint(Base):
+    """Session or credential read taint tracking projects accessed by MCP agents."""
+
+    __tablename__ = "mcp_read_taint"
+
+    taint_key: Mapped[bytes] = mapped_column(
+        BYTEA,
+        primary_key=True,
+        nullable=False,
+    )
+    project_id: Mapped[uuid.UUID] = mapped_column(
+        UUID(as_uuid=True),
+        ForeignKey("projects.id", ondelete="CASCADE"),
+        primary_key=True,
+        nullable=False,
+    )
+    workspace_id: Mapped[uuid.UUID] = mapped_column(
+        UUID(as_uuid=True),
+        ForeignKey("workspaces.id", ondelete="CASCADE"),
+        nullable=False,
+        index=True,
+    )
+    key_kind: Mapped[str] = mapped_column(
+        String(16),
+        nullable=False,
+    )
+    first_read_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        server_default=func.clock_timestamp(),
+    )
+    expires_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        index=True,
+    )
+
+    workspace: Mapped[Workspace] = relationship(
+        "Workspace",
+        foreign_keys=[workspace_id],
+    )
+    project: Mapped[Project] = relationship(
+        "Project",
+        foreign_keys=[project_id],
+    )
+
+    __table_args__ = (
+        CheckConstraint(
+            "octet_length(taint_key) = 32",
+            name="mcp_read_taint_key_len_check",
+        ),
+        CheckConstraint(
+            "key_kind IN ('session', 'credential')",
+            name="mcp_read_taint_key_kind_check",
+        ),
+    )
