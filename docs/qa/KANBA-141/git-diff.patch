+            "action": "add",
+        },
+        subject_token=env.token_adam,
+    )
+    # Now remove from perspective of KAN-142 targeting KAN-150
+    res_rem_inbound = await _call_link_objects(
+        env,
+        {
+            "source": "KAN-142",
+            "target": "KAN-150",
+            "link_type": "blocks",
+            "action": "remove",
