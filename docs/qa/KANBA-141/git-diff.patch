+
+    # Escape attempt: New session_2 with same tok_adam writing to PUB-1
+    session_2 = f"mcp-sess-escape-{uuid.uuid4()}"
+    r_escape = await client.post(
+        f"/api/v1/issues/{pub_1_id}/comments",
