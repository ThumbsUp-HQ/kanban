+@pytest.mark.asyncio
+async def test_case_2_canary_exfiltration_blocked(taint_test_env: dict[str, Any]) -> None:
+    """Case 2: Canary exfiltration test: reading SEC-1 then writing to PUB-1 is blocked."""
