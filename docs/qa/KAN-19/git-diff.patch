+import React from 'react';
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { PasskeyEnrollModal } from '../PasskeyEnrollModal';
+import * as personalSettingsApi from '../personalSettingsApi';
+import { ApiProblem } from '../../../api/problem';
+
+function renderModal(
+  props: Partial<React.ComponentProps<typeof PasskeyEnrollModal>> = {},
+  client = new QueryClient({ defaultOptions: { queries: { retry: false } } }),
+) {
+  const defaultProps: React.ComponentProps<typeof PasskeyEnrollModal> = {
+    isOpen: true,
+    onClose: vi.fn(),
+    onSuccess: vi.fn(),
+    initialAttachment: 'platform',
+    ...props,
+  };
+
+  return {
+    ...render(
+      <QueryClientProvider client={client}>
+        <PasskeyEnrollModal {...defaultProps} />
+      </QueryClientProvider>,
+    ),
+    client,
+    props: defaultProps,
+  };
+}
+
+describe('PasskeyEnrollModal (KAN-25)', () => {
+  const mockOptions: personalSettingsApi.PublicKeyCredentialCreationOptionsJSON = {
+    rp: { name: 'Kanban RP' },
+    user: { id: 'dXNlcjE', name: 'alice', displayName: 'Alice' },
+    challenge: 'Y2hhbGxlbmdlMQ',
+    pubKeyCredParams: [{ alg: -7, type: 'public-key' }],
+    timeout: 60000,
+  };
+
+  const mockCred = {
+    id: 'cred-mock-id',
+    rawId: new Uint8Array([1, 2, 3]).buffer,
+    type: 'public-key',
+    response: {
+      clientDataJSON: new TextEncoder().encode('{"type":"webauthn.create"}').buffer,
+      attestationObject: new Uint8Array([4, 5, 6]).buffer,
+      getTransports: () => ['internal', 'hybrid'],
+    },
+    getClientExtensionResults: () => ({}),
+  } as unknown as PublicKeyCredential;
+
+  let mockCredentials: {
+    create: ReturnType<typeof vi.fn>;
+    get: ReturnType<typeof vi.fn>;
+  };
+
+  beforeEach(() => {
+    vi.restoreAllMocks();
+
+    mockCredentials = {
+      create: vi.fn().mockResolvedValue(mockCred),
+      get: vi.fn().mockResolvedValue(null),
+    };
+
+    Object.defineProperty(navigator, 'credentials', {
+      writable: true,
+      configurable: true,
+      value: mockCredentials,
+    });
+  });
+
+  it('renders nothing when isOpen is false', () => {
+    const { container } = renderModal({ isOpen: false });
+    expect(container.firstChild).toBeNull();
+  });
+
+  it('renders modal with initial attachment and switches radio choices', () => {
+    renderModal({ initialAttachment: 'cross-platform' });
+
+    expect(screen.getByRole('dialog')).toBeDefined();
+    expect(screen.getByTestId('passkey-enroll-title')).toBeDefined();
+
+    const crossRadio = screen.getByTestId<HTMLInputElement>('attachment-cross-platform-radio');
+    expect(crossRadio.checked).toBe(true);
+
+    const platformRadio = screen.getByTestId<HTMLInputElement>('attachment-platform-radio');
+    fireEvent.click(platformRadio);
+    expect(platformRadio.checked).toBe(true);
+
+    const anyRadio = screen.getByTestId<HTMLInputElement>('attachment-any-radio');
+    fireEvent.click(anyRadio);
+    expect(anyRadio.checked).toBe(true);
+
+    fireEvent.click(crossRadio);
+    expect(crossRadio.checked).toBe(true);
+  });
+
+  it('calls onClose when clicking Cancel button or header close', () => {
+    const onClose = vi.fn();
+    renderModal({ onClose });
+
+    const closeBtn = screen.getByTestId('passkey-enroll-close-btn');
+    expect(closeBtn.getAttribute('aria-label')).toBe('Close');
+    expect(closeBtn.textContent).toBe('✕');
+
+    fireEvent.click(closeBtn);
+    expect(onClose).toHaveBeenCalledTimes(1);
+
+    fireEvent.click(screen.getByTestId('passkey-enroll-cancel-btn'));
+    expect(onClose).toHaveBeenCalledTimes(2);
+  });
+
+  it('dismisses modal on Escape key press when not submitting', () => {
+    const onClose = vi.fn();
+    renderModal({ onClose });
+
+    fireEvent.keyDown(document, { key: 'Escape' });
+    expect(onClose).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not dismiss modal on Escape when mid-submitting', async () => {
+    let resolveRegistration: ((val: unknown) => void) | undefined;
+    const pendingPromise = new Promise((resolve) => {
+      resolveRegistration = resolve;
+    });
+    vi.spyOn(personalSettingsApi, 'fetchWebauthnRegistrationOptions').mockReturnValueOnce(
+      pendingPromise as never,
+    );
+
+    const onClose = vi.fn();
+    renderModal({ onClose });
+
+    fireEvent.change(screen.getByTestId('passkey-enroll-nickname-input'), {
+      target: { value: 'Submitting Key' },
+    });
+    fireEvent.click(screen.getByTestId('passkey-enroll-submit-btn'));
+
+    // While submitting, press Escape
+    fireEvent.keyDown(document, { key: 'Escape' });
+    expect(onClose).not.toHaveBeenCalled();
+
+    // Keydown other keys (e.g. Enter) should not trigger close
+    fireEvent.keyDown(document, { key: 'Enter' });
+    expect(onClose).not.toHaveBeenCalled();
+
+    // Clean up pending promise and wait for submission to finish
+    resolveRegistration?.({ ...mockOptions });
+    await waitFor(() => {
+      expect(screen.queryByTestId('passkey-enroll-submit-btn')).not.toBeNull();
+    });
+  });
+
+  it('traps focus inside the modal on Tab and Shift+Tab', () => {
+    renderModal();
+
+    const input = screen.getByTestId('passkey-enroll-nickname-input');
+    fireEvent.change(input, { target: { value: 'My Key' } });
+
+    const closeBtn = screen.getByTestId('passkey-enroll-close-btn');
+    const submitBtn = screen.getByTestId('passkey-enroll-submit-btn');
+
+    // Focus last element (submit button) and press Tab -> cycles to first element (closeBtn)
+    submitBtn.focus();
+    expect(document.activeElement).toBe(submitBtn);
+
+    fireEvent.keyDown(document, { key: 'Tab', shiftKey: false });
+    expect(document.activeElement).toBe(closeBtn);
+
+    // Focus first element (close button) and press Shift+Tab -> cycles to last element (submitBtn)
+    closeBtn.focus();
+    expect(document.activeElement).toBe(closeBtn);
+
+    fireEvent.keyDown(document, { key: 'Tab', shiftKey: true });
+    expect(document.activeElement).toBe(submitBtn);
+
+    // If activeElement is outside modal, Tab focuses first element
+    document.body.focus();
+    fireEvent.keyDown(document, { key: 'Tab', shiftKey: false });
+    expect(document.activeElement).toBe(closeBtn);
+
+    // If activeElement is outside modal, Shift+Tab focuses last element
+    document.body.focus();
+    fireEvent.keyDown(document, { key: 'Tab', shiftKey: true });
+    expect(document.activeElement).toBe(submitBtn);
+  });
+
+  it('updates attachment choice when initialAttachment prop changes', () => {
+    const { rerender } = renderModal({ initialAttachment: 'platform' });
+    expect(screen.getByTestId<HTMLInputElement>('attachment-platform-radio').checked).toBe(true);
