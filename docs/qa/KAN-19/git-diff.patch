+                    else:
+                        fix_hint = (
+                            f"Unknown parameter '{k}'. Valid options: {', '.join(valid_options)}"
+                        )
+
+                    corrected_args: dict[str, Any] = {}
+                    for arg_k, arg_v in arguments.items():
