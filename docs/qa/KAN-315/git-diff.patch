+
+      fireEvent.keyDown(dropdown, { key: 'Home' });
+      expect(document.activeElement).toBe(menuItems[0]);
+
+      // Escape closes dropdown
+      fireEvent.keyDown(dropdown, { key: 'Escape' });
+      await waitFor(() => {
+        expect(screen.queryByRole('menu')).toBeNull();
+      });
+    });
+  });
