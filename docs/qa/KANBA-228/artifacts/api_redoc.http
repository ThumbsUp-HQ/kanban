                  <tr><td><code>tab</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Tab filter: all, comments, history, gates</td></tr>
                  <tr><td><code>order</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Order by timestamp: desc or asc</td></tr>
                  <tr><td><code>limit</code></td><td>query</td><td>No</td><td><code>integer</code></td><td>Items per page (1..100)</td></tr>
                  <tr><td><code>cursor</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Opaque HMAC keyset cursor</td></tr>
                  <tr><td><code>include_hashes</code></td><td>query</td><td>No</td><td><code>boolean</code></td><td>Include cryptographic row/prev hashes</td></tr>
