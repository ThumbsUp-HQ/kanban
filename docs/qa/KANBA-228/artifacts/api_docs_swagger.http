          <span class="opblock-path">/api/v1/admin/auth-cards/{card_ref}/enable</span>
          <span class="opblock-summary-text">Enable authentication card</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Enable card sign-in for users and administrators while auditing the action.</p>
