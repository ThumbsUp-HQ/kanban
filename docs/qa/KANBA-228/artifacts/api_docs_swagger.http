            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/api/v1/workspaces/{workspace_id}/switch</span>
          <span class="opblock-summary-text">Switch active workspace session</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Switch caller&#x27;s active session to the target workspace.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>workspace_id</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
