                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/oauth/device/info" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
    </section>
