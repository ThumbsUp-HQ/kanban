      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/oauth/authorize</span>
          <span class="opblock-summary-text">OAuth 2.1 Interactive Authorization / Consent Screen</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Render interactive consent screen for authorization code grant with PKCE S256.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>response_type</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>client_id</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>redirect_uri</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>code_challenge</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>code_challenge_method</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>state</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>resource</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>scope</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/oauth/authorize" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/oauth/authorize/decision</span>
          <span class="opblock-summary-text">Process OAuth 2.1 Consent Decision</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Process user consent decision, minting authorization code or returning access_denied.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X POST "http://localhost:8000/oauth/authorize/decision" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/oauth/device/authorize</span>
          <span class="opblock-summary-text">OAuth 2.0 Device Authorization (RFC 8628)</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Initiate RFC 8628 Device Authorization Flow for headless clients.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X POST "http://localhost:8000/oauth/device/authorize" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/oauth/jwks.json</span>
          <span class="opblock-summary-text">OAuth Public Key Set (JWKS)</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Return RFC 7517 public JWKS for verifying ES256 access tokens.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/oauth/jwks.json" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/oauth/register</span>
          <span class="opblock-summary-text">Dynamic Client Registration (RFC 7591)</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Register public OAuth 2.1 client with strict URI and rate limit validation.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
