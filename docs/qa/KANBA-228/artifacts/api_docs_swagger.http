      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/oauth/revoke</span>
          <span class="opblock-summary-text">OAuth Token Revocation (RFC 7009)</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Revoke an access token or refresh token per RFC 7009.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X POST "http://localhost:8000/oauth/revoke" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/oauth/token</span>
          <span class="opblock-summary-text">OAuth 2.1 Token Exchange (Authorization Code &amp; Refresh Token)</span>
        </summary>
