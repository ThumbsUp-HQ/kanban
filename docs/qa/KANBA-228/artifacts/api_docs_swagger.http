          <span class="opblock-path">/api/v1/oauth/device/info</span>
          <span class="opblock-summary-text">Get pending device authorization info</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Retrieve metadata for a pending device authorization request.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>user_code</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td>User code in format XXXX-XXXX</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
