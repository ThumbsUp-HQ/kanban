            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>u</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td>Target external HTTPS image URL</td></tr>
                  <tr><td><code>sig</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td>HMAC-SHA256 signature for media URL</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
