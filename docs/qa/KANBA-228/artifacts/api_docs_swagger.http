        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Handle IdP callback redirect, validate state and token, and establish session.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>slug</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>code</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>state</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>error</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>error_description</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>link_intent_id</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/auth/oidc/{slug}/callback" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/api/v1/auth/oidc/{slug}/start</span>
          <span class="opblock-summary-text">Start OIDC or OAuth2 login</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Initialize authorization-code flow with PKCE S256 for an OIDC or OAuth2 card.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>slug</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>return_to</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>link_intent_id</code></td><td>query</td><td>No</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>remember_me</code></td><td>query</td><td>No</td><td><code>boolean</code></td><td></td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
