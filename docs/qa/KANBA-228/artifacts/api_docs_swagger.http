                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X PATCH "http://localhost:8000/api/v1/workflow-hooks/{hook_id}" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-delete">
        <summary class="opblock-summary opblock-summary-delete">
          <span class="opblock-method opblock-method-delete">DELETE</span>
          <span class="opblock-path">/api/v1/workflow-hooks/{hook_id}</span>
          <span class="opblock-summary-text">Delete/detach a workflow hook</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Permanently delete and detach a workflow hook from a transition rule.

Requires project admin and AAL2.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>hook_id</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">204</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
