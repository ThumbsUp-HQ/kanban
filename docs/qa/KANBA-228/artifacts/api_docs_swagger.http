    <section class="opblock-tag-section">
      <h2 class="opblock-tag-header">resolve <span class="tag-count">(1)</span></h2>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/api/v1/resolve</span>
          <span class="opblock-summary-text">Resolve human-readable reference or UUID to canonical entity identity</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Resolve an entity key to UUID and metadata with timing equalization anti-enumeration.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>kind</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td>Entity kind: project, issue, state, user, cycle, module, label, hook</td></tr>
                  <tr><td><code>ref</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td>Human key, handle, or UUID reference</td></tr>
                  <tr><td><code>project</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Project key context required for project-scoped kinds</td></tr>
                  <tr><td><code>workspace</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Workspace slug or UUID filter to constrain resolution scope</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/resolve" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
    </section>
    <section class="opblock-tag-section">
      <h2 class="opblock-tag-header">search <span class="tag-count">(3)</span></h2>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/api/v1/search</span>
          <span class="opblock-summary-text">Unified cross-entity search</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Execute unified lexical full-text and trigram search under caller RLS.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>q</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Search query string</td></tr>
                  <tr><td><code>kinds</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Comma-separated entity kinds (issue,doc,page,sticky)</td></tr>
                  <tr><td><code>project</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Project identifier or UUID scope filter</td></tr>
                  <tr><td><code>limit</code></td><td>query</td><td>No</td><td><code>integer</code></td><td>Page size (1..50)</td></tr>
                  <tr><td><code>cursor</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Opaque HMAC-signed keyset pagination cursor</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/search" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/api/v1/search/issues</span>
          <span class="opblock-summary-text">Structured issue search</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Execute issue-scoped search composed with FilterSpec DSL predicates.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
