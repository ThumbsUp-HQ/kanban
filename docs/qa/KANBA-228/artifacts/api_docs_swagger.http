      <details class="opblock opblock-post">
        <summary class="opblock-summary opblock-summary-post">
          <span class="opblock-method opblock-method-post">POST</span>
          <span class="opblock-path">/api/v1/workspaces</span>
          <span class="opblock-summary-text">Create a new workspace and bind creator as WORKSPACE_ADMIN</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Create a new workspace, auto-initialize settings, and assign WORKSPACE_ADMIN.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
