          <span class="opblock-summary-text">Get access-filtered assignee suggestions</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Return autocomplete suggestions of active project viewers with zero cross-scope leakage.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>project_ref</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>q</code></td><td>query</td><td>Yes</td><td><code>string</code></td><td>Case-insensitive prefix query (1..64 chars)</td></tr>
                  <tr><td><code>limit</code></td><td>query</td><td>No</td><td><code>integer</code></td><td>Max suggestions to return (1..20)</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/projects/{project_ref}/assignee-suggestions" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
    </section>
    <section class="opblock-tag-section">
      <h2 class="opblock-tag-header">attachments <span class="tag-count">(3)</span></h2>
      <details class="opblock opblock-get">
