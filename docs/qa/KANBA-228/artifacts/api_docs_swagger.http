              <pre class="curl-box"><code>curl -X POST "http://localhost:8000/api/v1/workspaces" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-patch">
        <summary class="opblock-summary opblock-summary-patch">
          <span class="opblock-method opblock-method-patch">PATCH</span>
          <span class="opblock-path">/api/v1/workspaces/{workspace_id}</span>
          <span class="opblock-summary-text">Update workspace name or slug</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Update workspace name or slug. Requires WORKSPACE_ADMIN or SERVER_ADMIN.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>workspace_id</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
