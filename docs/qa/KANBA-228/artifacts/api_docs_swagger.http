    <section class="opblock-tag-section">
      <h2 class="opblock-tag-header">activity <span class="tag-count">(2)</span></h2>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/api/v1/issues/{issue_ref}/activity</span>
          <span class="opblock-summary-text">List activity feed items for an issue across 4 tabs</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Return paginated activity feed items with counts and hydrated comments for an issue.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
              <table class="param-table">
                <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><code>issue_ref</code></td><td>path</td><td>Yes</td><td><code>string</code></td><td></td></tr>
                  <tr><td><code>tab</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Tab filter: all, comments, history, gates</td></tr>
                  <tr><td><code>order</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Order by timestamp: desc or asc</td></tr>
                  <tr><td><code>limit</code></td><td>query</td><td>No</td><td><code>integer</code></td><td>Items per page (1..100)</td></tr>
                  <tr><td><code>cursor</code></td><td>query</td><td>No</td><td><code>string</code></td><td>Opaque HMAC keyset cursor</td></tr>
                  <tr><td><code>include_hashes</code></td><td>query</td><td>No</td><td><code>boolean</code></td><td>Include cryptographic row/prev hashes</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                  <tr><td><span class="status-badge status-4xx">422</span></td><td>Validation Error</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/issues/{issue_ref}/activity" -H "Accept: application/json"</code></pre>
            </div>
          </div>
        </div>
      </details>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/api/v1/projects/{project_ref}/activity</span>
          <span class="opblock-summary-text">List activity feed items across a project with RLS filtering</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">Return paginated activity feed items across all readable objects in a project.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Parameters</h4>
