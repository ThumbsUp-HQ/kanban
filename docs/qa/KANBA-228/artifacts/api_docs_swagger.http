    <section class="opblock-tag-section">
      <h2 class="opblock-tag-header">auth-mcp-keys <span class="tag-count">(3)</span></h2>
      <details class="opblock opblock-get">
        <summary class="opblock-summary opblock-summary-get">
          <span class="opblock-method opblock-method-get">GET</span>
          <span class="opblock-path">/api/v1/auth/mcp-keys</span>
          <span class="opblock-summary-text">List personal MCP API keys</span>
        </summary>
        <div class="opblock-body">
          <p class="opblock-desc">List all personal MCP API keys owned by the calling principal.</p>
          <div class="opblock-details-grid">
            <div class="opblock-section">
              <h4>Responses</h4>
              <table class="resp-table">
                <thead><tr><th>Code</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td><span class="status-badge status-2xx">200</span></td><td>Successful Response</td></tr>
                </tbody>
              </table>
            </div>
            <div class="opblock-section">
              <h4>cURL Example</h4>
              <pre class="curl-box"><code>curl -X GET "http://localhost:8000/api/v1/auth/mcp-keys" -H "Accept: application/json"</code></pre>
