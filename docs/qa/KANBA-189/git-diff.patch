+    );
+
+CREATE POLICY {table}_insert_rls ON {table}
+    FOR INSERT WITH CHECK (
+        workspace_id = app_current_workspace_id()
+    );
+
+CREATE POLICY {table}_update_rls ON {table}
+    FOR UPDATE USING (
+        workspace_id = app_current_workspace_id()
+    ) WITH CHECK (
