diff --git a/kanban/web/src/features/docs-center/wikiManifest.ts b/kanban/web/src/features/docs-center/wikiManifest.ts
index ef19254c..fd7c7ec1 100644
--- a/kanban/web/src/features/docs-center/wikiManifest.ts
