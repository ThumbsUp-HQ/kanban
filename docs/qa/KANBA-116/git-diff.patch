+    expect(screen.getByText('No stickies yet')).toBeDefined();
+    const createBtn = screen.getByRole('button', { name: '+ Create your first sticky' });
+    fireEvent.click(createBtn);
+    expect(onCreate).toHaveBeenCalledTimes(1);
