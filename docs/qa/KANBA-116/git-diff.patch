+
+    expect(screen.getByText('Project Overview Stickies')).toBeDefined();
+    expect(screen.getByTestId('sticky-card-s-1')).toBeDefined();
+    expect(screen.getByTestId('promoted-sticky-stub-s-2')).toBeDefined();
