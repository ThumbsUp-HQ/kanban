+      { promotion_snoozed_at_length: 650 },
+      '"etag-1"',
+    );
+
+    expect(screen.queryByTestId('sticky-promotion-banner')).toBeNull();
+  });
+
+  it('clicking Promote to Doc invokes onPromote callback', () => {
