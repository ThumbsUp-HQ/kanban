+    const longSticky: StickyItem = {
+      ...baseSticky,
+      body_markdown: 'z'.repeat(650),
+    };
+
+    render(
+      <StickyCard
+        sticky={longSticky}
+        onUpdate={vi.fn()}
+        onDelete={vi.fn()}
+        onPromote={onPromote}
+      />,
