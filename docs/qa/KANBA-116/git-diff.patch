+
+  it('renders empty state when stickies array is empty', () => {
+    const onCreate = vi.fn();
+    render(
+      <StickiesGrid
+        stickies={[]}
+        projectKey="KAN"
+        onCreateSticky={onCreate}
+        onUpdateSticky={vi.fn()}
+        onDeleteSticky={vi.fn()}
