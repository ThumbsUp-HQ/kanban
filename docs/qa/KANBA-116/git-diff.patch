+  },
+  {
+    id: 's-2',
+    workspace_id: 'ws-1',
+    project_id: 'proj-1',
+    body_markdown: 'Promoted sticky note',
+    color_token: 'slate',
+    sort_rank: '1',
+    promotion_recommended: false,
+    promotion_snoozed_at_length: null,
+    promoted_to_doc_id: 'doc-123',
+    is_promoted_stub: true,
+    promoted_to_doc: {
+      id: 'doc-123',
+      title: 'Promoted Architecture Doc',
+      canonical_key: 'DOC-1',
+    },
+    triggers: [],
+    capabilities: ['EDIT'],
+  },
