+
+  it('renders loading state when isLoading is true and stickies are empty', () => {
+    render(
+      <StickiesGrid
+        stickies={[]}
+        isLoading={true}
+        onUpdateSticky={vi.fn()}
+        onDeleteSticky={vi.fn()}
+        onPromoteSticky={vi.fn()}
