+    assert pg_row is not None
+    assert pg_row.body_sha256 == hashlib.sha256(page_body.encode("utf-8")).digest()
+    assert pg_row.version_seq == 1
+    assert str(pg_row.hierarchy_path) == f"d{d_id.hex}.p{pg_id.hex}"
