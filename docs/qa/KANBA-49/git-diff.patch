+async def _create_issue(
+    session: AsyncSession,
+    ws_id: uuid.UUID,
+    proj_id: uuid.UUID,
+    user_id: uuid.UUID,
+    defaults: tuple[uuid.UUID, uuid.UUID],
+) -> uuid.UUID:
