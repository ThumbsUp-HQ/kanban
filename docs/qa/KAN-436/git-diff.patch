diff --git a/kanban/tests/workflows/test_workflow_hooks_api.py b/kanban/tests/workflows/test_workflow_hooks_api.py
index 710ee3a1..e5adda4f 100644
--- a/kanban/tests/workflows/test_workflow_hooks_api.py
+++ b/kanban/tests/workflows/test_workflow_hooks_api.py
@@ -1007,3 +1007,121 @@ async def test_approved_wasm_modules_list_and_builtin_auto_seed(
     )
