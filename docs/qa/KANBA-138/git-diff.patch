+            "proj_id": proj_id,
+            "seq": seq1,
+            "st_id": st_id,
+            "user_id": user_id,
+        },
+    )
+
+    # Issue 2
+    seq2 = await session.scalar(
+        text("SELECT allocate_issue_sequence(:pid)"),
+        {"pid": proj_id},
+    )
+    i2_reg = await session.execute(
+        text(
+            "SELECT register_object("
+            "  'issue'::object_kind, :ws_id, :proj_id, :ckey, 'Issue 2', :u_id"
