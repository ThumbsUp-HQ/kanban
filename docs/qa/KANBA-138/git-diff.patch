+        {"ws_id": ws_id, "proj_id": proj_id, "ckey": f"PRJ-{seq1}", "u_id": user_id},
+    )
+    iss1 = i1_reg.scalar_one()
+    await session.execute(
+        text(
+            "INSERT INTO issues ("
+            "  id, workspace_id, project_id, sequence_id, summary, "
+            "  description_markdown, state_id, priority_id, "
