+            "id": iss2,
+            "ws_id": ws_id,
+            "proj_id": proj_id,
+            "seq": seq2,
+            "st_id": st_id,
+            "user_id": user_id,
+        },
+    )
+
+    # Link 1 -> 2 (BLOCKS)
+    await session.execute(
+        text(
+            "INSERT INTO object_links ("
