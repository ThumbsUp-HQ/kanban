+
+if TYPE_CHECKING:
+    from sqlalchemy.ext.asyncio import AsyncEngine
+
+PEPPER_KEY: Final[bytes] = b"p" * 32
+SESSION_HMAC_KEY: Final[bytes] = b"s" * 32
+
+
+@pytest.fixture
+def key_material() -> KeyMaterial:
+    """Provide testing key material."""
+    return KeyMaterial(
+        master_kek=b"k" * 32,
