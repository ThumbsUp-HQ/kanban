+          DASH_TOKEN: ${{ secrets.DASH_TOKEN }}
+        run: scripts/ci/upload_dash_log.sh perf-budgets
+
+      - name: Upload perf report artifact
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
