+      - name: Start test database
+        shell: bash
+        run: scripts/ci/run_and_log.sh testdb-up -- make testdb-up
+
+      - name: Run SLA Performance Budget Gate
+        shell: bash
+        run: |
+          scripts/ci/run_and_log.sh perf-budgets -- \
+            uv run python scripts/perf_budget_gate.py --report-out docs/qa/KANBA-151/perf-report.json
+
+      - name: Stop test database
