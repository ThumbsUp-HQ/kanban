diff --git a/kanban/web/src/components/error/AppErrorModal.css b/kanban/web/src/components/error/AppErrorModal.css
new file mode 100644
index 0000000..213a578
--- /dev/null
+++ b/kanban/web/src/components/error/AppErrorModal.css
@@ -0,0 +1,188 @@
+/**
+ * AppErrorModal CSS - High-Contrast Danger Theme
+ * Strict CSP Compliant (style-src 'self', zero inline styles)
+ */
+
+.app-error-backdrop {
+  position: fixed;
+  inset: 0;
+  background-color: rgba(0, 0, 0, 0.75);
+  backdrop-filter: blur(4px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 1.5rem;
+  z-index: 99999;
+}
+
+.app-error-modal {
+  width: 100%;
+  max-width: 720px;
+  background-color: var(--surface-bg, #1a1a1a);
+  color: var(--text-primary, #ffffff);
+  border: 2px solid var(--danger-border, #d32f2f);
+  border-radius: 8px;
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6), 0 0 24px rgba(211, 47, 47, 0.3);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  animation: appErrorFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+@keyframes appErrorFadeIn {
+  from {
+    opacity: 0;
+    transform: scale(0.96) translateY(-8px);
+  }
+  to {
+    opacity: 1;
+    transform: scale(1) translateY(0);
+  }
+}
+
+.app-error-modal__header {
+  background-color: #d32f2f;
+  color: #ffffff;
+  padding: 1rem 1.25rem;
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+}
+
+.app-error-modal__icon {
+  font-size: 1.5rem;
+  line-height: 1;
+}
+
+.app-error-modal__title {
+  margin: 0;
+  font-size: 1.25rem;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  color: #ffffff;
+}
+
+.app-error-modal__body {
+  padding: 1.25rem;
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  overflow-y: auto;
+  max-height: 70vh;
+}
+
+.app-error-modal__message {
+  font-size: 1rem;
+  font-weight: 600;
+  color: #ff8a80;
+  word-break: break-word;
+  background-color: rgba(211, 47, 47, 0.1);
+  padding: 0.75rem 1rem;
+  border-radius: 6px;
+  border-left: 4px solid #d32f2f;
+}
+
+.app-error-modal__url {
+  font-size: 0.875rem;
+  color: var(--text-secondary, #b0bec5);
+  display: flex;
+  align-items: baseline;
+  gap: 0.5rem;
+  word-break: break-all;
+}
+
+.app-error-modal__label {
+  font-weight: 600;
+  color: var(--text-primary, #ffffff);
+}
+
+.app-error-modal__url code {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+  background-color: rgba(255, 255, 255, 0.08);
+  padding: 0.2rem 0.4rem;
+  border-radius: 4px;
+}
+
+.app-error-modal__trace-wrapper {
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+}
+
+.app-error-modal__trace {
+  margin: 0;
+  padding: 0.875rem;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+  font-size: 0.8125rem;
+  line-height: 1.45;
+  background-color: #121212;
+  color: #eceff1;
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 6px;
+  max-height: 240px;
+  overflow-y: auto;
+  overflow-x: auto;
+  white-space: pre-wrap;
+  word-break: break-all;
+}
+
+.app-error-modal__actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 0.75rem;
+  padding: 1rem 1.25rem;
+  background-color: rgba(255, 255, 255, 0.03);
+  border-top: 1px solid rgba(255, 255, 255, 0.1);
+}
+
+.app-error-modal__btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0.5rem 1rem;
+  font-size: 0.875rem;
+  font-weight: 600;
+  border-radius: 6px;
+  cursor: pointer;
+  text-decoration: none;
+  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
+  line-height: 1.25;
+}
+
+.app-error-modal__btn:focus-visible {
+  outline: 2px solid #ffffff;
+  outline-offset: 2px;
+}
+
+.app-error-modal__btn--copy {
+  background-color: transparent;
+  color: #eceff1;
+  border: 1px solid rgba(255, 255, 255, 0.25);
+}
+
+.app-error-modal__btn--copy:hover {
+  background-color: rgba(255, 255, 255, 0.1);
+  border-color: rgba(255, 255, 255, 0.4);
+}
+
+.app-error-modal__btn--report {
+  background-color: #2e7d32;
+  color: #ffffff;
+  border: 1px solid #388e3c;
+}
+
+.app-error-modal__btn--report:hover {
+  background-color: #1b5e20;
+}
+
+.app-error-modal__btn--dismiss {
+  background-color: #d32f2f;
+  color: #ffffff;
+  border: 1px solid #b71c1c;
+}
+
+.app-error-modal__btn--dismiss:hover {
+  background-color: #c62828;
+}
