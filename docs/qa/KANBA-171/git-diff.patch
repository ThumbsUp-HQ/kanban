+++ b/kanban/web/src/components/error/AppErrorModal.test.tsx
@@ -0,0 +1,213 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import React, { useState } from 'react';
+import { MemoryRouter, useRouteError } from 'react-router';
+import {
+  AppErrorModal,
+  RouteErrorBoundary,
+  GlobalErrorBoundary,
+} from './AppErrorModal';
+
+vi.mock('../../utils/uuid', () => ({
+  safeCopyToClipboard: vi.fn().mockResolvedValue(true),
+  safeRandomUUID: vi.fn().mockReturnValue('11111111-1111-4111-8111-111111111111'),
+}));
+
+vi.mock('react-router', async () => {
+  const actual = await vi.importActual<typeof import('react-router')>('react-router');
+  return {
+    ...actual,
+    useRouteError: vi.fn(),
+  };
+});
+
+describe('AppErrorModal, RouteErrorBoundary, and GlobalErrorBoundary', () => {
+  afterEach(() => {
+    vi.clearAllMocks();
+  });
+
+  describe('AppErrorModal', () => {
+    it('renders danger header, message, url, stack trace, and action buttons', () => {
+      const error = new Error('Test fatal failure');
+      error.stack = 'Error: Test fatal failure\n    at Component.tsx:42';
+
+      render(<AppErrorModal error={error} />);
+
+      expect(screen.getByText('Application Error Detected')).toBeDefined();
+      expect(screen.getByTestId('error-message').textContent).toBe('Test fatal failure');
+      expect(screen.getByTestId('error-url')).toBeDefined();
+      expect(screen.getByTestId('error-trace').textContent).toContain('Error: Test fatal failure');
+
+      const copyBtn = screen.getByTestId('error-copy-btn');
+      const reportLink = screen.getByTestId('error-report-link');
+      const dismissBtn = screen.getByTestId('error-dismiss-btn');
+
+      expect(copyBtn).toBeDefined();
+      expect(reportLink).toBeDefined();
+      expect(dismissBtn).toBeDefined();
+
+      const href = reportLink.getAttribute('href') ?? '';
+      expect(href).toContain('https://github.com/ThumbsUp-HQ/thumbs-up-kanban/issues/new');
+      expect(href).toContain(encodeURIComponent('[Bug]: Application Error: Test fatal failure'));
+    });
+
+    it('copies traceback and shows Copied feedback on click', async () => {
+      const { safeCopyToClipboard } = await import('../../utils/uuid');
+      const error = new Error('Clipboard test error');
+      render(<AppErrorModal error={error} />);
+
+      const copyBtn = screen.getByTestId('error-copy-btn');
+      fireEvent.click(copyBtn);
+
+      await waitFor(() => {
+        expect(safeCopyToClipboard).toHaveBeenCalled();
+        expect(screen.getByText('Copied Traceback!')).toBeDefined();
+      });
+    });
+
+    it('clears ?peek= search param and invokes onDismiss callback', () => {
+      const onDismiss = vi.fn();
+      const pushStateSpy = vi.spyOn(window.history, 'replaceState');
+
+      const url = new URL(window.location.href);
+      url.searchParams.set('peek', 'KAN-123');
+      window.history.pushState({}, '', url.toString());
+
+      render(<AppErrorModal error="Non-Error string failure" onDismiss={onDismiss} />);
+
+      const dismissBtn = screen.getByTestId('error-dismiss-btn');
+      fireEvent.click(dismissBtn);
+
+      expect(onDismiss).toHaveBeenCalledTimes(1);
+      expect(pushStateSpy).toHaveBeenCalled();
+    });
+
+    it('handles non-Error objects and statusText gracefully', () => {
+      render(<AppErrorModal error={{ statusText: 'Not Found', status: 404 }} />);
+      expect(screen.getByTestId('error-message').textContent).toBe('Not Found');
+    });
+  });
+
+  describe('RouteErrorBoundary', () => {
+    it('renders AppErrorModal with error from useRouteError', () => {
+      const mockRouteError = new Error('Route level failure');
+      vi.mocked(useRouteError).mockReturnValue(mockRouteError);
+
+      render(
+        <MemoryRouter>
+          <RouteErrorBoundary />
+        </MemoryRouter>,
+      );
+
+      expect(screen.getByText('Application Error Detected')).toBeDefined();
+      expect(screen.getByTestId('error-message').textContent).toBe('Route level failure');
+    });
+  });
+
+  describe('GlobalErrorBoundary', () => {
+    // Suppress console.error in error boundary tests
+    const originalConsoleError = console.error;
+    beforeEach(() => {
+      console.error = vi.fn();
+    });
+    afterEach(() => {
+      console.error = originalConsoleError;
+    });
+
+    function BuggyComponent({ shouldThrow }: { shouldThrow: boolean }): React.JSX.Element {
+      if (shouldThrow) {
+        throw new Error('Component crashed inside GlobalErrorBoundary');
+      }
+      return <div>Healthy Child Content</div>;
+    }
+
+    it('renders children when no error occurs', () => {
+      render(
+        <GlobalErrorBoundary>
+          <div>Safe Content</div>
+        </GlobalErrorBoundary>,
+      );
+
+      expect(screen.getByText('Safe Content')).toBeDefined();
+    });
+
+    it('catches render errors and recovers on Dismiss click', () => {
+      function TestWrapper() {
+        const [hasError, setHasError] = useState(false);
+        return (
+          <div>
+            <button
+              type="button"
+              onClick={() => {
+                setHasError(true);
+              }}
+            >
+              Trigger Error
+            </button>
+            <GlobalErrorBoundary>
+              <BuggyComponent shouldThrow={hasError} />
+            </GlobalErrorBoundary>
+          </div>
+        );
+      }
+
+      render(<TestWrapper />);
+      expect(screen.getByText('Healthy Child Content')).toBeDefined();
+
+      fireEvent.click(screen.getByText('Trigger Error'));
+
+      expect(screen.getByText('Application Error Detected')).toBeDefined();
+      expect(screen.getByTestId('error-message').textContent).toBe(
+        'Component crashed inside GlobalErrorBoundary',
+      );
+
+      // Dismiss recovers
+      fireEvent.click(screen.getByTestId('error-dismiss-btn'));
+    });
+
+    it('catches window error and unhandledrejection events', async () => {
+      render(
+        <GlobalErrorBoundary>
+          <div>Child Area</div>
+        </GlobalErrorBoundary>,
+      );
+
+      expect(screen.getByText('Child Area')).toBeDefined();
+
+      // Dispatch window error event
+      const errorEvent = new ErrorEvent('error', {
+        error: new Error('Window level script error'),
+      });
+      window.dispatchEvent(errorEvent);
+
+      await waitFor(() => {
+        expect(screen.getByText('Application Error Detected')).toBeDefined();
+        expect(screen.getByTestId('error-message').textContent).toBe(
+          'Window level script error',
+        );
+      });
+
+      // Dismiss recovers back
+      fireEvent.click(screen.getByTestId('error-dismiss-btn'));
+      await waitFor(() => {
+        expect(screen.getByText('Child Area')).toBeDefined();
+      });
+
+      // Dispatch unhandled promise rejection event
+      const rejectionEvent = new CustomEvent('unhandledrejection', {
+        detail: { reason: new Error('Promise rejection error') },
+      }) as unknown as PromiseRejectionEvent;
+      Object.defineProperty(rejectionEvent, 'reason', {
+        value: new Error('Promise rejection error'),
+      });
+      window.dispatchEvent(rejectionEvent);
+
+      await waitFor(() => {
+        expect(screen.getByText('Application Error Detected')).toBeDefined();
+        expect(screen.getByTestId('error-message').textContent).toBe(
+          'Promise rejection error',
+        );
+      });
+    });
+  });
+});
diff --git a/kanban/web/src/components/error/AppErrorModal.tsx b/kanban/web/src/components/error/AppErrorModal.tsx
new file mode 100644
index 0000000..fb4277b
--- /dev/null
+++ b/kanban/web/src/components/error/AppErrorModal.tsx
@@ -0,0 +1,280 @@
+/**
+ * Blatant, Dismissible On-Screen Error Modal & Boundaries.
+ * Strict CSP Compliant (style-src 'self', zero inline style attributes).
+ */
+
+import React, {
+  Component,
+  useState,
+  useCallback,
+  type ErrorInfo,
+  type ReactNode,
+  type JSX,
+} from 'react';
+import { useLocation, useNavigate, useRouteError } from 'react-router';
+import { safeCopyToClipboard } from '../../utils/uuid';
+import './AppErrorModal.css';
+
+export interface AppErrorModalProps {
+  readonly error: unknown;
+  readonly errorInfo?: { componentStack?: string | null | undefined } | null | undefined;
+  readonly onDismiss?: () => void;
+}
+
+export function AppErrorModal({
+  error,
+  errorInfo,
+  onDismiss,
+}: AppErrorModalProps): JSX.Element {
+  const [copied, setCopied] = useState(false);
+
+  let errorMessage = 'An unexpected application error occurred.';
+  if (error instanceof Error) {
+    errorMessage = error.message;
+  } else if (typeof error === 'string') {
+    errorMessage = error;
+  } else if (typeof error === 'object' && error !== null && 'statusText' in error) {
+    errorMessage = String(error.statusText);
+  }
+
+  let stackTrace = 'No stack trace available.';
+  if (error instanceof Error && error.stack) {
+    stackTrace = error.stack;
+  } else if (typeof error === 'object' && error !== null) {
+    stackTrace = JSON.stringify(error, null, 2);
+  } else if (typeof error === 'string') {
+    stackTrace = error;
+  } else if (
+    typeof error === 'number' ||
+    typeof error === 'boolean' ||
+    typeof error === 'bigint'
+  ) {
+    stackTrace = error.toString();
+  }
+
+  const componentStack = errorInfo?.componentStack ?? '';
+  const fullTrace = componentStack
+    ? `${stackTrace}\n\nComponent Stack:\n${componentStack}`
+    : stackTrace;
+
+  const currentUrl =
+    typeof window !== 'undefined' ? window.location.href : 'Unknown URL';
+
+  const handleCopy = useCallback(async (): Promise<void> => {
+    const textToCopy = `Error: ${errorMessage}\nURL: ${currentUrl}\n\nTraceback:\n${fullTrace}`;
+    const success = await safeCopyToClipboard(textToCopy);
+    if (success) {
+      setCopied(true);
+      setTimeout(() => {
+        setCopied(false);
+      }, 2000);
+    }
+  }, [errorMessage, currentUrl, fullTrace]);
+
+  const handleDismiss = useCallback((): void => {
+    if (typeof window !== 'undefined') {
+      const url = new URL(window.location.href);
+      if (url.searchParams.has('peek')) {
+        url.searchParams.delete('peek');
+        window.history.replaceState({}, '', url.toString());
+        window.dispatchEvent(new PopStateEvent('popstate'));
+      }
+    }
+    onDismiss?.();
+  }, [onDismiss]);
+
+  const reportTitle = `[Bug]: Application Error: ${errorMessage.slice(0, 80)}`;
+  const reportBody = `### Application Error Detected\n\n**URL:** ${currentUrl}\n**Error:** ${errorMessage}\n\n\`\`\`\n${fullTrace}\n\`\`\``;
+  const reportUrl = `https://github.com/ThumbsUp-HQ/thumbs-up-kanban/issues/new?title=${encodeURIComponent(reportTitle)}&body=${encodeURIComponent(reportBody)}`;
+
+  return (
+    <div
+      className="app-error-backdrop"
+      role="alertdialog"
+      aria-modal="true"
+      aria-labelledby="app-error-title"
+      aria-describedby="app-error-message"
+    >
+      <div className="app-error-modal">
+        <header className="app-error-modal__header">
+          <span className="app-error-modal__icon" aria-hidden="true">
+            🚨
+          </span>
+          <h2 id="app-error-title" className="app-error-modal__title">
+            Application Error Detected
+          </h2>
+        </header>
+
+        <div className="app-error-modal__body">
+          <div
+            id="app-error-message"
+            className="app-error-modal__message"
+            data-testid="error-message"
+          >
+            {errorMessage}
+          </div>
+
+          <div className="app-error-modal__url" data-testid="error-url">
+            <span className="app-error-modal__label">URL:</span>
+            <code>{currentUrl}</code>
+          </div>
+
+          <div className="app-error-modal__trace-wrapper">
+            <span className="app-error-modal__label">Stack Trace:</span>
+            <pre className="app-error-modal__trace" data-testid="error-trace">
+              {fullTrace}
+            </pre>
+          </div>
+        </div>
+
+        <footer className="app-error-modal__actions">
+          <button
+            type="button"
+            className="app-error-modal__btn app-error-modal__btn--copy"
+            onClick={() => {
+              void handleCopy();
+            }}
+            data-testid="error-copy-btn"
+          >
+            {copied ? 'Copied Traceback!' : 'Copy Traceback'}
+          </button>
+
+          <a
+            href={reportUrl}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="app-error-modal__btn app-error-modal__btn--report"
+            data-testid="error-report-link"
+          >
+            Report to ThumbsUp-HQ
+          </a>
+
+          <button
+            type="button"
+            className="app-error-modal__btn app-error-modal__btn--dismiss"
+            onClick={handleDismiss}
+            data-testid="error-dismiss-btn"
+          >
+            Dismiss / Recover
+          </button>
+        </footer>
+      </div>
+    </div>
+  );
+}
+
+/**
+ * Route-level error boundary for React Router route `errorElement`.
+ */
+export function RouteErrorBoundary(): JSX.Element {
+  const error = useRouteError();
+  const navigate = useNavigate();
+  const location = useLocation();
+
+  const handleDismiss = useCallback((): void => {
+    const params = new URLSearchParams(location.search);
+    if (params.has('peek')) {
+      params.delete('peek');
+      const qs = params.toString();
+      void navigate(`${location.pathname}${qs ? `?${qs}` : ''}`, {
+        replace: true,
+      });
+    } else {
+      window.location.reload();
+    }
+  }, [location.pathname, location.search, navigate]);
+
+  return <AppErrorModal error={error} onDismiss={handleDismiss} />;
+}
+
+interface GlobalErrorBoundaryProps {
+  readonly children: ReactNode;
+}
+
+interface GlobalErrorBoundaryState {
+  readonly error: unknown;
+  readonly errorInfo: { componentStack?: string | null | undefined } | null;
+}
+
+/**
+ * Top-level application error boundary that wraps `<App />` and catches
+ * render errors as well as unhandled window errors and promise rejections.
+ */
+export class GlobalErrorBoundary extends Component<
+  GlobalErrorBoundaryProps,
+  GlobalErrorBoundaryState
+> {
+  constructor(props: GlobalErrorBoundaryProps) {
+    super(props);
+    this.state = {
+      error: null,
+      errorInfo: null,
+    };
+  }
+
+  static getDerivedStateFromError(error: unknown): Partial<GlobalErrorBoundaryState> {
+    return { error };
+  }
+
+  override componentDidCatch(error: unknown, errorInfo: ErrorInfo): void {
+    this.setState({
+      error,
+      errorInfo: { componentStack: errorInfo.componentStack ?? null },
+    });
+  }
+
+  override componentDidMount(): void {
+    window.addEventListener('error', this.handleWindowError);
+    window.addEventListener('unhandledrejection', this.handleUnhandledRejection);
+  }
+
+  override componentWillUnmount(): void {
+    window.removeEventListener('error', this.handleWindowError);
+    window.removeEventListener('unhandledrejection', this.handleUnhandledRejection);
+  }
+
+  private readonly handleWindowError = (event: ErrorEvent): void => {
+    // Only capture unhandled runtime script errors
+    if (event.error) {
+      this.setState({
+        error: event.error,
+        errorInfo: null,
+      });
+    } else if (event.message) {
+      this.setState({
+        error: new Error(event.message),
+        errorInfo: null,
+      });
+    }
+  };
+
+  private readonly handleUnhandledRejection = (
+    event: PromiseRejectionEvent,
+  ): void => {
+    this.setState({
+      error: event.reason ?? new Error('Unhandled Promise Rejection'),
+      errorInfo: null,
+    });
+  };
+
+  private readonly handleDismiss = (): void => {
+    this.setState({
+      error: null,
+      errorInfo: null,
+    });
+  };
+
+  override render(): ReactNode {
+    if (this.state.error !== null) {
+      return (
+        <AppErrorModal
+          error={this.state.error}
+          errorInfo={this.state.errorInfo}
+          onDismiss={this.handleDismiss}
+        />
+      );
+    }
+
+    return this.props.children;
+  }
+}
