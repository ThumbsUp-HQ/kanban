+          await apiFetch(
+            'POST',
+            '/api/v1/admin/workload-identities' as unknown as keyof import('../../api/schema.gen.ts').paths,
+            { body: payload },
+          );
+        }
+        setShowModal(false);
+        await fetchPolicies();
+      } catch (err) {
+        const challenge = extractAal2Challenge(err);
+        if (challenge) {
+          setAal2Challenge(challenge);
+          setPendingAction(() => async () => {
+            await action();
+          });
+        } else {
+          setError(err instanceof Error ? err.message : 'Failed to save workload policy');
+        }
+      } finally {
+        setSubmitting(false);
+      }
+    };
+
+    await action();
+  };
+
+  const handleToggle = async (pol: WorkloadIdentityPolicyItem): Promise<void> => {
+    const action = async (): Promise<void> => {
+      try {
