+    """Verify strict validation of iss, aud, exp, nbf, iat, sub, and required_claims."""
+    ws_id = await create_workspace(db_session, name="Workload Claims WS")
+    policy = WorkloadIdentityPolicy(
+        workspace_id=ws_id,
