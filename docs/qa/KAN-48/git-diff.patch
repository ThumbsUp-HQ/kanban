+def _add_tool_arguments_to_parser(parser: argparse.ArgumentParser, spec: ToolSpec) -> None:
+    """Map ToolSpec JSON Schema properties deterministically to argparse flags."""
+    schema = spec.input_schema or {}
+    properties: dict[str, Any] = schema.get("properties") or {}
+
+    for prop_name, prop_schema in properties.items():
+        if not isinstance(prop_schema, dict):
+            continue
+        kebab_name = _to_kebab(prop_name)
+        snake_name = _to_snake(prop_name)
+        prop_type = prop_schema.get("type")
+        help_desc = prop_schema.get("description", "")
+
+        # 1. Boolean flags
+        if prop_type == "boolean":
+            parser.add_argument(
+                f"--{kebab_name}",
+                dest=snake_name,
+                action=argparse.BooleanOptionalAction,
+                default=None,
+                help=help_desc,
+            )
+            if kebab_name != snake_name:
+                parser.add_argument(
+                    f"--{snake_name}",
+                    dest=snake_name,
+                    action=argparse.BooleanOptionalAction,
+                    default=None,
+                    help=argparse.SUPPRESS,
+                )
+            continue
+
+        # 2. Integer or Number flags
+        if prop_type in ("integer", "number"):
+            num_type = int if prop_type == "integer" else float
+            parser.add_argument(
+                f"--{kebab_name}",
+                dest=snake_name,
+                type=num_type,
+                default=None,
+                help=help_desc,
+            )
+            if kebab_name != snake_name:
+                parser.add_argument(
+                    f"--{snake_name}",
+                    dest=snake_name,
+                    type=num_type,
+                    default=None,
+                    help=argparse.SUPPRESS,
+                )
+            continue
+
+        # 3. Array flags (repeatable action="append")
+        if prop_type == "array":
+            parser.add_argument(
+                f"--{kebab_name}",
+                dest=snake_name,
+                action="append",
+                default=None,
+                help=f"{help_desc} (repeatable or comma-separated/JSON list)",
+            )
+            if kebab_name != snake_name:
+                parser.add_argument(
+                    f"--{snake_name}",
+                    dest=snake_name,
+                    action="append",
+                    default=None,
+                    help=argparse.SUPPRESS,
+                )
+            parser.add_argument(
+                f"--{kebab_name}-file",
+                dest=f"{snake_name}_file",
+                default=None,
+                help=f"File containing JSON/YAML list for {prop_name}",
+            )
+            continue
+
+        # 4. Structured Object flags
+        if prop_type == "object" or prop_name in _STRUCTURED_FIELD_NAMES:
+            parser.add_argument(
+                f"--{kebab_name}",
+                dest=snake_name,
+                default=None,
+                help=f"{help_desc} (JSON/YAML string or @path.json)",
+            )
+            if kebab_name != snake_name:
+                parser.add_argument(
+                    f"--{snake_name}",
+                    dest=snake_name,
+                    default=None,
+                    help=argparse.SUPPRESS,
+                )
+            parser.add_argument(
+                f"--{kebab_name}-file",
+                dest=f"{snake_name}_file",
+                default=None,
+                help=f"File containing JSON/YAML object for {prop_name}",
+            )
+            continue
+
+        # 5. String and Prose fields
+        parser.add_argument(
+            f"--{kebab_name}",
+            dest=snake_name,
+            default=None,
+            help=help_desc,
+        )
+        if kebab_name != snake_name:
+            parser.add_argument(
+                f"--{snake_name}",
+                dest=snake_name,
+                default=None,
+                help=argparse.SUPPRESS,
+            )
+
+        # Sibling file flags for prose / markdown fields
+        if prop_name in _PROSE_FIELD_NAMES:
+            parser.add_argument(
+                f"--{kebab_name}-file",
+                dest=f"{snake_name}_file",
+                default=None,
+                help=f"Path to file containing {prop_name} (or - for stdin)",
