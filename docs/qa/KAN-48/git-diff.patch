+                    "id": "01933b93-8000-7000-8000-000000000001",
+                    "kind": kind,
+                    "key": ref,
+                    "title": f"Resolved {ref}",
+                },
+            )
+
+        # 2. Project resolver
+        if "/api/v1/projects/KAN" in url_path:
+            return httpx.Response(
+                200,
+                json={
+                    "id": "01933b93-8000-7000-8000-000000000001",
+                    "key": "KAN",
+                    "identifier": "KAN",
+                    "name": "Kanban Core",
+                    "workflow_states": [
