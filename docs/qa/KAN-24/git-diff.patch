+            text(
+                "INSERT INTO sessions (id, token_sha256, principal_id, workspace_id, aal_level, "
+                "last_seen_at, idle_expires_at, absolute_expires_at) "
+                "VALUES (:id, :tok, :p_id, :ws_id, 2, now(), "
