        "tags": [
          "auth",
          "webauthn"
        ],
        "summary": "Delete Credential",
        "description": "Delete a registered WebAuthn credential. Refuses deleting last factor of admin.",
        "operationId": "delete_credential_api_v1_auth_webauthn_credentials__credential_id__delete",
        "parameters": [
          {
            "name": "credential_id",
            "in": "path",
