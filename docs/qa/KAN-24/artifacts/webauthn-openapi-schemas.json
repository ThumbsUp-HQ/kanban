  },
  "schemas": {
    "TotpConfirmRequest": {
      "properties": {
        "code": {
          "type": "string",
          "title": "Code",
          "description": "6-digit TOTP verification code"
        },
        "enrollment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enrollment Id",
          "description": "Optional setup enrollment session identifier for immediate AAL2 elevation"
        }
      },
      "type": "object",
      "required": [
        "code"
      ],
      "title": "TotpConfirmRequest",
      "description": "Payload for confirming a pending TOTP factor."
    },
    "WebauthnRegisterOptionsRequest": {
      "properties": {
        "authenticator_attachment": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "platform",
                "cross-platform"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Authenticator Attachment",
          "description": "Optional attachment modality hint ('platform' or 'cross-platform')"
        }
      },
      "type": "object",
      "title": "WebauthnRegisterOptionsRequest",
      "description": "Payload for requesting WebAuthn registration options."
    },
    "WebauthnRenameRequest": {
      "properties": {
        "nickname": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "title": "Nickname",
          "description": "Friendly nickname"
        }
      },
      "type": "object",
      "required": [
        "nickname"
      ],
      "title": "WebauthnRenameRequest",
      "description": "Payload for renaming a WebAuthn passkey credential."
    }
  }
}