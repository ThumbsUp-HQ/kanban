    "/api/v1/auth/webauthn/credentials/{credential_id}": {
      "patch": {
        "tags": [
          "auth",
          "webauthn"
        ],
        "summary": "Rename Credential",
        "description": "Rename a registered WebAuthn passkey credential.",
        "operationId": "rename_credential_api_v1_auth_webauthn_credentials__credential_id__patch",
        "parameters": [
          {
            "name": "credential_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Credential Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebauthnRenameRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
