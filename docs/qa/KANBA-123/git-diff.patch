-async def authenticate_verify(
-    request: Request,
-    principal: Annotated[PrincipalContext, Depends(get_principal)],
-) -> JSONResponse:
-    """Verify WebAuthn authentication response and elevate session to AAL2."""
-    if principal.session_id is None:
