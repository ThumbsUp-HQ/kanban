+
+.assignees-menu__loading {
+  padding: 6px 12px;
+  font-size: var(--text-xs, 12px);
+  color: var(--text-muted, #64748b);
+}
+
+.assignees-menu__item-btn {
+  width: 100%;
+  text-align: left;
+  padding: 6px 12px;
+  background: transparent;
+  border: none;
+  color: var(--text-primary, #f8fafc);
+  font-size: var(--text-xs, 12px);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.assignees-menu__item-btn:hover {
+  background-color: rgba(255, 255, 255, 0.05);
+}
+
+.assignees-menu__item-name {
+  color: var(--text-muted, #64748b);
+  font-size: 11px;
+  margin-left: auto;
+}
+
+.assignees-menu__divider {
+  border-top: 1px solid var(--border-subtle, #334155);
+}
+
+.assignees-menu__freetext-btn {
+  width: 100%;
+  text-align: left;
+  padding: 6px 12px;
+  background: transparent;
+  border: none;
+  color: var(--color-primary, #60a5fa);
+  font-size: var(--text-xs, 12px);
+  cursor: pointer;
+}
+
+.assignees-menu__freetext-btn:hover {
+  background-color: rgba(255, 255, 255, 0.05);
+}
+
+/* Override modal styling */
+.override-modal__form {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.override-modal__label {
+  display: block;
