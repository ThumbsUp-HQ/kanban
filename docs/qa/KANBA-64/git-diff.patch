++            db_session,
++            principal_id=p_id,
++            workspace_id=ws_id,
++        )
++
++        # Victim logs in presenting C0 as existing_cookie
++        c1: IssuedSession = await service.create_after_login(
++            db_session,
++            principal_id=p_id,
++            workspace_id=ws_id,
++            existing_cookie_val=c0.cookie_val,
++        )
++
++        # C1 is a fresh session
