++async def test_case_2_session_fixation_defense(
++    pg_worker_db: AsyncEngine,
++    key_material: KeyMaterial,
++) -> None:
++    """Test Case 2: Presenting pre-login cookie C0 revokes C0 and issues fresh C1."""
