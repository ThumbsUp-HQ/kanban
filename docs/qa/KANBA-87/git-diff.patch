+async def test_scheduler_and_registry() -> None:
+    """Test JobRegistry, JobScheduler start/stop and lifespan context."""
+    # Test registry
+    reg = JobRegistry()
+    ran = False
+
+    async def dummy_job(_target: Any) -> int:  # noqa: ANN401
+        nonlocal ran
+        ran = True
+        return 1
+
+    reg.register("dummy", 0.05, dummy_job)
