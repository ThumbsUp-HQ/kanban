+        iss3_id,
+        guest.id,
+        effect="DENY",
+        capability_mask=8,
+    )
+
+    # Mark Issue 4 creator-overridden and archived, plus seed gate execution rows
+    now_dt = datetime.now(UTC)
+    await api_env.seed.execute(
