+            archive_eligibility=archive_eligibility,
+            pending_gate=pending_gate,
+            latest_gate_verdict=latest_gate_verdict,
+        )
+        res.etag = compute_issue_etag(res, obj.updated_at if obj is not None else None)
+        results.append(res)
+
+    return results
