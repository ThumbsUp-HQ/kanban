+  });
+
+  it('unmounts Modules completely when modulesEnabled is false', () => {
+    const defaultCols = getDefaultColumns(false);
+    const onChange = vi.fn();
+
+    render(
+      <ColumnConfigurator
+        columns={defaultCols}
+        onChange={onChange}
+        projectKey="KAN"
+        modulesEnabled={false}
+      />
+    );
