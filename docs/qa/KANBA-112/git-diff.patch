index 0000000..8a00553
--- /dev/null
+++ b/kanban/web/src/features/table/tableColumns.test.ts
@@ -0,0 +1,141 @@
+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import {
+  ALL_TABLE_COLUMNS,
+  getDefaultColumns,
+  getAvailableColumns,
+  parseTableColumns,
+  reorderColumn,
+  toggleColumn,
+  saveTableColumns,
+  type TableColumnId,
+} from './tableColumns';
+
+describe('tableColumns', () => {
+  beforeEach(() => {
+    localStorage.clear();
+    vi.restoreAllMocks();
+  });
+
+  it('provides all expected column definitions', () => {
+    expect(ALL_TABLE_COLUMNS.length).toBe(12);
+    const ids = ALL_TABLE_COLUMNS.map((c) => c.id);
+    expect(ids).toContain('key');
+    expect(ids).toContain('summary');
+    expect(ids).toContain('state');
+    expect(ids).toContain('priority');
+    expect(ids).toContain('assignees');
+    expect(ids).toContain('labels');
+    expect(ids).toContain('cycle');
+    expect(ids).toContain('modules');
+    expect(ids).toContain('start_date');
+    expect(ids).toContain('due_date');
+    expect(ids).toContain('created_by');
+    expect(ids).toContain('access');
+  });
+
+  it('unmounts modules when modulesEnabled is false', () => {
+    const withModules = getAvailableColumns(true);
+    expect(withModules.some((c) => c.id === 'modules')).toBe(true);
+
+    const withoutModules = getAvailableColumns(false);
+    expect(withoutModules.some((c) => c.id === 'modules')).toBe(false);
+
+    const defaultWith = getDefaultColumns(true);
+    expect(defaultWith).toContain('modules');
+
+    const defaultWithout = getDefaultColumns(false);
+    expect(defaultWithout).not.toContain('modules');
+  });
+
+  it('parses valid and default columns from localStorage', () => {
+    const custom = ['key', 'summary', 'state', 'due_date'];
+    const parsed = parseTableColumns(JSON.stringify(custom), 'KAN', true);
+    expect(parsed).toEqual(['key', 'summary', 'state', 'due_date']);
+  });
+
+  it('handles negative/security hostile corrupt values gracefully', () => {
+    // Malformed JSON string
+    expect(parseTableColumns('{corrupt}', 'KAN', true)).toEqual(
+      getDefaultColumns(true)
+    );
+
+    // Hostile prototype injection object
+    expect(parseTableColumns('{"__proto__":1}', 'KAN', true)).toEqual(
+      getDefaultColumns(true)
+    );
+
+    // Hostile scripts or invalid IDs
+    const hostile = ['<script>', 'alert(1)', 'unknown'];
+    const parsed = parseTableColumns(JSON.stringify(hostile), 'KAN', true);
+    // Locked columns are prepended
+    expect(parsed).toContain('key');
+    expect(parsed).toContain('summary');
+
+    // Modules stripped when modulesEnabled is false even if explicitly present
+    const withStaleModules = ['key', 'summary', 'modules', 'state'];
+    const parsedNoMod = parseTableColumns(
+      JSON.stringify(withStaleModules),
+      'KAN',
+      false
+    );
+    expect(parsedNoMod).not.toContain('modules');
+    expect(parsedNoMod).toEqual(['key', 'summary', 'state']);
+  });
+
+  it('reorders non-locked columns and prevents illegal moves', () => {
+    const initial: TableColumnId[] = ['key', 'summary', 'state', 'priority', 'due_date'];
+
+    // Move priority up before state
+    const movedUp = reorderColumn(initial, 'priority', 'up');
+    expect(movedUp).toEqual(['key', 'summary', 'priority', 'state', 'due_date']);
+
+    // Move priority down
+    const movedDown = reorderColumn(movedUp, 'priority', 'down');
+    expect(movedDown).toEqual(initial);
+
+    // Cannot move locked key or summary
+    expect(reorderColumn(initial, 'key', 'down')).toEqual(initial);
+    expect(reorderColumn(initial, 'summary', 'down')).toEqual(initial);
+
+    // Cannot move beyond bounds
+    expect(reorderColumn(initial, 'state', 'up')).toEqual(initial); // cannot move into index 1 (summary is locked at index 1)
+    expect(reorderColumn(initial, 'due_date', 'down')).toEqual(initial);
+
+    // Unknown column returns unchanged
+    expect(reorderColumn(initial, 'access', 'up')).toEqual(initial);
+  });
+
+  it('toggles column visibility respecting locks and modulesEnabled', () => {
+    const initial: TableColumnId[] = ['key', 'summary', 'state'];
+
+    // Toggle start_date on
+    const withStart = toggleColumn(initial, 'start_date', true);
+    expect(withStart).toContain('start_date');
+
+    // Toggle start_date off
+    const withoutStart = toggleColumn(withStart, 'start_date', false);
+    expect(withoutStart).not.toContain('start_date');
+
+    // Cannot toggle locked columns off
+    expect(toggleColumn(initial, 'key', false)).toEqual(initial);
+    expect(toggleColumn(initial, 'summary', false)).toEqual(initial);
+
+    // Cannot toggle modules on if modulesEnabled is false
+    expect(toggleColumn(initial, 'modules', true, false)).not.toContain('modules');
+
+    // Redundant toggles return current list
+    expect(toggleColumn(initial, 'state', true)).toEqual(initial);
+    expect(toggleColumn(initial, 'access', false)).toEqual(initial);
+  });
+
+  it('saves columns to localStorage and handles storage exceptions', () => {
+    const cols: TableColumnId[] = ['key', 'summary', 'state'];
+    saveTableColumns(cols, 'KAN');
+    expect(localStorage.getItem('kb.tableCols.KAN')).toBe(JSON.stringify(cols));
+
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementationOnce(() => {
+      throw new Error('QuotaExceededError');
+    });
+    expect(() => { saveTableColumns(cols, 'KAN'); }).not.toThrow();
+  });
+});
diff --git a/kanban/web/src/features/table/tableColumns.ts b/kanban/web/src/features/table/tableColumns.ts
new file mode 100644
index 0000000..45ff9ab
--- /dev/null
+++ b/kanban/web/src/features/table/tableColumns.ts
@@ -0,0 +1,272 @@
+/**
+ * Typed table column definitions, defaults, reordering, and storage validation (KB-P3-38, S6.4, S7.2 8f).
+ */
+
+export type TableColumnId =
+  | 'key'
+  | 'summary'
+  | 'state'
+  | 'priority'
+  | 'assignees'
+  | 'labels'
+  | 'cycle'
+  | 'modules'
+  | 'start_date'
+  | 'due_date'
+  | 'created_by'
+  | 'access';
+
+export interface TableColumnDef {
+  readonly id: TableColumnId;
+  readonly label: string;
+  readonly locked?: boolean;
+  readonly defaultVisible: boolean;
+  readonly sortable?: boolean;
+  readonly sortField?: string;
+}
+
+export const ALL_TABLE_COLUMNS: readonly TableColumnDef[] = Object.freeze([
+  Object.freeze({
+    id: 'key',
+    label: 'Key',
+    locked: true,
+    defaultVisible: true,
+    sortable: true,
+    sortField: 'key',
+  }),
+  Object.freeze({
+    id: 'summary',
+    label: 'Summary',
+    locked: true,
+    defaultVisible: true,
+    sortable: true,
+    sortField: 'summary',
+  }),
+  Object.freeze({
+    id: 'state',
+    label: 'State',
+    defaultVisible: true,
+    sortable: true,
+    sortField: 'state',
+  }),
+  Object.freeze({
+    id: 'priority',
+    label: 'Priority',
+    defaultVisible: true,
+    sortable: true,
+    sortField: 'priority',
+  }),
+  Object.freeze({
+    id: 'assignees',
+    label: 'Assignees',
+    defaultVisible: true,
+    sortable: false,
+  }),
+  Object.freeze({
+    id: 'labels',
+    label: 'Labels',
+    defaultVisible: true,
+    sortable: false,
+  }),
+  Object.freeze({
+    id: 'cycle',
+    label: 'Cycle',
+    defaultVisible: true,
+    sortable: false,
+  }),
+  Object.freeze({
+    id: 'modules',
+    label: 'Modules',
+    defaultVisible: true,
+    sortable: false,
+  }),
+  Object.freeze({
+    id: 'start_date',
+    label: 'Start date',
+    defaultVisible: false,
+    sortable: true,
+    sortField: 'start_date',
+  }),
+  Object.freeze({
+    id: 'due_date',
+    label: 'Due date',
+    defaultVisible: true,
+    sortable: true,
+    sortField: 'due_date',
+  }),
+  Object.freeze({
+    id: 'created_by',
+    label: 'Created by',
+    defaultVisible: false,
+    sortable: true,
+    sortField: 'created_by',
+  }),
+  Object.freeze({
+    id: 'access',
+    label: 'Access',
+    defaultVisible: false,
+    sortable: false,
+  }),
+]);
+
+const VALID_COLUMN_IDS: ReadonlySet<string> = new Set(
+  ALL_TABLE_COLUMNS.map((col) => col.id)
+);
+
+/**
+ * Returns default visible columns for a project, taking modules_enabled into account.
+ */
+export function getDefaultColumns(modulesEnabled = true): TableColumnId[] {
+  return ALL_TABLE_COLUMNS
+    .filter((col) => {
+      if (col.id === 'modules' && !modulesEnabled) {
+        return false;
+      }
+      return col.defaultVisible;
+    })
+    .map((col) => col.id);
+}
+
+/**
+ * Returns all available column definitions for a project, taking modules_enabled into account.
+ */
+export function getAvailableColumns(modulesEnabled = true): TableColumnDef[] {
+  return ALL_TABLE_COLUMNS.filter((col) => {
+    if (col.id === 'modules' && !modulesEnabled) {
+      return false;
+    }
+    return true;
+  });
+}
+
+/**
+ * Parse and validate a raw localStorage value or config array.
+ * Falls back safely to default columns on corrupted, hostile, or invalid input.
+ */
+export function parseTableColumns(
+  raw: unknown,
+  _projectKey: string,
+  modulesEnabled = true
+): TableColumnId[] {
+  let parsed: unknown = raw;
+
+  if (typeof raw === 'string') {
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      return getDefaultColumns(modulesEnabled);
+    }
+  }
+
+  if (!Array.isArray(parsed)) {
+    return getDefaultColumns(modulesEnabled);
+  }
+
+  const validIds: TableColumnId[] = [];
+  const seen = new Set<string>();
+
+  for (const item of parsed) {
+    if (typeof item === 'string' && VALID_COLUMN_IDS.has(item) && !seen.has(item)) {
+      if (item === 'modules' && !modulesEnabled) {
+        continue;
+      }
+      seen.add(item);
+      validIds.push(item as TableColumnId);
+    }
+  }
+
+  // Ensure locked columns 'key' and 'summary' are present
+  if (!seen.has('key')) {
+    validIds.unshift('key');
+    seen.add('key');
+  }
+  if (!seen.has('summary')) {
+    // Insert summary right after key
+    const keyIdx = validIds.indexOf('key');
+    validIds.splice(keyIdx + 1, 0, 'summary');
+    seen.add('summary');
+  }
+
+  if (validIds.length === 0) {
+    return getDefaultColumns(modulesEnabled);
+  }
+
+  return validIds;
+}
+
+/**
+ * Reorders a column up or down within the active columns list.
+ * Locked columns ('key' and 'summary') cannot be moved past index 1.
+ */
+export function reorderColumn(
+  columns: readonly TableColumnId[],
+  columnId: TableColumnId,
+  direction: 'up' | 'down'
+): TableColumnId[] {
+  const next = [...columns];
+  const index = next.indexOf(columnId);
+  if (index === -1) {
+    return next;
+  }
+
+  const targetIndex = direction === 'up' ? index - 1 : index + 1;
+
+  // Cannot move out of bounds
+  if (targetIndex < 0 || targetIndex >= next.length) {
+    return next;
+  }
+
+  // Do not allow reordering key or summary
+  if (columnId === 'key' || columnId === 'summary') {
+    return next;
+  }
+
+  // Cannot move non-locked column before locked columns
+  if (targetIndex < 2) {
+    return next;
+  }
+
+  const [moved] = next.splice(index, 1) as [TableColumnId];
+  next.splice(targetIndex, 0, moved);
+  return next;
+}
+
+/**
+ * Toggles visibility of an optional column.
+ * Locked columns ('key' and 'summary') cannot be hidden.
+ */
+export function toggleColumn(
+  columns: readonly TableColumnId[],
+  columnId: TableColumnId,
+  visible: boolean,
+  modulesEnabled = true
+): TableColumnId[] {
+  if (columnId === 'key' || columnId === 'summary') {
+    return [...columns];
+  }
+  if (columnId === 'modules' && !modulesEnabled) {
+    return columns.filter((id) => id !== 'modules');
+  }
+
+  const exists = columns.includes(columnId);
+  if (visible && !exists) {
+    // Append to end
+    return [...columns, columnId];
+  }
+  if (!visible && exists) {
+    return columns.filter((id) => id !== columnId);
+  }
+  return [...columns];
+}
+
+/**
+ * Persist column choices to localStorage with defensive key names.
+ */
+export function saveTableColumns(columns: TableColumnId[], projectKey: string): void {
+  try {
+    const storageKey = `kb.tableCols.${projectKey}`;
+    localStorage.setItem(storageKey, JSON.stringify(columns));
+  } catch {
+    // Ignore storage quota or disabled storage exceptions
+  }
+}
