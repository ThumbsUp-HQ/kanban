+
+  it('reorders columns up and down and persists to localStorage', () => {
+    const initialCols: TableColumnId[] = ['key', 'summary', 'state', 'priority', 'assignees', 'due_date'];
+    const onChange = vi.fn();
+
+    render(
+      <ColumnConfigurator
+        columns={initialCols}
+        onChange={onChange}
+        projectKey="KAN"
+        modulesEnabled={true}
+      />
+    );
