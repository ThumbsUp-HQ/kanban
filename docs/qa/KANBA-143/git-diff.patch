+        "/api/v1/projects/WASM/wasm-modules",
+        json={"name": "echo_cvss", "wasm_base64": echo_b64},
+    )
+    assert resp_idempotent.status_code == 201
+    assert resp_idempotent.json()["sha256"] == data["sha256"]
