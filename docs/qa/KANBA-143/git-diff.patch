+def _read_fixture(name: str) -> bytes:
+    """Read a compiled WebAssembly fixture binary."""
+    path = FIXTURES_DIR / name
+    if not path.is_file():
+        msg = f"Fixture {name} not found at {path}"
+        raise FileNotFoundError(msg)
+    return path.read_bytes()
