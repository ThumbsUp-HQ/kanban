+    )
+    assert resp.status_code == 201
+    issue_key = resp.json()["key"]
+    issue_id = uuid.UUID(resp.json()["id"])
+
+    # 1. Direct UPDATE as kanban_app without transition_exec_id raises trigger error
+    with pytest.raises(DBAPIError) as exc_info:
