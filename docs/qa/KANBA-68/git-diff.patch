+async def list_docs(
+    session: AsyncSession,
+    caller: PrincipalContext,
+    project_id: uuid.UUID | None = None,
+) -> list[DocSummaryResponse]:
+    """List documents visible to the caller filtered by workspace and optional project."""
+    stmt = (
+        select(Doc)
