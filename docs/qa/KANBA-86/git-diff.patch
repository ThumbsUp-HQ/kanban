+
+    # Assert LINK_DELETED activity rows written
+    deleted_activity_count = await _count(
+        api_env,
+        "SELECT count(*) FROM activity_records WHERE event_type = 'LINK_DELETED'",
+    )
+    assert deleted_activity_count == 2
