+            f"Head commit: {head_commit or 'none'} | Secret redactions: {redaction_count}"
+        )
+
+    # 6. Dispatch to Harness (in_app_sdk, cli_pipe, or remote_runner)
+    tool_steps: list[ToolCallStep] = []
+    tool_trace_raw: list[dict[str, Any]] = []
+    prompt_tokens = 0
