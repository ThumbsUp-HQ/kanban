+
+    ctx = build_transition_context(
+        execution=execution,
+        issue=issue,
+        agent_def=agent_config,
+        repo_context=repo_ctx,
+        mcp_urls=mcp_urls,
+        ephemeral_token="kb_agt_eph_" + "sample_token_for_cli_demo",
