+    session1 = AsyncWebSocketSession(app)
+    await remote_runner_websocket_endpoint(session1.ws)
+    msg1 = await session1.receive_msg()
+    assert msg1["type"] == "websocket.close"
+    assert msg1["code"] == 4401
