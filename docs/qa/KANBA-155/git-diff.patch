+++ b/kanban/runners/__init__.py
@@ -0,0 +1,53 @@
+# Copyright 2026 Kanban Platform Contributors
+# Apache-2.0 License. See LICENSE for details.
+"""Remote runner orchestration, mTLS PKI, and WebSocket hub (KB-P5-22a, S14.2)."""
+
+from kanban.runners.hub import (
+    MAX_FRAME_BYTES,
+    ConnectedRunner,
+    HeartbeatFrame,
+    HelloAckFrame,
+    HelloFrame,
+    JobCancelFrame,
+    JobDispatchFrame,
+    JobResultFrame,
+    JobToolEventFrame,
+    RemoteRunnerDisconnectedError,
+    RemoteRunnerError,
+    RemoteRunnerExecutionError,
+    RemoteRunnerRevokedError,
+    RemoteRunnerUnavailableError,
+    RunnerWssHub,
+    get_global_hub,
+)
+from kanban.runners.pki import (
+    CsrValidationError,
+    IssuedCertificate,
+    compute_cert_fingerprint,
+    derive_runner_ca,
+    validate_and_sign_csr,
+)
+
+__all__ = [
+    "MAX_FRAME_BYTES",
+    "ConnectedRunner",
+    "CsrValidationError",
+    "HeartbeatFrame",
+    "HelloAckFrame",
+    "HelloFrame",
+    "IssuedCertificate",
+    "JobCancelFrame",
+    "JobDispatchFrame",
+    "JobResultFrame",
+    "JobToolEventFrame",
+    "RemoteRunnerDisconnectedError",
+    "RemoteRunnerError",
+    "RemoteRunnerExecutionError",
+    "RemoteRunnerRevokedError",
+    "RemoteRunnerUnavailableError",
+    "RunnerWssHub",
