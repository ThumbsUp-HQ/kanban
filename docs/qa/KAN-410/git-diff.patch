+++async function preparePageForScreenshot(page, theme) {
+++  await page.evaluate((t) => {
+++    document.documentElement.dataset.theme = t;
+++    localStorage.setItem('theme', t);
+++  }, theme);
+++  await page.waitForTimeout(300);
+++}
