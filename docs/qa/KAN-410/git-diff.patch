+++    colorScheme: theme,
+++    bypassCSP: false, // Strict CSP enforcement!
+++  });
+++
+++  if (COOKIE_VAL) {
+++    await context.addCookies([
+++      {
+++        name: 'kb_session',
+++        value: COOKIE_VAL,
+++        url: `http://127.0.0.1:${PORT}/`,
+++        httpOnly: true,
+++        sameSite: 'Lax',
+++      },
+++      {
+++        name: 'kb_csrf',
+++        value: CSRF_TOKEN,
+++        url: `http://127.0.0.1:${PORT}/`,
+++        httpOnly: false,
+++        sameSite: 'Lax',
+++      },
+++    ]);
+++  }
+++
+++  return context;
+++}
