+++            "agent_definition_id": str(env["agent_def_id"]),
+++            "workspace_id": str(env["workspace_id"]),
+++            "admin_principal_id": str(env["admin_principal_id"]),
+++        }
+++
+++        # Dispatch execution
+++        await runner.worker.handle_dispatch(event)
+++
+++        assert mock_server.request_count == 1
