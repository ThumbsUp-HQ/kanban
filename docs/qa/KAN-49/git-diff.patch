+        ).scalar_one()
+        assert cnt == 0
+
+        chain_res = (
+            await rls_sess.execute(
+                text("SELECT is_valid, checked_rows FROM verify_activity_chain(:ws)"),
+                {"ws": ws_id},
+            )
+        ).one()
+        assert chain_res[0] is True
+
+    await app_engine.dispose()
