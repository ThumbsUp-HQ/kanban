+    # Zero SEQUENCE_SKIPPED records
+    async with factory.session(admin_rls) as rls_sess:
+        cnt = (
+            await rls_sess.execute(
+                text(
+                    "SELECT count(*) FROM activity_records "
+                    "WHERE workspace_id = :ws AND event_type = 'SEQUENCE_SKIPPED'"
+                ),
