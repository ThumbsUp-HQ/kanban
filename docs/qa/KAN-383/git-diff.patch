+async function applyTheme(page: Page, theme: 'light' | 'dark'): Promise<void> {
+  await page.evaluate((t) => {
+    document.documentElement.setAttribute('data-theme', t);
+    localStorage.setItem('kb:theme', t);
+  }, theme);
+  await page.waitForTimeout(150);
+}
