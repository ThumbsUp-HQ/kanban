+    assert exc_info.value.code == "TAG_MISMATCH"
+
+    # 4. Wrapped DEK last tag byte tamper -> TAG_MISMATCH
+    tampered_dek_tag = flip_bit(sealed.wrapped_dek, len(sealed.wrapped_dek) - 1)
