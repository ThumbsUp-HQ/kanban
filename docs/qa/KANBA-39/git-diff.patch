-            r.chain_seq,
-            r.id,
-            r.object_id,
-            r.object_type,
-            r.actor_id,
-            r.event_type,
-            r.recorded_at,
-            r.payload
-        );
-
-        IF r.row_hash <> v_computed_hash THEN
-            RETURN QUERY SELECT false, v_checked, r.chain_seq, r.id, 'ROW_HASH_MISMATCH'::text;
-            RETURN;
-        END IF;
-
-        v_checked := v_checked + 1;
