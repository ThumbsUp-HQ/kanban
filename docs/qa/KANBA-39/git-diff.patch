-+        ),
-+        {"id": proj_id, "ws": ws_id},
-+    )
-+    await committed_db_session.commit()
-+
-+    # 20 concurrent callers using independent asyncpg connections
-+    socket_dir = os.environ.get("KB_TEST_PGHOST", "/tmp/kb-pgsock")
