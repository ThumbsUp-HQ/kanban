-+from __future__ import annotations
-+
-+import base64
-+import json
-+import stat
-+from typing import TYPE_CHECKING
-+
-+import pytest
-+
-+from deploy.standalone.keyring import (
-+    KEYRING_DIR_MODE,
-+    KEYRING_FILE_MODE,
-+    Keyring,
-+    KeyringError,
-+    compute_scram_sha256_verifier,
-+    load_or_create_keyring,
-+)
