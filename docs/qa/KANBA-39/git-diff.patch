-+        fstype = parts[2]
-+        if _is_path_prefix(mount_point, norm_data_dir):
-+            matching.append((mount_point, fstype))
-+    return matching
-+
-+
-+def _is_anon_volume(effective_mountinfo: str, target_mount: str) -> bool:
