+-    ) VALUES (
+-        p_workspace_id, p_object_id, p_object_type, p_actor_id, p_event_type, COALESCE(p_payload, '{}'::jsonb)
+-    ) RETURNING id INTO v_id;
+-
+-    RETURN v_id;
+-END $function$
