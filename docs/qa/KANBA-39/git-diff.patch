+-+        text(
+-+            "INSERT INTO principals (workspace_id, principal_type, display_name) "
+-+            "VALUES (:ws_id, :pt, :name) RETURNING id"
+-+        ),
+-+        {"ws_id": ws_id, "pt": principal_type, "name": display_name},
