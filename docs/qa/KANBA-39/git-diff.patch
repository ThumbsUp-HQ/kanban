+-+    g2 = await _create_group(app_session, ws_id, "Group 2")
+-+
+-+    await app_session.execute(
+-+        text(
+-+            "INSERT INTO principal_group_edges (member_id, group_id, workspace_id) VALUES "
+-+            "(:u, :g1, :ws_id), (:g1, :g2, :ws_id)"
