-+    -- 3. Project workspace match (if project_id is NOT NULL)
-+    IF NEW.project_id IS NOT NULL THEN
-+        SELECT workspace_id
-+        INTO v_proj_ws
-+        FROM projects
-+        WHERE id = NEW.project_id;
