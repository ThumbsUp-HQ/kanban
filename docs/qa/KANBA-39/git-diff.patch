++                models=self._settings.model_allowlist,
++            )
++        except Exception as exc:  # noqa: BLE001
++            latency_ms = (time.monotonic() - start_time) * 1000.0
++            err_msg = self._redact(str(exc))
++            return HealthStatus(
++                ok=False,
++                latency_ms=latency_ms,
++                models=(),
++                detail=err_msg,
++            )
