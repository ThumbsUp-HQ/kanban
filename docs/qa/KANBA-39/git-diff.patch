-/dev/sda1 / ext4 rw 0 0
-/dev/sda1 /var/lib/kanban/data ext4 rw,relatime 0 0
-"""
-    named_mountinfo = (
-        "100 50 8:1 /var/lib/docker/volumes/kanban_data/_data "
-        "/var/lib/kanban/data rw - ext4 /dev/sda1 rw\n"
