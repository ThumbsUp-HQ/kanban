-+    for raw_line in effective_mounts.splitlines():
-+        line = raw_line.strip()
-+        if not line or line.startswith("#"):
-+            continue
-+        parts = line.split()
-+        if len(parts) < _MIN_MOUNT_PARTS:
-+            continue
