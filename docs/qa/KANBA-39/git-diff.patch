-+        IF v_proj_ws <> NEW.workspace_id THEN
-+            RAISE EXCEPTION 'VIEW_PROJECT_WORKSPACE_MISMATCH: project % workspace % does not match view workspace %', NEW.project_id, v_proj_ws, NEW.workspace_id
-+                USING ERRCODE = 'P0001';
-+        END IF;
-+    END IF;
-+
-+    RETURN NEW;
-+END;
-+$$;
