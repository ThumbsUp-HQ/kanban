+            label="invalid",
+            surface="agent",
+            scopes=["agent:read"],
+            allowed_cidrs=["not-a-cidr"],
+        )
+    assert "Invalid CIDR block: not-a-cidr" in str(exc_admin.value)
+
+    with pytest.raises(ValidationError) as exc_unified:
