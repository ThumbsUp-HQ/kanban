+export interface SavedViewsEnvelope {
+  items?: SavedView[];
+  views?: SavedView[];
+}
+
+export function extractSavedViews(
+  data: SavedViewsEnvelope | SavedView[] | null | undefined,
+): SavedView[] {
+  if (!data) return [];
+  if (Array.isArray(data)) return data;
+  return data.items ?? data.views ?? [];
+}
