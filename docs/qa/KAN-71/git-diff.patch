new file mode 100644
index 00000000..ca68260d
--- /dev/null
+++ b/mcp/surfaces/agent/workpad.py
@@ -0,0 +1,127 @@
+# Copyright 2026 Kanban Platform Contributors
+# Apache-2.0 License. See LICENSE for details.
+"""Implementation of the update_workpad MCP tool (KB-AGENT-WORKPAD-01, KAN-71)."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Final
+
+from mcp.context import get_current_mcp_context
+from mcp.errors import KbMcpError, McpErrorCode
+from mcp.help import build_help
+
+if TYPE_CHECKING:
+    from mcp.internal_client import KanbanApiClient
+
+__all__ = [
+    "UPDATE_WORKPAD_SCHEMA",
+    "update_workpad",
+]
+
+_MAX_IDENTIFIER_LEN: Final[int] = 200
+_MAX_BODY_BYTES: Final[int] = 65536
+
+UPDATE_WORKPAD_SCHEMA: Final[dict[str, Any]] = {
+    "type": "object",
+    "properties": {
+        "identifier": {
+            "type": "string",
+        },
+        "body_markdown": {
+            "type": "string",
+        },
+        "revision": {
+            "type": "integer",
+        },
+    },
+    "required": ["identifier", "body_markdown"],
+    "additionalProperties": False,
+}
+
+_ALLOWED_KEYS: Final[frozenset[str]] = frozenset(UPDATE_WORKPAD_SCHEMA["properties"].keys())
+
+
+def _validate_update_workpad_arguments(arguments: dict[str, Any]) -> None:
+    """Strictly validate update_workpad arguments against schema constraints."""
+    if arguments.get("identifier") == "help":
+        return
+
+    for key in arguments:
+        if key not in _ALLOWED_KEYS:
+            msg = f"Unknown parameter '{key}'"
+            raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+
+    if "identifier" not in arguments:
+        msg = "Missing required parameter 'identifier'"
+        raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+
+    identifier = arguments["identifier"]
+    if not isinstance(identifier, str) or not identifier.strip():
+        msg = "identifier must be a non-empty string"
+        raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+    if len(identifier) > _MAX_IDENTIFIER_LEN:
+        msg = f"identifier length ({len(identifier)}) exceeds maximum of {_MAX_IDENTIFIER_LEN}"
+        raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+
+    if "body_markdown" not in arguments:
+        msg = "Missing required parameter 'body_markdown'"
+        raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+
+    body = arguments["body_markdown"]
+    if not isinstance(body, str):
+        msg = "body_markdown must be a string"
+        raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+    if len(body.encode("utf-8")) > _MAX_BODY_BYTES:
+        msg = f"body_markdown exceeds maximum allowed size of {_MAX_BODY_BYTES} bytes"
+        raise KbMcpError(McpErrorCode.VALIDATION_FAILED, msg)
+
+
+async def update_workpad(
+    arguments: dict[str, Any],
+    client: KanbanApiClient | None = None,
+) -> dict[str, Any]:
+    """Execute update_workpad tool updating the silent per-issue agent workpad slot."""
+    _validate_update_workpad_arguments(arguments)
+    identifier = arguments["identifier"].strip()
+
+    ctx = get_current_mcp_context()
+    active_client = client or (ctx.client if ctx else None)
+    if active_client is None:
+        msg = "MCP request context or client unavailable"
+        raise KbMcpError(McpErrorCode.INTERNAL, msg)
+
+    subject_token = ctx.subject_token if ctx else None
+    session_id = ctx.session_id if ctx else None
+
+    if identifier == "help":
+        return await build_help(
+            "update_workpad",
+            client=active_client,
+            subject_token=subject_token,
+            mcp_session_id=session_id,
+        )
+
+    payload: dict[str, Any] = {
+        "body_markdown": arguments["body_markdown"],
+    }
+    if "revision" in arguments and arguments["revision"] is not None:
+        payload["revision"] = arguments["revision"]
+
+    headers: dict[str, str] = {}
+    if "revision" in arguments and arguments["revision"] is not None:
+        headers["If-Match"] = str(arguments["revision"])
+
+    resp_data = await active_client.request(
+        "PUT",
+        f"/api/v1/issues/{identifier}/workpad",
+        json_data=payload,
+        headers=headers or None,
+        subject_token=subject_token,
+        mcp_session_id=session_id,
+    )
+
+    if not isinstance(resp_data, dict):
+        msg = "Invalid response from upstream update-workpad endpoint"
+        raise KbMcpError(McpErrorCode.UPSTREAM_ERROR, msg)
+
+    return resp_data
diff --git a/mcp/tests/test_mcp_rate_limits.py b/mcp/tests/test_mcp_rate_limits.py
new file mode 100644
index 00000000..0d5a296f
--- /dev/null
+++ b/mcp/tests/test_mcp_rate_limits.py
@@ -0,0 +1,101 @@
+# Copyright 2026 Kanban Platform Contributors
+# Apache-2.0 License. See LICENSE for details.
+"""Integration and unit tests for MCP tools/call sliding-window rate limiting (KAN-71).
+
+Covers:
+  - 429 RATE_LIMITED on tools/call burst exceeding policy limits.
+  - Presence of Retry-After response header.
+  - Normal initialize and tools/list unaffected by tools/call limiter.
+"""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from kanban.security.ratelimit.base import RateLimitDecision, RateLimiter, RateLimitPolicy
+from mcp.app import create_mcp_app
+from mcp.registry import Surface, ToolRegistry, create_placeholder_tool
+from mcp.settings import McpSettings
+
+
+class MockMemoryRateLimiter(RateLimiter):
+    """Simple in-memory rate limiter for testing burst denials."""
+
+    def __init__(self, limit: int = 2) -> None:
+        """Initialize mock in-memory rate limiter with limit."""
+        self.limit = limit
+        self.hits: dict[bytes, int] = {}
+
+    async def hit(self, _policy: RateLimitPolicy, key: bytes) -> RateLimitDecision:
+        """Record hit and return rate limit decision."""
+        count = self.hits.get(key, 0) + 1
+        self.hits[key] = count
+        if count > self.limit:
+            return RateLimitDecision(allowed=False, remaining=0, retry_after_seconds=30)
+        return RateLimitDecision(allowed=True, remaining=self.limit - count, retry_after_seconds=0)
+
+    async def reset(self, _policy: RateLimitPolicy, key: bytes) -> None:
+        """Reset rate limit counter for key."""
+        self.hits.pop(key, None)
+
+
+@pytest.mark.asyncio
+async def test_mcp_tools_call_rate_limiting() -> None:
+    """Verify tools/call burst returns 429 RATE_LIMITED with Retry-After header."""
+    settings = McpSettings(mode="standalone_inprocess", auth_enabled=False)
+    docs_reg = ToolRegistry(Surface.DOCS)
+    docs_reg.register(create_placeholder_tool(Surface.DOCS))
+    admin_reg = ToolRegistry(Surface.ADMIN)
+    admin_reg.register(create_placeholder_tool(Surface.ADMIN))
+    app = create_mcp_app(settings, docs_registry=docs_reg, admin_registry=admin_reg)
+
+    # Attach mock limiter allowing max 2 calls
+    app.state.rate_limiter = MockMemoryRateLimiter(limit=2)
+
+    transport = httpx.ASGITransport(app=app)
+    async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+        # 1. Initialize session
+        init_res = await client.post(
+            "/mcp/agent",
+            headers={"content-type": "application/json"},
+            json={
+                "jsonrpc": "2.0",
+                "id": 1,
+                "method": "initialize",
+                "params": {
+                    "protocolVersion": "2025-06-18",
+                    "capabilities": {},
+                    "clientInfo": {"name": "test-client", "version": "1.0"},
+                },
+            },
+        )
+        assert init_res.status_code == 200
+        session_id = init_res.headers.get("mcp-session-id")
+        assert session_id is not None
+
+        call_payload = {
+            "jsonrpc": "2.0",
+            "id": 2,
+            "method": "tools/call",
+            "params": {"name": "read_ticket", "arguments": {"identifier": "KAN-1"}},
+        }
+        headers = {
+            "content-type": "application/json",
+            "mcp-session-id": session_id,
+        }
+
+        # Call 1: Allowed (hits=1)
+        r1 = await client.post("/mcp/agent", headers=headers, json=call_payload)
+        assert r1.status_code != 429
+
+        # Call 2: Allowed (hits=2)
+        r2 = await client.post("/mcp/agent", headers=headers, json=call_payload)
+        assert r2.status_code != 429
+
+        # Call 3: Exceeded limit (hits=3) -> 429 RATE_LIMITED
+        r3 = await client.post("/mcp/agent", headers=headers, json=call_payload)
+        assert r3.status_code == 429, r3.text
+        assert r3.headers.get("retry-after") == "30"
+        err_json = r3.json()
+        assert err_json.get("code") == "RATE_LIMITED"
