+async def snooze_sticky_promotion(
+    session: AsyncSession,
+    caller: PrincipalContext,
+    sticky_id: uuid.UUID,
+) -> tuple[StickyResponse, str]:
+    """Snooze promotion recommendation until body grows by >= 1.5x."""
+    stmt = (
