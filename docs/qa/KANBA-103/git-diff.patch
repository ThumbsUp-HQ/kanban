+    one_part_b64 = base64.urlsafe_b64encode(b"just-one-part").decode("ascii")
+    with pytest.raises(ProblemException) as exc_info:
+        _decode_cursor(one_part_b64)
+    assert exc_info.value.code == "INVALID_CURSOR"
