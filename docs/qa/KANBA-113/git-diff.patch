diff --git a/kanban/web/src/app/AppShell.css b/kanban/web/src/app/AppShell.css
new file mode 100644
index 0000000..1880340
--- /dev/null
+++ b/kanban/web/src/app/AppShell.css
@@ -0,0 +1,68 @@
+.kb-app-shell {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  grid-template-rows: var(--topbar-h, 52px) 1fr;
+  grid-template-areas:
+    "sidebar topbar"
+    "sidebar main";
+  height: 100vh;
+  width: 100vw;
+  overflow: hidden;
+  background: var(--bg-canvas, #141619);
+  color: var(--fg-primary, #f8fafc);
+  font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
+}
+
+/* Visually Hidden Skip Link */
+.kb-skip-link {
+  position: absolute;
+  top: -9999px;
+  left: 16px;
+  background: var(--color-brand-primary, #3b82f6);
+  color: #ffffff;
+  padding: 8px 16px;
+  border-radius: var(--radius-md, 6px);
+  z-index: 10000;
+  text-decoration: none;
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.kb-skip-link:focus {
+  top: 16px;
+}
+
+.kb-app-shell > .kb-sidebar {
+  grid-area: sidebar;
+}
+
+.kb-app-shell > .kb-topbar {
+  grid-area: topbar;
+}
+
+.kb-main-canvas {
+  grid-area: main;
+  padding: var(--board-canvas-pad, 24px 28px);
+  overflow-y: auto;
+  overflow-x: hidden;
+  box-sizing: border-box;
+  outline: none;
+}
+
+/* Tablet & Mobile Layout (<= 1279px) */
+@media (max-width: 1279px) {
+  .kb-app-shell {
+    grid-template-columns: 1fr;
+    grid-template-rows: var(--topbar-h, 52px) 1fr;
+    grid-template-areas:
+      "topbar"
+      "main";
+  }
+}
+
+/* Mobile Canvas Padding Exception (<= 767px) */
+@media (max-width: 767px) {
+  .kb-main-canvas {
+    padding: 16px;
+  }
+}
diff --git a/kanban/web/src/app/AppShell.test.tsx b/kanban/web/src/app/AppShell.test.tsx
