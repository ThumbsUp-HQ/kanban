+      await waitFor(() => {
+        expect(getSpy).toHaveBeenCalledTimes(2);
+        expect(screen.getByText('Harden Multi-Card OIDC & LDAPS Auth Studio')).toBeDefined();
+      });
+    });
+  });
+});
