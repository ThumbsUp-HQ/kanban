+.kb-sidebar {
+  width: var(--sidebar-w, 256px);
+  min-width: var(--sidebar-w, 256px);
+  height: 100vh;
+  background: var(--bg-surface, #1e2025);
+  border-right: 1px solid var(--border-subtle, #333842);
+  display: flex;
+  flex-direction: column;
+  padding: var(--space-4, 16px);
+  box-sizing: border-box;
+  overflow-y: auto;
+  overflow-x: hidden;
+  transition: width 160ms ease, min-width 160ms ease, padding 160ms ease, visibility 160ms ease;
+  z-index: 20;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .kb-sidebar {
+    transition: none !important;
+  }
+}
+
+/* Desktop Collapsed */
+.kb-sidebar.kb-sidebar-collapsed {
+  width: 0 !important;
