+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import {
+  registerShortcut,
+  isEditableElement,
+  matchesCombo,
+} from './shortcuts';
+
+describe('shortcuts', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  afterEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  it('identifies editable elements correctly', () => {
+    expect(isEditableElement(null)).toBe(false);
+
+    const div = document.createElement('div');
+    expect(isEditableElement(div)).toBe(false);
+
+    const input = document.createElement('input');
+    expect(isEditableElement(input)).toBe(true);
+
+    const textarea = document.createElement('textarea');
+    expect(isEditableElement(textarea)).toBe(true);
+
+    const select = document.createElement('select');
+    expect(isEditableElement(select)).toBe(true);
+
+    div.contentEditable = 'true';
+    expect(isEditableElement(div)).toBe(true);
+
+    const divAttr = document.createElement('div');
+    divAttr.setAttribute('contenteditable', 'true');
+    expect(isEditableElement(divAttr)).toBe(true);
+
+    const notAnEl = {} as Element;
+    expect(isEditableElement(notAnEl)).toBe(false);
+  });
+
+  it('matches keyboard combos correctly for Mod and modifiers', () => {
+    const isMac = /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent);
+
+    const eventModK = new KeyboardEvent('keydown', {
+      key: 'k',
+      metaKey: isMac,
+      ctrlKey: !isMac,
+    });
+    expect(matchesCombo(eventModK, 'Mod+K')).toBe(true);
+    expect(matchesCombo(eventModK, 'Cmd/Ctrl+K')).toBe(true);
+
+    const eventPlainK = new KeyboardEvent('keydown', { key: 'k' });
+    expect(matchesCombo(eventPlainK, 'Mod+K')).toBe(false);
+
+    const eventBracket = new KeyboardEvent('keydown', { key: '[' });
+    expect(matchesCombo(eventBracket, '[')).toBe(true);
+    expect(matchesCombo(eventBracket, ']')).toBe(false);
+
+    const eventCtrlA = new KeyboardEvent('keydown', { key: 'a', ctrlKey: true });
+    expect(matchesCombo(eventCtrlA, 'ctrl+a')).toBe(true);
+    expect(matchesCombo(eventPlainK, 'ctrl+a')).toBe(false);
+
+    const eventMetaA = new KeyboardEvent('keydown', { key: 'a', metaKey: true });
+    expect(matchesCombo(eventMetaA, 'meta+a')).toBe(true);
+    expect(matchesCombo(eventPlainK, 'meta+a')).toBe(false);
+
+    const eventShiftA = new KeyboardEvent('keydown', { key: 'a', shiftKey: true });
+    expect(matchesCombo(eventShiftA, 'shift+a')).toBe(true);
+    expect(matchesCombo(eventPlainK, 'shift+a')).toBe(false);
+
+    const eventAltA = new KeyboardEvent('keydown', { key: 'a', altKey: true });
+    expect(matchesCombo(eventAltA, 'alt+a')).toBe(true);
+    expect(matchesCombo(eventPlainK, 'alt+a')).toBe(false);
+  });
+
+  it('registers and triggers shortcut, ignoring editable elements by default', () => {
+    const handler = vi.fn();
+    const unregister = registerShortcut('[', handler);
+
+    // Trigger on body
+    window.dispatchEvent(new KeyboardEvent('keydown', { key: '[' }));
+    expect(handler).toHaveBeenCalledTimes(1);
+
+    // Trigger while inside an input
+    const input = document.createElement('input');
+    document.body.appendChild(input);
+    input.focus();
+
+    window.dispatchEvent(new KeyboardEvent('keydown', { key: '[' }));
+    // Should NOT have fired second time
+    expect(handler).toHaveBeenCalledTimes(1);
+
+    unregister();
+    window.dispatchEvent(new KeyboardEvent('keydown', { key: '[' }));
+    expect(handler).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows shortcuts inside inputs when allowInInputs is true', () => {
+    const handler = vi.fn();
+    const isMac = /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent);
+    const unregister = registerShortcut('Mod+K', handler, { allowInInputs: true });
+
+    const input = document.createElement('input');
+    document.body.appendChild(input);
+    input.focus();
+
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', {
+        key: 'k',
+        metaKey: isMac,
+        ctrlKey: !isMac,
+      }),
+    );
+    expect(handler).toHaveBeenCalledTimes(1);
+
+    unregister();
+  });
+
+  it('handles Alt modifier and multiple registered shortcuts with teardown', () => {
+    const handler1 = vi.fn();
+    const handler2 = vi.fn();
+
+    const unreg1 = registerShortcut('Alt+X', handler1);
+    const unreg2 = registerShortcut('Alt+Y', handler2);
+
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', { key: 'x', altKey: true }),
+    );
+    expect(handler1).toHaveBeenCalledTimes(1);
+    expect(handler2).not.toHaveBeenCalled();
+
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', { key: 'y', altKey: true }),
+    );
+    expect(handler2).toHaveBeenCalledTimes(1);
+
+    unreg1();
+    unreg2();
+
+    // After unregistering all, listener should be torn down
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', { key: 'x', altKey: true }),
+    );
+    expect(handler1).toHaveBeenCalledTimes(1);
+  });
+
+  it('ignores events when isComposing is true', () => {
+    const handler = vi.fn();
+    const unregister = registerShortcut('[', handler);
+
+    const event = new KeyboardEvent('keydown', { key: '[' });
+    Object.defineProperty(event, 'isComposing', { value: true });
+
+    window.dispatchEvent(event);
+    expect(handler).not.toHaveBeenCalled();
+
+    unregister();
+  });
+
+  it('handles Alt modifier and multiple registered shortcuts with teardown', () => {
+    const handler1 = vi.fn();
+    const handler2 = vi.fn();
+
+    const unreg1 = registerShortcut('Alt+X', handler1);
+    const unreg2 = registerShortcut('Alt+Y', handler2);
+
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', { key: 'x', altKey: true }),
+    );
+    expect(handler1).toHaveBeenCalledTimes(1);
+    expect(handler2).not.toHaveBeenCalled();
+
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', { key: 'y', altKey: true }),
+    );
+    expect(handler2).toHaveBeenCalledTimes(1);
+
+    unreg1();
+    unreg2();
+
+    // After unregistering all, listener should be torn down
+    window.dispatchEvent(
+      new KeyboardEvent('keydown', { key: 'x', altKey: true }),
+    );
+    expect(handler1).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/kanban/web/src/app/shortcuts.ts b/kanban/web/src/app/shortcuts.ts
new file mode 100644
index 0000000..36419b7
--- /dev/null
+++ b/kanban/web/src/app/shortcuts.ts
@@ -0,0 +1,149 @@
+/**
+ * Global Keyboard Shortcut Dispatcher (KB-P3-34, S6.4).
+ * Single global listener with composing and input boundary guards.
+ */
+
+export interface ShortcutOptions {
+  readonly allowInInputs?: boolean;
+}
+
+export type ShortcutHandler = (event: KeyboardEvent) => void;
+
+interface RegisteredShortcut {
+  readonly combo: string;
+  readonly handler: ShortcutHandler;
+  readonly allowInInputs: boolean;
+}
+
+const registry = new Set<RegisteredShortcut>();
+let globalListenerAttached = false;
+
+/**
+ * Checks whether an element is an input, textarea, select, or contenteditable.
+ */
+export function isEditableElement(element: Element | null): boolean {
+  if (!element || !(element instanceof HTMLElement)) {
+    return false;
+  }
+  const tag = element.tagName.toUpperCase();
+  if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
+    return true;
+  }
+  return (
+    element.isContentEditable ||
+    element.contentEditable === 'true' ||
+    element.getAttribute('contenteditable') === 'true'
+  );
+}
+
+/**
+ * Normalizes keyboard event to compare against combo string.
+ */
+export function matchesCombo(event: KeyboardEvent, combo: string): boolean {
+  const isMac =
+    typeof navigator !== 'undefined' &&
+    /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent);
+
+  const parts = combo
+    .split('+')
+    .map((p) => p.trim().toLowerCase());
+
+  let reqMod = false;
+  let reqCtrl = false;
+  let reqMeta = false;
+  let reqShift = false;
+  let reqAlt = false;
+  let targetKey = '';
+
+  for (const part of parts) {
+    if (part === 'mod' || part === 'cmd/ctrl') {
+      reqMod = true;
+    } else if (part === 'ctrl' || part === 'control') {
+      reqCtrl = true;
+    } else if (part === 'cmd' || part === 'meta') {
+      reqMeta = true;
+    } else if (part === 'shift') {
+      reqShift = true;
+    } else if (part === 'alt') {
+      reqAlt = true;
+    } else {
+      targetKey = part;
+    }
+  }
+
+  if (reqMod) {
+    const hasMod = isMac ? event.metaKey : event.ctrlKey;
+    if (!hasMod) {
+      return false;
+    }
+  } else {
+    if (reqCtrl && !event.ctrlKey) return false;
+    if (reqMeta && !event.metaKey) return false;
+  }
+
+  if (reqShift && !event.shiftKey) return false;
+  if (reqAlt && !event.altKey) return false;
+
+  // Compare key
+  const eventKey = event.key.toLowerCase();
+  if (targetKey && eventKey !== targetKey) {
+    return false;
+  }
+
+  return true;
+}
+
+function handleGlobalKeydown(event: KeyboardEvent): void {
+  if (event.isComposing) {
+    return;
+  }
+
+  const active = typeof document !== 'undefined' ? document.activeElement : null;
+  const inInput = isEditableElement(active);
+
+  for (const item of registry) {
+    if (inInput && !item.allowInInputs) {
+      continue;
+    }
+    if (matchesCombo(event, item.combo)) {
+      item.handler(event);
+      break;
+    }
+  }
+}
+
+function ensureListener(): void {
+  if (!globalListenerAttached && typeof window !== 'undefined') {
+    window.addEventListener('keydown', handleGlobalKeydown);
+    globalListenerAttached = true;
+  }
+}
+
+function teardownListenerIfEmpty(): void {
+  if (registry.size === 0 && globalListenerAttached && typeof window !== 'undefined') {
+    window.removeEventListener('keydown', handleGlobalKeydown);
+    globalListenerAttached = false;
+  }
+}
+
+/**
+ * Registers a keyboard shortcut handler. Returns an unregister function.
+ */
+export function registerShortcut(
+  combo: string,
+  handler: ShortcutHandler,
+  options?: ShortcutOptions,
+): () => void {
+  const item: RegisteredShortcut = {
+    combo,
+    handler,
+    allowInInputs: options?.allowInInputs ?? false,
+  };
+  registry.add(item);
+  ensureListener();
+
+  return () => {
+    registry.delete(item);
+    teardownListenerIfEmpty();
+  };
+}
