+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import React from 'react';
+import { MemoryRouter, Route, Routes, useNavigate, type NavigateFunction } from 'react-router';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { IssueSurface } from './IssueSurface';
+import { setOpenerElement } from './IssueKeyLink';
+import { apiClient } from '../../api/client';
+import { ApiProblem } from '../../api/problem';
+import type { IssueDetail } from './slots';
+import * as breakpoints from '../../styles/breakpoints';
+
+const validIssue: IssueDetail = {
+  key: 'KAN-142',
+  object_id: '11111111-1111-1111-1111-111111111111',
+  project_key: 'KAN',
+  project_name: 'Platform Core',
+  summary: 'Harden Multi-Card OIDC & LDAPS Auth Studio',
+  description_markdown: 'Detailed description of the auth hardening task.',
+  priority: {
+    slug: 'high',
+    label: 'High',
+    emoji: '⚡',
+    sort_order: 2,
+    sla_target: null,
+  },
+  etag: '"etag-kan-142"',
+};
+
+function createTestHarness(initialEntries: string[] = ['/projects/KAN/issues?peek=KAN-142']) {
+  const queryClient = new QueryClient({
+    defaultOptions: {
+      queries: { retry: false, staleTime: 60_000 },
+    },
+  });
+
+  let navigateRef: ReturnType<typeof useNavigate> | null = null;
+
+  function NavCapture() {
+    const nav = useNavigate();
+    navigateRef = nav;
+    return null;
+  }
+
+  function Harness() {
+    return (
+      <QueryClientProvider client={queryClient}>
+        <MemoryRouter initialEntries={initialEntries}>
+          <NavCapture />
+          <Routes>
+            <Route
+              path="/projects/:projectKey/issues"
+              element={
+                <div id="main-content">
+                  <main id="kb-main" tabIndex={-1}>
+                    Main Canvas
+                  </main>
+                  <div id="kb-issue-surface-host">
+                    <IssueSurface />
+                  </div>
+                </div>
+              }
+            />
+            <Route
+              path="/projects/:projectKey/issues/:issueKey"
+              element={
+                <div id="main-content">
+                  <main id="kb-main" tabIndex={-1}>
+                    Main Canvas
+                  </main>
+                  <div id="kb-issue-surface-host">
+                    <IssueSurface />
+                  </div>
+                </div>
+              }
+            />
+          </Routes>
+        </MemoryRouter>
+      </QueryClientProvider>
+    );
+  }
+
+  return {
+    queryClient,
+    Harness,
+    getNavigate: (): NavigateFunction => {
+      if (!navigateRef) throw new Error('navigateRef not set');
+      return navigateRef;
+    },
+  };
+}
+
+describe('IssueSurface', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  describe('Required Test Case 1: Positive / Zero-remount invariant', () => {
+    it('maintains identical data-mount-id and data-mount-seq across 5 round-trip toggles with exactly 1 GET fetch', async () => {
+      const getSpy = vi.spyOn(apiClient, 'get').mockResolvedValue(validIssue);
+      const { Harness, getNavigate } = createTestHarness(['/projects/KAN/issues?peek=KAN-142']);
+
+      const { container } = render(<Harness />);
+
+      await waitFor(() => {
+        expect(screen.getByText('Harden Multi-Card OIDC & LDAPS Auth Studio')).toBeDefined();
+      });
+
+      const surface = container.querySelector('section');
+      expect(surface).not.toBeNull();
+      expect(surface?.className).toBe('surface--drawer');
+
+      const initialMountId = surface?.getAttribute('data-mount-id');
+      const initialMountSeq = surface?.getAttribute('data-mount-seq');
+      expect(initialMountId).toBeTruthy();
+      expect(initialMountSeq).toBeTruthy();
+
+      const navigate = getNavigate();
+
+      // Perform 5 round-trip toggles: drawer -> full -> drawer -> full ...
+      for (let i = 0; i < 5; i++) {
+        // Toggle to full screen
+        void navigate('/projects/KAN/issues/KAN-142');
+        await waitFor(() => {
+          const current = container.querySelector('section');
+          expect(current?.className).toBe('surface--full');
+          expect(current?.getAttribute('data-mount-id')).toBe(initialMountId);
+          expect(current?.getAttribute('data-mount-seq')).toBe(initialMountSeq);
+        });
+
+        // Toggle back to drawer
+        void navigate('/projects/KAN/issues?peek=KAN-142');
+        await waitFor(() => {
+          const current = container.querySelector('section');
+          expect(current?.className).toBe('surface--drawer');
+          expect(current?.getAttribute('data-mount-id')).toBe(initialMountId);
+          expect(current?.getAttribute('data-mount-seq')).toBe(initialMountSeq);
+        });
+      }
+
+      // Mocked fetch was called exactly once for KAN-142
+      expect(getSpy).toHaveBeenCalledTimes(1);
+    });
+  });
+
+  describe('Required Test Case 3: Negative / Security (XSS injection in summary & description)', () => {
+    it('renders malicious payloads as literal text nodes; no script or img elements exist', async () => {
+      const xssIssue: IssueDetail = {
+        ...validIssue,
+        summary: '<script>alert(1)</script><img src=x onerror=alert(1)>',
+        description_markdown: '<script>alert(2)</script><img src=y onerror=alert(2)>',
+      };
+      vi.spyOn(apiClient, 'get').mockResolvedValue(xssIssue);
+
+      const { Harness } = createTestHarness();
+      const { container } = render(<Harness />);
+
+      await waitFor(() => {
+        expect(screen.getByText('<script>alert(1)</script><img src=x onerror=alert(1)>')).toBeDefined();
+        expect(screen.getByText('<script>alert(2)</script><img src=y onerror=alert(2)>')).toBeDefined();
+      });
+
+      // Strict security invariant: zero script or injected img tags in the DOM
+      const scripts = container.querySelectorAll('script');
+      const imgs = container.querySelectorAll('img');
+      expect(scripts.length).toBe(0);
+      expect(imgs.length).toBe(0);
+    });
+  });
+
+  describe('Required Test Case 7: Keyboard shortcuts and focus return', () => {
+    it('Ctrl+Shift+F toggles mode', async () => {
+      vi.spyOn(apiClient, 'get').mockResolvedValue(validIssue);
+      const { Harness } = createTestHarness(['/projects/KAN/issues?peek=KAN-142']);
+
+      const { container } = render(<Harness />);
+
+      await waitFor(() => {
+        expect(screen.getByText('Harden Multi-Card OIDC & LDAPS Auth Studio')).toBeDefined();
+      });
+
+      expect(container.querySelector('section')?.className).toBe('surface--drawer');
+
+      // Trigger Mod+Shift+F
+      fireEvent.keyDown(window, {
+        key: 'F',
+        ctrlKey: true,
+        shiftKey: true,
+      });
+
+      await waitFor(() => {
+        expect(container.querySelector('section')?.className).toBe('surface--full');
+      });
+    });
+
+    it('Escape from full returns to drawer, second Escape closes and focus returns to opener', async () => {
+      vi.spyOn(apiClient, 'get').mockResolvedValue(validIssue);
+
+      const openerBtn = document.createElement('button');
+      openerBtn.id = 'opener-button';
+      document.body.appendChild(openerBtn);
+      setOpenerElement(openerBtn);
+
+      const { Harness } = createTestHarness(['/projects/KAN/issues/KAN-142']);
+      const { container } = render(<Harness />);
+
+      await waitFor(() => {
+        expect(container.querySelector('section')?.className).toBe('surface--full');
+      });
+
+      // First Escape: returns to drawer
+      fireEvent.keyDown(window, { key: 'Escape' });
+      await waitFor(() => {
+        expect(container.querySelector('section')?.className).toBe('surface--drawer');
+      });
+
+      // Second Escape: closes drawer and returns focus to opener
+      fireEvent.keyDown(window, { key: 'Escape' });
+      await waitFor(() => {
+        expect(container.querySelector('section')).toBeNull();
+        expect(document.activeElement).toBe(openerBtn);
+      });
+
+      document.body.removeChild(openerBtn);
+    });
+
+    it('returns focus to #kb-main when opener element was removed', async () => {
+      vi.spyOn(apiClient, 'get').mockResolvedValue(validIssue);
+
+      const detachedBtn = document.createElement('button');
+      // Do not append to body -> detached
+      setOpenerElement(detachedBtn);
+
+      const { Harness } = createTestHarness(['/projects/KAN/issues?peek=KAN-142']);
+      const { container } = render(<Harness />);
+
+      await waitFor(() => {
+        expect(container.querySelector('section')).toBeDefined();
+      });
+
+      fireEvent.keyDown(window, { key: 'Escape' });
+
+      await waitFor(() => {
+        expect(container.querySelector('section')).toBeNull();
+        const main = document.getElementById('kb-main');
+        expect(document.activeElement).toBe(main);
+      });
+    });
+  });
+
+  describe('Required Test Case 8: Viewport aria-modal property', () => {
+    it('sets aria-modal="true" on mobile and aria-modal="false" on desktop', async () => {
+      vi.spyOn(apiClient, 'get').mockResolvedValue(validIssue);
+
+      // Desktop
+      vi.spyOn(breakpoints, 'useBreakpoint').mockReturnValue('desktop');
+      const { Harness: DesktopHarness } = createTestHarness(['/projects/KAN/issues?peek=KAN-142']);
+      const { container: desktopContainer, unmount } = render(<DesktopHarness />);
+
+      await waitFor(() => {
+        expect(desktopContainer.querySelector('section')?.getAttribute('aria-modal')).toBe('false');
+      });
+      unmount();
+
+      // Mobile
+      vi.spyOn(breakpoints, 'useBreakpoint').mockReturnValue('mobile');
+      const { Harness: MobileHarness } = createTestHarness(['/projects/KAN/issues?peek=KAN-142']);
+      const { container: mobileContainer } = render(<MobileHarness />);
+
+      await waitFor(() => {
+        expect(mobileContainer.querySelector('section')?.getAttribute('aria-modal')).toBe('true');
+      });
+    });
+  });
+
+  describe('Required Test Case 9: Error handling (403, 404, network error with Retry)', () => {
+    it('renders identical anti-enumeration string for 403 and 404', async () => {
+      // 404
+      vi.spyOn(apiClient, 'get').mockRejectedValueOnce(
+        new ApiProblem(404, { title: 'Not Found', status: 404 }),
+      );
+      const { Harness: Harness404, queryClient } = createTestHarness(['/projects/KAN/issues?peek=KAN-999']);
+      const { unmount } = render(<Harness404 />);
+
+      await waitFor(() => {
+        expect(screen.getByText('Issue KAN-999 was not found or you do not have access.')).toBeDefined();
+      });
+      unmount();
+      queryClient.clear();
+
+      // 403
+      vi.spyOn(apiClient, 'get').mockRejectedValueOnce(
+        new ApiProblem(403, { title: 'Forbidden', status: 403 }),
+      );
+      const { Harness: Harness403 } = createTestHarness(['/projects/KAN/issues?peek=KAN-999']);
+      render(<Harness403 />);
+
+      await waitFor(() => {
+        expect(screen.getByText('Issue KAN-999 was not found or you do not have access.')).toBeDefined();
+      });
+    });
+
+    it('renders "Could not load <KEY>." and Retry button on network error', async () => {
+      const getSpy = vi
+        .spyOn(apiClient, 'get')
+        .mockRejectedValueOnce(new Error('Network error'))
+        .mockResolvedValueOnce(validIssue);
+
+      const { Harness } = createTestHarness(['/projects/KAN/issues?peek=KAN-142']);
+      render(<Harness />);
+
+      await waitFor(() => {
+        expect(screen.getByText('Could not load KAN-142.')).toBeDefined();
+      });
+
+      const retryBtn = screen.getByRole('button', { name: 'Retry' });
+      fireEvent.click(retryBtn);
+
+      await waitFor(() => {
+        expect(getSpy).toHaveBeenCalledTimes(2);
+        expect(screen.getByText('Harden Multi-Card OIDC & LDAPS Auth Studio')).toBeDefined();
+      });
+    });
+  });
+});
diff --git a/kanban/web/src/features/drawer/IssueSurface.tsx b/kanban/web/src/features/drawer/IssueSurface.tsx
new file mode 100644
index 0000000..ec6e178
--- /dev/null
+++ b/kanban/web/src/features/drawer/IssueSurface.tsx
@@ -0,0 +1,311 @@
+import React, {
+  useCallback,
+  useEffect,
+  useRef,
+  useState,
+  type JSX,
+} from 'react';
+import { useLocation, useNavigate } from 'react-router';
+import { useQuery } from '@tanstack/react-query';
+import { apiClient } from '../../api/client';
+import { ApiProblem } from '../../api/problem';
+import { qk } from '../../api/queryKeys';
+import { useBreakpoint } from '../../styles/breakpoints';
+import { registerShortcut } from '../../app/shortcuts';
+import {
+  useIssueSurfaceRoute,
+  toFullScreenPath,
+  toPeekPath,
+} from './useIssueSurfaceRoute';
+import { getOpenerElement } from './IssueKeyLink';
+import { useIssueSurfaceSlots, type IssueDetail } from './slots';
+import { IssueHeader } from './IssueHeader';
+import { SummaryField } from './SummaryField';
+import { useFocusTrap } from './useFocusTrap';
+import './IssueSurface.css';
+
+let moduleMountCounter = 0;
+
+interface IssueSurfaceRootProps {
+  mode: 'drawer' | 'full';
+  issueKey: string;
+  projectKey: string | null;
+}
+
+function IssueSurfaceRoot({
+  mode,
+  issueKey,
+  projectKey,
+}: IssueSurfaceRootProps): JSX.Element {
+  const [mountId] = useState(() => crypto.randomUUID());
+  const [mountSeq] = useState(() => {
+    moduleMountCounter += 1;
+    return moduleMountCounter;
+  });
+
+  const location = useLocation();
+  const navigate = useNavigate();
+  const rootRef = useRef<HTMLElement | null>(null);
+  const descRef = useRef<HTMLElement | null>(null);
+
+  const slots = useIssueSurfaceSlots();
+  const bp = useBreakpoint();
+  const isMobile = bp === 'mobile';
+
+  useFocusTrap(isMobile && mode === 'drawer', rootRef);
+
+  useEffect(() => {
+    rootRef.current?.focus();
+  }, [issueKey]);
+
+  const {
+    data: issue,
+    error,
+    isLoading,
+    refetch,
+  } = useQuery<IssueDetail>({
+    queryKey: qk.issue(issueKey),
+    queryFn: async () => {
+      return (await apiClient.get(
+        '/api/v1/issues/{issue_key}',
+        { params: { issue_key: issueKey } },
+      )) as unknown as IssueDetail;
+    },
+    staleTime: 60_000,
+  });
+
+  const handleClose = useCallback((): void => {
+    void navigate(toPeekPath(location, null));
+    const opener = getOpenerElement();
+    if (opener) {
+      opener.focus();
+    } else {
+      const main = document.getElementById('kb-main') ?? document.getElementById('main');
+      main?.focus();
+    }
+  }, [location, navigate]);
+
+  const handleToggleFullScreen = useCallback((): void => {
+    if (mode === 'drawer') {
+      const resolvedProject = projectKey ?? (issueKey.split('-')[0] ?? 'KAN');
+      void navigate(toFullScreenPath(resolvedProject, issueKey));
+    } else {
+      void navigate(toPeekPath(location, issueKey));
+    }
+  }, [mode, projectKey, issueKey, location, navigate]);
+
+  useEffect(() => {
+    const unregister = registerShortcut(
+      'mod+shift+f',
+      (e) => {
+        e.preventDefault();
+        handleToggleFullScreen();
+      },
+      { allowInInputs: true },
+    );
+    return unregister;
+  }, [handleToggleFullScreen]);
+
+  useEffect(() => {
+    const handleGlobalEscape = (e: KeyboardEvent): void => {
+      if (e.key !== 'Escape') {
+        return;
+      }
+      // If an open popup or dialog exists inside, it handles Escape first
+      const hasOpenPopover = document.querySelector(
+        '[data-hint-open="true"], [role="dialog"].kb-hint-popup',
+      );
+      if (hasOpenPopover) {
+        return;
+      }
+      if (e.defaultPrevented) {
+        return;
+      }
+      e.preventDefault();
+      if (mode === 'full') {
+        void navigate(toPeekPath(location, issueKey));
+      } else {
+        handleClose();
+      }
+    };
+    window.addEventListener('keydown', handleGlobalEscape);
+    return () => {
+      window.removeEventListener('keydown', handleGlobalEscape);
+    };
+  }, [mode, issueKey, location, navigate, handleClose]);
+
+  const DescriptionSlot = slots.description;
+  const RailSlot = slots.rail;
+  const ActivitySlot = slots.activity;
+
+  const errorStatus =
+    error instanceof ApiProblem
+      ? error.status
+      : (error as { status?: number } | undefined)?.status;
+  const isNotFoundOrForbidden = errorStatus === 403 || errorStatus === 404;
+
+  const renderContent = (): JSX.Element => {
+    if (isLoading) {
+      return (
+        <>
+          <div className="surface__header">
+            <button
+              type="button"
+              className="issue-header__btn"
+              aria-label="Close issue panel"
+              onClick={handleClose}
+            >
+              <span aria-hidden="true" className="issue-header__glyph">→</span>
+            </button>
+            <span className="mono issue-header__key">{issueKey}</span>
+          </div>
+          <div className="surface__body">
+            <div className="surface__prose">
+              <div className="surface__skeleton">
+                <div className="surface__skeleton-line surface__skeleton-line--title" />
+                <div className="surface__skeleton-line surface__skeleton-line--body" />
+              </div>
+            </div>
+            <aside className="surface__rail" aria-label="Properties" />
+          </div>
+        </>
+      );
+    }
+
+    if (error) {
+      return (
+        <>
+          <div className="surface__header">
+            <button
+              type="button"
+              className="issue-header__btn"
+              aria-label="Close issue panel"
+              onClick={handleClose}
+            >
+              <span aria-hidden="true" className="issue-header__glyph">→</span>
+            </button>
+            <button
+              type="button"
+              className="issue-header__btn"
+              aria-label={mode === 'full' ? 'Return to side panel' : 'Open in full screen'}
+              aria-keyshortcuts="Meta+Shift+F Control+Shift+F"
+              onClick={handleToggleFullScreen}
+            >
+              <span aria-hidden="true" className="issue-header__glyph">↗</span>
+            </button>
+            <span className="mono issue-header__key">{issueKey}</span>
+          </div>
+          <div className="surface__body">
+            <div className="surface__prose">
+              <div className="surface__error" role="alert">
+                <p className="surface__error-message">
+                  {isNotFoundOrForbidden
+                    ? `Issue ${issueKey} was not found or you do not have access.`
+                    : `Could not load ${issueKey}.`}
+                </p>
+                {!isNotFoundOrForbidden && (
+                  <button
+                    type="button"
+                    className="surface__retry-btn"
+                    onClick={() => void refetch()}
+                  >
+                    Retry
+                  </button>
+                )}
+              </div>
+            </div>
+            <aside className="surface__rail" aria-label="Properties" />
+          </div>
+        </>
+      );
+    }
+
+    if (!issue) {
+      return <></>;
+    }
+    const currentIssue: IssueDetail = issue;
+
+    const proseBody = (
+      <>
+        <SummaryField issue={currentIssue} descriptionFocusRef={descRef} />
+        {DescriptionSlot ? (
+          <DescriptionSlot issue={currentIssue} focusRef={descRef} />
+        ) : (
+          <div
+            ref={descRef as React.RefObject<HTMLDivElement>}
+            tabIndex={0}
+            className="surface__description"
+          >
+            {currentIssue.description_markdown}
+          </div>
+        )}
+        {ActivitySlot && <ActivitySlot issue={currentIssue} />}
+      </>
+    );
+
+    return (
+      <>
+        <IssueHeader
+          issue={currentIssue}
+          mode={mode}
+          onClose={handleClose}
+          toggleFullScreen={handleToggleFullScreen}
+        />
+        <div className="surface__body">
+          <div className="surface__prose">
+            <div className="surface__prose-inner">{proseBody}</div>
+          </div>
+          <aside className="surface__rail" aria-label="Properties">
+            {RailSlot ? <RailSlot issue={currentIssue} /> : null}
+          </aside>
+        </div>
+      </>
+    );
+  };
+
+  if (mode === 'full') {
+    return (
+      <section
+        ref={rootRef}
+        className="surface--full"
+        aria-labelledby={`issue-summary-${issueKey}`}
+        tabIndex={-1}
+        data-mount-id={mountId}
+        data-mount-seq={mountSeq}
+      >
+        {renderContent()}
+      </section>
+    );
+  }
+
+  return (
+    <section
+      ref={rootRef}
+      className="surface--drawer"
+      role="dialog"
+      aria-modal={isMobile ? 'true' : 'false'}
+      aria-labelledby={`issue-summary-${issueKey}`}
+      tabIndex={-1}
+      data-mount-id={mountId}
+      data-mount-seq={mountSeq}
+    >
+      {renderContent()}
+    </section>
+  );
+}
+
+export function IssueSurface(): JSX.Element | null {
+  const { mode, issueKey, projectKey } = useIssueSurfaceRoute();
+
+  if (mode === null || issueKey === null) {
+    return null;
+  }
+
+  return (
+    <IssueSurfaceRoot
+      mode={mode}
+      issueKey={issueKey}
+      projectKey={projectKey}
+    />
+  );
+}
