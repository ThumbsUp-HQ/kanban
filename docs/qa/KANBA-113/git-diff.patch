+  background: var(--bg-hover, #2c313a);
+  color: var(--fg-primary, #f8fafc);
+}
+
+/* Tablet & Mobile Breakpoints */
+@media (max-width: 1279px) {
+  .kb-topbar-hamburger {
+    display: inline-flex;
+  }
+}
+
+@media (max-width: 767px) {
+  .kb-topbar {
+    padding: 0 16px;
+    gap: 8px;
+  }
+  .kb-search-trigger {
+    min-width: unset;
+    width: 44px;
+    height: 44px;
+    padding: 0;
+    justify-content: center;
+  }
+  .kb-search-trigger-text,
+  .kb-search-kbd {
+    display: none;
+  }
+}
