+def test_subprocess_cli_worker_execution() -> None:
+    """Verify python -m kanban.attachments.pdf child worker stdin/stdout protocol."""
+    # Successful execution
+    proc = subprocess.run(
+        [sys.executable, "-m", "kanban.attachments.pdf"],
+        input=SAMPLE_VALID_PDF,
+        capture_output=True,
+        check=False,
