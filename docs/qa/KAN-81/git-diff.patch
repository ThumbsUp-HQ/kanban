+import { describe, it, expect } from 'vitest';
+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import { PdfAttachmentCard, formatByteSize } from './PdfAttachmentCard';
+
+describe('PdfAttachmentCard', () => {
+  it('renders complete metadata including page count, size, and truncated SHA', () => {
+    render(
+      <PdfAttachmentCard
+        filename="system-architecture.pdf"
+        downloadUrl="/api/v1/attachments/att_12345"
+        byteSize={2_500_000}
+        pageCount={12}
+        sha256="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+      />,
+    );
+
+    expect(screen.getByText('system-architecture.pdf')).toBeDefined();
+    expect(screen.getByText('2.4 MB')).toBeDefined();
+    expect(screen.getByText('12 pages')).toBeDefined();
+    expect(screen.getByText('sha256:e3b0c442')).toBeDefined();
+
+    const link = screen.getByRole('link', { name: 'Download system-architecture.pdf' });
+    expect(link.getAttribute('href')).toBe('/api/v1/attachments/att_12345');
+    expect(link.getAttribute('download')).toBe('system-architecture.pdf');
+    expect(link.getAttribute('target')).toBe('_blank');
+    expect(link.getAttribute('rel')).toBe('noopener noreferrer');
+  });
+
+  it('renders singular 1 page correctly', () => {
+    render(
+      <PdfAttachmentCard
+        filename="single-page.pdf"
+        downloadUrl="/api/v1/attachments/att_999"
+        pageCount={1}
+        byteSize={512}
+      />,
+    );
+    expect(screen.getByText('1 page')).toBeDefined();
+    expect(screen.getByText('512 B')).toBeDefined();
+  });
+
+  it('handles formatByteSize boundary values', () => {
+    expect(formatByteSize(undefined)).toBe('');
+    expect(formatByteSize(0)).toBe('');
+    expect(formatByteSize(-10)).toBe('');
+    expect(formatByteSize(500)).toBe('500 B');
+    expect(formatByteSize(1024)).toBe('1.0 KB');
+    expect(formatByteSize(1024 * 1024 * 2)).toBe('2.0 MB');
+  });
+
+  it('renders gracefully when optional metadata is omitted', () => {
+    render(
+      <PdfAttachmentCard
+        filename="minimal.pdf"
+        downloadUrl="/api/v1/attachments/min"
+      />,
+    );
+    expect(screen.getByText('minimal.pdf')).toBeDefined();
+    expect(screen.queryByText(/page/i)).toBeNull();
+    expect(screen.queryByText(/sha256:/i)).toBeNull();
+  });
+});
diff --git a/kanban/web/src/features/activity/PdfAttachmentCard.tsx b/kanban/web/src/features/activity/PdfAttachmentCard.tsx
new file mode 100644
index 00000000..2b44cb91
--- /dev/null
+++ b/kanban/web/src/features/activity/PdfAttachmentCard.tsx
@@ -0,0 +1,87 @@
+/**
+ * PDF Attachment Card Component (KB-ATTACH-PDF-01, S5.4).
+ * Renders verified metadata for PDF attachments with zero-canvas forced-download UX.
+ */
+
+import React, { type JSX } from 'react';
+import './PdfAttachmentCard.css';
+
+export interface PdfAttachmentCardProps {
+  readonly filename: string;
+  readonly downloadUrl: string;
+  readonly byteSize?: number | undefined;
+  readonly pageCount?: number | null | undefined;
+  readonly sha256?: string | undefined;
+  readonly testId?: string | undefined;
+}
+
+export function formatByteSize(bytes: number | undefined): string {
+  if (bytes === undefined || bytes <= 0) {
+    return '';
+  }
+  if (bytes < 1024) {
+    return `${String(bytes)} B`;
+  }
+  if (bytes < 1024 * 1024) {
+    return `${(bytes / 1024).toFixed(1)} KB`;
+  }
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+}
+
+export function PdfAttachmentCard({
+  filename,
+  downloadUrl,
+  byteSize,
+  pageCount,
+  sha256,
+  testId = 'pdf-attachment-card',
+}: PdfAttachmentCardProps): JSX.Element {
+  const formattedSize = formatByteSize(byteSize);
+  const truncatedSha = sha256 ? sha256.replace(/^sha256:/i, '').slice(0, 8) : null;
+
+  return (
+    <span
+      className="kb-pdf-card"
+      data-testid={testId}
+      role="region"
+      aria-label={`PDF Attachment: ${filename}`}
+    >
+      <span className="kb-pdf-card__icon" aria-hidden="true">
+        <span>📄</span>
+      </span>
+      <span className="kb-pdf-card__details">
+        <span className="kb-pdf-card__filename" title={filename}>
+          {filename}
+        </span>
+        <span className="kb-pdf-card__meta">
+          {formattedSize ? (
+            <span className="kb-pdf-card__badge kb-pdf-card__size">{formattedSize}</span>
+          ) : null}
+          {pageCount && pageCount > 0 ? (
+            <span className="kb-pdf-card__badge kb-pdf-card__pages">
+              {String(pageCount)} {pageCount === 1 ? 'page' : 'pages'}
+            </span>
+          ) : null}
+          {truncatedSha && sha256 ? (
+            <span className="kb-pdf-card__badge kb-pdf-card__sha" title={`SHA-256: ${sha256}`}>
+              sha256:{truncatedSha}
+            </span>
+          ) : null}
+        </span>
+      </span>
+      <span className="kb-pdf-card__actions">
+        <a
+          href={downloadUrl}
+          download={filename}
+          className="kb-pdf-card__download"
+          target="_blank"
+          rel="noopener noreferrer"
+          aria-label={`Download ${filename}`}
+          data-testid={`${testId}-download`}
+        >
+          ⬇ Download
+        </a>
+      </span>
+    </span>
+  );
+}
