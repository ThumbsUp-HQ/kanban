++-            if ":" in stripped:
++-                k, v = stripped.split(":", 1)
++-                parsed[k.strip()] = v.lstrip()
++-        return parsed
++-
++-    async def read_json_body(self, timeout_seconds: float = 3.0) -> dict[str, Any]:
