++-+    code_s_plus_2 = totp_at(secret, (current_step + 2) * 30)
++-+
++-+    # Acceptance window [s-1, s+1] with last_accepted_step = 0
++-+    ok, step = verify_totp(secret, code_s_minus_1, last_accepted_step=0, timestamp=current_time)
++-+    assert ok is True
