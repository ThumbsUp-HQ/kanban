++-+            resulting_count,
++-+        ) = await _enforce_wip_limits(session, caller, issue, target_state, req)
++-+
++-+    # 7. Execute single-row mutation
++-+    old_rank = issue.board_rank
++-+    old_state_id = issue.state_id
