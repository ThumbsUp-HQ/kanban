++-                        return parsed
++-
++-                chunk = await self.body_queue.get()
++-                if chunk is None:
++-                    if self._buffer:
++-                        parsed = self._parse_frame(self._buffer)
++-                        self._buffer = ""
++-                        if parsed:
++-                            return parsed
++-                    return {}
++-                self._buffer += chunk.decode("utf-8")
++-
++-    @staticmethod
++-    def _parse_frame(frame: str) -> dict[str, str]:
++-        parsed: dict[str, str] = {}
