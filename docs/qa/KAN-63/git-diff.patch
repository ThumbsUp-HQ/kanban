+class _McpGatewaySigningTransport(httpx.AsyncBaseTransport):
+    """Wraps ASGITransport and signs requests bearing X-KB-Service-Principal: mcp-gateway."""
+
+    def __init__(self, inner: httpx.AsyncBaseTransport) -> None:
+        self._inner = inner
