+async def _count(env: ApiEnv, sql: str, **params: Any) -> int:  # noqa: ANN401
+    """Return a scalar count from the committed seed session."""
+    await env.seed.rollback()
+    return int((await env.seed.execute(text(sql), params)).scalar_one())
