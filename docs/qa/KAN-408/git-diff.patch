+@dataclass(frozen=True)
+class CompanionCertificates:
+    """Certificate bundle for local loopback companion servers."""
+
+    ca_cert_pem: str
+    ca_key_pem: str
+    server_cert_pem: str
+    server_key_pem: str
+    spki_sha256: str
