+                    event_type=ActivityEventType.ISSUE_RANK_MOVED,
+                    payload={"old_rank": "0|hzzzzz:", "new_rank": "0|i00000:"},
+                )
+                await session.commit()
+
+            # Drain outbox via relay
+            relay = OutboxRelay(
+                engine=pg_worker_db,
+                listen_dsn=str(pg_worker_db.url),
