++-+def test_eval_safe_formula_pow_and_mult_dos_bounds() -> None:
++-+    """Verify bounds on ast.Pow and ast.Mult preventing event loop DoS."""
++-+    ctx = {"issue": {"key": "KAN-1"}}
++-+
++-+    # ast.Pow bounds: exponent <= 64, abs(base) <= 1_000_000
