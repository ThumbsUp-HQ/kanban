+++    if issue_key is None and object_id is not None:
+++        stmt = (
+++            select(Issue.project_id, Issue.sequence_id, Project.identifier)
+++            .join(Project, Project.id == Issue.project_id)
+++            .where(Issue.id == object_id)
+++        )
