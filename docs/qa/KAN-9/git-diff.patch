+++    if object_id is not None:
+++        cached_issue = cast("Any", session.identity_map).get((Issue, (object_id,)))
+++        if cached_issue is not None:
+++            project_id = cached_issue.project_id
+++            seq_id = getattr(cached_issue, "sequence_id", None)
