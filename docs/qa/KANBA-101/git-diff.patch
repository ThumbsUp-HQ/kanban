+async def _make_link(  # noqa: PLR0913, PLR0917
+    seed: AsyncSession,
+    ws_id: uuid.UUID,
+    source_id: uuid.UUID,
+    source_key: str,
+    target_id: uuid.UUID,
+    target_key: str,
+    creator_id: uuid.UUID,
+    link_type: LinkKind = LinkKind.RELATES_TO,
+) -> uuid.UUID:
+    """Create an ACTIVE object_link directly in the seed session."""
+    link_id = uuid.uuid4()
+    link = ObjectLink(
+        id=link_id,
+        workspace_id=ws_id,
+        source_id=source_id,
+        source_type=ObjectKind.ISSUE,
+        target_id=target_id,
+        target_type=ObjectKind.ISSUE,
+        link_type=link_type,
+        link_state="ACTIVE",
+        source_key_snapshot=source_key,
+        target_key_snapshot=target_key,
+        created_by_id=creator_id,
+    )
+    seed.add(link)
+    await seed.commit()
+    return link_id
+
