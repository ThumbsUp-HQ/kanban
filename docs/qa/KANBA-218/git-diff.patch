+
+    // Empty drop
+    fireEvent.drop(dropzone, {
+      dataTransfer: {
+        files: [],
+      },
+    });
+
+    // File input with no files
+    const fileInput = screen.getByTestId('file-input');
+    fireEvent.change(fileInput, { target: { files: [] } });
+
+    const file = new File([JSON.stringify(sampleBundle)], 'export.json', {
