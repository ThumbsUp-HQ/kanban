+      <MemoryRouter initialEntries={['/admin/imports']}>
+        <PlaneImportStudio />
+      </MemoryRouter>,
+    );
+
+    const dropzone = screen.getByTestId('dropzone-area');
+    fireEvent.dragOver(dropzone);
+    expect(dropzone.className).toContain('kb-plane-dropzone-active');
