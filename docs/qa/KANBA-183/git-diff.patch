+          if (entry !== null && typeof entry === 'object') {
+            const p = (entry as Record<string, unknown>).path;
+            const m = (entry as Record<string, unknown>).message;
+            if (p !== undefined && m !== undefined) {
+              let pathStr = '';
+              if (Array.isArray(p)) {
+                pathStr = p
+                  .map((x) => (typeof x === 'string' ? x : typeof x === 'number' ? String(x) : ''))
