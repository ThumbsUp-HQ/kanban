+
+  const { data: modules = [], isLoading } = useQuery<ProjectModuleItem[]>({
+    queryKey: ['projects', key, 'modules'],
+    queryFn: async () => {
+      const res = await apiFetch('GET', '/api/v1/projects/{project_ref}/modules' as never, {
+        params: { project_ref: key },
