+
 export function ProjectModulesView(): JSX.Element {
   const { projectKey } = useParams<{ projectKey: string }>();
   const key = projectKey ?? 'KAN';
+  const queryClient = useQueryClient();
+
+  const [newName, setNewName] = useState('');
