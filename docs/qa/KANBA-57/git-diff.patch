+async def test_case_2_positive_rls_session_context_binding(
+    pg_worker_db: AsyncEngine,
+) -> None:
+    """Test Case 2: Route using get_rls_session observes current_setting('app.principal_id')."""
+    p_id = uuid.uuid4()
+    w_id = uuid.uuid4()
