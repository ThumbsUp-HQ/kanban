+@dataclass
+class _HydratedCandidate:
+    """Internal candidate representation across lexical, vector, and synaptic stages."""
+
+    id: uuid.UUID
+    kind: str
+    key: str | None
+    title: str
+    summary: str | None
+    body_markdown: str
