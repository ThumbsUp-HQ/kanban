+                id=uuid.uuid4(),
+                workspace_id=workspace_id,
+                project_id=project_id,
+                provider_config_id=provider_config_id,
+                period_kind=period_kind,
+                period_start=p_start,
+                token_cap=token_cap,
+                tokens_reserved=0,
+                tokens_used=0,
