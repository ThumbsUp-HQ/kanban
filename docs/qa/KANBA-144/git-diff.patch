+
+        future_stmt = select(AITokenLedger).where(
+            AITokenLedger.workspace_id == workspace_id,
+            AITokenLedger.provider_config_id == provider_config_id,
+            AITokenLedger.period_kind == period_kind,
+            AITokenLedger.period_start > p_start,
