+        fut_res = await self._session.execute(future_stmt)
+        for fut in fut_res.scalars().all():
+            if token_cap >= fut.tokens_used + fut.tokens_reserved:
+                fut.token_cap = token_cap
+
+        await self._session.flush()
+        return ledger
