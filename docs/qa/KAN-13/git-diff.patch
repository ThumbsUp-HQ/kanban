+  FencedCheck -->|No: Code Syntax| SyntaxPre[pre className="code-block"]
+\`\`\`
+
+All issue descriptions and comments now render live vector SVGs directly!`,
+  priority: {
+    slug: 'high',
+    label: 'High',
+    emoji: '⚡',
+    sort_order: 2,
+    sla_target: null,
+  },
+  state: {
+    id: 'state-in-progress',
