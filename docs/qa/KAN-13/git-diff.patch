+      expect(matches).toHaveLength(2);
+      expect(textarea.value).not.toContain(';');
+      expect(textarea.value).toBe(
+        '```mermaid\ngraph TD\n  A[Start] --> B[End]\n```\n\n```mermaid\ngraph TD\n  A[Start] --> B[End]\n```\n',
+      );
+    });
