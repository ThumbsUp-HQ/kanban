+        name: 'Primary Workspace',
+        slug: 'kanban',
+        is_current: true,
+      },
+    },
+    'GET /api/v1/projects': { json: [projectKan] },
+    'GET /api/v1/projects/KAN': { json: projectKan },
+    'GET /api/v1/projects/KAN/views': { json: [] },
