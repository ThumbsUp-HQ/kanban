+const rawProject = loadFixture<Record<string, unknown>>('project-kan');
+const projectKan = {
+  ...rawProject,
+  identifier: 'KAN',
+  capabilities: ['VIEW', 'COMMENT', 'EDIT', 'ADMIN'],
