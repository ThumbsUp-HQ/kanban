+def _parse_metadata_path(
+    path: str, default_surface: str = ""
+) -> tuple[str, str | None, str | None]:
+    """Parse surface, workspace_slug, and project_key from an RFC 9728 discovery path."""
+    prefix = "/.well-known/oauth-protected-resource"
+    if not path.startswith(prefix):
+        return default_surface or "agent", None, None
+
+    sub = path[len(prefix) :].strip("/")
+    parts = [p for p in sub.split("/") if p]
+    if parts and parts[0] == "mcp":
+        parts = parts[1:]
+
+    surface = default_surface
+    if parts and parts[0] in ("agent", "docs", "admin"):
+        surface = parts[0]
+        parts = parts[1:]
+    elif parts and parts[0] == "w":
+        surface = surface or "agent"
+    elif parts:
+        surface = parts[0]
+        parts = parts[1:]
+    else:
+        surface = surface or "agent"
+
+    workspace_slug: str | None = None
+    project_key: str | None = None
+    if parts and parts[0] == "w" and len(parts) >= 2:  # noqa: PLR2004
+        workspace_slug = parts[1]
+        if len(parts) >= 4 and parts[2] == "p":  # noqa: PLR2004
+            project_key = parts[3]
+
+    if not surface or surface == "mcp":
+        surface = "agent"
+
+    return surface, workspace_slug, project_key
