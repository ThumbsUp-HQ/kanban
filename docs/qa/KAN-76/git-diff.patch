-+        except ValueError:
-+            unclassified.append(path)
-+
-+    return {
-+        "total_routes": len(routes),
-+        "classified_counts": classified,
-+        "unclassified_routes": unclassified,
-+        "unprotected_admin_routes": assert_admin_routes_protected(app),
-+    }
