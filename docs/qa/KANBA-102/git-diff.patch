+
+    # Add comments on both issues
+    await client.post(
+        f"/api/v1/issues/{i1_key}/comments",
+        json={"body_markdown": "Comment on visible issue 1"},
+    )
+    await client.post(
+        f"/api/v1/issues/{i2_key}/comments",
+        json={"body_markdown": "Comment on hidden issue 2"},
