+    member = await make_user("member1", workspace_role="WORKSPACE_MEMBER")
+    _ = await make_project(
+        "ACTV", created_by=admin, roles={admin: "PROJECT_ADMIN", member: "MEMBER"}
+    )
+    client = as_principal(admin)
+
