+
+    c2_del_resp = await client.delete(f"/api/v1/comments/{c2_id}")
+    assert c2_del_resp.status_code == 204, c2_del_resp.text
+
+    # 4. History changes: update issue summary (ISSUE_FIELD_CHANGED)
+    iss_patch_resp = await client.patch(
