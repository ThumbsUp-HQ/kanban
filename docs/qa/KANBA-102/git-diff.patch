+        json={"summary": "Hidden Restricted Issue 2", "priority": "high"},
+    )
+    assert i2_resp.status_code == 201
+    i2_id = uuid.UUID(i2_resp.json()["id"])
+    i2_key = i2_resp.json()["key"]
+
+    # Explicit DENY VIEW on Issue 2 for reader
