+          {
+            id: '01a1e706-8146-7e4c-b3e0-0b1bd00d479b',
+            name: 'Platform Engineering',
+            slug: 'platform-eng',
+            is_current: true,
+          },
+        ],
+      },
+      'GET /api/v1/projects': {
+        json: {
+          items: [
+            {
+              key: 'KAN',
+              name: 'Kanban',
