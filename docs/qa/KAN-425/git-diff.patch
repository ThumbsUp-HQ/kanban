+        assert r_cf.status_code == 201
+        cf_data = r_cf.json()
+        cf_id = cf_data["id"]
+        manifest_sha = cf_data["manifest_sha256"]
+        results["w3_custom_field_created"] = cf_data
+
+        # B1. Live Test-Execute draft REST API endpoint
+        r_test_exec = await client.post(
