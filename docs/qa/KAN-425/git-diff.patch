+        }
+
+        const { container, unmount } = render(
+          <DocMarkdownViewer
+            content={chapter.content}
+          />,
+        );
+        const targetElement = resolveSectionElement(container, anchor);
+        expect(targetElement).not.toBeNull();
+        unmount();
+      }
+    });
