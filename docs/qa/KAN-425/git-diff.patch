+            "exit_code": cli_approve_proc.returncode,
+            "stdout": scrub_text(cli_approve_proc.stdout.strip()),
+        }
+
+        cli_veto_proc = subprocess.run(
+            [
+                "uv", "run", "--no-sync", "kanban-agent", "validate-transition",
