+async function applyTheme(page: Page, theme: 'light' | 'dark'): Promise<void> {
+  await page.evaluate((t: string) => {
+    localStorage.setItem('kb:theme', t);
+    document.documentElement.dataset.theme = t;
+  }, theme);
+  await page.waitForTimeout(100);
+}
