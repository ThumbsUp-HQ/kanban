+        assert r_fresh.status_code == 200
+        assert r_fresh.json()["status"] == "APPROVED"
+        results["w3_secondary_approved"] = r_fresh.json()
+
+        # === WORKOUT 4: Workflow Hooks + DryRun + Live Transition Gate + CLI Parity + Git Repo Binding ===
