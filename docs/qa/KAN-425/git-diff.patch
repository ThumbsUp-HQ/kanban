+                "--repo-path", ".",
+                "--provider", "fixture",
+                "--cassette", "tests/fixtures/ai/cli_codex_readonly_veto.yaml",
+                "--from-state", "In Review",
+                "--to-state", "Done",
+                "--require-approve",
+            ],
+            capture_output=True,
+            text=True,
