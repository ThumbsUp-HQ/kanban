+            ".venv/bin/python",
+            "-m",
+            "uvicorn",
+            "kanban.app:create_app",
+            "--factory",
+            "--host",
+            "127.0.0.1",
+            "--port",
+            "18418",
+            "--log-level",
+            "warning",
+        ],
+        env=env,
+        stdout=uv_log,
+        stderr=uv_log,
+    )
+
