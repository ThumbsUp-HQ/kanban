+        # Rejection under --require-approve exits with code 2
+        assert cli_veto_proc.returncode in (1, 2)
+        results["w4_cli_parity_veto"] = {
+            "exit_code": cli_veto_proc.returncode,
+            "stdout": scrub_text(cli_veto_proc.stdout.strip()),
