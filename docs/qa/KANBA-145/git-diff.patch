+@pytest.mark.asyncio
+async def test_proxy_coverage_branches(short_tmp_dir: Path) -> None:
+    """Cover edge cases: base_dir None, request_count, existing socket unlink, _http_client None, normalization mismatch."""
+    # 1. base_dir is None
