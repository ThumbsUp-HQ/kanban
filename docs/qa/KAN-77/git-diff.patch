+
+        created_issues_map: dict[str, uuid.UUID] = {}
+        pending_links: list[tuple[str, str, LinkKind]] = []
+        pending_comments: list[tuple[uuid.UUID, list[Any]]] = []
+
+        for item in raw_issues:
+            if not isinstance(item, dict):
