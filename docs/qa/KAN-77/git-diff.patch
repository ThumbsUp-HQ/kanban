+
+        def _resolve_user(raw_user: Any) -> tuple[uuid.UUID | None, str | None]:
+            if not raw_user:
+                return None, None
+            if isinstance(raw_user, dict):
+                user_id_str = str(
+                    raw_user.get("name")
