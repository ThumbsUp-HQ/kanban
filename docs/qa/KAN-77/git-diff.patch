+                    is_default=(s_group == "backlog"),
+                )
+                self.session.add(st)
+                states.append(st)
+            await self.session.flush()
+
+        states_by_group = {s.state_group: s.id for s in states}
+        states_by_name = {s.name.lower(): s.id for s in states}
