+      <path d="m6 9 6 6 6-6" />
+    </svg>
+  );
+}
+
+export function PriorityNoneIcon({ size, className, ...props }: IconProps): JSX.Element {
+  return (
+    <svg
+      width={size ?? 16}
+      height={size ?? 16}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={2}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      className={className}
+      aria-hidden="true"
+      {...props}
+    >
+      <line x1="5" y1="12" x2="19" y2="12" strokeDasharray="3 3" />
+    </svg>
+  );
+}
+
+export interface PriorityIconProps extends IconProps {
+  priority: 'urgent' | 'high' | 'medium' | 'low' | 'none' | (string & {});
+}
+
+export function PriorityIcon({ priority, ...props }: PriorityIconProps): JSX.Element {
+  const p = priority ? priority.toLowerCase() : 'none';
+  switch (p) {
+    case 'urgent':
+      return <PriorityUrgentIcon {...props} />;
+    case 'high':
+      return <PriorityHighIcon {...props} />;
+    case 'medium':
+      return <PriorityMediumIcon {...props} />;
+    case 'low':
+      return <PriorityLowIcon {...props} />;
+    case 'none':
+    default:
+      return <PriorityNoneIcon {...props} />;
+  }
+}
