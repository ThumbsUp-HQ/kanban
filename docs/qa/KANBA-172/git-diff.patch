+// SPDX-License-Identifier: MIT
+/**
+ * Zero-dependency SVG Icon Registry for 👍kanban (Lucide/Tabler-compatible pure SVG JSX).
+ * Strict CSP Invariant: Zero inline style attributes (style-src 'self').
+ * All icons use currentColor for seamless theme integration.
+ */
+
+import React, { type JSX } from 'react';
+
+export interface IconProps extends React.SVGAttributes<SVGElement> {
+  size?: number | string;
+  className?: string;
+}
+
+// ---------------------------------------------------------------------------
+// Priority Icons
+// ---------------------------------------------------------------------------
+
+export function PriorityUrgentIcon({ size, className, ...props }: IconProps): JSX.Element {
+  return (
+    <svg
+      width={size ?? 16}
+      height={size ?? 16}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={2}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      className={className}
+      aria-hidden="true"
+      {...props}
+    >
+      <path d="m18 15-6-6-6 6" />
+      <path d="m18 9-6-6-6 6" />
+    </svg>
+  );
+}
+
+export function PriorityHighIcon({ size, className, ...props }: IconProps): JSX.Element {
+  return (
+    <svg
