-+    IF p_doc IS NULL THEN
-+        RETURN FALSE;
-+    END IF;
-+    IF jsonb_typeof(p_doc) <> 'object' THEN
-+        RETURN FALSE;
-+    END IF;
-+    IF octet_length(p_doc::text) > 8192 THEN
-+        RETURN FALSE;
-+    END IF;
