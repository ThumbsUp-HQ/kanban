+
+/* Structured Format Metadata Editor */
+.custom-field-structured-metadata {
+  margin-bottom: 1rem;
+  padding: 0.75rem;
+  background: var(--bg-surface-raised, #f8fafc);
+  border: 1px solid var(--border-color, #e2e8f0);
+  border-radius: 6px;
+}
+
+.custom-field-structured-metadata-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 0.5rem;
+}
+
+.custom-field-structured-metadata-title {
+  font-size: 0.82rem;
+  font-weight: 600;
+  color: var(--text-primary, #0f172a);
+}
+
+.custom-field-structured-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+  gap: 0.75rem;
+}
+
+.custom-field-structured-field {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+}
+
+.custom-field-structured-field label {
+  font-size: 0.75rem;
+  font-weight: 500;
+  color: var(--text-secondary, #64748b);
+}
+
+.custom-field-structured-field--checkbox {
+  justify-content: flex-end;
+}
+
+.custom-field-btn--xs {
+  padding: 0.2rem 0.5rem;
+  font-size: 0.75rem;
+}
+
+.custom-field-raw-meta-collapsed {
+  display: none;
+}
+
+/* Flavor Guidance Callout */
+.custom-field-flavor-guidance {
+  margin-top: 0.35rem;
+}
+
+.custom-field-guidance-pill {
+  display: inline-block;
+  font-size: 0.75rem;
+  padding: 0.2rem 0.5rem;
+  border-radius: 4px;
+  background: var(--bg-surface-raised, #f1f5f9);
+  border: 1px solid var(--border-color, #cbd5e1);
+  color: var(--text-secondary, #475569);
+}
+
+/* Tamper Confirmation Digests */
+.custom-field-tamper-digests {
+  margin: 0.75rem 0;
+  padding: 0.5rem;
+  background: var(--bg-canvas, #f3f4f6);
+  border-radius: 4px;
+  border: 1px solid var(--border-color, #e5e7eb);
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+}
+
+.custom-field-tamper-digest-row {
+  display: flex;
+  flex-direction: column;
+  gap: 0.15rem;
+}
+
+.custom-field-tamper-label {
+  font-size: 0.72rem;
+  font-weight: 600;
+  color: var(--text-secondary, #6b7280);
+}
+
+.custom-field-tamper-code {
+  font-family: var(--font-mono, monospace);
+  font-size: 0.75rem;
+  word-break: break-all;
+  color: var(--text-primary, #111827);
+}
+
