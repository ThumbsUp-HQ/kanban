+  kanban/tests/workflows/test_workflow_hooks_api.py \
+  kanban/tests/workflows/test_dry_run.py \
+  --cov=kanban --cov-config=.tmp_coveragerc --cov-report=term-missing
+rm -f .tmp_coveragerc
