-    stored_b64 = base64.b64encode(stored_key).decode("ascii")
-    server_b64 = base64.b64encode(server_key).decode("ascii")
-
-    return f"SCRAM-SHA-256${iterations}:{salt_b64}${stored_b64}:{server_b64}"
