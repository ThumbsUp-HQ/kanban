+    assert embeddings[1] == [0.4, 0.5, 0.6]
+
+    # 4. Health probe positive and negative
+    # Positive: retrieve succeeds
+    mock_exchange_ok = {
+        "request": {"method": "GET", "path": "/v1/models/gpt-4o-mini"},
+        "response": {"status": 200, "json_body": {"id": "gpt-4o-mini", "object": "model"}},
