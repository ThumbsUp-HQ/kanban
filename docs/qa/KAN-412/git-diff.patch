+  color: var(--kb-color-text-secondary, #4b5563);
+  margin-bottom: var(--space-4, 16px);
+}
+
+[data-theme='dark'] .kb-budget-unlimited-note {
+  background-color: #111827;
+  border-color: #374151;
+  color: #9ca3af;
+}
+
