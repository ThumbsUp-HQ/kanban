+async function setupPageMocks(page: Page, airGapMode = false): Promise<void> {
+  await page.addInitScript(() => {
+    class MockWebSocket extends EventTarget {
+      readyState = 1;
+      url = '';
+      onopen: ((ev: Event) => void) | null = null;
+      onclose: ((ev: CloseEvent) => void) | null = null;
+      onerror: ((ev: Event) => void) | null = null;
+      onmessage: ((ev: MessageEvent) => void) | null = null;
+      constructor(url: string) {
+        super();
+        this.url = url;
+        setTimeout(() => {
+          this.readyState = 1;
+          if (this.onopen) this.onopen(new Event('open'));
+          this.dispatchEvent(new Event('open'));
+        }, 10);
+      }
+      send(_data?: unknown): void {
+        if (_data !== undefined) return;
+      }
+      close() {
+        this.readyState = 3;
+        if (this.onclose) this.onclose(new CloseEvent('close'));
+        this.dispatchEvent(new CloseEvent('close'));
+      }
+    }
+    // @ts-expect-error MockWebSocket replaces native window.WebSocket for tests
+    window.WebSocket = MockWebSocket;
+
+    class MockEventSource extends EventTarget {
+      readyState = 1;
+      url = '';
+      onopen: ((ev: Event) => void) | null = null;
+      onerror: ((ev: Event) => void) | null = null;
+      onmessage: ((ev: MessageEvent) => void) | null = null;
+      constructor(url: string) {
+        super();
+        this.url = url;
+        setTimeout(() => {
+          this.readyState = 1;
+          if (this.onopen) this.onopen(new Event('open'));
+          this.dispatchEvent(new Event('open'));
+        }, 10);
+      }
+      close() {
+        this.readyState = 2;
+      }
+    }
+    // @ts-expect-error MockEventSource replaces native window.EventSource for tests
+    window.EventSource = MockEventSource;
+  });
+  await mockApi(page, getMocks(airGapMode));
+  await page.route('**/ai-providers/budgets*', async (route) => {
+    const url = new URL(route.request().url());
+    const provId = url.searchParams.get('provider_config_id');
+    const matched = mockBudgets.filter((b) => !provId || b.provider_config_id === provId);
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(matched.length > 0 ? matched : [mockBudgets[0]]),
+    });
+  });
+}
