+  margin-top: var(--space-2, 8px);
+}
+
+.kb-provider-presets-label {
+  font-size: var(--text-xs, 12px);
+  font-weight: 600;
+  color: var(--kb-color-text-secondary, #6b7280);
+}
+
+.kb-preset-btn {
+  padding: 4px 10px;
+  font-size: var(--text-xs, 12px);
+  border-radius: var(--radius-sm, 6px);
+  cursor: pointer;
+}
+
