+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--space-2, 8px);
+  margin-bottom: var(--space-3, 12px);
+}
+
+.kb-budget-presets-label {
+  font-size: var(--text-xs, 12px);
+  font-weight: 600;
+  color: var(--kb-color-text-secondary, #6b7280);
+}
+
+.kb-budget-preset-btn {
+  padding: 4px 8px;
+  font-size: var(--text-xs, 12px);
+  border-radius: var(--radius-sm, 6px);
+  cursor: pointer;
+}
+
+.kb-budget-preset-btn--freeze {
+  color: var(--danger-fg, #ef4444);
+}
+
