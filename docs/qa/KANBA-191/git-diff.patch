+# -----------------------------------------------------------------------------
+# Case 3: Boundary & Integration
+# -----------------------------------------------------------------------------
+def test_configure_logging_integration(caplog: pytest.LogCaptureFixture) -> None:
+    """Verify configure_logging configures root and package loggers while preserving caplog."""
+    stream = io.StringIO()
