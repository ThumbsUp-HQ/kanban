+
+    # Reset air_gap_mode
+    async with app.state.session_factory.session(admin_ctx) as s:
+        ws_settings = await s.get(WorkspaceSettings, admin.workspace_id)
+        if ws_settings:
+            ws_settings.air_gap_mode = False
+            await s.commit()
