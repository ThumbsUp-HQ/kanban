+
+describe('KANBA-226 Accessibility & WCAG 2.2 AA Conformance Suite', () => {
+  let queryClient: QueryClient;
+
+  beforeEach(() => {
+    queryClient = new QueryClient({
+      defaultOptions: { queries: { retry: false } },
+    });
+    setOpenerElement(null);
+  });
+
+  afterEach(() => {
+    queryClient.clear();
+    setOpenerElement(null);
+  });
+
+  describe('1. Cyclic Focus Traps and aria-modal="true" on Modals & Drawers', () => {
+    it('QuickCreateIssueModal enforces role="dialog", aria-modal="true", and cyclic Tab / Shift+Tab focus trap', async () => {
+      const onClose = vi.fn();
+      const onCreate = vi.fn();
+
+      const { container } = render(
+        <QuickCreateIssueModal
+          isOpen={true}
+          onClose={onClose}
+          onCreate={onCreate}
+          projectKey="KAN"
+        />
+      );
+
+      const dialog = container.querySelector('[role="dialog"]');
+      expect(dialog).toBeDefined();
+      expect(dialog?.getAttribute('aria-modal')).toBe('true');
+
+      // Find focusable elements
+      const closeBtn = screen.getByRole('button', { name: 'Close modal' });
+      const cancelBtn = screen.getByRole('button', { name: 'Cancel' });
+
+      // Focus last focusable (cancel button) and press Tab -> cycles to first focusable (close button)
+      cancelBtn.focus();
+      expect(document.activeElement).toBe(cancelBtn);
+
+      const tabEvent = new KeyboardEvent('keydown', {
+        key: 'Tab',
+        bubbles: true,
+        cancelable: true,
+      });
+      document.dispatchEvent(tabEvent);
+      expect(document.activeElement).toBe(closeBtn);
+
+      // Shift+Tab from closeBtn cycles back to last element (cancelBtn)
+      closeBtn.focus();
+      expect(document.activeElement).toBe(closeBtn);
+
+      const shiftTabEvent = new KeyboardEvent('keydown', {
+        key: 'Tab',
+        shiftKey: true,
+        bubbles: true,
+        cancelable: true,
+      });
+      document.dispatchEvent(shiftTabEvent);
+      expect(document.activeElement).toBe(cancelBtn);
+    });
+
+    it('AccessInspectorPopover enforces role="dialog", aria-modal="true", and cyclic focus trap', async () => {
+      const onClose = vi.fn();
+
+      const { container } = render(
+        <QueryClientProvider client={queryClient}>
+          <AccessInspectorPopover
+            objectId="11111111-1111-1111-1111-111111111111"
+            onClose={onClose}
+          />
+        </QueryClientProvider>
+      );
+
+      const dialog = container.querySelector('[role="dialog"]');
+      expect(dialog).toBeDefined();
+      expect(dialog?.getAttribute('aria-modal')).toBe('true');
+
+      const closeBtn = screen.getByRole('button', { name: 'Close Access Inspector' });
+      closeBtn.focus();
+      expect(document.activeElement).toBe(closeBtn);
+
+      // Press Shift+Tab on first element -> cycles within dialog
+      const shiftTabEvent = new KeyboardEvent('keydown', {
+        key: 'Tab',
+        shiftKey: true,
+        bubbles: true,
+        cancelable: true,
+      });
+      document.dispatchEvent(shiftTabEvent);
+      expect(dialog?.contains(document.activeElement)).toBe(true);
+    });
