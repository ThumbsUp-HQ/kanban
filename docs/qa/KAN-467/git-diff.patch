diff --git a/kanban/web/src/features/reports/__tests__/ReportExportModal.test.tsx b/kanban/web/src/features/reports/__tests__/ReportExportModal.test.tsx
index 343d7111..d1c8376d 100644
--- a/kanban/web/src/features/reports/__tests__/ReportExportModal.test.tsx
