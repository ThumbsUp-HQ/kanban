+      console.log('Current URL:', page.url());
+      console.log('Body HTML preview:', (await page.locator('body').innerHTML()).slice(0, 500));
+
+      await page.screenshot({
+        path: path.join(OUT_DIR, '05-tablet-oauth-governance-studio.png'),
