+            "VALUES (:id, 'USER', :ws_id, 'Member User', 'ACTIVE')"
+        ),
+        {"id": member_id, "ws_id": ws_id},
+    )
+    await session.execute(
+        text(
+            "INSERT INTO users (id, object_type, principal_type, workspace_id, email) "
+            "VALUES (:id, 'user', 'USER', :ws_id, 'member@example.com')"
