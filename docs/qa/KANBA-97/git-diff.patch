+            text("SELECT count(*) FROM webauthn_credentials WHERE id = :id"),
+            {"id": non_admin_cred_id},
+        )
+        assert count.scalar_one() == 0
+
+        # 11c. delete_credential without workspace_id
+        non_admin_cred_id2 = uuid.uuid4()
+        await session.execute(
+            text(
