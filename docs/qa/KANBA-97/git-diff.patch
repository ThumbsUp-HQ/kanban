+                    event_type=ActivityEventType.WEBAUTHN_DELETED,
+                    payload={"credential_id": str(credential_id)},
+                )
+            except Exception:
+                logger.debug("Failed to record WEBAUTHN_DELETED activity", exc_info=True)
