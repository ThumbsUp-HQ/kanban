+            principal_id=cred_row["principal_id"],
+            credential_id=cred_row["credential_id"],
+            public_key=cred_row["public_key"],
+            sign_count=new_sign_count,
+            aaguid=cred_row["aaguid"],
+            transports=list(cred_row["transports"] or []),
