+                session_id=sess_id,
+                principal_id=p_id,
+                credential_payload={"response": {"clientDataJSON": "bm90LWpzb24"}},  # "not-json"
+            )
+        assert exc.value.status == 401
+
+        # 5. verify_registration: non-existent challenge in database (already consumed or missing)
