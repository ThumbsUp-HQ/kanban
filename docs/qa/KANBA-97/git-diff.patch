+
+        # 10c. verify_authentication: suspect clone already flagged
+        cred_uuid = uuid.uuid4()
+        raw_cred_bytes = b"k" * 32
+        raw_cred_b64 = base64.urlsafe_b64encode(raw_cred_bytes).decode().rstrip("=")
+        await session.execute(
