+            credential_id=non_admin_cred_id2,
+            is_admin=False,
+            workspace_id=None,
+        )
+        count2 = await session.execute(
+            text("SELECT count(*) FROM webauthn_credentials WHERE id = :id"),
+            {"id": non_admin_cred_id2},
+        )
+        assert count2.scalar_one() == 0
