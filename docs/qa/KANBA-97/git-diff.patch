+            await svc.verify_authentication(
+                session,
+                session_id=sess_id,
+                principal_id=p_id,
+                credential_payload={"response": {"clientDataJSON": "bm90LWpzb24"}},
+            )
+        assert exc.value.status == 401
+
+        # 8b. verify_authentication: missing challenge in clientDataJSON
+        no_chal_auth = (
