+        # 15. Delete card successfully -> 204
+        await service.delete_card(
+            sess, "oidc-to-delete", confirm_slug="oidc-to-delete", actor_id=admin_id
+        )
+        deleted = await service._resolve_card(sess, "oidc-to-delete")
+        assert deleted is None
