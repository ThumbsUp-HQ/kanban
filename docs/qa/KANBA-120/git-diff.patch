+async def _setup_admin_principal(session: AsyncSession, ws_id: uuid.UUID) -> uuid.UUID:
+    """Provision a SERVER_ADMIN principal with role bindings and AAL2 session context."""
+    u_id = uuid.uuid4()
+    await session.execute(
+        text(
