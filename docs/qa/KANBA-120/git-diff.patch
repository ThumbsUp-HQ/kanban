+        # Check allowed_email_domains bound
+        if len(data.allowed_email_domains) > MAX_ALLOWED_EMAIL_DOMAINS:
+            raise ProblemException(
+                code="INVALID_EMAIL_DOMAINS",
+                status=422,
+                title="Invalid Email Domains",
