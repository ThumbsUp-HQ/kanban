+        clean_domains = [d.strip().lower() for d in data.allowed_email_domains if d.strip()]
+
+        # Generate unique card ID
+        card_id = uuid.uuid4()
+
+        # Determine sort_rank
+        if data.sort_rank is None or not data.sort_rank.strip():
+            existing = await admin_list(session)
