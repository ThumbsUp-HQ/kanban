+/**
+ * About 👍kanban Page Styling (KB-ABOUT-SBOM, KAN-34).
+ * Strictly compliant with Content-Security-Policy style-src 'self'.
+ * Zero inline style attributes, 100% canonical CSS tokens.
+ */
+
+.kb-about-container {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6);
+  padding: var(--space-6);
+  max-width: 1200px;
+  margin: 0 auto;
+  width: 100%;
+}
+
+.kb-about-loading,
+.kb-about-error {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: var(--space-12);
+  color: var(--fg-muted);
+  font-size: var(--text-base);
+}
+
+.kb-about-error {
+  color: var(--danger-fg);
+}
+
+/* Hero Section */
+.kb-about-hero {
+  background: var(--bg-surface);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg);
+  padding: var(--space-8);
