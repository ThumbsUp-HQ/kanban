+                filteredComponents.map((c) => (
+                  <tr key={`${c.ecosystem}-${c.name}-${c.version}`}>
+                    <td className="kb-about-pkg-name">{c.name}</td>
+                    <td className="kb-about-pkg-version">{c.version}</td>
+                    <td>{c.ecosystem}</td>
+                    <td>{c.license}</td>
+                    <td>
