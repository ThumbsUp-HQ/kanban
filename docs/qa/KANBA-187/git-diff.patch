+  color: var(--fg-primary);
+  font-size: var(--text-sm);
+  outline: none;
+}
+
+.kb-personal-settings-input:focus,
+.kb-personal-settings-select:focus {
+  border-color: var(--focus-ring);
+  box-shadow: 0 0 0 var(--focus-ring-w) var(--focus-ring);
