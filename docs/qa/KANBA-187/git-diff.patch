+
+.kb-personal-settings-btn-primary:hover:not(:disabled) {
+  opacity: 0.9;
+}
+
+.kb-personal-settings-btn-secondary {
+  border-color: var(--border-subtle);
+  background-color: transparent;
+  color: var(--fg-primary);
+}
+
+.kb-personal-settings-btn-secondary:hover:not(:disabled) {
+  background-color: var(--bg-hover);
+}
+
+.kb-personal-settings-btn-danger {
+  border-color: var(--danger-fg);
+  color: var(--danger-fg);
+  background-color: transparent;
+}
+
+.kb-personal-settings-btn-danger:hover:not(:disabled) {
+  background-color: var(--danger-bg);
+}
+
+.kb-personal-settings-btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+.kb-personal-settings-password-wrapper {
+  position: relative;
+  display: flex;
+  align-items: center;
+}
+
+.kb-personal-settings-password-input {
+  width: 100%;
+  padding-right: 48px;
+}
+
+.kb-personal-settings-toggle-pw {
+  position: absolute;
+  right: 8px;
+  background: transparent;
+  border: none;
+  color: var(--fg-secondary);
+  cursor: pointer;
+  padding: 4px 8px;
+  font-size: var(--text-xs);
+  border-radius: var(--radius-sm);
+}
+
+.kb-personal-settings-toggle-pw:hover {
+  color: var(--fg-primary);
+}
+
+.kb-personal-settings-status-box {
+  display: flex;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+  margin-bottom: var(--space-4);
+}
+
+.kb-personal-settings-stat-card {
+  flex: 1;
+  min-width: 180px;
+  padding: 16px;
+  background-color: var(--bg-canvas);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md);
+}
+
+.kb-personal-settings-stat-num {
+  font-size: var(--text-2xl);
+  font-weight: 700;
+  color: var(--fg-primary);
+  margin-bottom: 4px;
+}
+
+.kb-personal-settings-stat-label {
+  font-size: var(--text-xs);
+  color: var(--fg-secondary);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.kb-personal-settings-table {
+  width: 100%;
+  border-collapse: collapse;
+  text-align: left;
+  margin-top: var(--space-3);
+}
+
+.kb-personal-settings-th {
+  padding: 10px 12px;
+  border-bottom: 1px solid var(--border-subtle);
+  color: var(--fg-secondary);
+  font-size: var(--text-xs);
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.kb-personal-settings-td {
+  padding: 12px;
+  border-bottom: 1px solid var(--border-subtle);
+  font-size: var(--text-sm);
+  color: var(--fg-primary);
+}
+
+.kb-personal-settings-modal-backdrop {
+  position: fixed;
+  inset: 0;
+  background-color: var(--scrim-bg);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 1000;
+  padding: var(--space-4);
+}
+
+.kb-personal-settings-modal {
+  background-color: var(--bg-surface);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg);
+  width: 100%;
+  max-width: 520px;
+  box-shadow: var(--shadow-xl);
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+}
+
+.kb-personal-settings-modal-header {
+  padding: 16px 20px;
+  border-bottom: 1px solid var(--border-subtle);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.kb-personal-settings-modal-title {
+  margin: 0;
+  font-size: var(--text-lg);
+  font-weight: 600;
+  color: var(--fg-primary);
+}
+
+.kb-personal-settings-modal-body {
+  padding: 20px;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+
+.kb-personal-settings-modal-footer {
+  padding: 16px 20px;
+  border-top: 1px solid var(--border-subtle);
+  display: flex;
+  justify-content: flex-end;
+  gap: var(--space-2);
+}
+
+.kb-personal-settings-recovery-grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 8px;
+  background-color: var(--bg-canvas);
+  padding: 12px;
+  border-radius: var(--radius-md);
+  font-family: var(--font-mono);
+  font-size: var(--text-sm);
+  margin-top: var(--space-2);
+}
+
+.kb-personal-settings-recovery-item {
+  color: var(--fg-primary);
+  user-select: all;
+}
diff --git a/kanban/web/src/features/settings/PersonalSettingsPage.tsx b/kanban/web/src/features/settings/PersonalSettingsPage.tsx
