+    assert "outbound" in parsed_142["links"]
+    assert "truncated" not in parsed_142["links"]
+    assert parsed_142["links"]["outbound"][0]["link_type"] == "RELATES_TO"
+    assert parsed_142["links"]["outbound"][0]["target"]["key"] == "KAN-150"
