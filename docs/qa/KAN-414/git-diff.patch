++                    writer.write(_make_search_done(msg_id, RESULT_CODE_SUCCESS))
++                    await writer.drain()
++
++                elif op_name == "extendedReq":
++                    oid = str(op_val["requestName"])
++                    if oid == STARTTLS_OID:
++                        writer.write(_make_extended_response(msg_id, RESULT_CODE_SUCCESS))
++                        await writer.drain()
