+    await bind_ctx(db_session, admin, ws)
+
+    # 4a: Updating original_created_by_id raises CREATOR_PROVENANCE_IMMUTABLE
+    with pytest.raises((IntegrityError, DBAPIError)) as exc_orig:
+        async with db_session.begin_nested():
