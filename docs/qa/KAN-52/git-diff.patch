+  const sorted = [...issues].sort((a, b) => {
+    let cmp = 0;
+    switch (sortBy) {
+      case 'updated': {
+        const aUp = a.updated_at ?? '';
+        const bUp = b.updated_at ?? '';
+        cmp = aUp.localeCompare(bUp);
+        break;
+      }
+      case 'created': {
+        const aCr = a.created_at ?? '';
+        const bCr = b.created_at ?? '';
+        cmp = aCr.localeCompare(bCr);
+        break;
