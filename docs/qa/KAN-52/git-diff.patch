+  align-items: center;
+  gap: 4px;
+  margin-left: auto;
+}
+
+.issue-navigator-position {
+  font-family: var(--font-mono, monospace);
+  font-size: 12px;
+  color: var(--fg-muted, #94a3b8);
+  margin-right: 4px;
+  white-space: nowrap;
+}
+
+.issue-prev-btn,
