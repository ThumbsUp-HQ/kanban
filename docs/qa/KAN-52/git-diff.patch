+        break;
+      }
+      case 'state': {
+        const orderA = a.state.sort_order ?? 999;
+        const orderB = b.state.sort_order ?? 999;
+        cmp = orderA - orderB;
+        if (cmp === 0) {
+          cmp = a.state.name.localeCompare(b.state.name);
+        }
+        break;
+      }
+      case 'key': {
+        cmp = parseIssueNumber(a.key) - parseIssueNumber(b.key);
