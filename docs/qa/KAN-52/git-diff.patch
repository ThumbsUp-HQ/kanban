+        break;
+      }
+      case 'rank': {
+        const rA = a.board_rank ?? '';
+        const rB = b.board_rank ?? '';
+        cmp = rA.localeCompare(rB);
+        break;
+      }
+      default:
+        cmp = 0;
+    }
+    return sortDir === 'asc' ? cmp : -cmp;
+  });
+  return sorted;
