+/* ==========================================================================
+   Master-Detail Issue View Canvas (KAN-52 Problem 3)
+   ========================================================================== */
+
+.split-header-breadcrumb {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--fg-secondary, #cbd5e1);
+}
+
+.split-header-pager {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  margin-left: auto;
+}
+
+.issue-navigator-position {
+  font-family: var(--font-mono, monospace);
+  font-size: 12px;
+  color: var(--fg-muted, #94a3b8);
+  margin-right: 4px;
+  white-space: nowrap;
+}
+
+.issue-prev-btn,
+.issue-next-btn {
+  width: 24px;
+  height: 24px;
+  min-width: 24px;
+  min-height: 24px;
+  padding: 0;
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--border-subtle, #333842);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--fg-secondary, #cbd5e1);
+  font-size: 11px;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  transition: all 120ms ease;
+}
+
+.issue-prev-btn:hover:not(:disabled),
+.issue-next-btn:hover:not(:disabled) {
+  background: var(--bg-hover, #2c313a);
+  color: var(--fg-primary, #f8fafc);
+}
+
+.issue-prev-btn:disabled,
+.issue-next-btn:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+.split-summary-title {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--fg-primary, #f8fafc);
+  margin: var(--space-2, 8px) 0;
+  line-height: 1.3;
+  cursor: pointer;
+}
+
+.split-summary-input {
+  width: 100%;
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--fg-primary, #f8fafc);
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--accent-primary);
+  border-radius: var(--radius-sm, 4px);
+  padding: 4px 8px;
+  margin: var(--space-2, 8px) 0;
+  box-sizing: border-box;
+}
+
+.split-action-toolbar {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+  padding: 8px var(--space-4, 16px);
+  background: var(--bg-surface-raised, #24272f);
+  border-bottom: 1px solid var(--border-subtle, #333842);
+  flex-wrap: wrap;
+}
+
+.split-toolbar-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  height: 28px;
+  padding: 0 10px;
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--border-subtle, #333842);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--fg-secondary, #cbd5e1);
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 120ms ease;
+}
+
+.split-toolbar-btn:hover {
+  background: var(--bg-hover, #2c313a);
+  color: var(--fg-primary, #f8fafc);
+}
