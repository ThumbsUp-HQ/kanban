+import { describe, it, expect } from 'vitest';
+import { matchesIssueQuery } from './predicateParser';
+import type { IssueItem } from './viewsApi';
+
+describe('predicateParser (KAN-52)', () => {
+  const mockIssue: IssueItem = {
+    id: '11111111-1111-1111-1111-111111111111',
+    key: 'KAN-101',
+    summary: 'Fix mars rover antenna connection',
+    description_markdown: 'Detailed report on mars rover communication loss.',
+    state: { id: 'state-todo', name: 'Todo', group: 'unstarted' },
+    priority: { slug: 'high', label: 'High' },
+    cycle_id: 'cycle-1',
+    cycle: { id: 'cycle-1', name: 'Sprint 1' },
+    module_ids: ['mod-1'],
+    modules: [{ id: 'mod-1', name: 'Rover Telemetry' }],
+    labels: [{ id: 'lbl-1', name: 'hardware', color_hex: '#ff0000' }],
+    assignees: [
+      {
+        id: 'asg-1',
+        kind: 'principal',
+        principal: {
+          id: 'u-1',
+          handle: 'alice',
+          display_name: 'Alice Smith',
+          type: 'USER',
+        },
+      },
+    ],
+  };
+
+  it('matches empty query to true', () => {
+    expect(matchesIssueQuery('', mockIssue, 'KAN')).toBe(true);
+    expect(matchesIssueQuery('   ', mockIssue, 'KAN')).toBe(true);
+  });
+
+  it('matches structured SQL/JQL queries with AND and equal operators', () => {
+    expect(
+      matchesIssueQuery('project = "KAN" AND status = "Todo"', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('project = "KAN" AND priority = "high"', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('assignee = "alice" AND label = "hardware"', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('cycle = "Sprint 1" AND module = "Rover Telemetry"', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('key = "KAN-101"', mockIssue, 'KAN'),
+    ).toBe(true);
+
+    // Negative matches
+    expect(
+      matchesIssueQuery('project = "OTHER" AND status = "Todo"', mockIssue, 'KAN'),
+    ).toBe(false);
+    expect(
+      matchesIssueQuery('status = "Done"', mockIssue, 'KAN'),
+    ).toBe(false);
+    expect(
+      matchesIssueQuery('priority = "low"', mockIssue, 'KAN'),
+    ).toBe(false);
+    expect(
+      matchesIssueQuery('assignee = "bob"', mockIssue, 'KAN'),
+    ).toBe(false);
+    expect(
+      matchesIssueQuery('label = "software"', mockIssue, 'KAN'),
+    ).toBe(false);
+  });
+
+  it('matches token-based queries like state:started priority:high "mars"', () => {
+    expect(
+      matchesIssueQuery('priority:high "mars"', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('status:todo priority:high', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('state:unstarted antenna', mockIssue, 'KAN'),
+    ).toBe(true);
+    expect(
+      matchesIssueQuery('assignee:alice mars', mockIssue, 'KAN'),
+    ).toBe(true);
+
+    // Negative matches
+    expect(
+      matchesIssueQuery('priority:urgent "mars"', mockIssue, 'KAN'),
+    ).toBe(false);
+    expect(
+      matchesIssueQuery('state:completed mars', mockIssue, 'KAN'),
+    ).toBe(false);
+    expect(
+      matchesIssueQuery('jupiter', mockIssue, 'KAN'),
+    ).toBe(false);
+  });
+
+  it('handles edge cases for unassigned, no-cycle, and free text assignee', () => {
+    const unassignedIssue: IssueItem = {
+      ...mockIssue,
+      assignees: [],
+      cycle_id: null,
+      cycle: null,
+    };
+    expect(matchesIssueQuery('assignee:unassigned', unassignedIssue, 'KAN')).toBe(true);
+    expect(matchesIssueQuery('assignee = "unassigned"', unassignedIssue, 'KAN')).toBe(true);
+    expect(matchesIssueQuery('cycle = "none"', unassignedIssue, 'KAN')).toBe(true);
+
+    const freeTextIssue: IssueItem = {
+      ...mockIssue,
+      assignees: [
+        {
+          id: 'asg-2',
+          kind: 'free_text',
+          free_text: 'contractor@example.com',
+          notify: false,
+          hint: 'External',
+        },
+      ],
+    };
+    expect(matchesIssueQuery('assignee:contractor', freeTextIssue, 'KAN')).toBe(true);
+  });
+});
diff --git a/kanban/web/src/features/views/predicateParser.ts b/kanban/web/src/features/views/predicateParser.ts
new file mode 100644
index 00000000..f6188152
--- /dev/null
+++ b/kanban/web/src/features/views/predicateParser.ts
@@ -0,0 +1,173 @@
+/**
+ * Predicate parser for Issue Navigator Query Mode (KAN-52).
+ * Supports structured SQL/JQL predicates (e.g. project = "KAN" AND status = "Todo")
+ * and token predicates (e.g. state:started priority:high "mars").
+ */
+
+import type { IssueItem } from './viewsApi';
+
+function stripQuotes(str: string): string {
+  const trimmed = str.trim();
+  if (
+    (trimmed.startsWith('"') && trimmed.endsWith('"')) ||
+    (trimmed.startsWith("'") && trimmed.endsWith("'"))
+  ) {
+    return trimmed.slice(1, -1);
+  }
+  return trimmed;
+}
+
+export function matchesIssueQuery(
+  rawQuery: string,
+  issue: IssueItem,
+  projectKey: string = issue.key.split('-')[0] ?? '',
+): boolean {
+  const query = rawQuery.trim();
+  if (!query) {
+    return true;
+  }
+
+  // Check if query uses JQL / SQL style "AND" clauses or "=" operators
+  if (/\s+AND\s+/i.test(query) || query.includes('=')) {
+    const clauses = query.split(/\s+AND\s+/i);
+    return clauses.every((clause) => {
+      const trimmedClause = clause.trim();
+      if (!trimmedClause) return true;
+
+      const equalMatch = /^([a-zA-Z0-9_]+)\s*=\s*(.+)$/.exec(trimmedClause);
+      if (equalMatch) {
+        const field = equalMatch[1]?.toLowerCase();
+        const rawVal = stripQuotes(equalMatch[2] ?? '');
+        return matchesFieldValue(field, rawVal, issue, projectKey);
+      }
+
+      // Fallback: tokenize clause
+      return matchesTokens(trimmedClause, issue, projectKey);
+    });
+  }
+
+  // Token-based predicate mode: e.g. state:started priority:high "mars"
+  return matchesTokens(query, issue, projectKey);
+}
+
+function matchesFieldValue(
+  field: string | undefined,
+  val: string,
+  issue: IssueItem,
+  projectKey: string,
+): boolean {
+  if (!field) return true;
+  const targetVal = val.toLowerCase().trim();
+
+  switch (field) {
+    case 'project': {
+      const pKey = projectKey.toLowerCase();
+      const issuePKey = issue.key.split('-')[0]?.toLowerCase() ?? '';
+      return pKey === targetVal || issuePKey === targetVal;
+    }
+    case 'status':
+    case 'state': {
+      const sName = issue.state.name.toLowerCase();
+      const sGroup = issue.state.group.toLowerCase();
+      const sId = issue.state.id.toLowerCase();
+      return (
+        sName === targetVal ||
+        sGroup === targetVal ||
+        sId === targetVal ||
+        sName.includes(targetVal)
+      );
+    }
+    case 'priority': {
+      const pSlug = issue.priority.slug.toLowerCase();
+      const pLabel = issue.priority.label.toLowerCase();
+      return pSlug === targetVal || pLabel === targetVal;
+    }
+    case 'assignee': {
+      if (targetVal === 'unassigned') {
+        return !issue.assignees || issue.assignees.length === 0;
+      }
+      return (issue.assignees ?? []).some((a) => {
+        if (a.kind === 'principal') {
+          return (
+            a.principal.handle.toLowerCase() === targetVal ||
+            a.principal.display_name.toLowerCase().includes(targetVal) ||
+            a.principal.id === targetVal
+          );
+        }
+        return a.free_text.toLowerCase().includes(targetVal);
+      });
+    }
+    case 'label': {
+      return (issue.labels ?? []).some(
+        (l) =>
+          l.name.toLowerCase() === targetVal ||
+          l.id === targetVal ||
+          l.name.toLowerCase().includes(targetVal),
+      );
+    }
+    case 'cycle': {
+      if (!issue.cycle_id) return targetVal === 'none' || targetVal === 'no-cycle';
+      return (
+        issue.cycle_id.toLowerCase() === targetVal ||
+        (issue.cycle?.name ?? '').toLowerCase().includes(targetVal)
+      );
+    }
+    case 'module': {
+      const mods = issue.modules ?? [];
+      const modIds = issue.module_ids ?? [];
+      return (
+        mods.some((m) => m.name.toLowerCase().includes(targetVal) || m.id === targetVal) ||
+        modIds.some((id) => id.toLowerCase() === targetVal)
+      );
+    }
+    case 'key': {
+      return issue.key.toLowerCase() === targetVal;
+    }
+    default: {
+      // General field check
+      return (
+        issue.summary.toLowerCase().includes(targetVal) ||
+        issue.key.toLowerCase().includes(targetVal)
+      );
+    }
+  }
+}
+
+function matchesTokens(
+  tokenString: string,
+  issue: IssueItem,
+  projectKey: string,
+): boolean {
+  // Regex to match key:value, quoted strings "...", or regular words
+  const regex = /([a-zA-Z0-9_]+):(".*?"|'.*?'|[^\s]+)|"([^"]+)"|'([^']+)'|([^\s]+)/g;
+  let match: RegExpExecArray | null;
+  const tokens: { field?: string; value: string }[] = [];
+
+  while ((match = regex.exec(tokenString)) !== null) {
+    if (match[1] && match[2]) {
+      tokens.push({
+        field: match[1].toLowerCase(),
+        value: stripQuotes(match[2]),
+      });
+    } else if (match[3]) {
+      tokens.push({ value: match[3] });
+    } else if (match[4]) {
+      tokens.push({ value: match[4] });
+    } else if (match[5]) {
+      tokens.push({ value: match[5] });
+    }
+  }
+
+  if (tokens.length === 0) return true;
+
+  return tokens.every((token) => {
+    if (token.field) {
+      return matchesFieldValue(token.field, token.value, issue, projectKey);
+    }
+    const word = token.value.toLowerCase();
+    const matchesSummary = issue.summary.toLowerCase().includes(word);
+    const matchesKey = issue.key.toLowerCase().includes(word);
+    const matchesDesc = (issue.description_markdown ?? '').toLowerCase().includes(word);
+    return matchesSummary || matchesKey || matchesDesc;
+  });
+}
