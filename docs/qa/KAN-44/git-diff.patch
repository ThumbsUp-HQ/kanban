+.split-assign-to-me-btn:hover,
+.split-git-branch-copy:hover {
+  background: var(--bg-hover, #2c313a);
+}
+
+.split-dates-list {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  font-size: 12px;
+}
+
+.split-date-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.split-date-label {
+  color: var(--fg-muted, #94a3b8);
+}
+
+.split-date-val {
+  color: var(--fg-secondary, #cbd5e1);
+  font-family: var(--font-mono, monospace);
+}
+
+.split-breadcrumb {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--fg-secondary, #cbd5e1);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 240px;
+}
+
+.split-pager {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.issue-navigator-position {
+  font-size: 12px;
+  font-family: var(--font-mono, monospace);
+  color: var(--fg-muted, #94a3b8);
+}
+
+.issue-pager-btn {
+  font-size: 12px;
+  padding: 2px 6px;
+}
+
+.surface__body--split {
+  display: block;
+  overflow-y: auto;
+  flex: 1 1 auto;
+}
+
+.split-body-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 280px;
+  height: 100%;
+}
+
+@media (max-width: 900px) {
+  .split-body-grid {
+    grid-template-columns: 1fr;
+    height: auto;
+    min-height: 100%;
+  }
+
+  .split-main-col {
+    overflow-y: visible;
+  }
+}
+
+@media (max-width: 768px) {
+  .split-action-toolbar {
+    padding: 8px 12px;
+    gap: 8px;
+  }
+
+  .split-toolbar-btn {
+    min-height: 44px;
+    height: 44px;
+    padding: 0 12px;
+    font-size: 13px;
+  }
+
+  .split-state-select {
+    min-height: 44px;
+    height: 44px;
+    padding: 0 10px;
+    font-size: 13px;
+  }
+
+  /* Hide redundant duplicate state selects in split view on mobile */
+  .surface__header--split .header-state-select {
+    display: none;
+  }
+
+  .surface--split .split-side-col [data-testid="quick-props-state-select"] {
+    display: none;
+  }
+
+  .surface__header--split {
+    flex-wrap: wrap;
+    gap: 8px;
+    padding: 8px 12px;
+  }
+}
+
+.split-main-col {
+  padding: var(--space-4, 16px);
+  overflow-y: auto;
+}
+
+.split-empty-hint {
+  font-size: 12px;
+  color: var(--fg-muted, #94a3b8);
+  margin: 0;
+}
+
+.split-subissues-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.split-subissue-item {
+  font-size: 12px;
+  color: var(--fg-primary, #f8fafc);
+}
+
+.split-assignee-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: 13px;
+  color: var(--fg-primary, #f8fafc);
+}
+
