+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--fg-primary, #f8fafc);
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--accent-primary);
+  border-radius: var(--radius-sm, 4px);
+  padding: 4px 8px;
+  margin: var(--space-2, 8px) 0;
+  box-sizing: border-box;
+}
+
+.split-action-toolbar {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+  padding: 8px var(--space-4, 16px);
+  background: var(--bg-surface-raised, #24272f);
+  border-bottom: 1px solid var(--border-subtle, #333842);
+  flex-wrap: wrap;
+}
+
+.split-toolbar-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  height: 28px;
+  padding: 0 10px;
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--border-subtle, #333842);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--fg-secondary, #cbd5e1);
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 120ms ease;
+}
+
+.split-toolbar-btn:hover {
+  background: var(--bg-hover, #2c313a);
+  color: var(--fg-primary, #f8fafc);
+}
+
+.split-toolbar-btn--fav-active {
+  color: var(--text-warning, #fbbf24);
+  border-color: var(--border-warning, #fbbf24);
+}
+
+.split-state-select {
+  height: 28px;
+  padding: 0 8px;
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--border-subtle, #333842);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--fg-primary, #f8fafc);
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+  outline: none;
+}
+
+.split-state-select:focus {
+  border-color: var(--accent-primary);
+}
+
+.split-section {
+  margin-bottom: var(--space-4, 16px);
+  background: var(--bg-surface, #1e2025);
+  border: 1px solid var(--border-subtle, #333842);
+  border-radius: var(--radius-md, 6px);
+  overflow: hidden;
+}
+
+.split-section > summary {
+  padding: 8px var(--space-3, 12px);
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--fg-secondary, #cbd5e1);
+  background: var(--bg-surface-raised, #24272f);
+  cursor: pointer;
+  user-select: none;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  border-bottom: 1px solid var(--border-subtle, #333842);
+}
+
+.split-section-body {
+  padding: var(--space-3, 12px);
+}
+
+.split-right-column {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4, 16px);
+  padding: var(--space-4, 16px);
+  border-left: 1px solid var(--border-subtle, #333842);
+  background: var(--bg-surface, #1e2025);
+  overflow-y: auto;
+}
+
+.split-sidebar-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2, 8px);
+}
+
+.split-sidebar-card-title {
+  font-size: 11px;
+  font-weight: 600;
+  color: var(--fg-muted, #94a3b8);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.split-assign-to-me-btn {
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+.split-assign-to-me-btn,
+.split-git-branch-copy {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 6px 10px;
+  background: var(--bg-surface-raised, #24272f);
+  border: 1px solid var(--border-subtle, #333842);
+  border-radius: var(--radius-sm, 4px);
+  color: var(--fg-primary, #f8fafc);
+  font-size: 12px;
+  cursor: pointer;
+  transition: all 120ms ease;
+}
+
+.split-assign-to-me-btn:hover,
+.split-git-branch-copy:hover {
+  background: var(--bg-hover, #2c313a);
+}
+
+.split-dates-list {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  font-size: 12px;
+}
+
+.split-date-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.split-date-label {
+  color: var(--fg-muted, #94a3b8);
+}
+
+.split-date-val {
+  color: var(--fg-secondary, #cbd5e1);
+  font-family: var(--font-mono, monospace);
+}
+
+.split-breadcrumb {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--fg-secondary, #cbd5e1);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 240px;
+}
+
+.split-pager {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.issue-navigator-position {
+  font-size: 12px;
+  font-family: var(--font-mono, monospace);
+  color: var(--fg-muted, #94a3b8);
+}
+
+.issue-pager-btn {
+  font-size: 12px;
+  padding: 2px 6px;
+}
+
+.surface__body--split {
+  display: block;
+  overflow-y: auto;
+  flex: 1 1 auto;
+}
+
+.split-body-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 280px;
+  height: 100%;
+}
+
+@media (max-width: 900px) {
+  .split-body-grid {
+    grid-template-columns: 1fr;
+    height: auto;
+    min-height: 100%;
+  }
+
+  .split-main-col {
+    overflow-y: visible;
+  }
+}
+
+@media (max-width: 768px) {
+  .split-action-toolbar {
+    padding: 8px 12px;
+    gap: 8px;
+  }
+
+  .split-toolbar-btn {
+    min-height: 44px;
+    height: 44px;
+    padding: 0 12px;
+    font-size: 13px;
+  }
+
+  .split-state-select {
+    min-height: 44px;
+    height: 44px;
+    padding: 0 10px;
+    font-size: 13px;
+  }
+
+  /* Hide redundant duplicate state selects in split view on mobile */
+  .surface__header--split .header-state-select {
+    display: none;
+  }
+
+  .surface--split [data-testid="split-section-details"] [data-testid="quick-props-state-select"] {
+    display: none;
+  }
+
+  .surface--split [data-testid="split-section-details"] .quick-props__group:has([data-testid="quick-props-state-select"]) {
+    display: none;
+  }
+
+  .surface__header--split {
+    flex-wrap: wrap;
+    gap: 8px;
+    padding: 8px 12px;
+  }
+}
+
+.split-main-col {
+  padding: var(--space-4, 16px);
+  overflow-y: auto;
+}
+
+.split-empty-hint {
+  font-size: 12px;
+  color: var(--fg-muted, #94a3b8);
+  margin: 0;
+}
+
+.split-subissues-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.split-subissue-item {
+  font-size: 12px;
+  color: var(--fg-primary, #f8fafc);
+}
+
+.split-assignee-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: 13px;
+  color: var(--fg-primary, #f8fafc);
+}
+
+
 
