+                "list_cycles",
+                "create_cycle",
+                "update_cycle",
+                "start_cycle",
+                "complete_cycle",
+                "rollover",
+                "list_modules",
+                "create_module",
+                "update_module",
+                "list_views",
+                "create_view",
+                "update_view",
+                "help",
+            ],
+            "description": "Operation to perform on cycles, modules, or saved views",
+        },
+        "project": {
+            "type": "string",
+            "description": "Project identifier or UUID (required except for help)",
+        },
+        "cycle": {
+            "type": "string",
+            "description": "Cycle name or UUID (for update, start, complete, rollover)",
+        },
+        "target_cycle": {
