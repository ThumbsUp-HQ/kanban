@@ -0,0 +1,62 @@
+/**
+ * Unit Tests for Mermaid Theme Sync (KB-P3-47, S5.3).
+ */
+
+import { describe, it, expect } from 'vitest';
+import {
+  readMermaidThemeTokens,
+  getMermaidThemeKey,
+  DEFAULT_LIGHT_THEME_TOKENS,
+  DEFAULT_DARK_THEME_TOKENS,
+} from './mermaidTheme';
+
+describe('mermaidTheme', () => {
+  it('reads default light theme tokens when no CSS variables are set', () => {
+    const tokens = readMermaidThemeTokens();
+    expect(tokens.bgSurface).toBe('#ffffff');
+    expect(tokens.fgPrimary).toBe('#111827');
+    expect(tokens.borderStrong).toBe('#d1d5db');
+    expect(tokens.accentPrimary).toBe('#1d4ed8');
+  });
+
+  it('reads custom CSS variables set on documentElement', () => {
+    document.documentElement.style.setProperty('--bg-surface', '#16181d');
+    document.documentElement.style.setProperty('--fg-primary', '#f9fafb');
+    document.documentElement.style.setProperty('--border-strong', '#3f4756');
+    document.documentElement.style.setProperty('--accent-primary', '#3b82f6');
+
+    try {
+      const tokens = readMermaidThemeTokens();
+      expect(tokens.bgSurface).toBe('#16181d');
+      expect(tokens.fgPrimary).toBe('#f9fafb');
+      expect(tokens.borderStrong).toBe('#3f4756');
+      expect(tokens.accentPrimary).toBe('#3b82f6');
+    } finally {
+      document.documentElement.style.removeProperty('--bg-surface');
+      document.documentElement.style.removeProperty('--fg-primary');
+      document.documentElement.style.removeProperty('--border-strong');
+      document.documentElement.style.removeProperty('--accent-primary');
+    }
+  });
+
+  it('generates stable theme keys', () => {
+    const keyLight = getMermaidThemeKey(DEFAULT_LIGHT_THEME_TOKENS);
+    const keyDark = getMermaidThemeKey(DEFAULT_DARK_THEME_TOKENS);
+
+    expect(keyLight).toBe('#ffffff|#111827|#d1d5db|#1d4ed8');
+    expect(keyDark).toBe('#16181d|#f9fafb|#3f4756|#1d4ed8');
+    expect(keyLight).not.toBe(keyDark);
+  });
+
+  it('falls back to default tokens when window or document is undefined', () => {
+    const origWindow = global.window;
+    try {
+      // @ts-expect-error test environment fallback
+      delete global.window;
+      const tokens = readMermaidThemeTokens();
+      expect(tokens).toEqual(DEFAULT_LIGHT_THEME_TOKENS);
+    } finally {
+      global.window = origWindow;
+    }
+  });
+});
diff --git a/kanban/web/src/editor/mermaid/mermaidTheme.ts b/kanban/web/src/editor/mermaid/mermaidTheme.ts
new file mode 100644
index 0000000..ece8b1d
--- /dev/null
+++ b/kanban/web/src/editor/mermaid/mermaidTheme.ts
@@ -0,0 +1,56 @@
+/**
+ * Mermaid Theme Sync (KB-P3-47, S5.3).
+ * Extracts resolved semantic CSS tokens (--bg-surface, --fg-primary,
+ * --border-strong, --accent-primary) from document.documentElement
+ * for passing to beautiful-mermaid renderer in Web Worker.
+ */
+
+export interface MermaidThemeTokens {
+  readonly bgSurface: string;
+  readonly fgPrimary: string;
+  readonly borderStrong: string;
+  readonly accentPrimary: string;
+}
+
+export const DEFAULT_LIGHT_THEME_TOKENS: MermaidThemeTokens = Object.freeze({
+  bgSurface: '#ffffff',
+  fgPrimary: '#111827',
+  borderStrong: '#d1d5db',
+  accentPrimary: '#1d4ed8',
+});
+
+export const DEFAULT_DARK_THEME_TOKENS: MermaidThemeTokens = Object.freeze({
+  bgSurface: '#16181d',
+  fgPrimary: '#f9fafb',
+  borderStrong: '#3f4756',
+  accentPrimary: '#1d4ed8',
+});
+
+/**
+ * Reads resolved semantic CSS tokens from document root.
+ */
+export function readMermaidThemeTokens(): MermaidThemeTokens {
+  if (typeof document === 'undefined' || typeof window === 'undefined') {
+    return DEFAULT_LIGHT_THEME_TOKENS;
+  }
+
+  const computed = window.getComputedStyle(document.documentElement);
+  const bgSurface = computed.getPropertyValue('--bg-surface').trim() || DEFAULT_LIGHT_THEME_TOKENS.bgSurface;
+  const fgPrimary = computed.getPropertyValue('--fg-primary').trim() || DEFAULT_LIGHT_THEME_TOKENS.fgPrimary;
+  const borderStrong = computed.getPropertyValue('--border-strong').trim() || DEFAULT_LIGHT_THEME_TOKENS.borderStrong;
+  const accentPrimary = computed.getPropertyValue('--accent-primary').trim() || DEFAULT_LIGHT_THEME_TOKENS.accentPrimary;
+
+  return {
+    bgSurface,
+    fgPrimary,
+    borderStrong,
+    accentPrimary,
+  };
+}
+
+/**
+ * Returns a stable string key representing the theme tokens for cache indexing.
+ */
+export function getMermaidThemeKey(tokens: MermaidThemeTokens): string {
+  return `${tokens.bgSurface}|${tokens.fgPrimary}|${tokens.borderStrong}|${tokens.accentPrimary}`;
+}
