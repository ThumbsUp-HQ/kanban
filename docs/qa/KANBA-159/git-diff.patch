+"""End-to-end tests for RunnerDaemon: mTLS loopback, TLS 1.3, revocation & cancel (KB-P5-22b)."""
+# ruff: noqa: SLF001, S106, ANN401, ARG001, ARG002, ARG005, PLC0415, RUF059, T201, PLR0915
+
+from __future__ import annotations
