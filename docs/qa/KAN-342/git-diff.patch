+  align-items: center;
+  gap: 8px;
+  padding: 10px 12px;
+  border-radius: var(--radius-md, 8px);
+  border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.1));
+  background: var(--bg-surface-raised, rgba(0, 0, 0, 0.02));
+  color: var(--fg-primary, #0f172a);
+  font-size: 0.875rem;
+  font-weight: 500;
+  cursor: pointer;
+  text-align: left;
+  transition: all 120ms ease;
+}
+
+.touch-reorder-state-option:hover {
+  border-color: var(--accent-primary, #3b82f6);
+  background: var(--bg-surface, #ffffff);
+}
+
+.touch-reorder-state-option--selected {
+  border-color: var(--accent-primary, #3b82f6);
+  background: rgba(59, 130, 246, 0.08);
+  color: var(--accent-primary, #3b82f6);
+  font-weight: 600;
+}
+
+.touch-reorder-state-glyph {
+  font-size: 0.875rem;
+  line-height: 1;
+}
+
+.touch-reorder-current-tag {
+  font-size: 0.6875rem;
+  color: var(--fg-muted, #94a3b8);
+  margin-left: auto;
+}
+
+.touch-reorder-rank-options {
+  display: flex;
+  gap: 8px;
+}
+
+.touch-reorder-rank-btn {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 10px 12px;
+  border-radius: var(--radius-md, 8px);
+  border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.1));
+  background: var(--bg-surface-raised, rgba(0, 0, 0, 0.02));
+  color: var(--fg-primary, #0f172a);
+  font-size: 0.875rem;
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 120ms ease;
+}
+
+.touch-reorder-rank-btn:hover {
+  border-color: var(--accent-primary, #3b82f6);
+  background: var(--bg-surface, #ffffff);
+}
+
+.touch-reorder-rank-btn--active {
+  border-color: var(--accent-primary, #3b82f6);
+  background: rgba(59, 130, 246, 0.08);
+  color: var(--accent-primary, #3b82f6);
+  font-weight: 600;
+}
+
+.touch-reorder-actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 10px;
+  padding: 14px 20px;
+  border-top: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.08));
+  background: var(--bg-surface-raised, rgba(0, 0, 0, 0.02));
+}
+
+.touch-reorder-cancel-btn {
+  padding: 8px 16px;
+  border-radius: var(--radius-md, 6px);
+  border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.15));
+  background: var(--bg-surface, #ffffff);
+  color: var(--fg-secondary, #64748b);
+  font-size: 0.875rem;
+  font-weight: 500;
+  cursor: pointer;
+}
+
+.touch-reorder-cancel-btn:hover {
+  background: var(--bg-surface-raised, rgba(0, 0, 0, 0.05));
+  color: var(--fg-primary, #0f172a);
+}
+
+.touch-reorder-apply-btn {
+  padding: 8px 18px;
+  border-radius: var(--radius-md, 6px);
+  border: 1px solid transparent;
+  background: var(--accent-primary, #3b82f6);
+  color: #ffffff;
+  font-size: 0.875rem;
+  font-weight: 500;
+  cursor: pointer;
+  transition: background-color 120ms ease;
+}
+
+.touch-reorder-apply-btn:hover {
+  filter: brightness(1.08);
+}
diff --git a/kanban/web/src/features/views/useTouchDragSensor.ts b/kanban/web/src/features/views/useTouchDragSensor.ts
new file mode 100644
index 00000000..d3715ea6
--- /dev/null
+++ b/kanban/web/src/features/views/useTouchDragSensor.ts
@@ -0,0 +1,149 @@
+import { useCallback, useRef, useState, type TouchEvent as ReactTouchEvent } from 'react';
+
+export interface UseTouchDragSensorOptions {
+  delay?: number; // default: 200ms
+  tolerance?: number; // default: 8px
+  onLongPress?: () => void;
+  onCancel?: () => void;
+}
+
+export interface TouchCoords {
+  x: number;
+  y: number;
+}
+
+export interface UseTouchDragSensorResult {
+  isTouchLifted: boolean;
+  isScrolling: boolean;
+  isScrollingRef: React.RefObject<boolean>;
+  touchHandlers: {
+    onTouchStart: (e: ReactTouchEvent<HTMLElement>) => void;
+    onTouchMove: (e: ReactTouchEvent<HTMLElement>) => void;
+    onTouchEnd: (e: ReactTouchEvent<HTMLElement>) => void;
+    onTouchCancel: (e: ReactTouchEvent<HTMLElement>) => void;
+  };
+  cancelTouch: () => void;
+}
+
+/**
+ * Tuned touch gesture sensor for Pragmatic DnD mobile ergonomics (KAN-342).
+ *
+ * Threshold:
+ * - delay: 200ms
+ * - tolerance: 8px
+ *
+ * If movement delta exceeds 8px within 200ms, gesture is classified as a standard
+ * touch scroll and drag activation is cancelled.
+ * If finger remains stationary within 8px for >= 200ms, long-press activates visual
+ * lift and haptic feedback.
+ */
+export function useTouchDragSensor({
+  delay = 200,
+  tolerance = 8,
+  onLongPress,
+  onCancel,
+}: UseTouchDragSensorOptions = {}): UseTouchDragSensorResult {
+  const [isTouchLifted, setIsTouchLifted] = useState(false);
+  const [isScrolling, setIsScrolling] = useState(false);
+
+  const startCoordsRef = useRef<TouchCoords | null>(null);
+  const timerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const isScrollingRef = useRef<boolean>(false);
+  const isLiftedRef = useRef<boolean>(false);
+
+  const clearTimer = useCallback(() => {
+    if (timerRef.current !== null) {
+      clearTimeout(timerRef.current);
+      timerRef.current = null;
+    }
+  }, []);
+
+  const cancelTouch = useCallback(() => {
+    clearTimer();
+    startCoordsRef.current = null;
+    isScrollingRef.current = false;
+    isLiftedRef.current = false;
+    setIsTouchLifted(false);
+    setIsScrolling(false);
+    onCancel?.();
+  }, [clearTimer, onCancel]);
+
+  const onTouchStart = useCallback(
+    (e: ReactTouchEvent<HTMLElement>) => {
+      const touch = e.touches[0];
+      if (e.touches.length !== 1 || !touch) {
+        cancelTouch();
+        return;
+      }
+
+      startCoordsRef.current = { x: touch.clientX, y: touch.clientY };
+      isScrollingRef.current = false;
+      setIsScrolling(false);
+
+      clearTimer();
+      timerRef.current = setTimeout(() => {
+        isLiftedRef.current = true;
+        setIsTouchLifted(true);
+        if (typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function') {
+          try {
+            navigator.vibrate(50);
+          } catch {
+            // Ignore unsupported platform errors
+          }
+        }
+        onLongPress?.();
+      }, delay);
+    },
+    [delay, clearTimer, cancelTouch, onLongPress],
+  );
+
+  const onTouchMove = useCallback(
+    (e: ReactTouchEvent<HTMLElement>) => {
+      const touch = e.touches[0];
+      if (!startCoordsRef.current || !touch) return;
+
+      const deltaX = Math.abs(touch.clientX - startCoordsRef.current.x);
+      const deltaY = Math.abs(touch.clientY - startCoordsRef.current.y);
+      const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
+
+      if (distance > tolerance) {
+        // Standard touch scroll gesture detected: cancel long-press activation
+        clearTimer();
+        isScrollingRef.current = true;
+        setIsScrolling(true);
+        if (isLiftedRef.current) {
+          isLiftedRef.current = false;
+          setIsTouchLifted(false);
+        }
+        onCancel?.();
+      }
+    },
+    [tolerance, clearTimer, onCancel],
+  );
+
+  const onTouchEnd = useCallback(() => {
+    clearTimer();
+    startCoordsRef.current = null;
+    isScrollingRef.current = false;
+    isLiftedRef.current = false;
+    setIsTouchLifted(false);
+    setIsScrolling(false);
+  }, [clearTimer]);
+
+  const onTouchCancel = useCallback(() => {
+    cancelTouch();
+  }, [cancelTouch]);
+
+  return {
+    isTouchLifted,
+    isScrolling,
+    isScrollingRef,
+    touchHandlers: {
+      onTouchStart,
+      onTouchMove,
+      onTouchEnd,
+      onTouchCancel,
+    },
+    cancelTouch,
+  };
+}
