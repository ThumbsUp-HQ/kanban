{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "ticket": "KAN-36",
  "description": "Contract sample for KAN-36 (KB-P3-PENTEST-01 / CWE-613): Session persistence and TTL preservation across workspace switch, non-cookie session rejection, and issue PATCH/GET ETag parity",
  "contracts": {
    "workspace_switch_non_persistent": {
      "name": "Workspace switch with is_persistent=false",
      "description": "Ensures that switching active workspaces preserves is_persistent=false, omits Max-Age/Expires on session cookies, and clears fallback cookies over HTTPS",
      "request": {
        "method": "POST",
        "url": "/api/v1/workspaces/ef3d354c-aa4c-4255-a4eb-2de60ce888da/switch",
        "headers": {
          "Cookie": "__Host-kb_session=kb_sess_tok_abc123; __Host-kb_csrf=csrf_secret_xyz789",
          "X-CSRF-Token": "csrf_secret_xyz789"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Set-Cookie": [
            "__Host-kb_session=kb_sess_tok_new456; Path=/; Secure; HttpOnly; SameSite=Lax",
            "__Host-kb_csrf=csrf_secret_new012; Path=/; Secure; SameSite=Lax",
            "kb_session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; SameSite=Lax",
            "kb_csrf=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax"
          ]
        },
        "body": {
          "workspace_id": "ef3d354c-aa4c-4255-a4eb-2de60ce888da",
          "status": "switched",
          "session_persisted": false
        },
        "session_state": {
          "is_persistent": false,
          "rotated_from_id": "018d40a2-bf39-7164-9a8c-6878b273b189",
          "absolute_expires_at": "2026-11-21T12:00:00.000000Z",
          "idle_expires_at": "2026-11-20T12:30:00.000000Z",
          "aal_level": 2,
          "aal2_verified_at": "2026-11-20T11:40:00.000000Z",
          "mfa_pending": false
        }
      }
    },
    "workspace_switch_non_cookie_caller_rejected": {
      "name": "Workspace switch rejection for non-cookie caller",
      "description": "Rejects callers lacking a valid browser cookie session with 401 SESSION_REQUIRED before any cookies are minted",
      "request": {
        "method": "POST",
        "url": "/api/v1/workspaces/ef3d354c-aa4c-4255-a4eb-2de60ce888da/switch",
        "headers": {
          "Authorization": "Bearer kb_token_mcp_scoped_abc"
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "body": {
          "type": "https://errors.kanban.dev/session-required",
          "title": "Session Required",
          "status": 401,
          "detail": "A valid browser session is required to switch workspaces via cookie",
          "code": "SESSION_REQUIRED"
        }
      }
    },
    "issue_patch_and_get_etag_parity": {
      "name": "Issue PATCH and immediate GET ETag parity",
      "description": "Guarantees that PATCH response ETag header and body.etag exactly match subsequent GET ETag header and body.etag with zero drift",
      "patch_exchange": {
        "request": {
          "method": "PATCH",
          "url": "/api/v1/issues/KANBA-10",
          "headers": {
            "Content-Type": "application/json",
            "If-Match": "\"2026-11-20T11:00:00.000000Z:0:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          },
          "body": {
            "summary": "Hardened Workspace Switch Session Persistence"
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": "application/json",
            "ETag": "\"2026-11-20T12:00:00.000000Z:1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          },
          "body": {
            "key": "KANBA-10",
            "summary": "Hardened Workspace Switch Session Persistence",
            "etag": "\"2026-11-20T12:00:00.000000Z:1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          }
        }
      },
      "get_exchange": {
        "request": {
          "method": "GET",
          "url": "/api/v1/issues/KANBA-10",
          "headers": {}
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": "application/json",
            "ETag": "\"2026-11-20T12:00:00.000000Z:1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          },
          "body": {
            "key": "KANBA-10",
            "summary": "Hardened Workspace Switch Session Persistence",
            "etag": "\"2026-11-20T12:00:00.000000Z:1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          }
        }
      },
      "parity_verified": true
    },
    "issue_workflow_transition_dual_etag_acceptance": {
      "name": "Transition engine accepts both composite ETag and legacy SHA-256 in If-Match",
      "composite_etag_request": {
        "method": "POST",
        "url": "/api/v1/issues/KANBA-10/transitions",
        "headers": {
          "Content-Type": "application/json",
          "If-Match": "\"2026-11-20T12:00:00.000000Z:1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
        },
        "body": {
          "to_state": "In Progress"
        },
        "response": {
          "status": 200,
          "headers": {
            "ETag": "\"2026-11-20T12:05:00.000000Z:2:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          },
          "body": {
            "key": "KANBA-10",
            "state": "In Progress",
            "etag": "\"2026-11-20T12:05:00.000000Z:2:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          }
        }
      },
      "legacy_sha256_request": {
        "method": "POST",
        "url": "/api/v1/issues/KANBA-10/transitions",
        "headers": {
          "Content-Type": "application/json",
          "If-Match": "\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
        },
        "body": {
          "to_state": "Done"
        },
        "response": {
          "status": 200,
          "headers": {
            "ETag": "\"2026-11-20T12:10:00.000000Z:3:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          },
          "body": {
            "key": "KANBA-10",
            "state": "Done",
            "etag": "\"2026-11-20T12:10:00.000000Z:3:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""
          }
        }
      }
    }
  }
}
