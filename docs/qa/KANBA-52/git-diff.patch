+    creator = user_id or uuid.uuid4()
+    row = await session.execute(
+        text(
+            "SELECT register_object("
+            "  CAST(:obj_type AS object_kind), :ws_id, :proj_id, :canonical_key, :title, :user_id"
+            ")"
+        ),
+        {
+            "obj_type": obj_type,
+            "ws_id": ws_id,
+            "proj_id": project_id,
+            "canonical_key": canonical_key,
+            "title": title,
+            "user_id": creator,
