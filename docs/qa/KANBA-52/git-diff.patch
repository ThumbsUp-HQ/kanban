+    ws_slug = slug or f"ws-{uuid.uuid4().hex[:12]}"
+    row = await session.execute(
+        text("INSERT INTO workspaces (slug, name) VALUES (:slug, :name) RETURNING id"),
+        {"slug": ws_slug, "name": name},
