+    obj2 = await _register_obj(db_session, ws2, "issue", "M2-1", user_id=user_id)
+
+    # Insert cross-workspace link with an invalid matrix tuple
+    lid = uuid.uuid4()
+    await db_session.execute(text("SET LOCAL session_replication_role = replica"))
