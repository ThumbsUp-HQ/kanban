+
+    # Modify SHA by changing properties
+    bundle.projects[0].name = "Renamed Project"
+    bundle.states[0].name = "Modified State"
+    bundle.labels[0].color = "#222222"
+    bundle.cycles[0].name = "Modified Cycle"
