+-- 7. Lookup Helper Functions and Grants for Non-Bypass CLI Resolution
+GRANT app_rls_reader TO kanban_app;
+
+CREATE OR REPLACE FUNCTION lookup_principal_by_handle(p_handle text)
+RETURNS TABLE (id uuid, workspace_id uuid, display_name text)
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+    SELECT u.id, u.workspace_id, p.display_name
+    FROM users u
+    JOIN principals p ON u.id = p.id
+    WHERE lower(replace(p.display_name, ' ', '')) = lower(ltrim(p_handle, '@'))
+       OR lower(p.display_name) = lower(ltrim(p_handle, '@'))
+       OR lower(u.email) = lower(ltrim(p_handle, '@'))
+    LIMIT 1;
+$$;
+GRANT EXECUTE ON FUNCTION lookup_principal_by_handle(text) TO kanban_app;
+
+CREATE OR REPLACE FUNCTION lookup_project_by_identifier(p_workspace_id uuid, p_ident text)
+RETURNS TABLE (id uuid, workspace_id uuid, identifier text, name text)
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+    SELECT id, workspace_id, identifier, name
+    FROM projects
+    WHERE (workspace_id = p_workspace_id OR p_workspace_id IS NULL)
+      AND (upper(identifier) = upper(p_ident) OR id::text = p_ident)
+    LIMIT 1;
+$$;
+GRANT EXECUTE ON FUNCTION lookup_project_by_identifier(uuid, text) TO kanban_app;
+
+-- 8. Refresh Materialized Effective Resource Access
+SELECT rebuild_effective_access_for_workspace('00000000-0000-0000-0000-000000000001');
+
+COMMIT;
