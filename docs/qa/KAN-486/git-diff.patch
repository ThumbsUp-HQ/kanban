+    expect(!document.dispatchEvent(enterEvent)).toBe(false);
+
+    const tabEvent = new KeyboardEvent('keydown', { key: 'Tab', bubbles: true, cancelable: true });
+    expect(!document.dispatchEvent(tabEvent)).toBe(false);
+
+    unmount();
