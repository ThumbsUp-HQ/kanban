+/* Copyright 2026 Kanban Platform Contributors */
+/* Apache-2.0 License. See LICENSE for details. */
+
+.admin-studio-subnav {
+  display: flex;
+  width: 100%;
+  border-bottom: 1px solid var(--kb-color-border-subtle, var(--border-subtle, #30363d));
+  margin-bottom: 24px;
+  padding-bottom: 0;
+  overflow-x: auto;
+  scrollbar-width: thin;
+}
+
+.admin-studio-subnav__scroll {
+  display: flex;
+  gap: 8px;
+  min-width: max-content;
+  padding-bottom: 4px;
+}
+
+.admin-studio-subnav__item {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 8px 14px;
+  min-height: 44px;
+  border-radius: 6px 6px 0 0;
+  text-decoration: none;
+  font-size: 0.9rem;
+  font-weight: 500;
+  color: var(--kb-color-text-secondary, var(--fg-secondary, #8b949e));
+  border-bottom: 2px solid transparent;
+  transition: all 0.15s ease-in-out;
+  white-space: nowrap;
+}
+
+.admin-studio-subnav__item:hover {
+  color: var(--kb-color-text-primary, var(--fg-primary, #f0f6fc));
+  border-bottom-color: var(--kb-color-text-secondary, var(--fg-secondary, #8b949e));
+}
+
+.admin-studio-subnav__item--active {
+  color: var(--accent-primary, #58a6ff) !important;
+  border-bottom-color: var(--accent-primary, #58a6ff) !important;
+  font-weight: 600;
+}
+
+.admin-studio-subnav__icon {
+  font-size: 1rem;
+}
