+    expect(accessLabelRow).not.toBeNull();
+
+    // Sibling label check
+    const refLabel = refLabelRow?.querySelector('label[for="repo-ref-input"]');
+    const accessLabel = accessLabelRow?.querySelector('label[for="repo-access-select"]');
