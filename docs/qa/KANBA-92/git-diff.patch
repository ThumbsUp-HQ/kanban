+import { act, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { RealtimeStatus, announce, type RealtimeState } from './RealtimeStatus.tsx';
+
+describe('RealtimeStatus', () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('renders no chip while open and for connecting', () => {
+    const { rerender } = render(<RealtimeStatus state="open" />);
+    expect(document.querySelector('.realtime-status-chip')).toBeNull();
+    rerender(<RealtimeStatus state="connecting" />);
+    expect(document.querySelector('.realtime-status-chip')).toBeNull();
+  });
+
+  it('defaults to open (hidden)', () => {
+    render(<RealtimeStatus />);
+    expect(document.querySelector('.realtime-status-chip')).toBeNull();
+  });
+
+  it.each<[RealtimeState, string]>([
+    ['reconnecting', 'Reconnecting...'],
+    ['sse-fallback', 'Live updates via fallback channel'],
+    ['closed', 'Offline - changes will sync when reconnected'],
+  ])('shows role=status text for %s', (state, text) => {
+    render(<RealtimeStatus state={state} />);
+    const chip = document.querySelector('.realtime-status-chip');
+    expect(chip?.getAttribute('role')).toBe('status');
+    expect(chip?.getAttribute('aria-live')).toBe('polite');
+    expect(chip?.textContent).toBe(text);
+  });
+
+  it('counts elapsed seconds while reconnecting and resets afterwards', () => {
+    const { rerender } = render(<RealtimeStatus state="reconnecting" />);
+    act(() => {
+      vi.advanceTimersByTime(3000);
+    });
+    expect(document.querySelector('.realtime-status-chip')?.textContent).toBe('Reconnecting... 3s');
+    rerender(<RealtimeStatus state="closed" />);
+    rerender(<RealtimeStatus state="reconnecting" />);
+    expect(document.querySelector('.realtime-status-chip')?.textContent).toBe('Reconnecting...');
+    act(() => {
+      vi.advanceTimersByTime(1000);
+    });
+    expect(document.querySelector('.realtime-status-chip')?.textContent).toBe('Reconnecting... 1s');
+  });
+
+  it('never receives focus on state change and exposes no tab stop', () => {
+    const { rerender } = render(
+      <>
+        <button data-testid="board-btn">board</button>
+        <RealtimeStatus state="open" />
+      </>,
+    );
+    const button = screen.getByTestId('board-btn');
+    button.focus();
+    rerender(
+      <>
+        <button data-testid="board-btn">board</button>
+        <RealtimeStatus state="closed" />
+      </>,
+    );
+    expect(document.activeElement).toBe(button);
+    expect(document.querySelector('.realtime-status-chip')?.hasAttribute('tabindex')).toBe(false);
+  });
+
+  it('announce() publishes to the live region and unsubscribes on unmount', () => {
+    const { unmount } = render(<RealtimeStatus />);
+    act(() => {
+      announce('Update failed');
+    });
+    expect(document.querySelector('.realtime-live-region')?.textContent).toBe('Update failed');
+    unmount();
+    expect(() => {
+      announce('after unmount');
+    }).not.toThrow();
+  });
+});
diff --git a/kanban/web/src/api/RealtimeStatus.tsx b/kanban/web/src/api/RealtimeStatus.tsx
new file mode 100644
index 0000000..56207b9
--- /dev/null
+++ b/kanban/web/src/api/RealtimeStatus.tsx
@@ -0,0 +1,80 @@
+/**
+ * Non-blocking realtime status chip and shared aria-live announcer (KB-P3-33).
+ * Never steals focus, never overlays board input. Hidden while the connection is `open`.
+ */
+
+import { useEffect, useState } from 'react';
+import './RealtimeStatus.css';
+
+export type RealtimeState = 'connecting' | 'open' | 'reconnecting' | 'sse-fallback' | 'closed';
+
+type AnnounceListener = (message: string) => void;
+const announceListeners = new Set<AnnounceListener>();
+
+/** Publishes a polite announcement to the shared live region. */
+export function announce(message: string): void {
+  for (const listener of announceListeners) {
+    listener(message);
+  }
+}
+
+export interface RealtimeStatusProps {
+  state?: RealtimeState;
+}
+
+const CHIP_ATTRS = { role: 'status', 'aria-live': 'polite' } as const;
+
+/** Owns the elapsed counter so it restarts from zero on every (re)mount. */
+function ReconnectingChip() {
+  const [seconds, setSeconds] = useState(0);
+
+  useEffect(() => {
+    const timer = setInterval(() => {
+      setSeconds((prev) => prev + 1);
+    }, 1000);
+    return () => {
+      clearInterval(timer);
+    };
+  }, []);
+
+  return (
+    <div className="realtime-status-chip" {...CHIP_ATTRS} data-state="reconnecting">
+      {seconds > 0 ? `Reconnecting... ${String(seconds)}s` : 'Reconnecting...'}
+    </div>
+  );
+}
+
+const STATIC_TEXT: Partial<Record<RealtimeState, string>> = {
+  'sse-fallback': 'Live updates via fallback channel',
+  closed: 'Offline - changes will sync when reconnected',
+};
+
+export function RealtimeStatus({ state = 'open' }: RealtimeStatusProps) {
+  const [announcement, setAnnouncement] = useState('');
+
+  useEffect(() => {
+    const listener: AnnounceListener = (message) => {
+      setAnnouncement(message);
+    };
+    announceListeners.add(listener);
+    return () => {
+      announceListeners.delete(listener);
+    };
+  }, []);
+
+  const staticText = STATIC_TEXT[state];
+
+  return (
+    <>
+      <div className="realtime-live-region" role="status" aria-live="polite">
+        {announcement}
+      </div>
+      {state === 'reconnecting' && <ReconnectingChip />}
+      {staticText !== undefined && (
+        <div className="realtime-status-chip" {...CHIP_ATTRS} data-state={state}>
+          {staticText}
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/kanban/web/src/api/client.test.ts b/kanban/web/src/api/client.test.ts
