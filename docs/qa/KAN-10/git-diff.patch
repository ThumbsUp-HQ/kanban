+        stmt: object,
+        params: dict[str, Any] | None = None,
+    ) -> MagicMock:
+        sql = str(stmt)
+        params = params or {}
+
+        mock_res = MagicMock()
+
+        if "set_config" in sql:
+            mock_res.scalar_one_or_none.return_value = None
+            return mock_res
+
+        if "FROM projects" in sql:
+            ident = params.get("ident", "")
+            ws_id = params.get("ws_id")
