+            [line for line in stk_txt.splitlines() if line.startswith("id:")][0]
+            .split(":", 1)[1]
+            .strip()
+        )
+        stk_etag = (
+            [line for line in stk_txt.splitlines() if line.startswith("etag:")][0]
+            .split(":", 1)[1]
+            .strip()
