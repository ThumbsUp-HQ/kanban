+        execution_id=exec_id,
+        invoking_principal_id=adam_id,
+        agent_principal_id=agent_id,
+        project_id=proj_id,
+        allowed_tools=["search_knowledge"],
+        ttl_seconds=60,
+        max_calls=5,
