+    )
+    await rebuild_era(committed_db_session, ws_id)
+    await committed_db_session.commit()
+
+    exec_id = uuid.uuid4()
+
+    # 1. Mint with allowed_tools=['search']
+    _rec1, tok_search = await mint_ephemeral_token(
+        committed_db_session,
