+        project_id=proj_id,
+    )
+    await rebuild_era(admin_env.seed_session, admin_env.workspace_id)
+    await admin_env.seed_session.commit()
+
+    parent_data = await admin_env.internal_client.request(
+        "POST",
+        "/api/v1/projects/TOCTOU/issues",
