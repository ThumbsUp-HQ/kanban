+@pytest.mark.asyncio
+async def test_csrf_validation_missing_and_mismatch() -> None:
+    """Case 9a: Missing or mismatched CSRF token returns RFC 7807 403 Forbidden."""
+    ws_id = uuid.uuid4()
+    app = _setup_app_with_cassette("sparkle_fim_ok.yaml", ws_id)
+
+    payload = {
+        "project_id": str(uuid.uuid4()),
+        "surface": "doc",
+        "prefix": "def foo():\n    ",
+        "suffix": "",
+        "client_request_id": str(uuid.uuid4()),
+    }
+
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
+        # 1. Missing CSRF header and cookie
+        res_no_csrf = await client.post("/api/v1/sparkle/complete", json=payload)
+        assert res_no_csrf.status_code == 403
+        problem = res_no_csrf.json()
+        assert problem["code"] in ("CSRF_TOKEN_MISSING", "CSRF_REJECTED")
+
+        # 2. Missing cookie token
+        res_no_cookie = await client.post(
+            "/api/v1/sparkle/complete",
+            json=payload,
+            headers={"X-CSRF-Token": "test-token"},
+        )
+        assert res_no_cookie.status_code == 403
+        assert res_no_cookie.json()["code"] in ("CSRF_TOKEN_MISSING", "CSRF_REJECTED")
+
+        # 3. Missing header token
+        res_no_header = await client.post(
+            "/api/v1/sparkle/complete",
+            json=payload,
+            cookies={"__Host-kb_csrf": "test-token"},
+        )
+        assert res_no_header.status_code == 403
+        assert res_no_header.json()["code"] in ("CSRF_TOKEN_MISSING", "CSRF_REJECTED")
+
+        # 4. Token mismatch (constant-time check fails)
+        res_mismatch = await client.post(
+            "/api/v1/sparkle/complete",
+            json=payload,
+            headers={"X-CSRF-Token": "token-a"},
+            cookies={"__Host-kb_csrf": "token-b"},
+        )
+        assert res_mismatch.status_code == 403
+        assert res_mismatch.json()["code"] in ("CSRF_TOKEN_INVALID", "CSRF_REJECTED")
+
+    # Direct unit verification of verify_csrf dependency in router.py
+    req = Request({"type": "http", "method": "POST", "headers": []})
+    with pytest.raises(ProblemException) as exc1:
+        await verify_csrf(req, x_csrf_token=None, cookie_token=None)
+    assert exc1.value.code == "CSRF_TOKEN_MISSING"
+
+    with pytest.raises(ProblemException) as exc2:
+        await verify_csrf(req, x_csrf_token="token-a", cookie_token="token-b")  # noqa: S106
+    assert exc2.value.code == "CSRF_TOKEN_INVALID"
+
+    # Matching tokens pass
+    await verify_csrf(req, x_csrf_token="match", cookie_token="match")  # noqa: S106
+
