+        "due_date": "2026-11-30",
+        "links": [{"type": "relates_to", "target": f"KANBA-{j}"} for j in range(20)],
+        "etag": "W/deadbeef12345678",
+        "access": {"users": ["sec-lead", "platform-lead"], "groups": ["engineering"]},
