+
+    # 3. Dist with index-*.js in assets (no sri-manifest)
+    manifest.unlink()
+    assets = fake_dist / "assets"
+    assets.mkdir()
+    index_js = assets / "index-abc1234.js"
+    index_js.write_text("console.log('test')", encoding="utf-8")
