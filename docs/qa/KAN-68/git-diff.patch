-                        "  CAST(:payload AS jsonb)"
-                        ")"
-                    ),
-                    {
-                        "ws": lease.workspace_id,
-                        "oid": lease.issue_id,
-                        "actor": lease.principal_id,
-                        "payload": payload_str,
-                    },
-                )
-            except Exception as exc:  # noqa: BLE001
