-+            raise ProblemException(
-+                code="LEASE_HELD",
-+                status=409,
-+                title="Lease Held",
-+                detail=(
-+                    f"Issue is leased by another principal until "
-+                    f"{active_lease.expires_at.isoformat()}"
-+                ),
