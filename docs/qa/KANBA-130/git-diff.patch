+    assert "@bobsmith" in res_formatted
+    assert "uuid-here" in res_formatted
+
+    # 2. update_ticket with modules_add/remove, labels_add/remove, parent
+    mock_client = MagicMock()
+    curr_issue = {
+        "key": "KAN-1",
+        "description_markdown": "desc",
