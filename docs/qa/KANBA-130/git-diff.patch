+@pytest.mark.asyncio
+async def test_case_4_boundary_conditions(agent_test_env: AgentTestEnv) -> None:
+    """Case 4: 50 nodes succeed, 51 fail; depth 6 succeeds, depth 7 fails; dates fail."""
+    env = agent_test_env
+
+    # 1. 50 nodes succeed
+    flat_49 = [{"summary": f"Sub {i}"} for i in range(1, 50)]
