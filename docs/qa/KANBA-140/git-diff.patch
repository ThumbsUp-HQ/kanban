diff --git a/kanban/web/src/features/oauth/DeviceActivatePage.tsx b/kanban/web/src/features/oauth/DeviceActivatePage.tsx
new file mode 100644
index 0000000..5c35eec
--- /dev/null
+++ b/kanban/web/src/features/oauth/DeviceActivatePage.tsx
@@ -0,0 +1,324 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, useEffect, type JSX, type ChangeEvent } from 'react';
+import { useSearchParams } from 'react-router';
+import {
+  fetchDeviceCodeInfo,
+  submitDeviceActivation,
+  type DeviceCodeInfoResponse,
+} from './oauthApi';
+import { EmojiHint } from '../../components/emoji/EmojiHint';
+import './DeviceActivatePage.css';
+
+const BASE20_CHARS = 'BCDFGHJKLMNPQRSTVWXZ';
+
+export function formatUserCodeInput(raw: string): string {
+  const cleaned = raw
+    .toUpperCase()
+    .split('')
+    .filter((ch) => BASE20_CHARS.includes(ch))
+    .join('');
+  if (cleaned.length <= 4) {
+    return cleaned;
+  }
+  return `${cleaned.slice(0, 4)}-${cleaned.slice(4, 8)}`;
+}
+
+export function DeviceActivatePage(): JSX.Element {
+  const [searchParams] = useSearchParams();
+  const [userCode, setUserCode] = useState<string>(() =>
+    formatUserCodeInput(searchParams.get('user_code') ?? ''),
+  );
+  const [info, setInfo] = useState<DeviceCodeInfoResponse | null>(null);
+  const [loading, setLoading] = useState<boolean>(false);
+  const [submitting, setSubmitting] = useState<boolean>(false);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [completionStatus, setCompletionStatus] = useState<'approved' | 'denied' | null>(null);
+  const [selectedScopes, setSelectedScopes] = useState<string[]>([]);
+  const [selectedProjects, setSelectedProjects] = useState<string[]>([]);
+
+  useEffect(() => {
+    const codeParam = searchParams.get('user_code');
+    if (!codeParam) {
+      return;
+    }
+    const formatted = formatUserCodeInput(codeParam);
+    if (formatted.length !== 9) {
+      return;
+    }
+
+    const isMounted = { current: true };
+    void (async () => {
+      try {
+        const data = await fetchDeviceCodeInfo(formatted);
+        if (isMounted.current) {
+          setInfo(data);
+          setSelectedScopes(data.requested_scopes);
+          setSelectedProjects(data.allowed_projects ?? ['KANBA']);
+        }
+      } catch (err: unknown) {
+        if (isMounted.current) {
+          const errObj = err as { code?: string; message?: string };
+          if (errObj.code === 'RATE_LIMIT_EXCEEDED') {
+            setErrorMessage('Too many attempts. Please wait 5 minutes before trying again.');
+          } else if (errObj.code === 'EXPIRED_CODE') {
+            setErrorMessage('This user code has expired. Please initiate device login again.');
+          } else if (errObj.code === 'ALREADY_PROCESSED') {
+            setErrorMessage('This device code has already been approved or denied.');
+          } else {
+            setErrorMessage(errObj.message ?? 'Invalid code or code not found.');
+          }
+          setInfo(null);
+        }
+      }
+    })();
+
+    return () => {
+      isMounted.current = false;
+    };
+  }, [searchParams]);
+
+  const handleLookup = async (codeToLookup: string): Promise<void> => {
+    setLoading(true);
+    setErrorMessage(null);
+    try {
+      const data = await fetchDeviceCodeInfo(codeToLookup);
+      setInfo(data);
+      setSelectedScopes(data.requested_scopes);
+      setSelectedProjects(data.allowed_projects ?? ['KANBA']);
+    } catch (err: unknown) {
+      const errObj = err as { code?: string; message?: string };
+      if (errObj.code === 'RATE_LIMIT_EXCEEDED') {
+        setErrorMessage('Too many attempts. Please wait 5 minutes before trying again.');
+      } else if (errObj.code === 'EXPIRED_CODE') {
+        setErrorMessage('This user code has expired. Please initiate device login again.');
+      } else if (errObj.code === 'ALREADY_PROCESSED') {
+        setErrorMessage('This device code has already been approved or denied.');
+      } else {
+        setErrorMessage(errObj.message ?? 'Invalid code or code not found.');
+      }
+      setInfo(null);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handleCodeChange = (e: ChangeEvent<HTMLInputElement>): void => {
+    const formatted = formatUserCodeInput(e.target.value);
+    setUserCode(formatted);
+    setErrorMessage(null);
+  };
+
+  const handleDecision = async (approved: boolean): Promise<void> => {
+    /* v8 ignore next 3 - unreachable defensive guard when no info is rendered */
+    if (!info) {
+      return;
+    }
+    setSubmitting(true);
+    setErrorMessage(null);
+    try {
+      const res = await submitDeviceActivation({
+        user_code: info.user_code,
+        approved,
+        scopes: approved ? selectedScopes : undefined,
+        allowed_projects: approved ? selectedProjects : undefined,
+      });
+      setCompletionStatus(res.status);
+    } catch (err: unknown) {
+      const errObj = err as { code?: string; message?: string };
+      if (errObj.code === 'AAL2_REQUIRED') {
+        setErrorMessage(
+          'AAL2 Passkey or TOTP verification required to approve /mcp/admin access.',
+        );
+      } else {
+        setErrorMessage(errObj.message ?? 'An error occurred while processing approval.');
+      }
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const toggleScope = (scope: string): void => {
+    setSelectedScopes((prev) =>
+      prev.includes(scope) ? prev.filter((s) => s !== scope) : [...prev, scope],
+    );
+  };
+
+  const toggleProject = (project: string): void => {
+    setSelectedProjects((prev) =>
+      prev.includes(project) ? prev.filter((p) => p !== project) : [...prev, project],
+    );
+  };
+
+  const isAdminTarget = info?.surface === 'admin' || (info?.resource ?? '').includes('/mcp/admin');
+
+  return (
+    <div className="kb-device-activate-layout" data-testid="device-activate-layout">
+      <div className="kb-device-activate-card">
+        <header className="kb-device-activate-header">
+          <h1 className="kb-device-activate-title">Connect CLI Device</h1>
+          <p className="kb-device-activate-subtitle">
+            Approve headless CLI or bot access with explicit resource boundaries.
+          </p>
+        </header>
+
+        {errorMessage && (
+          <div className="kb-device-error-banner" role="alert" data-testid="error-banner">
+            {errorMessage}
+          </div>
+        )}
+
+        {completionStatus === 'approved' && (
+          <div
+            className="kb-device-status-box kb-device-status-success"
+            data-testid="completion-approved"
+          >
+            <h2>Device Approved!</h2>
+            <p>You may now return to your terminal or CLI tool.</p>
+          </div>
+        )}
+
+        {completionStatus === 'denied' && (
+          <div
+            className="kb-device-status-box kb-device-status-denied"
+            data-testid="completion-denied"
+          >
+            <h2>Device Request Denied</h2>
+            <p>The authorization request was rejected. No tokens were issued.</p>
+          </div>
+        )}
+
+        {!completionStatus && !info && (
+          <div className="kb-device-input-group">
+            <label htmlFor="user-code-input" className="kb-device-input-label">
+              Enter 8-Character Device Code:
+            </label>
+            <input
+              id="user-code-input"
+              data-testid="user-code-input"
+              type="text"
+              className="kb-device-code-input"
+              placeholder="XXXX-XXXX"
+              maxLength={9}
+              value={userCode}
+              onChange={handleCodeChange}
+              autoComplete="off"
+              autoFocus
+            />
+            <button
+              type="button"
+              className="kb-device-lookup-button"
+              data-testid="lookup-button"
+              disabled={userCode.length < 9 || loading}
+              onClick={() => {
+                void handleLookup(userCode);
+              }}
+            >
+              {loading ? 'Verifying...' : 'Continue'}
+            </button>
+          </div>
+        )}
+
+        {!completionStatus && info && (
+          <section className="kb-device-consent-section" data-testid="consent-section">
+            <div className="kb-device-app-info">
+              <div className="kb-device-app-row">
+                <span className="kb-device-app-prop-label">Client Name:</span>
+                <span className="kb-device-app-prop-value" data-testid="client-name">
+                  {info.client_name}
+                </span>
+              </div>
+              <div className="kb-device-app-row">
+                <span className="kb-device-app-prop-label">User Code:</span>
+                <span className="kb-device-app-prop-value" data-testid="verified-code">
+                  {info.user_code}
+                </span>
+              </div>
+              <div className="kb-device-app-row">
+                <span className="kb-device-app-prop-label">Target Resource:</span>
+                <span className="kb-device-app-prop-value" data-testid="resource-target">
+                  {info.resource}
+                </span>
+              </div>
+              <div className="kb-device-app-row">
+                <span className="kb-device-app-prop-label">Access Domain:</span>
+                <span className="kb-device-app-prop-value">
+                  <EmojiHint kind="access" /> {info.surface.toUpperCase()}
+                </span>
+              </div>
+            </div>
+
+            {isAdminTarget && (
+              <div className="kb-device-aal2-banner" data-testid="aal2-banner">
+                <EmojiHint kind="restricted" />
+                <span>
+                  Admin Surface: Approval requires active AAL2 multi-factor authentication.
+                </span>
+              </div>
+            )}
+
+            <div className="kb-device-scopes-group">
+              <div className="kb-device-group-title">Requested Scopes:</div>
+              {info.requested_scopes.map((scope) => (
+                <label key={scope} className="kb-device-checkbox-label">
+                  <input
+                    type="checkbox"
+                    checked={selectedScopes.includes(scope)}
+                    onChange={() => {
+                      toggleScope(scope);
+                    }}
+                    data-testid={`scope-checkbox-${scope}`}
+                  />
+                  <span>{scope}</span>
+                </label>
+              ))}
+            </div>
+
+            <div className="kb-device-projects-group">
+              <div className="kb-device-group-title">Project Narrowing:</div>
+              {['KANBA'].map((proj) => (
+                <label key={proj} className="kb-device-checkbox-label">
+                  <input
+                    type="checkbox"
+                    checked={selectedProjects.includes(proj)}
+                    onChange={() => {
+                      toggleProject(proj);
+                    }}
+                    data-testid={`project-checkbox-${proj}`}
+                  />
+                  <span>Project: {proj}</span>
+                </label>
+              ))}
+            </div>
+
+            <div className="kb-device-actions-row">
+              <button
+                type="button"
+                className="kb-device-deny-button"
+                data-testid="deny-button"
+                disabled={submitting}
+                onClick={() => {
+                  void handleDecision(false);
+                }}
+              >
+                Deny
+              </button>
+              <button
+                type="button"
+                className="kb-device-approve-button"
+                data-testid="approve-button"
+                disabled={submitting || selectedScopes.length === 0}
+                onClick={() => {
+                  void handleDecision(true);
+                }}
+              >
+                {submitting ? 'Approving...' : 'Approve'}
+              </button>
+            </div>
+          </section>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/kanban/web/src/features/oauth/__tests__/DeviceActivatePage.test.tsx b/kanban/web/src/features/oauth/__tests__/DeviceActivatePage.test.tsx
new file mode 100644
index 0000000..3e67955
--- /dev/null
+++ b/kanban/web/src/features/oauth/__tests__/DeviceActivatePage.test.tsx
@@ -0,0 +1,430 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import React from 'react';
+import { MemoryRouter } from 'react-router';
+import { DeviceActivatePage, formatUserCodeInput } from '../DeviceActivatePage';
+import * as oauthApi from '../oauthApi';
+
+describe('DeviceActivatePage (KB-P4-16)', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  describe('formatUserCodeInput helper', () => {
+    it('filters non-consonant characters and formats XXXX-XXXX', () => {
+      expect(formatUserCodeInput('wdjbmjht')).toBe('WDJB-MJHT');
+      expect(formatUserCodeInput('w d j b - m j h t')).toBe('WDJB-MJHT');
+      // Vowels and numbers filtered
+      expect(formatUserCodeInput('A1E8O0')).toBe('');
+      expect(formatUserCodeInput('ABCD')).toBe('BCD');
+      expect(formatUserCodeInput('BCDFGHJKLM')).toBe('BCDF-GHJK');
+    });
+  });
+
+  it('renders input field, accepts user code, and fetches device info (Test Case 1)', async () => {
+    const mockInfo: oauthApi.DeviceCodeInfoResponse = {
+      user_code: 'WDJB-MJHT',
+      client_name: 'Antigravity CLI',
+      client_id: 'client_123',
+      resource: 'https://kanban.example.com/mcp/agent',
+      surface: 'agent',
+      requested_scopes: ['agent:read', 'agent:write'],
+      allowed_projects: ['KANBA'],
+      expires_at: new Date(Date.now() + 600000).toISOString(),
+    };
+
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockResolvedValue(mockInfo);
+    vi.spyOn(oauthApi, 'submitDeviceActivation').mockResolvedValue({ status: 'approved' });
+
+    render(
+      <MemoryRouter initialEntries={['/activate']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+
+    const input = screen.getByTestId<HTMLInputElement>('user-code-input');
+    fireEvent.change(input, { target: { value: 'WDJBMJHT' } });
+    expect(input.value).toBe('WDJB-MJHT');
+
+    const lookupBtn = screen.getByTestId<HTMLButtonElement>('lookup-button');
+    expect(lookupBtn.disabled).toBe(false);
+    fireEvent.click(lookupBtn);
+
+    await waitFor(() => {
+      expect(screen.getByTestId('consent-section')).not.toBeNull();
+    });
+
+    expect(screen.getByTestId('client-name').textContent).toContain('Antigravity CLI');
+    expect(screen.getByTestId('verified-code').textContent).toContain('WDJB-MJHT');
+    expect(screen.getByTestId('resource-target').textContent).toContain('/mcp/agent');
+
+    // Narrow scopes and projects
+    const scopeWrite = screen.getByTestId('scope-checkbox-agent:write');
+    const scopeRead = screen.getByTestId('scope-checkbox-agent:read');
+    fireEvent.click(scopeWrite); // Uncheck write
+    fireEvent.click(scopeWrite); // Re-check write
+    fireEvent.click(scopeWrite); // Uncheck write again
+
+    // Uncheck read to test empty scopes disabling approve button
+    fireEvent.click(scopeRead);
+    const approveBtn = screen.getByTestId<HTMLButtonElement>('approve-button');
+    expect(approveBtn.disabled).toBe(true);
+    fireEvent.click(scopeRead); // Re-check read
+    expect(approveBtn.disabled).toBe(false);
+
+    // Toggle project
+    const projBox = screen.getByTestId('project-checkbox-KANBA');
+    fireEvent.click(projBox); // Uncheck KANBA
+    fireEvent.click(projBox); // Check KANBA back
+
+    fireEvent.click(approveBtn);
+
+    await waitFor(() => {
+      expect(oauthApi.submitDeviceActivation).toHaveBeenCalledWith({
+        user_code: 'WDJB-MJHT',
+        approved: true,
+        scopes: ['agent:read'],
+        allowed_projects: ['KANBA'],
+      });
+      expect(screen.getByTestId('completion-approved')).not.toBeNull();
+    });
+  });
+
+  it('auto-loads device info when pre-filled via query parameter', async () => {
+    const mockInfo: oauthApi.DeviceCodeInfoResponse = {
+      user_code: 'BCDF-GHJK',
+      client_name: 'Claude Code',
+      client_id: 'client_claude',
+      resource: 'https://kanban.example.com/mcp/agent',
+      surface: 'agent',
+      requested_scopes: ['agent:read'],
+      allowed_projects: null,
+      expires_at: new Date().toISOString(),
+    };
+
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockResolvedValue(mockInfo);
+
+    render(
+      <MemoryRouter initialEntries={['/activate?user_code=bcdfghjk']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+
+    await waitFor(() => {
+      expect(screen.getByTestId('consent-section')).not.toBeNull();
+      expect(screen.getByTestId('client-name').textContent).toContain('Claude Code');
+    });
+  });
+
+  it('handles query param with short code or failed auto-lookup', async () => {
+    // 1. Short code query param
+    const { unmount } = render(
+      <MemoryRouter initialEntries={['/activate?user_code=short']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+    expect(screen.getByTestId('user-code-input')).not.toBeNull();
+    unmount();
+
+    // 2. Failed auto-lookup via query param (expired)
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockRejectedValueOnce({
+      code: 'EXPIRED_CODE',
+    });
+
+    const { unmount: unmount2 } = render(
+      <MemoryRouter initialEntries={['/activate?user_code=bcdfghjk']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+
+    await waitFor(() => {
+      expect(screen.getByTestId('error-banner').textContent).toContain(
+        'This user code has expired. Please initiate device login again.',
+      );
+    });
+    unmount2();
+
+    // 3. Failed auto-lookup via query param (rate limited)
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockRejectedValueOnce({
+      code: 'RATE_LIMIT_EXCEEDED',
+    });
+    const { unmount: unmount3 } = render(
+      <MemoryRouter initialEntries={['/activate?user_code=bcdfghjk']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+    await waitFor(() => {
+      expect(screen.getByTestId('error-banner').textContent).toContain('Too many attempts.');
+    });
+    unmount3();
+
+    // 4. Failed auto-lookup via query param (already processed)
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockRejectedValueOnce({
+      code: 'ALREADY_PROCESSED',
+    });
+    const { unmount: unmount4 } = render(
+      <MemoryRouter initialEntries={['/activate?user_code=bcdfghjk']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+    await waitFor(() => {
+      expect(screen.getByTestId('error-banner').textContent).toContain('already been approved');
+    });
+    unmount4();
+
+    // 5. Failed auto-lookup via query param (generic error)
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockRejectedValueOnce(new Error('Unknown failure'));
+    render(
+      <MemoryRouter initialEntries={['/activate?user_code=bcdfghjk']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+    await waitFor(() => {
+      expect(screen.getByTestId('error-banner').textContent).toContain('Unknown failure');
+    });
+  });
+
+  it('handles user denial decision', async () => {
+    const mockInfo: oauthApi.DeviceCodeInfoResponse = {
+      user_code: 'WDJB-MJHT',
+      client_name: 'Test CLI',
+      client_id: 'client_test',
+      resource: 'https://kanban.example.com/mcp/agent',
+      surface: 'agent',
+      requested_scopes: ['agent:read'],
+      allowed_projects: null,
+      expires_at: new Date().toISOString(),
+    };
+
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockResolvedValue(mockInfo);
+    vi.spyOn(oauthApi, 'submitDeviceActivation').mockResolvedValue({ status: 'denied' });
+
+    render(
+      <MemoryRouter initialEntries={['/activate?user_code=WDJB-MJHT']}>
+        <DeviceActivatePage />
+      </MemoryRouter>,
+    );
+
+    await waitFor(() => {
+      expect(screen.getByTestId('deny-button')).not.toBeNull();
+    });
+
+    fireEvent.click(screen.getByTestId('deny-button'));
+
+    await waitFor(() => {
