+    let resolvePromise!: (val: oauthApi.DeviceCodeInfoResponse) => void;
+    let rejectPromise!: (err: unknown) => void;
+
+    // 1. Resolve after unmount
+    vi.spyOn(oauthApi, 'fetchDeviceCodeInfo').mockReturnValueOnce(
