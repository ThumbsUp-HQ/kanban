+      },
+      'GET /api/v1/auth/oauth-grants': () => ({ json: apps }),
+      'DELETE /api/v1/auth/oauth-grants/:grantId': (req) => {
+        apps = apps.filter((a) => a.id !== req.params.grantId);
+        return { status: 204 };
