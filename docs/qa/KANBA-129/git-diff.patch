+    } else {
+      window.location.assign('/');
+    }
+  };
+
+  // Format base32 in 4-character chunks
+  const formatBase32 = (secret: string) => {
+    return secret.match(/.{1,4}/g)?.join(' ') ?? secret;
+  };
+
+  return (
