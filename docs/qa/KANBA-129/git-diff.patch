+describe('LdapLoginForm (KB-P3-35)', () => {
+  const ldapCard: AuthCard = {
+    id: 'c-ldap',
+    slug: 'corp-ad',
+    provider_kind: 'LDAP',
+    display_name: 'Corp AD',
