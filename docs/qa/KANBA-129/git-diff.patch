+    const form = screen.getByRole('button', { name: /Sign in as Local Administrator/i }).closest('form');
+    expect(form).not.toBeNull();
+    if (form) {
+      fireEvent.submit(form);
+    }
+    unmount();
+    resolveLogin?.({ status: 'authenticated' });
+  });
+});
