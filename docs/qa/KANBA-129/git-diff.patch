+  const handleRegisterPasskey = async () => {
+    if (isSubmitting || !enrollmentId) return;
+    setIsSubmitting(true);
+    setError(null);
+
+    try {
+      const { options } = await getWebauthnRegistrationOptions({
+        enrollment_id: enrollmentId,
