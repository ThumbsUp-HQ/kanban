+-    fireEvent.click(screen.getByRole('button', { name: /kill switch/i }));
+-    fireEvent.click(screen.getByRole('button', { name: /confirm kill switch/i }));
+-
+-    await waitFor(() => {
+-      expect(announceSpy).toHaveBeenCalledWith(
