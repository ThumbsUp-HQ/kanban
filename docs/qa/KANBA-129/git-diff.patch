+-      queries: { retry: false },
+-      mutations: { retry: false },
+-    },
+-  });
+-  if (initialData) {
+-    queryClient.setQueryData(['access', TEST_OBJECT_ID], initialData);
+-  }
+-  return {
+-    queryClient,
+-    ...render(<QueryClientProvider client={queryClient}>{ui}</QueryClientProvider>),
+-  };
+-}
