+    const { unmount } = render(<LocalAdminDisclosure onSuccess={vi.fn()} onError={vi.fn()} />);
+
+    fireEvent.click(
+      screen.getByRole('button', { name: /Sign in with Local Admin \+ Passkey \/ TOTP/i }),
