+    )
+    await add_acl_entry(
+        db_session, ws_id, issue_id, active_agent, effect="ALLOW", capability_mask=Capability.ALL
+    )
+    await rebuild_era(db_session, ws_id)
+
+    # 1. OBO with DISABLED agent returns NONE
