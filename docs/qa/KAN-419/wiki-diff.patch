+### Recipe 2: GitLab CI/CD Configuration
+
+```yaml
+kanban-automation:
+  stage: test
+  id_tokens:
+    GITLAB_OIDC_TOKEN:
+      aud: https://kanban.example.com
+  script:
+    - |
+      RESPONSE=$(curl -sLS -X POST "https://kanban.example.com/oauth/token" \
+        -H "Content-Type: application/x-www-form-urlencoded" \
+        -d "grant_type=urn:ietf:params:oauth:grant-type:token-exchange" \
+        -d "subject_token=${GITLAB_OIDC_TOKEN}" \
+        -d "subject_token_type=urn:ietf:params:oauth:token-type:jwt" \
+        -d "audience=https://kanban.example.com/mcp/agent")
+      TOKEN=$(echo "${RESPONSE}" | jq -r .access_token)
+      curl -sLS -X POST "https://kanban.example.com/mcp/agent/tools/call" \
+        -H "Authorization: Bearer ${TOKEN}" \
+        -H "Content-Type: application/json" \
+        -d '{"name": "search_tickets", "arguments": {"query": "CI Pipeline", "lod": "summary"}}'
+```
