+++    def mint_jwt(
+++        self,
+++        sub: str = "repo:ThumbsUp-HQ/kanban:ref:refs/heads/main",
+++        aud: str = "kanban-workload-aud",
+++        iss: str = ISSUER_URL,
+++        ttl_seconds: int = 300,
+++        extra_claims: dict[str, Any] | None = None,
+++    ) -> str:
+++        now = int(time.time())
+++        claims = {
+++            "iss": iss,
+++            "sub": sub,
+++            "aud": aud,
+++            "exp": now + ttl_seconds,
+++            "nbf": now - 10,
+++            "iat": now,
+++            "jti": f"workload-jti-{time.time_ns()}",
+++        }
+++        if extra_claims:
+++            claims.update(extra_claims)
