+++        )
+++        self.httpd.socket = ssl_ctx.wrap_socket(self.httpd.socket, server_side=True)
+++        self.thread: threading.Thread | None = None
+++
+++    def start(self) -> None:
+++        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+++        self.thread.start()
+++
+++    def stop(self) -> None:
