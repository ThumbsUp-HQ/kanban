@@ -0,0 +1,223 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, type JSX } from 'react';
+import { EmojiHint } from '../../components/emoji/EmojiHint';
+import type { GateActivityItem } from './types';
+import './gates.css';
+
+export interface GateActivityRowProps {
+  item: GateActivityItem;
+  onJumpToComment?: ((commentId: string) => void) | undefined;
+}
+
+export function GateActivityRow({ item, onJumpToComment }: GateActivityRowProps): JSX.Element {
+  const [copiedHash, setCopiedHash] = useState(false);
+  const payload = item.payload;
+  const hookName = payload.hook_name ?? item.actor.display_name ?? 'Workflow Gate';
+  const harness = payload.harness ?? 'cli: agy -p';
+  const latency =
+    payload.execution_latency_ms !== undefined ? `${String(payload.execution_latency_ms)} ms` : '';
+  const hash = payload.verdict_sha256 ?? item.row_hash ?? '';
+  const reason = payload.reason ?? 'Transition criteria not satisfied.';
+  const auditCommentId = payload.audit_comment_id;
+
+  const formattedDate = new Date(item.created_at).toLocaleString(undefined, {
+    month: 'short',
+    day: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+
+  if (item.event_type === 'GATE_APPROVED') {
+    return (
+      <div
+        className="gate-activity-row gate-activity-row--approved"
+        data-testid={`gate-activity-approved-${item.id}`}
+      >
+        <EmojiHint
+          kind="gateApproved"
+          variant="interactive"
+          label={`Gate Approved: ${hookName}`}
+          content={
+            <div className="gate-popover">
+              <div className="gate-popover__line1">Gate: {hookName}</div>
+              {latency && <div className="gate-popover__line2">Latency: {latency}</div>}
+              {hash && (
+                <div className="gate-popover__hash-box">
+                  <code className="gate-popover__hash-code">{hash}</code>
+                </div>
+              )}
+            </div>
+          }
+          testId={`activity-gate-hint-${item.id}`}
+        />
+        <div className="gate-activity-row__body">
+          <div className="gate-activity-row__header">
+            <span className="gate-activity-row__hook">{hookName}</span>
+            <span className="gate-activity-row__harness">({harness})</span>
+            <time dateTime={item.created_at} className="gate-activity-row__time">
+              {formattedDate}
+            </time>
+          </div>
+          <div className="gate-activity-row__detail">
+            Approved transition {latency ? `in ${latency}` : ''}
+          </div>
+          {hash && (
+            <div className="gate-activity-row__actions">
+              <code className="gate-popover__hash-code" data-testid="activity-verdict-hash">
+                {hash}
+              </code>
+              <button
+                type="button"
+                className="gate-popover__copy-btn"
+                data-testid="activity-copy-hash-btn"
+                onClick={() => {
+                  void navigator.clipboard.writeText(hash);
+                  setCopiedHash(true);
+                  setTimeout(() => {
+                    setCopiedHash(false);
+                  }, 2000);
+                }}
+              >
+                {copiedHash ? 'Copied' : 'Copy Hash'}
+              </button>
+            </div>
+          )}
+        </div>
+      </div>
+    );
+  }
+
+  if (item.event_type === 'GATE_REJECTED') {
+    return (
+      <div
+        className="gate-activity-row gate-activity-row--rejected"
+        data-testid={`gate-activity-rejected-${item.id}`}
+      >
+        <EmojiHint
+          kind="gateVetoed"
+          variant="interactive"
+          label={`Gate Vetoed: ${hookName}`}
+          content={
+            <div className="gate-popover">
+              <div className="gate-popover__line1">Vetoed by {hookName}</div>
+              <div className="gate-popover__reason">{reason}</div>
+            </div>
+          }
+          testId={`activity-gate-hint-${item.id}`}
+        />
+        <div className="gate-activity-row__body">
+          <div className="gate-activity-row__header">
+            <span className="gate-activity-row__hook">{hookName}</span>
+            <span className="gate-activity-row__harness">({harness})</span>
+            <time dateTime={item.created_at} className="gate-activity-row__time">
+              {formattedDate}
+            </time>
+          </div>
+          {/* Anti-XSS: Reason rendered as plain text node */}
+          <div className="gate-activity-row__detail" data-testid="gate-activity-reason">
+            {reason}
+          </div>
+          {auditCommentId && onJumpToComment && (
+            <div className="gate-activity-row__actions">
+              <button
+                type="button"
+                className="gate-popover__jump-link"
+                data-testid={`jump-comment-btn-${item.id}`}
+                onClick={() => {
+                  onJumpToComment(auditCommentId);
+                }}
+              >
+                View full gate review comment -&gt;
+              </button>
+            </div>
+          )}
+        </div>
+      </div>
+    );
+  }
+
+  if (item.event_type === 'GATE_ABORTED_STALE') {
+    return (
+      <div
+        className="gate-activity-row gate-activity-row--stale"
+        data-testid={`gate-activity-stale-${item.id}`}
+      >
+        <EmojiHint
+          kind="warning"
+          variant="tooltip"
+          label="Gate Aborted: Stale Snapshot"
+          content="Ticket was modified while the agent gate was evaluating (TOCTOU violation)."
+          testId={`activity-gate-hint-${item.id}`}
+        />
+        <div className="gate-activity-row__body">
+          <div className="gate-activity-row__header">
+            <span className="gate-activity-row__hook">{hookName}</span>
+            <time dateTime={item.created_at} className="gate-activity-row__time">
+              {formattedDate}
+            </time>
+          </div>
+          <div className="gate-activity-row__detail">
+            Transition cancelled (ticket changed while gate was running)
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  if (item.event_type === 'GATE_FAIL_OPEN_WARN') {
+    const warningCode = payload.warning_code ?? 'TIMEOUT';
+    return (
+      <div
+        className="gate-activity-row gate-activity-row--warn"
+        data-testid={`gate-activity-warn-${item.id}`}
+      >
+        <EmojiHint
+          kind="warning"
+          variant="tooltip"
+          label="Gate Warning: Fail-Open"
+          content={`Gate encountered an error (${warningCode}) but policy permitted proceeding.`}
+          testId={`activity-gate-hint-${item.id}`}
+        />
+        <div className="gate-activity-row__body">
+          <div className="gate-activity-row__header">
+            <span className="gate-activity-row__hook">{hookName}</span>
+            <time dateTime={item.created_at} className="gate-activity-row__time">
+              {formattedDate}
+            </time>
+          </div>
+          <div className="gate-activity-row__detail">
+            Gate failed open with warning: {warningCode}
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  // Pending
+  return (
+    <div
+      className="gate-activity-row gate-activity-row--pending"
+      data-testid={`gate-activity-pending-${item.id}`}
+    >
+      <EmojiHint
+        kind="gatePending"
+        variant="tooltip"
+        label={`Gate Pending: ${hookName}`}
+        content={`Gate evaluation in progress via ${harness}`}
+        testId={`activity-gate-hint-${item.id}`}
+      />
+      <div className="gate-activity-row__body">
+        <div className="gate-activity-row__header">
+          <span className="gate-activity-row__hook">{hookName}</span>
+          <span className="gate-activity-row__harness">({harness})</span>
+          <time dateTime={item.created_at} className="gate-activity-row__time">
+            {formattedDate}
+          </time>
+        </div>
+        <div className="gate-activity-row__detail">Transition gate currently running...</div>
+      </div>
+    </div>
+  );
+}
diff --git a/kanban/web/src/features/gates/GateStatusPill.tsx b/kanban/web/src/features/gates/GateStatusPill.tsx
new file mode 100644
index 0000000..c8542ea
--- /dev/null
+++ b/kanban/web/src/features/gates/GateStatusPill.tsx
@@ -0,0 +1,258 @@
+// Copyright 2026 Kanban Platform Contributors
+// Apache-2.0 License. See LICENSE for details.
+
+import React, { useState, useEffect, useRef, type JSX, type ReactNode } from 'react';
+import { EmojiHint } from '../../components/emoji/EmojiHint';
+import type { PendingGateInfo, LatestGateVerdict } from './types';
+import './gates.css';
+
+export interface UseElapsedGateTimerResult {
+  elapsedSeconds: number;
+  formattedElapsed: string;
+}
+
+export function formatElapsedSeconds(totalSeconds: number): string {
+  const safeSeconds = Math.max(0, Math.floor(totalSeconds));
+  const mins = Math.floor(safeSeconds / 60);
+  const secs = safeSeconds % 60;
+  return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
+}
+
+/**
+ * Live 1s elapsed timer hook that tracks time elapsed since startedAt.
+ * Pauses interval updates when the document is hidden and cleans up on unmount.
+ */
+export function useElapsedGateTimer(startedAt: string | undefined): UseElapsedGateTimerResult {
+  const [now, setNow] = useState<number>(() => Date.now());
+  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  useEffect(() => {
+    if (!startedAt) {
+      return undefined;
+    }
+
+    const startMs = new Date(startedAt).getTime();
+    if (Number.isNaN(startMs)) {
+      return undefined;
+    }
+
+    const startInterval = (): void => {
+      if (timerRef.current !== null) {
+        clearInterval(timerRef.current);
+      }
+      timerRef.current = setInterval(() => {
+        setNow(Date.now());
+      }, 1000);
+    };
+
+    const stopInterval = (): void => {
+      if (timerRef.current !== null) {
+        clearInterval(timerRef.current);
+        timerRef.current = null;
+      }
+    };
+
+    const handleVisibilityChange = (): void => {
+      if (document.hidden) {
+        stopInterval();
+      } else {
+        setNow(Date.now());
+        startInterval();
+      }
+    };
+
+    document.addEventListener('visibilitychange', handleVisibilityChange);
+    startInterval();
+
+    return () => {
+      stopInterval();
+      document.removeEventListener('visibilitychange', handleVisibilityChange);
+    };
+  }, [startedAt]);
+
+  if (!startedAt) {
+    return { elapsedSeconds: 0, formattedElapsed: '00:00' };
+  }
+
+  const startMs = new Date(startedAt).getTime();
+  if (Number.isNaN(startMs)) {
+    return { elapsedSeconds: 0, formattedElapsed: '00:00' };
+  }
+
+  const diffSeconds = Math.max(0, Math.floor((now - startMs) / 1000));
+  return {
+    elapsedSeconds: diffSeconds,
+    formattedElapsed: formatElapsedSeconds(diffSeconds),
+  };
+}
+
+export interface GateStatusPillProps {
+  status: 'pending' | 'rejected' | 'approved';
+  pendingGate?: PendingGateInfo | null | undefined;
+  latestVerdict?: LatestGateVerdict | null | undefined;
+  issueKey?: string | undefined;
+  canCancel?: boolean | undefined;
+  onCancelGate?: ((executionId: string) => void | Promise<void>) | undefined;
+  onJumpToComment?: ((commentId: string) => void) | undefined;
+  testId?: string | undefined;
+}
+
+export function GateStatusPill({
+  status,
+  pendingGate,
+  latestVerdict,
+  issueKey,
+  canCancel = false,
+  onCancelGate,
+  onJumpToComment,
+  testId,
+}: GateStatusPillProps): JSX.Element {
+  const [copiedHash, setCopiedHash] = useState(false);
+  const timer = useElapsedGateTimer(status === 'pending' ? pendingGate?.started_at : undefined);
+
+  if (status === 'pending') {
+    const hookName = pendingGate?.hook_name ?? 'Workflow Gate';
+    const harness = pendingGate?.harness_label ?? pendingGate?.harness_kind ?? 'cli: agy -p';
+    const isRo = pendingGate?.repo_mount_ro !== false;
+    const executionId = pendingGate?.execution_id ?? '';
+
+    const popoverContent = (): ReactNode => (
+      <div className="gate-popover" data-testid="gate-pending-popover">
+        <div className="gate-popover__line1">
+          Gate: {hookName} ({harness})
+        </div>
+        <div className="gate-popover__line2">
+          <span className="gate-popover__timer" data-testid="gate-elapsed-timer">
+            Elapsed: {timer.formattedElapsed}
+          </span>
+          {isRo && (
+            <span className="gate-popover__repo-ro" data-testid="gate-repo-ro-badge">
+              :ro repo mounted
+            </span>
+          )}
+        </div>
+        {canCancel && executionId && onCancelGate && (
+          <button
+            type="button"
+            className="gate-popover__cancel-btn"
+            data-testid={issueKey ? `cancel-gate-btn-${issueKey}` : 'cancel-gate-button'}
+            onClick={(e) => {
+              e.stopPropagation();
+              void onCancelGate(executionId);
+            }}
+          >
+            Cancel gate
+          </button>
+        )}
+      </div>
+    );
+
+    return (
+      <EmojiHint
+        kind="gatePending"
+        variant="interactive"
+        label={`Gate Pending: ${hookName}`}
+        content={popoverContent}
+        testId={testId ?? (issueKey ? `gate-pending-${issueKey}` : 'gate-pending-pill')}
+      />
+    );
+  }
+
+  if (status === 'rejected') {
+    const hookName = latestVerdict?.hook_name ?? 'Workflow Gate';
+    const agentSlug = latestVerdict?.agent_slug ?? 'agent';
+    const reasonRaw = latestVerdict?.reason_preview ?? 'Transition criteria not satisfied.';
+    // Ensure <= 280 chars
+    const reasonPreview = reasonRaw.length > 280 ? `${reasonRaw.slice(0, 277)}...` : reasonRaw;
+    const auditCommentId = latestVerdict?.audit_comment_id;
+
+    const formattedTime = latestVerdict?.completed_at
+      ? new Date(latestVerdict.completed_at).toLocaleTimeString(undefined, {
+          hour: '2-digit',
+          minute: '2-digit',
+        })
+      : '';
+
+    const popoverContent = (): ReactNode => (
+      <div className="gate-popover" data-testid="gate-vetoed-popover">
+        <div className="gate-popover__line1">
+          Vetoed by {hookName} ({agentSlug}) {formattedTime ? `at ${formattedTime}` : ''}
+        </div>
+        <div className="gate-popover__reason" data-testid="gate-veto-reason">
+          {reasonPreview}
+        </div>
+        {auditCommentId && (
+          <button
+            type="button"
+            className="gate-popover__jump-link"
+            data-testid="jump-to-comment-link"
+            onClick={(e) => {
+              e.stopPropagation();
+              onJumpToComment?.(auditCommentId);
+            }}
+          >
+            View full gate review comment -&gt;
+          </button>
+        )}
+      </div>
+    );
+
+    return (
+      <EmojiHint
+        kind="gateVetoed"
+        variant="interactive"
+        label={`Gate Vetoed: ${hookName}`}
+        content={popoverContent}
+        testId={testId ?? (issueKey ? `gate-vetoed-${issueKey}` : 'gate-vetoed-pill')}
+      />
+    );
+  }
+
+  // Approved
+  const hookName = latestVerdict?.hook_name ?? 'Workflow Gate';
+  const latencyMs = latestVerdict?.latency_ms !== undefined ? `${String(latestVerdict.latency_ms)} ms` : '';
+  const hash = latestVerdict?.verdict_sha256 ?? '';
+
+  const popoverContent = (): ReactNode => (
+    <div className="gate-popover" data-testid="gate-approved-popover">
+      <div className="gate-popover__line1">Gate: {hookName}</div>
+      {latencyMs && (
+        <div className="gate-popover__line2" data-testid="gate-latency">
+          Latency: {latencyMs}
+        </div>
+      )}
+      {hash && (
+        <div className="gate-popover__hash-box">
+          <code className="gate-popover__hash-code" data-testid="verdict-sha256-code">
+            {hash}
+          </code>
+          <button
+            type="button"
+            className="gate-popover__copy-btn"
+            data-testid="copy-verdict-hash-btn"
+            onClick={(e) => {
+              e.stopPropagation();
+              void navigator.clipboard.writeText(hash);
+              setCopiedHash(true);
+              setTimeout(() => {
+                setCopiedHash(false);
+              }, 2000);
+            }}
+          >
+            {copiedHash ? 'Copied' : 'Copy Hash'}
+          </button>
+        </div>
+      )}
+    </div>
+  );
+
+  return (
+    <EmojiHint
+      kind="gateApproved"
+      variant="interactive"
+      label={`Gate Approved: ${hookName}`}
+      content={popoverContent}
+      testId={testId ?? (issueKey ? `gate-approved-${issueKey}` : 'gate-approved-pill')}
+    />
+  );
+}
