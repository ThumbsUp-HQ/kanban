+
+    # UTF-16 lone surrogate in .md attachment must raise ContentNormalizeError("INVALID_UTF8_SURROGATE")
+    bundle_surrogate = PlaneBundle(
+        projects=[PlaneProject(id="p-k2", identifier="KANBA2", name="Kanba 2")],
+        issues=[
+            PlaneIssue(
+                id="i-surr-att",
