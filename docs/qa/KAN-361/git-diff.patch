+      try {
+        await page.goto(vp.url, { waitUntil: 'load', timeout: 15000 });
+      } catch (err) {
+        console.warn(`Warning navigating to ${vp.url}:`, err.message);
+      }
+
+      await page.evaluate((theme) => {
+        document.documentElement.setAttribute('data-theme', theme);
