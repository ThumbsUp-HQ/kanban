diff --git a/kanban/web/src/features/admin-agents/agentStudio.css b/kanban/web/src/features/admin-agents/agentStudio.css
index ef049ca7..f5451030 100644
--- a/kanban/web/src/features/admin-agents/agentStudio.css
+++ b/kanban/web/src/features/admin-agents/agentStudio.css
@@ -460,3 +460,76 @@
     align-items: stretch;
   }
 }
+
+/* Drawer and Modal Footers (KAN-451) */
+.kb-form-label-row {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  max-width: 100%;
+}
+
+.kb-drawer-footer,
+.kb-modal-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3, 12px);
+  margin-top: var(--space-6, 24px);
+  flex-wrap: wrap;
+}
+
+.kb-drawer-footer-actions-left {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3, 12px);
+}
+
+.kb-drawer-footer-actions-right {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3, 12px);
+  margin-left: auto;
+}
+
+.kb-drawer-footer button,
+.kb-drawer-footer-actions-left button,
+.kb-drawer-footer-actions-right button {
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+@media (max-width: 767px) {
+  .kb-modal-card {
+    padding-bottom: 0;
+  }
+
+  .kb-modal-footer,
+  .kb-drawer-footer {
+    position: sticky;
+    bottom: 0;
+    background: var(--bg-surface);
+    border-top: 1px solid var(--border-subtle);
+    padding: var(--space-3, 12px) 0 calc(var(--space-4, 16px) + env(safe-area-inset-bottom, 0px));
+    z-index: 5;
+    flex-direction: column-reverse;
