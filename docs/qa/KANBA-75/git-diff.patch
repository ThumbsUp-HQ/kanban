+    pr_target = prios_after[0]
+
+    # Bulk insert 501 issues in the committed session
+    proj_uuid = uuid.UUID(proj_id)
+    ws_id = (
+        await api_env.seed.execute(
+            text("SELECT workspace_id FROM projects WHERE id = :p"), {"p": proj_uuid}
+        )
