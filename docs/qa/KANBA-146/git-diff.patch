-                  })}
-                </ul>
-              </nav>
-            )}
-          </div>
-
-          {/* Linked Work Items Section */}
-          <div className="docs-linked-items-section">
-            <h3 className="docs-rail-heading">Linked Work Items</h3>
-            {objectLinks.length === 0 ? (
