-                        {link.target_title}
-                      </span>
-                    )}
-                    {link.link_type === 'PROMOTED_TO_DOC' && (
-                      <span className="docs-promoted-badge" title="Promoted from Sticky">
-                        📄 Promoted
-                      </span>
-                    )}
-                  </li>
-                ))}
-              </ul>
-            )}
-          </div>
-        </div>
-      )}
-
-      {/* HISTORY TAB PANEL */}
-      {activeTab === 'history' && (
