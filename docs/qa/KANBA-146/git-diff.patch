+  border-radius: var(--radius-sm, 4px);
+  font-size: 12px;
+  font-weight: 500;
+}
+
+.custom-field-approval-actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 12px;
+  margin-top: 6px;
+}
+
+.custom-field-approve-group {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.custom-field-checkbox-label {
+  font-size: 12px;
+  color: var(--fg-secondary, #4b5563);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  cursor: pointer;
+}
+
+/* --------------------------------------------------------------------------
+   MODAL DIALOGS
+   -------------------------------------------------------------------------- */
+
+.custom-field-modal-overlay {
+  position: fixed;
+  inset: 0;
+  background-color: rgba(0, 0, 0, 0.4);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 100;
+}
+
+.custom-field-modal {
+  background-color: var(--bg-surface, #ffffff);
+  border-radius: var(--radius-md, 6px);
+  padding: 20px 24px;
+  width: 90%;
+  max-width: 480px;
+  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+.custom-field-modal-title {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--fg-primary, #111827);
+}
+
+.custom-field-modal-subtitle {
+  margin: 0;
+  font-size: 12px;
+  color: var(--fg-secondary, #4b5563);
+}
+
+.custom-field-modal-warning-text {
+  margin: 0;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--danger-fg, #881337);
+  background-color: var(--danger-bg, #ffe4e6);
+  padding: 10px;
+  border-radius: var(--radius-sm, 4px);
+}
+
+.custom-field-modal-actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 6px;
+}
+
+/* --------------------------------------------------------------------------
+   RESPONSIVE ADAPTATIONS
+   -------------------------------------------------------------------------- */
+
+@media (max-width: 768px) {
+  .custom-fields-editor-layout {
+    flex-direction: column;
+  }
+
+  .custom-fields-editor-sidebar {
+    width: 100%;
+    flex: 0 0 auto;
+    max-height: 200px;
+    border-right: none;
+    border-bottom: 1px solid var(--border-subtle, #e5e7eb);
+  }
+
+  .custom-fields-editor-main {
+    padding: 16px;
+  }
+
+  .custom-fields-form-grid {
+    grid-template-columns: 1fr;
+  }
+}
