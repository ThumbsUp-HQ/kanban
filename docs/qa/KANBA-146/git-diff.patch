+.custom-field-input:focus,
+.custom-field-select:focus,
+.custom-field-textarea:focus {
+  outline: 2px solid var(--focus-ring, #2563eb);
+  outline-offset: -1px;
+}
+
+.custom-field-source-editor {
+  line-height: 1.4;
+  tab-size: 2;
+}
+
+.custom-field-input-error {
+  color: var(--danger-fg, #881337);
+  font-size: 11px;
+  font-weight: 500;
+}
+
+.custom-fields-form-actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 8px;
+}
+
+/* --------------------------------------------------------------------------
+   BUTTONS
+   -------------------------------------------------------------------------- */
+
+.custom-field-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 7px 14px;
+  border-radius: var(--radius-sm, 4px);
+  font-size: 13px;
+  font-weight: 500;
+  cursor: pointer;
+  border: 1px solid transparent;
+  transition: background-color 100ms ease;
+}
+
+.custom-field-btn--sm {
+  padding: 4px 8px;
+  font-size: 11px;
+}
+
+.custom-field-btn--primary {
+  background-color: var(--accent-primary, #1d4ed8);
+  color: var(--accent-primary-fg, #ffffff);
+}
+
+.custom-field-btn--primary:hover:not(:disabled) {
+  opacity: 0.9;
+}
+
+.custom-field-btn--secondary {
+  background-color: var(--bg-surface, #ffffff);
+  border-color: var(--border-subtle, #e5e7eb);
+  color: var(--fg-primary, #111827);
+}
+
+.custom-field-btn--secondary:hover:not(:disabled) {
+  background-color: var(--bg-hover, #f1f3f5);
+}
+
+.custom-field-btn--danger {
+  background-color: var(--danger-bg, #ffe4e6);
+  color: var(--danger-fg, #881337);
+  border-color: #fecdd3;
+}
+
+.custom-field-btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* --------------------------------------------------------------------------
+   ESCALATION APPROVAL PANEL (S13.2)
+   -------------------------------------------------------------------------- */
+
+.custom-field-approval-panel {
+  background-color: var(--bg-surface, #ffffff);
+  border: 1px solid var(--border-subtle, #e5e7eb);
+  border-radius: var(--radius-md, 6px);
+  padding: 16px 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.custom-field-approval-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.custom-field-approval-title {
+  margin: 0;
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--fg-primary, #111827);
+}
+
+.custom-field-status-chip {
+  padding: 2px 8px;
+  border-radius: 9999px;
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.custom-field-status-chip--approved {
+  background-color: #ecfdf5;
+  color: #047857;
+}
+
+.custom-field-status-chip--pending,
+.custom-field-status-chip--pending_second_approver {
+  background-color: var(--warn-bg, #fef3c7);
+  color: var(--warn-fg, #78350f);
+}
+
+.custom-field-status-chip--revoked {
+  background-color: var(--danger-bg, #ffe4e6);
+  color: var(--danger-fg, #881337);
+}
+
+.custom-field-status-chip--default {
+  background-color: var(--bg-hover, #f1f3f5);
+  color: var(--fg-secondary, #4b5563);
+}
+
+.custom-field-matrix-summary {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 10px 12px;
+  background-color: var(--bg-canvas, #f7f8fa);
+  border-radius: var(--radius-sm, 4px);
+  font-size: 12px;
+}
+
+.custom-field-matrix-row {
+  display: flex;
+  justify-content: space-between;
+}
+
+.custom-field-matrix-label {
+  color: var(--fg-secondary, #4b5563);
+}
+
+.custom-field-matrix-val {
+  color: var(--fg-primary, #111827);
+  font-weight: 500;
+}
+
+.custom-field-sp-warning-banner {
+  background-color: var(--warn-bg, #fef3c7);
+  border: 1px solid #fde68a;
+  color: var(--warn-fg, #78350f);
+  padding: 10px 14px;
+  border-radius: var(--radius-sm, 4px);
+  font-size: 12px;
+  font-weight: 500;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.custom-field-error-banner {
+  background-color: var(--danger-bg, #ffe4e6);
+  border: 1px solid #fecdd3;
+  color: var(--danger-fg, #881337);
+  padding: 10px 14px;
+  border-radius: var(--radius-sm, 4px);
+  font-size: 12px;
+  font-weight: 500;
+}
+
+.custom-field-approval-actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 12px;
+  margin-top: 6px;
+}
+
+.custom-field-approve-group {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.custom-field-checkbox-label {
+  font-size: 12px;
+  color: var(--fg-secondary, #4b5563);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  cursor: pointer;
+}
+
+/* --------------------------------------------------------------------------
+   MODAL DIALOGS
+   -------------------------------------------------------------------------- */
+
+.custom-field-modal-overlay {
+  position: fixed;
+  inset: 0;
+  background-color: rgba(0, 0, 0, 0.4);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 100;
+}
+
+.custom-field-modal {
+  background-color: var(--bg-surface, #ffffff);
+  border-radius: var(--radius-md, 6px);
+  padding: 20px 24px;
+  width: 90%;
+  max-width: 480px;
+  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+.custom-field-modal-title {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--fg-primary, #111827);
+}
+
+.custom-field-modal-subtitle {
+  margin: 0;
+  font-size: 12px;
+  color: var(--fg-secondary, #4b5563);
+}
+
+.custom-field-modal-warning-text {
+  margin: 0;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--danger-fg, #881337);
+  background-color: var(--danger-bg, #ffe4e6);
+  padding: 10px;
+  border-radius: var(--radius-sm, 4px);
+}
+
+.custom-field-modal-actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 6px;
+}
+
+/* --------------------------------------------------------------------------
+   RESPONSIVE ADAPTATIONS
+   -------------------------------------------------------------------------- */
+
+@media (max-width: 768px) {
+  .custom-fields-editor-layout {
+    flex-direction: column;
+  }
+
+  .custom-fields-editor-sidebar {
+    width: 100%;
+    flex: 0 0 auto;
+    max-height: 200px;
+    border-right: none;
+    border-bottom: 1px solid var(--border-subtle, #e5e7eb);
+  }
+
+  .custom-fields-editor-main {
+    padding: 16px;
+  }
+
+  .custom-fields-form-grid {
+    grid-template-columns: 1fr;
+  }
+}
