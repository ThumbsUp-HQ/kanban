-/** Collects all descendant IDs of a node */
-export function getDescendantIds(node: PageTreeNode): Set<string> {
-  const ids = new Set<string>();
-  function walk(n: PageTreeNode) {
-    if (n.children) {
-      for (const child of n.children) {
-        if (child.id) {
-          ids.add(child.id);
-          walk(child);
-        }
-      }
-    }
-  }
-  walk(node);
-  return ids;
-}
