-+            elif clean_item.startswith("- "):
-+                parts.append(f"- [ ] {clean_item[2:]}")
-+            else:
-+                parts.append(f"- [ ] {clean_item}")
-+        parts.append("")
-+
-+    raw_doc = "\n".join(parts).strip() + "\n"
-+    return normalize_to_markdown(raw_doc)
