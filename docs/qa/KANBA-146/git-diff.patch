-+): Promise<PageResponse> {
-+  return typedFetch<PageResponse>('POST', `/api/v1/pages/${encodeURIComponent(pageId)}/versions/${String(versionSeq)}/restore`, {
-+    ifMatch: etag,
-+  });
-+}
-+
-+export interface CreatedIssue {
-+  id: string;
-+  key?: string;
-+  title?: string;
-+}
-+
-+export async function createIssue(
-+  projectKey: string,
