+class _NotifEnvelope(OutboxEventLike):
+    def __init__(
+        self,
+        workspace_id: uuid.UUID,
+        topic: str,
+        payload: dict[str, Any] | None,
+        object_id: uuid.UUID | None = None,
+        project_id: uuid.UUID | None = None,
+    ) -> None:
+        self.workspace_id = workspace_id
