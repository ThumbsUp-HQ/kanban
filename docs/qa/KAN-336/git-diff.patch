+                "fields": {
+                    "summary": "Safe summary",
+                    "description": "Safe description",
+                    "status": {"name": "Backlog"},
+                    "priority": {"name": "Medium"},
+                    "comment": {
+                        "comments": [
+                            {
+                                "id": "c-sec-1",
