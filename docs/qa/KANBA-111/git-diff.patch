+import { act, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { RealtimeStatus, announce, type RealtimeState } from './RealtimeStatus.tsx';
+
+describe('RealtimeStatus', () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('renders no chip while open and for connecting', () => {
+    const { rerender } = render(<RealtimeStatus state="open" />);
+    expect(document.querySelector('.realtime-status-chip')).toBeNull();
+    rerender(<RealtimeStatus state="connecting" />);
+    expect(document.querySelector('.realtime-status-chip')).toBeNull();
+  });
+
+  it('defaults to open (hidden)', () => {
+    render(<RealtimeStatus />);
+    expect(document.querySelector('.realtime-status-chip')).toBeNull();
+  });
+
+  it.each<[RealtimeState, string]>([
+    ['reconnecting', 'Reconnecting...'],
+    ['sse-fallback', 'Live updates via fallback channel'],
+    ['closed', 'Offline - changes will sync when reconnected'],
+  ])('shows role=status text for %s', (state, text) => {
+    render(<RealtimeStatus state={state} />);
+    const chip = document.querySelector('.realtime-status-chip');
+    expect(chip?.getAttribute('role')).toBe('status');
+    expect(chip?.getAttribute('aria-live')).toBe('polite');
+    expect(chip?.textContent).toBe(text);
+  });
+
+  it('counts elapsed seconds while reconnecting and resets afterwards', () => {
+    const { rerender } = render(<RealtimeStatus state="reconnecting" />);
+    act(() => {
+      vi.advanceTimersByTime(3000);
+    });
+    expect(document.querySelector('.realtime-status-chip')?.textContent).toBe('Reconnecting... 3s');
+    rerender(<RealtimeStatus state="closed" />);
+    rerender(<RealtimeStatus state="reconnecting" />);
+    expect(document.querySelector('.realtime-status-chip')?.textContent).toBe('Reconnecting...');
+    act(() => {
+      vi.advanceTimersByTime(1000);
+    });
+    expect(document.querySelector('.realtime-status-chip')?.textContent).toBe('Reconnecting... 1s');
+  });
+
+  it('never receives focus on state change and exposes no tab stop', () => {
+    const { rerender } = render(
+      <>
+        <button data-testid="board-btn">board</button>
+        <RealtimeStatus state="open" />
+      </>,
+    );
+    const button = screen.getByTestId('board-btn');
+    button.focus();
+    rerender(
+      <>
+        <button data-testid="board-btn">board</button>
+        <RealtimeStatus state="closed" />
+      </>,
+    );
+    expect(document.activeElement).toBe(button);
+    expect(document.querySelector('.realtime-status-chip')?.hasAttribute('tabindex')).toBe(false);
+  });
+
+  it('announce() publishes to the live region and unsubscribes on unmount', () => {
+    const { unmount } = render(<RealtimeStatus />);
+    act(() => {
+      announce('Update failed');
+    });
+    expect(document.querySelector('.realtime-live-region')?.textContent).toBe('Update failed');
+    unmount();
+    expect(() => {
+      announce('after unmount');
+    }).not.toThrow();
+  });
+});
diff --git a/kanban/web/src/api/RealtimeStatus.tsx b/kanban/web/src/api/RealtimeStatus.tsx
new file mode 100644
index 0000000..56207b9
--- /dev/null
+++ b/kanban/web/src/api/RealtimeStatus.tsx
@@ -0,0 +1,80 @@
+/**
+ * Non-blocking realtime status chip and shared aria-live announcer (KB-P3-33).
+ * Never steals focus, never overlays board input. Hidden while the connection is `open`.
+ */
+
+import { useEffect, useState } from 'react';
+import './RealtimeStatus.css';
+
+export type RealtimeState = 'connecting' | 'open' | 'reconnecting' | 'sse-fallback' | 'closed';
+
+type AnnounceListener = (message: string) => void;
+const announceListeners = new Set<AnnounceListener>();
+
+/** Publishes a polite announcement to the shared live region. */
+export function announce(message: string): void {
+  for (const listener of announceListeners) {
+    listener(message);
+  }
+}
+
+export interface RealtimeStatusProps {
+  state?: RealtimeState;
+}
+
+const CHIP_ATTRS = { role: 'status', 'aria-live': 'polite' } as const;
+
+/** Owns the elapsed counter so it restarts from zero on every (re)mount. */
+function ReconnectingChip() {
+  const [seconds, setSeconds] = useState(0);
+
+  useEffect(() => {
+    const timer = setInterval(() => {
+      setSeconds((prev) => prev + 1);
+    }, 1000);
+    return () => {
+      clearInterval(timer);
+    };
+  }, []);
+
+  return (
+    <div className="realtime-status-chip" {...CHIP_ATTRS} data-state="reconnecting">
+      {seconds > 0 ? `Reconnecting... ${String(seconds)}s` : 'Reconnecting...'}
+    </div>
+  );
+}
+
+const STATIC_TEXT: Partial<Record<RealtimeState, string>> = {
+  'sse-fallback': 'Live updates via fallback channel',
+  closed: 'Offline - changes will sync when reconnected',
+};
+
+export function RealtimeStatus({ state = 'open' }: RealtimeStatusProps) {
+  const [announcement, setAnnouncement] = useState('');
+
+  useEffect(() => {
+    const listener: AnnounceListener = (message) => {
+      setAnnouncement(message);
+    };
+    announceListeners.add(listener);
+    return () => {
+      announceListeners.delete(listener);
+    };
+  }, []);
+
+  const staticText = STATIC_TEXT[state];
+
+  return (
+    <>
+      <div className="realtime-live-region" role="status" aria-live="polite">
+        {announcement}
+      </div>
+      {state === 'reconnecting' && <ReconnectingChip />}
+      {staticText !== undefined && (
+        <div className="realtime-status-chip" {...CHIP_ATTRS} data-state={state}>
+          {staticText}
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/kanban/web/src/api/client.test.ts b/kanban/web/src/api/client.test.ts
new file mode 100644
index 0000000..6eecc5e
--- /dev/null
+++ b/kanban/web/src/api/client.test.ts
@@ -0,0 +1,201 @@
+import { afterEach, beforeEach, describe, expect, it, vi, type Mock } from 'vitest';
+import { ApiClientError, REQUEST_TIMEOUT_MS, apiFetch, getCsrfToken } from './client.ts';
+import { ApiProblem } from './problem.ts';
+
+function jsonResponse(body: unknown, init: ResponseInit = {}, type = 'application/json'): Response {
+  return new Response(JSON.stringify(body), {
+    status: 200,
+    headers: { 'content-type': type },
+    ...init,
+  });
+}
+
+let cookieJar = '';
+
+/** jsdom rejects `__Host-` cookies over http, so the cookie string is stubbed. */
+function setCookie(value: string): void {
+  cookieJar = `a=1; __Host-kb_csrf=${value}; b=2`;
+}
+
+function clearCookie(): void {
+  cookieJar = '';
+}
+
+describe('apiFetch', () => {
+  let fetchMock: Mock<typeof fetch>;
+
+  beforeEach(() => {
+    fetchMock = vi.fn<typeof fetch>();
+    vi.stubGlobal('fetch', fetchMock);
+    vi.spyOn(document, 'cookie', 'get').mockImplementation(() => cookieJar);
+    clearCookie();
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+    clearCookie();
+  });
+
+  it('GET resolves path params with same-origin credentials', async () => {
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({ key: 'KAN-142' })));
+    const result = await apiFetch('GET', '/api/v1/issues/{issue_key}', {
+      params: { issue_key: 'KAN-142' },
+    });
+    expect(result).toEqual({ key: 'KAN-142' });
+    const [url, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(url).toBe('/api/v1/issues/KAN-142');
+    expect(init.credentials).toBe('same-origin');
+    expect((init.headers as Record<string, string>).Accept).toBe('application/json');
+    expect((init.headers as Record<string, string>)['X-CSRF-Token']).toBeUndefined();
+    expect(init.body).toBeUndefined();
+  });
+
+  it('PATCH sends X-CSRF-Token, If-Match and a JSON body', async () => {
+    setCookie('tok%2B1');
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({ ok: true })));
+    await apiFetch('PATCH', '/api/v1/issues/{issue_key}', {
+      params: { issue_key: 'KAN-1' },
+      ifMatch: '"abc"',
+      body: { summary: 'x' },
+    });
+    const [, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    const headers = init.headers as Record<string, string>;
+    expect(headers['X-CSRF-Token']).toBe('tok+1');
+    expect(headers['If-Match']).toBe('"abc"');
+    expect(headers['Content-Type']).toBe('application/json');
+    expect(init.body).toBe('{"summary":"x"}');
+  });
+
+  it('passes string bodies through without JSON re-encoding', async () => {
+    setCookie('t');
+    fetchMock.mockImplementation(() => Promise.resolve(new Response(null, { status: 204 })));
+    await apiFetch('POST', '/api/v1/projects/{project_ref}/issues', {
+      params: { project_ref: 'KAN' },
+      body: 'raw',
+    });
+    const [, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(init.body).toBe('raw');
+    expect((init.headers as Record<string, string>)['Content-Type']).toBeUndefined();
+  });
+
+  it('throws CSRF_TOKEN_MISSING without calling fetch', async () => {
+    await expect(
+      apiFetch('PATCH', '/api/v1/issues/{issue_key}', { params: { issue_key: 'K-1' } }),
+    ).rejects.toMatchObject({ code: 'CSRF_TOKEN_MISSING' });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('encodes hostile path params', async () => {
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({})));
+    await apiFetch('GET', '/api/v1/issues/{issue_key}', { params: { issue_key: '../admin' } });
+    expect((fetchMock.mock.calls[0] as [string])[0]).toBe('/api/v1/issues/..%2Fadmin');
+  });
+
+  it.each(['https://evil.example/x', '//evil.example/x', 'api/v1/x', '/\\evil'])(
+    'rejects non-relative url %s',
+    async (url) => {
+      await expect(apiFetch('GET', url as never)).rejects.toMatchObject({
+        code: 'ABSOLUTE_URL_FORBIDDEN',
+      });
+      expect(fetchMock).not.toHaveBeenCalled();
+    },
+  );
+
+  it('serialises query values, arrays and skips nullish entries', async () => {
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({})));
+    await apiFetch('GET', '/api/v1/projects/{project_ref}/issues', {
+      params: { project_ref: 'KAN' },
+      query: { limit: 10, tag: ['a', 'b'], skip: undefined, none: null, flag: true },
+    });
+    expect((fetchMock.mock.calls[0] as [string])[0]).toBe(
+      '/api/v1/projects/KAN/issues?limit=10&tag=a&tag=b&flag=true',
+    );
+  });
+
+  it('appends with & when the path already has a query and ignores an empty query', async () => {
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({})));
+    await apiFetch('GET', '/api/v1/x?a=1' as never, { query: { b: 2 } });
+    expect((fetchMock.mock.calls[0] as [string])[0]).toBe('/api/v1/x?a=1&b=2');
+    await apiFetch('GET', '/api/v1/y' as never, { query: {} });
+    expect((fetchMock.mock.calls[1] as [string])[0]).toBe('/api/v1/y');
+  });
+
+  it('returns undefined for 204', async () => {
+    setCookie('t');
+    fetchMock.mockImplementation(() => Promise.resolve(new Response(null, { status: 204 })));
+    await expect(apiFetch('DELETE', '/api/v1/x' as never)).resolves.toBeUndefined();
+  });
+
+  it('throws UNEXPECTED_CONTENT_TYPE for text/html (and for a missing header)', async () => {
+    fetchMock.mockResolvedValueOnce(
+      new Response('<html>', { status: 200, headers: { 'content-type': 'text/html' } }),
+    );
+    await expect(apiFetch('GET', '/api/v1/x' as never)).rejects.toMatchObject({
+      code: 'UNEXPECTED_CONTENT_TYPE',
+    });
+    const bare = new Response('x', { status: 200 });
+    bare.headers.delete('content-type');
+    fetchMock.mockResolvedValueOnce(bare);
+    await expect(apiFetch('GET', '/api/v1/x' as never)).rejects.toBeInstanceOf(ApiClientError);
+  });
+
+  it('accepts application/problem+json success bodies', async () => {
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({ a: 1 }, {}, 'application/problem+json')));
+    await expect(apiFetch('GET', '/api/v1/x' as never)).resolves.toEqual({ a: 1 });
+  });
+
+  it('maps RFC 7807 errors to ApiProblem', async () => {
+    fetchMock.mockResolvedValue(
+      jsonResponse({ code: 'PRECONDITION_FAILED', title: 'T' }, { status: 412 }, 'application/problem+json'),
+    );
+    const err = await apiFetch('GET', '/api/v1/x' as never).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(ApiProblem);
+    expect((err as ApiProblem).status).toBe(412);
+    expect((err as ApiProblem).code).toBe('PRECONDITION_FAILED');
+  });
+
+  it('maps malformed problem json and text bodies to UNKNOWN', async () => {
+    fetchMock.mockResolvedValueOnce(
+      new Response('{not json', { status: 500, headers: { 'content-type': 'application/json' } }),
+    );
+    await expect(apiFetch('GET', '/api/v1/x' as never)).rejects.toMatchObject({ code: 'UNKNOWN', status: 500 });
+    fetchMock.mockResolvedValueOnce(
+      new Response('oops', { status: 502, headers: { 'content-type': 'text/plain' } }),
+    );
+    await expect(apiFetch('GET', '/api/v1/x' as never)).rejects.toMatchObject({ code: 'UNKNOWN', status: 502 });
+  });
+
+  it('combines the caller signal with the default timeout', async () => {
+    fetchMock.mockImplementation(() => Promise.resolve(jsonResponse({})));
+    const controller = new AbortController();
+    await apiFetch('GET', '/api/v1/x' as never, { signal: controller.signal });
+    const [, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(init.signal).toBeInstanceOf(AbortSignal);
+    controller.abort();
+    expect(init.signal?.aborted).toBe(true);
+  });
+
+  it('uses a 15000ms default timeout', () => {
+    expect(REQUEST_TIMEOUT_MS).toBe(15000);
+  });
+});
+
+describe('getCsrfToken', () => {
+  beforeEach(() => {
+    vi.spyOn(document, 'cookie', 'get').mockImplementation(() => cookieJar);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    clearCookie();
+  });
+
+  it('returns null when absent', () => {
+    expect(getCsrfToken()).toBeNull();
+  });
+
+  it('returns the raw value when it is not valid percent-encoding', () => {
+    setCookie('%E0%A4%A');
+    expect(getCsrfToken()).toBe('%E0%A4%A');
+  });
+});
