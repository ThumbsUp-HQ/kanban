++import React, { useLayoutEffect, useRef, useEffect, type JSX } from 'react';
++import { useVirtualizer } from '@tanstack/react-virtual';
++import { dropTargetForElements } from '@atlaskit/pragmatic-drag-and-drop/element/adapter';
