++async def delete_object_link(
++    session: AsyncSession,
++    caller: PrincipalContext,
++    link_id: uuid.UUID,
++) -> None:
++    """Delete a typed object link, requiring LINK on source and anti-enumeration 404."""
++    # 1. Fetch link
++    link = await session.get(ObjectLink, link_id)
++    if link is None:
++        not_found()
