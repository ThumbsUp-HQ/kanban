++CREATE TABLE comment_reactions (
++    comment_id   UUID NOT NULL REFERENCES issue_comments(id) ON DELETE CASCADE,
++    principal_id UUID NOT NULL REFERENCES principals(id) ON DELETE CASCADE,
++    emoji        TEXT NOT NULL,
