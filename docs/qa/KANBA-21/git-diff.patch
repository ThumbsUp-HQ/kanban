+linkage = "dynamic"
+justification = "Loaded as a separate shared object; not statically linked. Verified."
+""",
+        encoding="utf-8",
+    )
+
+    py_json = FIXTURES_DIR / "python_lgpl.json"
+    node_json = FIXTURES_DIR / "node_clean.json"
+
+    rc = main(
+        [
+            "--python-json",
+            str(py_json),
