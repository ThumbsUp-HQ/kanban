+
+    rc = main(
+        [
+            "--python-json",
+            str(py_json),
+            "--node-json",
+            str(node_json),
+        ]
+    )
+
+    captured = capsys.readouterr()
+    assert rc == 1
+    assert "python\tpkg-lgpl\t3.0.0\tLGPL-3.0\tDENY" in captured.out
+
+
