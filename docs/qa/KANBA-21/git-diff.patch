++def test_classify_unit_boundaries() -> None:
++    """Unit test individual classify boundary cases."""
++    assert classify("") == Verdict.UNKNOWN
++    assert classify("   ") == Verdict.UNKNOWN
++    assert classify("UNKNOWN") == Verdict.UNKNOWN
