++PARENTHESIZED_PHRASES: dict[str, str] = {
++    "mozilla public license 2.0 (mpl 2.0)": "MPL-2.0",
++    "isc license (iscl)": "ISC",
++    "apache license (v2.0)": "Apache-2.0",
