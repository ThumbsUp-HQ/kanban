-        object_id=state_id,
-        topic="column.rebalanced",
-        payload={
-            "state_id": str(state_id),
-            "project_id": str(project_id),
-            "reindexed_count": len(updates),
-            "max_prev_len": max_prev_len,
-        },
-    )
-
-    logger.info(
-        "Rebalanced column %s in project %s: updated %d/%d cards (max prev len %d)",
-        state_id,
-        project_id,
-        len(updates),
-        len(rows),
-        max_prev_len,
-    )
-    return len(updates)
