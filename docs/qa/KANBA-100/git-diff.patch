-def _invalid_cursor(detail: str) -> ProblemException:
-    """Build canonical 422 INVALID_CURSOR problem exception."""
-    return ProblemException(
-        code="INVALID_CURSOR",
-        status=422,
-        title="Invalid Cursor",
-        detail=detail,
-    )
