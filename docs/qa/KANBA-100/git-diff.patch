-+            raise ProblemException(
-+                code="FILTER_TOO_COMPLEX",
-+                status=422,
-+                title="Filter Too Complex",
-+                detail=f"Filter list operand exceeded limit of {MAX_ARRAY_ITEMS} items",
-+            )
-+        max_d = depth
-+        leaves = 0
-+        for item in data:
