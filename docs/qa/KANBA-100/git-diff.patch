-+def test_midpoint_rank_order_error() -> None:
-+    """prev_rank >= next_rank raises RankOrderError."""
-+    with pytest.raises(RankOrderError, match="must be strictly less than"):
-+        midpoint_rank("b", "a")
-+
-+    with pytest.raises(RankOrderError, match="must be strictly less than"):
-+        midpoint_rank("same", "same")
