-+    else:
-+        stmt = text(
-+            "SELECT principal_id, allow_mask, deny_mask "
-+            "FROM effective_resource_access "
-+            "WHERE object_id = :obj_id "
-+            "  AND principal_id = ANY(CAST(:candidate_ids AS uuid[]))"
