+    assert isinstance(seq, int)
+    p_ident = await session.scalar(
+        text("SELECT identifier FROM projects WHERE id = :id"),
+        {"id": proj_id},
+    )
+    ckey = f"{p_ident}-{seq}"
+    i_id = await _register_obj(
+        session,
+        ws_id,
