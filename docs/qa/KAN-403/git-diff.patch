+def _create_sample_png_bytes(width: int = 64, height: int = 64) -> bytes:
+    """Generate minimal valid PNG bytes."""
+    im = Image.new("RGBA", (width, height), (33, 150, 243, 255))
+    bio = io.BytesIO()
+    im.save(bio, format="PNG")
+    return bio.getvalue()
