   delete: <P extends keyof paths>(path: P, opts?: ApiFetchOptions) => apiFetch('DELETE', path, opts),
+  blob: (method: Method, path: string, opts?: ApiFetchOptions) => apiFetchBlob(method, path, opts),
 };
