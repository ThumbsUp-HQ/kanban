+    copySpy.mockResolvedValueOnce(false);
+    render(<ComposeExportTab initialData={mockData} />);
+    fireEvent.click(screen.getByText('Copy .env.example'));
+
+    await waitFor(() => {
+      expect(screen.getByRole('alert').textContent).toContain('Failed to copy');
+    });
+  });
