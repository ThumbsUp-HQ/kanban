+            "--ticket-file",
+            ticket_file,
+            "--proof-dir",
+            proof_dir,
+            "--provider",
+            "fixture",
+            "--cassette",
+            cassette_file,
+        ]
+    )
+
+    assert exit_code == 0
+    captured = capsys.readouterr()
