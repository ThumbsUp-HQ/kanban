+    async with FakeLdapServer(ldap_certs, mode="ldaps", ignore_size_limit=True) as server:
+        for idx in range(3):
+            dn = f"cn=user{idx},ou=users,dc=corp,dc=example"
+            server.directory.entries[dn] = {
