+    # 7. Scheme pairing validation
+    with pytest.raises(ValidationError, match="ldap:// scheme requires transport_mode='starttls'"):
+        LdapCardConfig(
+            kind="LDAP",
+            url="ldap://dc01.corp.example:389",
