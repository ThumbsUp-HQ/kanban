-+    // 3. Deduplicate concurrent identical requests
-+    const existing = this.inFlight.get(cacheKey);
-+    if (existing) {
-+      return existing;
-+    }
-+
-+    // 4. Dispatch to worker with watchdog
-+    const promise = new Promise<MermaidClientResult>((resolve) => {
-+      this.requestIdCounter += 1;
