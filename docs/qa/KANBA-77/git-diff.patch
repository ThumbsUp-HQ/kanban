-    parent_page = (
-        await session.execute(
-            select(Page).where(
-                Page.id == parent_page_id,
-                Page.workspace_id == caller.workspace_id,
-            )
-        )
-    ).scalar_one_or_none()
-    if parent_page is None:
-        not_found()
-    if parent_page.doc_id != doc_id:
-        raise ProblemException(
-            code="PAGE_PARENT_DOC_MISMATCH",
