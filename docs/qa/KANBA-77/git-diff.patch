-    slug = _SPACES_REGEX.sub("-", base).strip("-")
-    if not slug:
-        slug = "section"
-
-    count = seen_counts.get(slug, 0)
-    seen_counts[slug] = count + 1
-
-    if count == 0:
-        return slug
-    return f"{slug}-{count}"
