-+def test_compute_new_sort_rank() -> None:
-+    """Sort rank computation exercises after_id and before_id boundary branches."""
-+    u1 = uuid.uuid4()
-+    u2 = uuid.uuid4()
-+    u3 = uuid.uuid4()
-+    siblings = [(u1, "a0"), (u2, "b0"), (u3, "c0")]
