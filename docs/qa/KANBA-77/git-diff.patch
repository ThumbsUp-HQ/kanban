-+    res_codex = validate_cli_args("codex", codex_args)
-+    assert res_codex.argv == (
-+        "/usr/local/bin/codex",
-+        "-p",
-+        "-s",
-+        "read-only",
-+        "--model",
-+        "o3-mini",
-+    )
