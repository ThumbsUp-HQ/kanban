+        with pytest.raises(WebSocketDisconnect) as exc_info:
+            await extra_client.connect()
+        assert exc_info.value.code == WS_CLOSE_CONNECTION_LIMIT
+    finally:
+        for c in clients:
+            with contextlib.suppress(Exception):
