-+        code = f"authcode-{secrets.token_hex(8)}"
-+        self.issued_codes[code] = IssuedAuthCode(
-+            code=code,
-+            client_id=client_id,
-+            redirect_uri=redirect_uri,
-+            scope="openid",
-+            state=state,
-+            nonce=nonce,
-+            code_challenge=code_challenge,
