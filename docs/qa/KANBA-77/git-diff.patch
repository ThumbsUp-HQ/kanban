-
--- Function 1: oidc_request_create
-CREATE OR REPLACE FUNCTION kb_auth.oidc_request_create(
-    p_card_id UUID,
-    p_state_hash BYTEA,
-    p_nonce BYTEA,
-    p_code_verifier_sealed BYTEA,
-    p_browser_binding_hash BYTEA,
-    p_return_to TEXT,
-    p_link_intent_id UUID,
