-        files={"file": ("test.png", buf.getvalue(), "image/png")},
-    )
-    assert upload_resp.status_code == 201
-    signed_url = upload_resp.json()["signed_url"]
-
-    # 1. Tampered signature -> 403
-    tampered_url = signed_url[:-4] + "xxxx"
