-+
-+def test_positive_cli_args_validation() -> None:
-+    """Test Case 1: Validate positive argument vectors for agy and codex."""
-+    # agy with -p
-+    res_agy = validate_cli_args("agy", ["-p"])
-+    assert res_agy.argv == ("/usr/local/bin/agy", "-p")
