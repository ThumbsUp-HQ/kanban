-def encode_issue_cursor(sequence_id: int) -> str:
-    """Encode sequence_id into an opaque URL-safe base64 cursor."""
-    return base64.urlsafe_b64encode(str(sequence_id).encode("ascii")).decode("ascii").rstrip("=")
