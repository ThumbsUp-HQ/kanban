+    MAX_CONNECTIONS_PER_PRINCIPAL,
+    SSEConnection,
+)
+from kanban.security.permissions import Capability
+from kanban.tests.realtime.conftest import (
+    AsyncSSETestClient,
+    build_realtime_test_app,
+    create_auth_session,
