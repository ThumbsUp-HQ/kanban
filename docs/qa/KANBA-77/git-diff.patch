+        )
+
+        envelope = _FakeEnvelope(
+            workspace_id=ws_id,
+            object_id=issue_id,
+            project_id=fixture_data["proj_id"],
+        )
+        candidates = [admin_id, maya_id, other_id]
+        authorized = await authorize_event_recipients(session, envelope, candidates)
