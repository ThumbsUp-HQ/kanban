+                code="PROVENANCE_SELF_UPGRADE_FORBIDDEN",
+                status=403,
+                title="Provenance Self Upgrade Forbidden",
+                detail="Only verified agents can claim verified_agent provenance tier.",
+            )
+        return requested_tier
+
+    return base_channel_tier
