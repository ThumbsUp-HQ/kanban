+    assert resp.status_code == 200
+    assert resp.headers.get("X-Kanban-Untrusted-Taint") == "1"
+
+    # Verify mcp_read_taint records untrusted content
+    sess_hash = hashlib.sha256(session_id.encode("utf-8")).digest()
