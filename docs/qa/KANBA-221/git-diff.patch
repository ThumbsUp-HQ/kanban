@@ -0,0 +1,238 @@
+import React from 'react';
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import { MemoryRouter } from 'react-router';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import {
+  NotificationsBell,
+  formatEventBadge,
+  formatTimeAgo,
+} from './NotificationsBell';
+import { apiFetch } from '../../api/client';
+
+vi.mock('../../api/client', () => ({
+  apiFetch: vi.fn(),
+  apiClient: {
+    get: vi.fn(),
+    post: vi.fn(),
+    patch: vi.fn(),
+  },
+}));
+
+const mockApiFetch = vi.mocked(apiFetch);
+
+const mockNotifications = {
+  items: [
+    {
+      id: 'notif-1',
+      issue: { id: 'iss-1', key: 'KAN-101', summary: 'Fix login error' },
+      event_type: 'COMMENT_MENTION',
+      actor: { handle: 'alice', display_name: 'Alice' },
+      created_at: new Date(Date.now() - 5 * 60000).toISOString(), // 5m ago
+      read_at: null,
+    },
+    {
+      id: 'notif-2',
+      issue: { id: 'iss-2', key: 'KAN-102', summary: 'Add passkeys support' },
+      event_type: 'ASSIGNEE_ADDED',
+      actor: { handle: 'bob', display_name: 'Bob' },
+      created_at: new Date(Date.now() - 2 * 3600000).toISOString(), // 2h ago
+      read_at: null,
+    },
+    {
+      id: 'notif-3',
+      issue: { id: 'iss-3', key: 'OPS-201', summary: 'Verify agent gate' },
+      event_type: 'AGENT_GATE_FAILED',
+      actor: { label: 'Reality Checker' },
+      created_at: new Date(Date.now() - 86400000).toISOString(), // 1d ago
+      read_at: '2026-01-01T00:00:00Z',
+    },
+  ],
+};
+
+function renderComponent() {
+  const queryClient = new QueryClient({
+    defaultOptions: { queries: { retry: false, gcTime: 0 } },
+  });
+  return render(
+    <QueryClientProvider client={queryClient}>
+      <MemoryRouter>
+        <NotificationsBell />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+
+describe('NotificationsBell & Feed Tray', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockApiFetch.mockResolvedValue(mockNotifications);
+  });
+
+  it('renders bell button with unread count badge (2 unread)', async () => {
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    expect(bellBtn).toBeDefined();
+
+    const badge = await screen.findByTestId('notifications-badge');
+    expect(badge.textContent).toBe('2');
+  });
+
+  it('toggles notifications tray open and displays notification feed items', async () => {
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    fireEvent.click(bellBtn);
+
+    expect(await screen.findByTestId('notifications-tray')).toBeDefined();
+    expect(screen.getByText('Notifications')).toBeDefined();
+    expect(screen.getByText('Mark all read')).toBeDefined();
+
+    // Verify items
+    expect(screen.getByText('Fix login error')).toBeDefined();
+    expect(screen.getByText('Add passkeys support')).toBeDefined();
+    expect(screen.getByText('Verify agent gate')).toBeDefined();
+
+    // Verify event badges
+    expect(screen.getByText('@mention')).toBeDefined();
+    expect(screen.getByText('assigned')).toBeDefined();
+    expect(screen.getByText('🤖 gate')).toBeDefined();
+  });
+
+  it('handles clicking deep link to work item and dispatches kb:open-issue-peek', async () => {
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    fireEvent.click(bellBtn);
+
+    const peekListener = vi.fn();
+    window.addEventListener('kb:open-issue-peek', peekListener);
+
+    const link = await screen.findByTestId('notif-deep-link-KAN-101');
+    fireEvent.click(link);
+
+    expect(peekListener).toHaveBeenCalled();
+    const firstCall = peekListener.mock.calls[0];
+    expect(firstCall).toBeDefined();
+    const detail = (firstCall![0] as CustomEvent).detail;
+    expect(detail.issueKey).toBe('KAN-101');
+
+    // Tray closes after navigation
+    expect(screen.queryByTestId('notifications-tray')).toBeNull();
+    window.removeEventListener('kb:open-issue-peek', peekListener);
+  });
+
+  it('marks individual notification as read on checkmark click', async () => {
+    mockApiFetch.mockImplementation(async (method, path) => {
+      if (path.includes('/read')) return {};
+      return mockNotifications;
+    });
+
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    fireEvent.click(bellBtn);
+
+    const markReadBtn = await screen.findByTestId('mark-read-notif-1');
+    fireEvent.click(markReadBtn);
+
+    await waitFor(() => {
+      expect(mockApiFetch).toHaveBeenCalledWith('POST', '/api/v1/notifications/notif-1/read');
+    });
+  });
+
+  it('marks all notifications as read on Mark all read click', async () => {
+    mockApiFetch.mockImplementation(async (method, path) => {
+      if (path === '/api/v1/notifications/read-all') return { marked: 2 };
+      return mockNotifications;
+    });
+
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    fireEvent.click(bellBtn);
+
+    const markAllBtn = await screen.findByTestId('mark-all-read-btn');
+    fireEvent.click(markAllBtn);
+
+    await waitFor(() => {
+      expect(mockApiFetch).toHaveBeenCalledWith('POST', '/api/v1/notifications/read-all');
+    });
+  });
+
+  it('closes tray when Escape key is pressed or clicking outside', async () => {
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    fireEvent.click(bellBtn);
+
+    expect(await screen.findByTestId('notifications-tray')).toBeDefined();
+
+    // Escape closes
+    fireEvent.keyDown(window, { key: 'Escape' });
+    expect(screen.queryByTestId('notifications-tray')).toBeNull();
+
+    // Reopen and click outside
+    fireEvent.click(bellBtn);
+    expect(await screen.findByTestId('notifications-tray')).toBeDefined();
+
+    fireEvent.mouseDown(document.body);
+    expect(screen.queryByTestId('notifications-tray')).toBeNull();
+  });
+
+  it('renders empty state when there are 0 notifications', async () => {
+    mockApiFetch.mockResolvedValue({ items: [] });
+    renderComponent();
+
+    const bellBtn = await screen.findByTestId('notifications-bell');
+    fireEvent.click(bellBtn);
+
+    expect(await screen.findByTestId('notifications-empty')).toBeDefined();
+    expect(screen.getByText('No notifications yet')).toBeDefined();
+    expect(screen.queryByTestId('notifications-badge')).toBeNull();
+  });
+
+  it('formatEventBadge and formatTimeAgo cover all helper branches', () => {
+    expect(formatEventBadge('ISSUE_STATE_CHANGED').label).toBe('transition');
+    expect(formatEventBadge('UNKNOWN_CUSTOM_EVENT').label).toBe('update');
+
+    expect(formatTimeAgo(new Date(Date.now() - 10000).toISOString())).toBe('just now');
+    expect(formatTimeAgo(new Date(Date.now() - 300000).toISOString())).toBe('5m ago');
+    expect(formatTimeAgo(new Date(Date.now() - 7200000).toISOString())).toBe('2h ago');
+    expect(formatTimeAgo(new Date(Date.now() - 172800000).toISOString())).toBe('2d ago');
+    expect(formatTimeAgo('invalid-date')).toBe('');
+  });
+
+  it('covers >99 unread badge, nodash key deep link, and toggle close without refetch', async () => {
+    const manyUnread = Array.from({ length: 105 }, (_, i) => ({
+      id: `notif-${i}`,
+      issue: { id: `iss-${i}`, key: 'NODASHKEY', summary: `Item ${i}` },
+      event_type: 'COMMENT_MENTION',
+      actor: i === 0 ? { handle: 'charlie' } : {},
+      created_at: new Date().toISOString(),
+      read_at: null,
+    }));
+    mockApiFetch.mockResolvedValueOnce({ items: manyUnread });
+    renderComponent();
+
+    const badge = await screen.findByTestId('notifications-badge');
+    expect(badge.textContent).toBe('99+');
+
+    const bellBtn = screen.getByTestId('notifications-bell');
+    // Open
+    fireEvent.click(bellBtn);
+    expect(await screen.findByTestId('notifications-tray')).toBeDefined();
+
+    // Click item with nodash key
+    const links = screen.getAllByText('NODASHKEY');
+    fireEvent.click(links[0]!);
+    expect(screen.queryByTestId('notifications-tray')).toBeNull();
+
+    // Reopen and click bell again to close
+    fireEvent.click(bellBtn);
+    expect(await screen.findByTestId('notifications-tray')).toBeDefined();
+    fireEvent.click(bellBtn);
+    expect(screen.queryByTestId('notifications-tray')).toBeNull();
+  });
+});
diff --git a/kanban/web/src/features/notifications/NotificationsBell.tsx b/kanban/web/src/features/notifications/NotificationsBell.tsx
new file mode 100644
index 0000000..3bbf7c9
--- /dev/null
+++ b/kanban/web/src/features/notifications/NotificationsBell.tsx
@@ -0,0 +1,276 @@
+/**
+ * In-App Notifications Bell & Feed Tray (KANBA-221, S7.2 8l, KB-P3-06).
+ * Unread counter badge, @mention/assignment/transition/gate feed, Mark read / Mark all read,
+ * deep links to work items, and full keyboard dismissibility.
+ */
+
+import React, { useState, useEffect, useRef, useMemo, type JSX } from 'react';
+import { useNavigate } from 'react-router';
+import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
+import { apiFetch } from '../../api/client';
+import { qk } from '../../api/queryKeys';
+import './NotificationsBell.css';
+
+export interface NotificationItem {
+  id: string;
+  issue?: {
+    id?: string | null | undefined;
+    key?: string | null | undefined;
+    summary?: string | null | undefined;
+  } | null | undefined;
+  event_type?: string | null | undefined;
+  type?: string | null | undefined;
+  title?: string | null | undefined;
+  body?: string | null | undefined;
+  link?: string | null | undefined;
+  actor?: {
+    handle?: string | null | undefined;
+    display_name?: string | null | undefined;
+    label?: string | null | undefined;
+  } | null | undefined;
+  created_at: string;
+  read_at?: string | null | undefined;
+  read?: boolean | undefined;
+}
+
+export function formatEventBadge(eventType?: string | null | undefined): { label: string; className: string } {
+  const t = (eventType ?? '').toUpperCase();
+  if (t.includes('MENTION')) {
+    return { label: '@mention', className: 'notif-badge--mention' };
+  }
+  if (t.includes('ASSIGNEE') || t.includes('ASSIGN')) {
+    return { label: 'assigned', className: 'notif-badge--assigned' };
+  }
+  if (t.includes('STATE') || t.includes('TRANSITION')) {
+    return { label: 'transition', className: 'notif-badge--transition' };
+  }
+  if (t.includes('GATE')) {
+    return { label: '🤖 gate', className: 'notif-badge--gate' };
+  }
+  return { label: 'update', className: 'notif-badge--default' };
+}
+
+export function formatTimeAgo(isoString: string): string {
+  const diffMs = Date.now() - new Date(isoString).getTime();
+  if (isNaN(diffMs)) return '';
+  const mins = Math.floor(diffMs / 60000);
+  if (mins < 1) return 'just now';
+  if (mins < 60) return `${String(mins)}m ago`;
+  const hours = Math.floor(mins / 60);
+  if (hours < 24) return `${String(hours)}h ago`;
+  const days = Math.floor(hours / 24);
+  return `${String(days)}d ago`;
+}
+
+export function NotificationsBell(): JSX.Element {
+  const [isOpen, setIsOpen] = useState(false);
+  const containerRef = useRef<HTMLDivElement>(null);
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const navigate = useNavigate();
+  const queryClient = useQueryClient();
+
+  // Query notifications feed
+  const { data, refetch } = useQuery<{ items: NotificationItem[] }>({
+    queryKey: qk.notifications(),
+    queryFn: async () => {
+      try {
+        const res = (await apiFetch('GET', '/api/v1/notifications' as never, {
+          query: { limit: 30 },
+        })) as {
+          items?: NotificationItem[];
+        };
+        return { items: res.items ?? [] };
+      } catch {
+        return { items: [] };
+      }
+    },
+    refetchInterval: 30000,
+  });
+
+  const items = useMemo(() => data?.items ?? [], [data?.items]);
+  const unreadCount = useMemo(() => items.filter((n) => !n.read_at).length, [items]);
+
+  // Mark single notification read
+  const markReadMutation = useMutation({
+    mutationFn: async (id: string) => {
+      await apiFetch('POST', `/api/v1/notifications/${encodeURIComponent(id)}/read` as never);
+    },
+    onSuccess: () => {
+      void queryClient.invalidateQueries({ queryKey: qk.notifications() });
+    },
+  });
+
+  // Mark all read
+  const markAllReadMutation = useMutation({
+    mutationFn: async () => {
+      await apiFetch('POST', '/api/v1/notifications/read-all');
+    },
+    onSuccess: () => {
+      void queryClient.invalidateQueries({ queryKey: qk.notifications() });
+    },
+  });
+
+  // Close on outside click
+  useEffect(() => {
+    if (!isOpen) return;
+
+    function handlePointerDown(e: MouseEvent): void {
+      if (
+        containerRef.current &&
+        !containerRef.current.contains(e.target as Node)
+      ) {
+        setIsOpen(false);
+      }
+    }
+
+    function handleKeyDown(e: KeyboardEvent): void {
+      if (e.key === 'Escape') {
+        e.preventDefault();
+        setIsOpen(false);
+        triggerRef.current?.focus();
+      }
+    }
+
+    window.addEventListener('mousedown', handlePointerDown);
+    window.addEventListener('keydown', handleKeyDown);
+    return () => {
+      window.removeEventListener('mousedown', handlePointerDown);
+      window.removeEventListener('keydown', handleKeyDown);
+    };
+  }, [isOpen]);
+
+  const handleDeepLink = (issueKey: string): void => {
+    setIsOpen(false);
+    const pKey = issueKey.includes('-') ? issueKey.split('-')[0] : 'KAN';
+    void navigate(`/projects/${pKey}/issues?peek=${encodeURIComponent(issueKey)}`);
+    window.dispatchEvent(
+      new CustomEvent('kb:open-issue-peek', {
+        detail: { issueKey },
+        bubbles: true,
+      }),
+    );
+  };
+
+  return (
+    <div ref={containerRef} className="kb-notif-wrapper">
+      <button
+        ref={triggerRef}
+        type="button"
+        className="kb-notif-bell-btn"
+        aria-label={unreadCount > 0 ? `Notifications (${String(unreadCount)} unread)` : 'Notifications'}
+        aria-expanded={isOpen}
+        aria-haspopup="dialog"
+        onClick={() => {
+          setIsOpen(!isOpen);
+          if (!isOpen) void refetch();
+        }}
+        data-testid="notifications-bell"
+      >
+        <span aria-hidden="true" className="kb-notif-bell-icon">🔔</span>
+        {unreadCount > 0 && (
+          <span className="kb-notif-badge" data-testid="notifications-badge">
+            {unreadCount > 99 ? '99+' : unreadCount}
+          </span>
+        )}
+      </button>
+
+      {isOpen && (
+        <div
+          className="kb-notif-tray"
+          role="dialog"
+          aria-label="Notifications"
+          data-testid="notifications-tray"
+        >
+          <header className="kb-notif-tray-header">
+            <h3 className="kb-notif-tray-title">Notifications</h3>
+            {unreadCount > 0 && (
+              <button
+                type="button"
+                className="kb-notif-mark-all-btn"
+                onClick={() => {
+                  markAllReadMutation.mutate();
+                }}
+                disabled={markAllReadMutation.isPending}
+                data-testid="mark-all-read-btn"
+              >
+                Mark all read
+              </button>
+            )}
+          </header>
+
+          <div className="kb-notif-tray-body">
+            {items.length === 0 ? (
+              <div className="kb-notif-empty" data-testid="notifications-empty">
+                <span aria-hidden="true" className="kb-notif-empty-icon">🔕</span>
+                <p>No notifications yet</p>
+              </div>
+            ) : (
+              <ul className="kb-notif-list">
+                {items.map((item) => {
+                  const isUnread = item.read_at === null || item.read_at === undefined
+                    ? (item.read !== undefined ? !item.read : true)
+                    : false;
+                  const badge = formatEventBadge(item.event_type ?? item.type);
+                  const actorName =
+                    item.actor?.display_name ??
+                    (item.actor?.handle ? `@${item.actor.handle.replace(/^@+/, '')}` : (item.actor?.label ?? 'System'));
+
+                  return (
+                    <li
+                      key={item.id}
+                      className={`kb-notif-item ${isUnread ? 'kb-notif-item--unread' : ''}`}
+                      data-testid={`notification-item-${item.id}`}
+                    >
+                      <div className="kb-notif-item-top">
+                        <span className={`kb-notif-type-badge ${badge.className}`}>
+                          {badge.label}
+                        </span>
+                        <span className="kb-notif-time">{formatTimeAgo(item.created_at)}</span>
+                        {isUnread && (
+                          <button
+                            type="button"
+                            className="kb-notif-mark-read-btn"
+                            aria-label={`Mark as read: ${item.issue?.key ?? item.id}`}
+                            onClick={() => {
+                              markReadMutation.mutate(item.id);
+                            }}
+                            data-testid={`mark-read-${item.id}`}
+                            title="Mark as read"
+                          >
+                            ✓
+                          </button>
+                        )}
+                      </div>
+
+                      <div className="kb-notif-item-content">
+                        <span className="kb-notif-actor">{actorName}</span>
+                        {item.issue?.key ? (
+                          <a
+                            href={`?peek=${encodeURIComponent(item.issue.key)}`}
+                            className="kb-notif-link"
+                            onClick={(e) => {
+                              e.preventDefault();
+                              if (item.issue?.key) {
+                                handleDeepLink(item.issue.key);
+                              }
+                            }}
+                            data-testid={`notif-deep-link-${item.issue.key}`}
+                          >
+                            <span className="kb-notif-issue-key">{item.issue.key}</span>
+                            <span className="kb-notif-summary">{item.issue.summary ?? ''}</span>
+                          </a>
+                        ) : (
+                          <span className="kb-notif-summary">{item.title ?? item.body ?? 'Notification'}</span>
+                        )}
+                      </div>
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
