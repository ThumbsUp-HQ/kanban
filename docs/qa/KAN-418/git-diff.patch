+
+for (const dir of OUT_DIRS) {
+  fs.mkdirSync(dir, { recursive: true });
+}
+
+async function preparePageForScreenshot(page, vp, theme) {
+  await page.evaluate((t) => {
+    document.documentElement.dataset.theme = t;
+    localStorage.setItem('theme', t);
+  }, theme);
+
+  await page.addStyleTag({
+    content: `
+      .kb-app-shell, .kb-main-canvas {
+        height: auto !important;
+        max-height: none !important;
+        overflow: visible !important;
+      }
+      .kb-topbar, header {
+        position: static !important;
+      }
+      .realtime-status-chip {
+        display: inline-flex !important;
+        visibility: visible !important;
+      }
+    `,
+  });
+  await page.waitForTimeout(200);
+}
+
+async function saveScreenshot(page, filename) {
+  for (const dir of OUT_DIRS) {
+    const fullPath = path.join(dir, filename);
+    await page.screenshot({ path: fullPath, fullPage: true });
+  }
+  console.log(`[Captured] ${filename}`);
+}
+
+async function createContext(browser, width, height, theme) {
+  const context = await browser.newContext({
+    viewport: { width, height },
+    colorScheme: theme,
+    bypassCSP: true,
+  });
+
+  if (COOKIE_VAL) {
+    await context.addCookies([
+      {
+        name: 'kb_session',
+        value: COOKIE_VAL,
+        url: `http://127.0.0.1:${PORT}/`,
+        httpOnly: true,
+        sameSite: 'Lax',
+      },
+      {
+        name: 'kb_csrf',
+        value: CSRF_TOKEN,
+        url: `http://127.0.0.1:${PORT}/`,
+        httpOnly: false,
+        sameSite: 'Lax',
+      },
+    ]);
+  }
+
+  return context;
+}
+
+async function main() {
+  console.log(`Connecting to live Kanban application at ${BASE_URL}...`);
+  const browser = await chromium.launch({ headless: true });
+
+  try {
