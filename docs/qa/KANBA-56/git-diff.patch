+    row = await session.execute(
+        text("INSERT INTO workspaces (slug, name) VALUES (:slug, :name) RETURNING id"),
+        {"slug": ws_slug, "name": "Relay Concurrency Workspace"},
+    )
+    val = row.scalar_one()
+    if not isinstance(val, UUID):
+        val = UUID(str(val))
+    return val
