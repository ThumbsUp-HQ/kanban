index 0000000..606180a
--- /dev/null
+++ b/database/outbox/broker.py
@@ -0,0 +1,169 @@
+"""RealtimeBroker protocol, OutboxEnvelope, and enqueue helper."""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from datetime import datetime
+from typing import TYPE_CHECKING, Any, Literal, Protocol, runtime_checkable
+from uuid import UUID
+
+from sqlalchemy import text
+
+if TYPE_CHECKING:
+    from collections.abc import AsyncIterator, Mapping
+
+    from sqlalchemy.ext.asyncio import AsyncSession
+
+    from database.outbox.valkey_broker import ValkeyStreamClient
+
+_TOPIC_REGEX = re.compile(r"^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$")
+MAX_TOPIC_LENGTH = 128
+MAX_PAYLOAD_BYTES = 7168
+MAX_WIRE_BYTES = 7900
+
+
+class OutboxPayloadTooLargeError(ValueError):
+    """Raised when an outbox event payload exceeds PostgreSQL storage or notify limits."""
+
+
+@dataclass(frozen=True, slots=True)
+class OutboxEnvelope:
+    """Immutable wire envelope for reliable domain event fanout."""
+
+    id: UUID
+    seq: int
+    workspace_id: UUID
+    project_id: UUID | None
+    object_id: UUID | None
+    topic: str
+    payload: dict[str, Any]
+    created_at: datetime
+
+    def to_wire_json(self) -> str:
+        """Serialize envelope to compact deterministic JSON, validating wire size."""
+        doc = {
+            "created_at": self.created_at.isoformat(),
+            "id": str(self.id),
+            "object_id": str(self.object_id) if self.object_id is not None else None,
+            "payload": self.payload,
+            "project_id": str(self.project_id) if self.project_id is not None else None,
+            "seq": self.seq,
+            "topic": self.topic,
+            "workspace_id": str(self.workspace_id),
+        }
+        raw = json.dumps(doc, separators=(",", ":"), sort_keys=True)
+        raw_bytes = raw.encode("utf-8")
+        if len(raw_bytes) > MAX_WIRE_BYTES:
+            msg = (
+                f"Outbox envelope wire size ({len(raw_bytes)} bytes) "
+                f"exceeds {MAX_WIRE_BYTES}-byte NOTIFY ceiling"
+            )
+            raise OutboxPayloadTooLargeError(msg)
+        return raw
+
+    @classmethod
+    def from_wire_json(cls, raw: str) -> OutboxEnvelope:
+        """Deserialize envelope from compact JSON string."""
+        data = json.loads(raw)
+        return cls(
+            id=UUID(data["id"]),
+            seq=int(data["seq"]),
+            workspace_id=UUID(data["workspace_id"]),
+            project_id=UUID(data["project_id"]) if data.get("project_id") else None,
+            object_id=UUID(data["object_id"]) if data.get("object_id") else None,
+            topic=str(data["topic"]),
+            payload=dict(data.get("payload", {})),
+            created_at=datetime.fromisoformat(data["created_at"]),
+        )
+
+
+def topic_matches(pattern: str, topic: str) -> bool:
+    """Match topic against exact name, wildcard '*', or segment prefix wildcard."""
+    if pattern == "*":
+        return True
+    if pattern.endswith(".*"):
+        prefix = pattern[:-2]
+        return topic.startswith(prefix + ".")
+    return pattern == topic
+
+
+@runtime_checkable
+class RealtimeBroker(Protocol):
+    """Protocol for event fanout brokers (PgNotifyBroker and ValkeyBroker)."""
+
+    async def publish(self, event: OutboxEnvelope) -> None:
+        """Publish an outbox envelope to subscribers."""
+        ...
+
+    def subscribe(self, topic_pattern: str = "*") -> AsyncIterator[OutboxEnvelope]:
+        """Subscribe to events matching a topic pattern."""
+        ...
+
+    async def close(self) -> None:
+        """Release underlying connections and resources."""
+        ...
+
+
+async def enqueue_outbox_event(  # noqa: PLR0913
+    session: AsyncSession,
+    *,
+    workspace_id: UUID,
+    topic: str,
+    payload: Mapping[str, Any],
+    project_id: UUID | None = None,
+    object_id: UUID | None = None,
+) -> UUID:
+    """Validate and atomically insert an outbox event in the caller's active transaction."""
+    if not _TOPIC_REGEX.match(topic) or len(topic) > MAX_TOPIC_LENGTH:
+        msg = f"Invalid outbox topic: {topic!r}"
+        raise ValueError(msg)
+
+    payload_json = json.dumps(payload, separators=(",", ":"), sort_keys=True)
+    payload_bytes = payload_json.encode("utf-8")
+    if len(payload_bytes) > MAX_PAYLOAD_BYTES:
+        msg = (
+            f"Payload size ({len(payload_bytes)} bytes) "
+            f"exceeds {MAX_PAYLOAD_BYTES}-byte storage ceiling"
+        )
+        raise OutboxPayloadTooLargeError(msg)
+
+    result = await session.execute(
+        text(
+            "INSERT INTO outbox_events ("
+            "  workspace_id, project_id, object_id, topic, payload"
+            ") VALUES (:ws_id, :proj_id, :obj_id, :topic, CAST(:payload AS jsonb)) "
+            "RETURNING id"
+        ),
+        {
+            "ws_id": workspace_id,
+            "proj_id": project_id,
+            "obj_id": object_id,
+            "topic": topic,
+            "payload": payload_json,
+        },
+    )
+    return UUID(str(result.scalar_one()))
+
+
+def build_realtime_broker(
+    deployment_mode: Literal["standalone", "production"],
+    *,
+    pg_dsn: str,
+    valkey_client: ValkeyStreamClient | None = None,
+    require_valkey: bool = False,
+) -> RealtimeBroker:
+    """Construct RealtimeBroker implementation based on deployment mode and client availability."""
+    if deployment_mode == "production" and require_valkey and valkey_client is None:
+        msg = "Production mode with require_valkey=True requires a non-None valkey_client"
+        raise ValueError(msg)
+
+    if deployment_mode == "standalone" or valkey_client is None:
+        from database.outbox.pg_broker import PgNotifyBroker  # noqa: PLC0415
+
+        return PgNotifyBroker(pg_dsn)
+
+    from database.outbox.valkey_broker import ValkeyBroker  # noqa: PLC0415
+
+    return ValkeyBroker(valkey_client)
diff --git a/database/outbox/pg_broker.py b/database/outbox/pg_broker.py
new file mode 100644
index 0000000..40cd1d7
--- /dev/null
+++ b/database/outbox/pg_broker.py
@@ -0,0 +1,130 @@
+"""PostgreSQL LISTEN/NOTIFY implementation of RealtimeBroker."""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+from typing import TYPE_CHECKING
+
+import asyncpg  # type: ignore[import-untyped]
+
+from database.outbox.broker import OutboxEnvelope, RealtimeBroker, topic_matches
+
+if TYPE_CHECKING:
+    from collections.abc import AsyncIterator
+
+logger = logging.getLogger("database.outbox.pg_broker")
+
+DEFAULT_CHANNEL = "kanban_realtime"
+MAX_QUEUE_SIZE = 1024
+
+
+class PgNotifyBroker(RealtimeBroker):
+    """Zero-Valkey standalone broker using PostgreSQL LISTEN/NOTIFY."""
+
+    def __init__(self, pg_dsn: str, channel: str = DEFAULT_CHANNEL) -> None:
+        """Initialize PostgreSQL notify broker with DSN and target channel."""
+        self._dsn = pg_dsn.replace("postgresql+asyncpg://", "postgresql://")
+        self._channel = channel
+        self._listener_conn: asyncpg.Connection | None = None
+        self._publisher_conn: asyncpg.Connection | None = None
+        self._subscribers: dict[asyncio.Queue[OutboxEnvelope | None], str] = {}
+        self._lock = asyncio.Lock()
+        self._closed = False
+
+    async def _ensure_listener(self) -> asyncpg.Connection:
+        async with self._lock:
+            if self._closed:
+                msg = "Broker is closed"
+                raise RuntimeError(msg)
+            if self._listener_conn is None or self._listener_conn.is_closed():
+                conn = await asyncpg.connect(self._dsn)
+                await conn.add_listener(self._channel, self._on_notification)
+                self._listener_conn = conn
+            return self._listener_conn
+
+    async def _ensure_publisher(self) -> asyncpg.Connection:
+        async with self._lock:
+            if self._closed:
+                msg = "Broker is closed"
+                raise RuntimeError(msg)
+            if self._publisher_conn is None or self._publisher_conn.is_closed():
+                self._publisher_conn = await asyncpg.connect(self._dsn)
+            return self._publisher_conn
+
+    def _on_notification(
+        self,
+        _connection: asyncpg.Connection,
+        _pid: int,
+        _channel: str,
+        payload: str,
+    ) -> None:
+        """Handle incoming NOTIFY payload and route to matching subscriber queues."""
+        try:
+            envelope = OutboxEnvelope.from_wire_json(payload)
+        except Exception:
+            logger.exception("Failed to deserialize wire JSON from notify payload")
+            return
+
+        for queue, pattern in list(self._subscribers.items()):
+            if topic_matches(pattern, envelope.topic):
+                if queue.full():
+                    with contextlib.suppress(asyncio.QueueEmpty):
+                        queue.get_nowait()
+                    logger.warning(
+                        "REALTIME_SUBSCRIBER_LAGGED: dropped oldest envelope for topic %s",
+                        envelope.topic,
+                    )
+                with contextlib.suppress(asyncio.QueueFull):
+                    queue.put_nowait(envelope)
+
+    async def publish(self, event: OutboxEnvelope) -> None:
+        """Publish an OutboxEnvelope over PostgreSQL NOTIFY."""
+        if self._closed:
+            msg = "Broker is closed"
+            raise RuntimeError(msg)
+        wire_json = event.to_wire_json()
+        conn = await self._ensure_publisher()
+        await conn.execute("SELECT pg_notify($1, $2)", self._channel, wire_json)
+
+    async def subscribe(self, topic_pattern: str = "*") -> AsyncIterator[OutboxEnvelope]:
+        """Subscribe to envelopes matching the topic pattern."""
+        await self._ensure_listener()
+        queue: asyncio.Queue[OutboxEnvelope | None] = asyncio.Queue(maxsize=MAX_QUEUE_SIZE)
+        self._subscribers[queue] = topic_pattern
+        try:
+            while not self._closed:
+                item = await queue.get()
+                if item is None:
+                    break
+                yield item
+        finally:
+            self._subscribers.pop(queue, None)
+
+    async def close(self) -> None:
+        """Close connections and release subscribers."""
+        async with self._lock:
+            if self._closed:
+                return
+            self._closed = True
+
+            for queue in list(self._subscribers.keys()):
+                with contextlib.suppress(asyncio.QueueFull):
+                    queue.put_nowait(None)
+            self._subscribers.clear()
+
+            if self._listener_conn is not None and not self._listener_conn.is_closed():
+                try:
+                    await self._listener_conn.remove_listener(self._channel, self._on_notification)
+                    await self._listener_conn.close()
+                except Exception:
+                    logger.debug("Error closing listener connection", exc_info=True)
+                self._listener_conn = None
+
+            if self._publisher_conn is not None and not self._publisher_conn.is_closed():
+                try:
+                    await self._publisher_conn.close()
+                except Exception:
+                    logger.debug("Error closing publisher connection", exc_info=True)
+                self._publisher_conn = None
