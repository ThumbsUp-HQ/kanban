+    await expect(modalCard).toBeVisible();
+
+    await page.locator('[data-testid="mint-label-input"]').fill('Landscape Token');
+
+    await page.screenshot({
+      path: resolve(SCREENSHOT_DIR, '06-844x390-mobile-landscape.png'),
