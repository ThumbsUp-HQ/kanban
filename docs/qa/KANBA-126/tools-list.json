{
  "tools": [
    {
      "name": "search_tickets",
      "description": "Search tickets by text and structured filters under caller permissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional lexical query string"
          },
          "project": {
            "type": "string",
            "description": "Project key or UUID"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "State names or UUIDs"
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Assignee handles (@handle), 'me', or UUIDs"
          },
          "cycle": {
            "type": "string",
            "description": "Cycle number or UUID"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Module names or UUIDs"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Label names or UUIDs"
          },
          "blocked": {
            "type": "boolean",
            "description": "true = has open inbound BLOCKS links"
          },
          "gate_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "description": "Filter by gate review status"
          },
          "mode": {
            "type": "string",
            "enum": [
              "lexical",
              "hybrid"
            ],
            "default": "lexical",
            "description": "Search mode ('lexical' or 'hybrid')"
          },
          "lod": {
            "type": "string",
            "enum": [
              "summary",
              "standard"
            ],
            "default": "summary",
            "description": "Level of detail for returned items"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20,
            "description": "Maximum number of items to return (1..50)"
          },
          "cursor": {
            "type": "string",
            "maxLength": 200,
            "description": "Opaque pagination cursor from previous response"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "read_ticket",
      "description": "Read ticket details, markdown, links, comments, and activity at chosen LOD.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Issue key (e.g. 'KAN-142'), UUID, or 'help'"
          },
          "lod": {
            "type": "string",
            "enum": [
              "summary",
              "standard",
              "full"
            ],
            "default": "standard",
            "description": "Level of detail for response projection"
          },
          "comments_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "default": 20,
            "description": "Maximum comments to return (0..50)"
          }
        },
        "required": [
          "identifier"
        ],
        "additionalProperties": false
      }
    }
  ]
}