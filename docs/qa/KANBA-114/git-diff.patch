+function TestShellPanelOpener({ uuid }: { uuid: string }) {
+  const { openPanel } = useShellPanels();
+  return (
+    <button type="button" onClick={() => { openPanel('access', uuid); }}>
+      Shell Open Trigger
+    </button>
+  );
+}
