+/**
+ * Effective Access Inspector Popover styles (KB-P3-49, S3.4, S6.1, S6.2).
+ * Breathable Jira/Plane spatial rhythm, strict CSSOM positioning, CSP clean.
+ */
+
+:root {
+  --prop-row-h: 38px;
+}
+
+.access-inspector-backdrop {
+  position: fixed;
+  inset: 0;
+  background-color: rgba(15, 23, 42, 0.4);
+  z-index: 999;
+  backdrop-filter: blur(1px);
+}
+
+.access-inspector {
+  position: fixed;
+  width: min(520px, calc(100vw - 32px));
+  max-height: min(680px, 85vh);
+  background-color: var(--bg-surface-raised, #ffffff);
+  color: var(--text-primary, #0f172a);
+  border: 1px solid var(--border-subtle, #e2e8f0);
+  border-radius: var(--radius-lg, 10px);
+  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
+  display: flex;
+  flex-direction: column;
+  z-index: 1000;
+  overflow: hidden;
+  box-sizing: border-box;
+}
+
+@media (max-width: 767px) {
+  .access-inspector {
+    width: 100vw !important;
+    max-height: 88dvh !important;
+    bottom: 0 !important;
+    left: 0 !important;
+    top: auto !important;
+    border-radius: 16px 16px 0 0 !important;
+    transform: none !important;
+  }
+}
+
+.access-inspector__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 20px;
+  border-bottom: 1px solid var(--border-subtle, #e2e8f0);
+  background-color: var(--bg-surface, #ffffff);
+  gap: 12px;
+  flex-shrink: 0;
+}
+
+.access-inspector__title {
+  font-size: 13px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: var(--text-primary, #0f172a);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+}
+
+.access-inspector__header-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.access-inspector__close-btn {
+  background: transparent;
+  border: none;
+  font-size: 16px;
+  line-height: 1;
+  padding: 6px 8px;
+  border-radius: 6px;
+  cursor: pointer;
+  color: var(--text-secondary, #64748b);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.access-inspector__close-btn:hover {
+  background-color: var(--bg-surface-hover, #f1f5f9);
+  color: var(--text-primary, #0f172a);
+}
+
+.access-inspector__scope-banner {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 20px;
+  background-color: var(--bg-surface-sunken, #f8fafc);
+  border-bottom: 1px solid var(--border-subtle, #e2e8f0);
+  font-size: 13px;
+  flex-shrink: 0;
+}
+
+.access-inspector__scope-label {
+  font-weight: 600;
+  color: var(--text-secondary, #64748b);
+}
+
+.access-inspector__scope-badge {
+  color: var(--text-primary, #0f172a);
+  font-weight: 500;
+}
+
+.access-inspector__body {
+  padding: 16px 20px;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-5, 20px);
+  flex-grow: 1;
+}
+
+.access-inspector__section {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.access-inspector__section-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 12px;
+  font-weight: 700;
+  color: var(--text-secondary, #64748b);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  margin-bottom: 2px;
