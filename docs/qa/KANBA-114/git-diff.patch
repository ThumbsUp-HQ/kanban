+
+    for pid, dname in (
+        (admin_id, "Project Admin"),
+        (sa_id, "Server Admin"),
+    ):
+        await db_session.execute(
+            text("SELECT register_object('user'::object_kind, :ws, NULL, :ckey, :name, :uid, :id)"),
