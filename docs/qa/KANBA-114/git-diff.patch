diff --git a/kanban/web/src/features/access/AccessInspectorPopover.css b/kanban/web/src/features/access/AccessInspectorPopover.css
new file mode 100644
index 0000000..0384153
--- /dev/null
+++ b/kanban/web/src/features/access/AccessInspectorPopover.css
@@ -0,0 +1,360 @@
+/**
+ * Effective Access Inspector Popover styles (KB-P3-49, S3.4, S6.1, S6.2).
+ * Breathable Jira/Plane spatial rhythm, strict CSSOM positioning, CSP clean.
+ */
+
+:root {
+  --prop-row-h: 38px;
+}
+
+.access-inspector-backdrop {
+  position: fixed;
+  inset: 0;
+  background-color: rgba(15, 23, 42, 0.4);
+  z-index: 999;
+  backdrop-filter: blur(1px);
+}
+
+.access-inspector {
+  position: fixed;
+  width: min(520px, calc(100vw - 32px));
+  max-height: min(680px, 85vh);
+  background-color: var(--bg-surface-raised, #ffffff);
+  color: var(--text-primary, #0f172a);
+  border: 1px solid var(--border-subtle, #e2e8f0);
+  border-radius: var(--radius-lg, 10px);
+  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
+  display: flex;
+  flex-direction: column;
+  z-index: 1000;
+  overflow: hidden;
+  box-sizing: border-box;
+}
+
+@media (max-width: 767px) {
+  .access-inspector {
+    width: 100vw !important;
+    max-height: 88dvh !important;
+    bottom: 0 !important;
+    left: 0 !important;
+    top: auto !important;
+    border-radius: 16px 16px 0 0 !important;
+    transform: none !important;
+  }
+}
+
+.access-inspector__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 20px;
+  border-bottom: 1px solid var(--border-subtle, #e2e8f0);
+  background-color: var(--bg-surface, #ffffff);
+  gap: 12px;
+  flex-shrink: 0;
+}
+
+.access-inspector__title {
+  font-size: 13px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: var(--text-primary, #0f172a);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+}
+
+.access-inspector__header-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.access-inspector__close-btn {
+  background: transparent;
+  border: none;
+  font-size: 16px;
+  line-height: 1;
+  padding: 6px 8px;
+  border-radius: 6px;
+  cursor: pointer;
+  color: var(--text-secondary, #64748b);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.access-inspector__close-btn:hover {
+  background-color: var(--bg-surface-hover, #f1f5f9);
+  color: var(--text-primary, #0f172a);
+}
+
+.access-inspector__scope-banner {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 20px;
+  background-color: var(--bg-surface-sunken, #f8fafc);
+  border-bottom: 1px solid var(--border-subtle, #e2e8f0);
+  font-size: 13px;
+  flex-shrink: 0;
+}
+
+.access-inspector__scope-label {
+  font-weight: 600;
+  color: var(--text-secondary, #64748b);
+}
+
+.access-inspector__scope-badge {
+  color: var(--text-primary, #0f172a);
+  font-weight: 500;
+}
+
+.access-inspector__body {
+  padding: 16px 20px;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-5, 20px);
+  flex-grow: 1;
+}
+
+.access-inspector__section {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.access-inspector__section-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 12px;
+  font-weight: 700;
+  color: var(--text-secondary, #64748b);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  margin-bottom: 2px;
+}
+
+.access-inspector__section-title {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.access-inspector__row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-height: var(--prop-row-h, 38px);
+  padding: var(--space-2, 8px) var(--space-4, 16px);
+  background-color: var(--bg-surface, #ffffff);
+  border-radius: 6px;
+  border: 1px solid var(--border-subtle, #e2e8f0);
+  font-size: 13px;
+  box-sizing: border-box;
+}
+
+.access-inspector__row-left {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.access-inspector__row-right {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-shrink: 0;
+}
+
+.access-inspector__empty {
+  font-size: 13px;
+  color: var(--text-muted, #94a3b8);
+  font-style: italic;
+  padding: 6px 16px;
+}
+
+.access-inspector__badge {
+  display: inline-flex;
+  align-items: center;
+  padding: 2px 8px;
+  border-radius: 4px;
+  font-size: 11px;
+  font-weight: 600;
+  background-color: var(--bg-surface-sunken, #f1f5f9);
+  color: var(--text-secondary, #475569);
+  border: 1px solid var(--border-subtle, #cbd5e1);
+}
+
+.access-inspector__badge--admin {
+  background-color: #eff6ff;
+  color: #1d4ed8;
+  border-color: #bfdbfe;
+}
+
+.access-inspector__badge--edit {
+  background-color: #f0fdf4;
+  color: #15803d;
+  border-color: #bbf7d0;
+}
+
+.access-inspector__badge--comment {
+  background-color: #fefce8;
+  color: #a16207;
+  border-color: #fef08a;
+}
+
+.access-inspector__badge--view {
+  background-color: #f8fafc;
+  color: #475569;
+  border-color: #e2e8f0;
+}
+
+.access-inspector__tag {
+  font-size: 11px;
+  color: var(--text-secondary, #64748b);
+  font-weight: 500;
+}
+
+.access-inspector__deny-pill {
+  display: inline-flex;
+  align-items: center;
+  padding: 3px 8px;
+  font-size: 11px;
+  font-weight: 700;
+  border-radius: 9999px;
+  letter-spacing: 0.04em;
+  background-color: var(--danger-bg, #ffe4e6);
+  color: var(--danger-fg, #881337);
+  border: 1px solid var(--danger-fg, #881337);
+}
+
+.access-inspector__row--redacted {
+  background-color: var(--bg-surface-sunken, #f8fafc);
+  border-style: dashed;
+  color: var(--text-secondary, #64748b);
+}
+
+.access-inspector__redacted-label {
+  font-style: italic;
+  font-size: 12px;
+}
+
+.access-inspector__btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 12px;
+  font-weight: 600;
+  padding: 4px 10px;
+  border-radius: 6px;
+  cursor: pointer;
+  border: 1px solid transparent;
+  transition: all 120ms ease-in-out;
+}
+
+.access-inspector__btn--primary {
+  background-color: var(--primary, #2563eb);
+  color: #ffffff;
+}
+
+.access-inspector__btn--primary:hover {
+  background-color: var(--primary-hover, #1d4ed8);
+}
+
+.access-inspector__btn--secondary {
+  background-color: var(--bg-surface, #ffffff);
+  border-color: var(--border-subtle, #cbd5e1);
+  color: var(--text-primary, #0f172a);
+}
+
+.access-inspector__btn--secondary:hover {
+  background-color: var(--bg-surface-hover, #f1f5f9);
+}
+
+.access-inspector__btn--danger {
+  background-color: var(--danger-fg, #881337);
+  color: #ffffff;
+  border-color: var(--danger-fg, #881337);
+}
+
+.access-inspector__btn--danger:hover {
+  background-color: #4c0519;
+}
+
+.access-inspector__kill-switch-btn {
+  background: transparent;
+  border: none;
+  color: var(--danger-fg, #881337);
+  font-size: 11px;
+  font-weight: 700;
+  cursor: pointer;
+  padding: 2px 6px;
+  border-radius: 4px;
+}
+
+.access-inspector__kill-switch-btn:hover:not(:disabled) {
+  background-color: var(--danger-bg, #ffe4e6);
+}
