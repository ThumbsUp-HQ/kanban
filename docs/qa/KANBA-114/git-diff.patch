+
+    ident = f"P{uuid.uuid4().hex[:4].upper()}"
+    proj_id = await db_session.scalar(
+        text(
+            "SELECT register_object("
+            "'project'::object_kind, :ws, NULL, :ident, 'Custom Field Proj', :uid)"
