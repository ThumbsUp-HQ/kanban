-+def _cursor_error() -> ProblemException:
-+    return ProblemException(
-+        code="INVALID_CURSOR",
-+        status=422,
-+        title="Invalid Cursor",
-+        detail="The provided pagination cursor is invalid or mismatched.",
-+    )
