-def _encode_ber_length(length: int) -> bytes:
-    """Encode length into definite BER octets."""
-    if length < BER_SHORT_LEN_MAX:
-        return bytes([length])
-    octets: list[int] = []
-    val = length
-    while val > 0:
-        octets.append(val & 0xFF)
-        val >>= 8
-    octets.reverse()
-    return bytes([BER_SHORT_LEN_MAX | len(octets)]) + bytes(octets)
-
