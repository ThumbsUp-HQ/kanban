++
++export type TableColumnId =
++  | 'key'
++  | 'summary'
++  | 'state'
++  | 'priority'
++  | 'assignees'
++  | 'labels'
++  | 'cycle'
++  | 'modules'
++  | 'start_date'
++  | 'due_date'
++  | 'created_by'
++  | 'access';
++
++export interface TableColumnDef {
++  readonly id: TableColumnId;
++  readonly label: string;
++  readonly locked?: boolean;
++  readonly defaultVisible: boolean;
++  readonly sortable?: boolean;
++  readonly sortField?: string;
++}
++
++export const ALL_TABLE_COLUMNS: readonly TableColumnDef[] = Object.freeze([
++  Object.freeze({
++    id: 'key',
++    label: 'Key',
++    locked: true,
++    defaultVisible: true,
++    sortable: true,
++    sortField: 'key',
++  }),
++  Object.freeze({
++    id: 'summary',
++    label: 'Summary',
++    locked: true,
++    defaultVisible: true,
++    sortable: true,
++    sortField: 'summary',
++  }),
++  Object.freeze({
++    id: 'state',
++    label: 'State',
++    defaultVisible: true,
++    sortable: true,
