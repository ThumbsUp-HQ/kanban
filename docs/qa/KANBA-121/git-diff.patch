-+-- Migration: p3_06_notifications
-+-- Issue subscriptions, auto-subscribe rules, per-event mute & notifications via outbox (KB-P3-06)
-+
-+-- 1. Extend issue_subscriptions with muted_event_types and unsubscribed_at tombstone
-+ALTER TABLE issue_subscriptions ADD COLUMN IF NOT EXISTS muted_event_types TEXT[] NOT NULL DEFAULT '{}';
