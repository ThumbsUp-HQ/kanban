+++  color_hex: string;
+++}
+++
+++export interface PrincipalSummary {
+++  id: string;
+++  handle: string;
+++  display_name: string;
+++  type: string;
+++}
+++
+++export interface PrincipalAssignee {
+++  id: string;
+++  kind: 'principal';
+++  principal: PrincipalSummary;
+++}
