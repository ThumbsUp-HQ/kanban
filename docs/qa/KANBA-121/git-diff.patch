+    ];
+
+    render(
+      <TableView
+        issues={variedIssues}
+        projectKey="KAN"
+        modulesEnabled={true}
+        onToggleSelect={onToggleSelect}
+      />
+    );
+
+    const checkbox = screen.getByRole('checkbox', { name: 'Select KAN-301' });
+    fireEvent.click(checkbox);
+    expect(onToggleSelect).toHaveBeenCalledWith('KAN-301', true);
