+  font-size: 0.875rem;
+  color: var(--fg-primary);
+  box-sizing: border-box;
+}
+
+.quick-create-input:focus {
+  outline: 2px solid var(--focus-ring);
+  border-color: transparent;
+}
+
+.quick-create-textarea {
+  width: 100%;
+  min-height: 100px;
+  padding: var(--space-2, 8px) var(--space-3, 12px);
+  background: var(--bg-canvas);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md, 6px);
+  font-family: var(--font-sans);
+  font-size: 0.875rem;
+  color: var(--fg-primary);
+  box-sizing: border-box;
+  resize: vertical;
+}
+
+.quick-create-textarea:focus {
+  outline: 2px solid var(--focus-ring);
+  border-color: transparent;
+}
+
+.quick-create-row-fields {
+  display: flex;
+  gap: var(--space-3, 12px);
+}
+
+.quick-create-select {
+  width: 100%;
+  height: 36px;
+  padding: 0 var(--space-2, 8px);
+  background: var(--bg-canvas);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md, 6px);
+  font-family: var(--font-sans);
+  font-size: 0.8125rem;
+  color: var(--fg-primary);
+  box-sizing: border-box;
+}
+
+.quick-create-footer {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: var(--space-3, 12px);
+  margin-top: var(--space-2, 8px);
+}
+
+.quick-create-btn-cancel {
+  min-height: 36px;
+  padding: 0 var(--space-4, 16px);
+  background: transparent;
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md, 6px);
+  font-family: var(--font-sans);
+  font-size: 0.875rem;
+  font-weight: 500;
+  color: var(--fg-secondary);
+  cursor: pointer;
+}
+
+.quick-create-btn-submit {
+  min-height: 36px;
+  padding: 0 var(--space-4, 16px);
+  background: var(--accent-primary);
+  color: var(--accent-primary-fg);
+  border: none;
+  border-radius: var(--radius-md, 6px);
+  font-family: var(--font-sans);
+  font-size: 0.875rem;
+  font-weight: 500;
+  cursor: pointer;
+}
+
+.quick-create-btn-submit:hover {
+  opacity: 0.9;
+}
+
+/* ==========================================================================
+   Responsive Adaptations (Mobile <= 767px)
+   ========================================================================== */
+
+@media (max-width: 767px) {
+  .bulk-action-bar {
+    bottom: var(--space-4, 16px);
+    width: calc(100% - 32px);
+    overflow-x: auto;
+    justify-content: flex-start;
+  }
+
+  .bulk-btn {
+    min-height: 44px;
+    height: 44px;
+    padding: 0 var(--space-3, 12px);
+  }
+
+  .swimlane-col-headers {
+    overflow-x: auto;
+    width: 100%;
+  }
+
+  .swimlane-band-columns {
+    flex-direction: column;
+    row-gap: var(--space-4, 16px);
+  }
+
+  .swimlane-band .board-column {
+    width: 100%;
+    min-width: 100%;
+    max-width: 100%;
+  }
+}
