diff --git a/kanban/web/src/features/table/TableView.tsx b/kanban/web/src/features/table/TableView.tsx
new file mode 100644
index 0000000..01c5fa8
--- /dev/null
+++ b/kanban/web/src/features/table/TableView.tsx
@@ -0,0 +1,388 @@
+import React, { useState, useMemo, type JSX } from 'react';
+import { ColumnConfigurator } from './ColumnConfigurator';
+import {
+  type TableColumnId,
+  ALL_TABLE_COLUMNS,
+  getDefaultColumns,
+  parseTableColumns,
+} from './tableColumns';
+import { EmojiHint } from '../../components/emoji/EmojiHint';
+import type { IssueItem, SortDirection } from '../views/viewsApi';
+import '../views/listTable.css';
+
+export interface TableViewProps {
+  issues: IssueItem[];
+  projectKey: string;
+  modulesEnabled?: boolean;
+  selectedIds?: string[];
+  onToggleSelect?: (key: string, selected: boolean) => void;
+  onSelectAll?: (selected: boolean) => void;
+  onCreateIssue?: () => void;
+  nextCursor?: string | null;
+  onLoadMore?: () => void;
+  isLoading?: boolean;
+}
+
+export function TableView({
+  issues,
+  projectKey,
+  modulesEnabled = true,
+  selectedIds = [],
+  onToggleSelect,
+  onSelectAll,
+  onCreateIssue,
+  nextCursor,
+  onLoadMore,
+  isLoading = false,
+}: TableViewProps): JSX.Element {
+  // Load saved columns from localStorage
+  const [columns, setColumns] = useState<TableColumnId[]>(() => {
+    try {
+      const stored = localStorage.getItem(`kb.tableCols.${projectKey}`);
+      return parseTableColumns(stored, projectKey, modulesEnabled);
+    } catch {
+      return getDefaultColumns(modulesEnabled);
+    }
+  });
+
+  // Sorting state
+  const [sortField, setSortField] = useState<TableColumnId | null>(null);
+  const [sortDir, setSortDir] = useState<SortDirection>('none');
+
+  const handleSortClick = (colId: TableColumnId) => {
+    if (sortField !== colId) {
+      setSortField(colId);
+      setSortDir('asc');
+    } else if (sortDir === 'asc') {
+      setSortDir('desc');
+    } else {
+      setSortField(null);
+      setSortDir('none');
+    }
+  };
+
+  // Sort issues deterministically
+  const sortedIssues = useMemo(() => {
+    if (!sortField || sortDir === 'none') {
+      return issues;
+    }
+
+    return [...issues].sort((a, b) => {
+      let cmp = 0;
+      if (sortField === 'key') {
+        cmp = a.key.localeCompare(b.key);
+      } else if (sortField === 'summary') {
+        cmp = a.summary.localeCompare(b.summary);
+      } else if (sortField === 'state') {
+        const sA = a.state.name;
+        const sB = b.state.name;
+        cmp = sA.localeCompare(sB);
+      } else if (sortField === 'priority') {
+        const pA = a.priority.sort_order ?? 999;
+        const pB = b.priority.sort_order ?? 999;
+        cmp = pA - pB;
+      } else if (sortField === 'due_date') {
+        const dA = a.due_date ?? '';
+        const dB = b.due_date ?? '';
+        cmp = dA.localeCompare(dB);
+      } else if (sortField === 'start_date') {
+        const dA = a.start_date ?? '';
+        const dB = b.start_date ?? '';
+        cmp = dA.localeCompare(dB);
+      } else if (sortField === 'created_by') {
+        const cA = (a.created_by_handle ?? a.created_by_id) ?? '';
+        const cB = (b.created_by_handle ?? b.created_by_id) ?? '';
+        cmp = cA.localeCompare(cB);
+      }
+
+      if (cmp !== 0) {
+        return sortDir === 'asc' ? cmp : -cmp;
+      }
+      // Tie break on key
+      return a.key.localeCompare(b.key);
+    });
+  }, [issues, sortField, sortDir]);
+
+  const selectedSet = useMemo(() => new Set(selectedIds), [selectedIds]);
+  const allSelected = issues.length > 0 && issues.every((i) => selectedSet.has(i.key));
+
+  const colDefMap = useMemo(() => {
+    const map = new Map<TableColumnId, (typeof ALL_TABLE_COLUMNS)[number]>();
+    for (const c of ALL_TABLE_COLUMNS) {
+      map.set(c.id, c);
+    }
+    return map;
+  }, []);
+
+  // Filter columns to active and valid (strictly omitting modules if modulesEnabled is false)
+  const activeColumns = useMemo(() => {
+    return columns.filter((colId) => {
+      if (colId === 'modules' && !modulesEnabled) {
+        return false;
+      }
+      return true;
+    });
+  }, [columns, modulesEnabled]);
+
+  if (issues.length === 0) {
+    return (
+      <div className="view-empty-state">
+        <h2 className="view-empty-title">No work items found</h2>
+        <p className="view-empty-desc">Get started by creating the first work item in this project.</p>
+        <button
+          type="button"
+          className="view-empty-create-btn"
+          onClick={onCreateIssue}
+        >
+          + Create first work item
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="table-view-container">
+      <div className="table-toolbar">
+        <span className="mono">{issues.length} items</span>
+        <ColumnConfigurator
+          columns={activeColumns}
+          onChange={setColumns}
+          projectKey={projectKey}
+          modulesEnabled={modulesEnabled}
+        />
+      </div>
+
+      <div className="table-scroll-wrap">
+        <table className="issues-table">
+          <thead className="issues-table-head">
+            <tr className="table-header-row">
+              <th className="sticky-col table-key-header" data-col-header="key">
+                <div className="table-key-cell-content">
+                  <input
+                    type="checkbox"
+                    checked={allSelected}
+                    aria-label="Select all issues"
+                    onChange={(e) => onSelectAll?.(e.target.checked)}
+                  />
+                  <button
+                    type="button"
+                    className="issues-table-sort-btn"
+                    onClick={() => { handleSortClick('key'); }}
+                  >
+                    <span>Key</span>
+                    {sortField === 'key' && (
+                      <span className="issues-table-sort-icon">
+                        {sortDir === 'asc' ? '▲' : '▼'}
+                      </span>
+                    )}
+                  </button>
+                </div>
+              </th>
+
+              {activeColumns
+                .filter((id) => id !== 'key')
+                .map((colId) => {
+                  const def = colDefMap.get(colId);
+                  const label = def?.label ?? colId;
+                  const isSortable = def?.sortable;
+                  const isCurrentSort = sortField === colId;
+                  let ariaSort: 'none' | 'ascending' | 'descending' = 'none';
+                  if (isCurrentSort) {
+                    ariaSort = sortDir === 'asc' ? 'ascending' : 'descending';
+                  }
+
+                  return (
+                    <th
+                      key={colId}
+                      data-col-header={colId}
+                      aria-sort={isSortable ? ariaSort : undefined}
+                    >
+                      {isSortable ? (
+                        <button
+                          type="button"
+                          className="issues-table-sort-btn"
+                          onClick={() => { handleSortClick(colId); }}
+                        >
+                          <span>{label}</span>
+                          {isCurrentSort && (
+                            <span className="issues-table-sort-icon">
+                              {sortDir === 'asc' ? '▲' : '▼'}
+                            </span>
+                          )}
+                        </button>
+                      ) : (
+                        <span>{label}</span>
+                      )}
+                    </th>
+                  );
+                })}
+            </tr>
+          </thead>
+
+          <tbody className="issues-table-body">
+            {sortedIssues.map((issue) => {
+              const isSelected = selectedSet.has(issue.key);
+
+              // Priority mapping
+              let priorityKind: 'priorityUrgent' | 'priorityHigh' | 'priorityMedium' | 'priorityLow' =
+                'priorityMedium';
+              const pSlug = issue.priority.slug.toLowerCase();
+              if (pSlug === 'urgent') priorityKind = 'priorityUrgent';
+              else if (pSlug === 'high') priorityKind = 'priorityHigh';
+              else if (pSlug === 'low') priorityKind = 'priorityLow';
+
+              // Overdue check
+              const isTerminal =
+                issue.state.group === 'completed' || issue.state.group === 'cancelled';
+              let isOverdue = false;
+              if (issue.due_date && !isTerminal) {
+                const today = new Date().toISOString().slice(0, 10);
+                if (issue.due_date < today) {
+                  isOverdue = true;
+                }
+              }
+
+              return (
+                <tr
+                  key={issue.id || issue.key}
+                  data-issue-key={issue.key}
+                  className={`table-row ${isSelected ? 'table-row--selected' : ''}`.trim()}
+                >
+                  <td className="sticky-col">
+                    <div className="table-key-cell-content">
+                      <input
+                        type="checkbox"
+                        checked={isSelected}
+                        aria-label={`Select ${issue.key}`}
+                        onChange={(e) => onToggleSelect?.(issue.key, e.target.checked)}
+                      />
+                      <a
+                        href={`?layout=table&peek=${encodeURIComponent(issue.key)}`}
+                        className="mono table-key-link"
+                      >
+                        {issue.key}
+                      </a>
+                    </div>
+                  </td>
+
+                  {activeColumns
+                    .filter((id) => id !== 'key')
+                    .map((colId) => {
+                      if (colId === 'summary') {
+                        return <td key={colId}>{issue.summary}</td>;
+                      }
+                      if (colId === 'state') {
+                        return (
+                          <td key={colId}>
+                            <span className="status-pill">{issue.state.name}</span>
+                          </td>
+                        );
+                      }
+                      if (colId === 'priority') {
+                        return (
+                          <td key={colId}>
+                            <span className="table-priority-cell">
+                              <EmojiHint kind={priorityKind} testId={`hint-prio-${priorityKind}`} />
+                              <span>{issue.priority.label ? issue.priority.label : issue.priority.slug}</span>
+                            </span>
+                          </td>
+                        );
+                      }
+                      if (colId === 'assignees') {
+                        return (
+                          <td key={colId}>
+                            <div className="table-chips-wrap">
+                              {issue.assignees?.map((a) => (
+                                <span
+                                  key={a.id}
+                                  className={`assignee-chip ${a.kind === 'free_text' ? 'assignee-chip--external' : ''}`}
+                                >
+                                  {a.kind === 'free_text' && (
+                                    <EmojiHint
+                                      kind="externalAssignee"
+                                      testId="hint-external-assignee"
+                                    />
+                                  )}
+                                  <span>{a.kind === 'free_text' ? a.free_text : (a.principal.display_name ? a.principal.display_name : a.principal.handle)}</span>
+                                </span>
+                              ))}
+                            </div>
+                          </td>
+                        );
+                      }
+                      if (colId === 'labels') {
+                        return (
+                          <td key={colId}>
+                            <div className="table-chips-wrap">
+                              {issue.labels?.map((lbl) => (
+                                <span key={lbl.id} className="label-pill">
+                                  {lbl.name}
+                                </span>
+                              ))}
+                            </div>
+                          </td>
+                        );
+                      }
+                      if (colId === 'cycle') {
+                        return (
+                          <td key={colId}>
+                            {issue.cycle_id ? <span className="cycle-pill">Cycle</span> : null}
+                          </td>
+                        );
+                      }
+                      if (colId === 'modules') {
+                        return (
+                          <td key={colId}>
+                            {issue.module_ids && issue.module_ids.length > 0 ? (
+                              <span className="module-pill">Modules</span>
+                            ) : null}
+                          </td>
+                        );
+                      }
+                      if (colId === 'start_date') {
+                        return <td key={colId}>{issue.start_date ?? ''}</td>;
+                      }
+                      if (colId === 'due_date') {
+                        return (
+                          <td key={colId}>
+                            {issue.due_date ? (
+                              <span className={`due-pill ${isOverdue ? 'due-pill--overdue' : ''}`}>
+                                📅 {issue.due_date}
+                              </span>
+                            ) : (
+                              ''
+                            )}
+                          </td>
+                        );
+                      }
+                      if (colId === 'created_by') {
+                        return <td key={colId}>{issue.created_by_handle ?? issue.created_by_id}</td>;
+                      }
+                      return (
+                        <td key={colId}>
+                          {issue.has_explicit_acl && <EmojiHint kind="access" />}
+                        </td>
+                      );
+                    })}
+                </tr>
+              );
+            })}
+          </tbody>
+        </table>
+      </div>
+
+      {nextCursor && (
+        <div className="view-load-more">
+          <button
+            type="button"
+            className="view-load-more-btn"
+            disabled={isLoading}
+            onClick={onLoadMore}
+          >
+            {isLoading ? 'Loading...' : 'Load more'}
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/kanban/web/src/features/table/tableColumns.test.ts b/kanban/web/src/features/table/tableColumns.test.ts
new file mode 100644
index 0000000..8a00553
--- /dev/null
+++ b/kanban/web/src/features/table/tableColumns.test.ts
@@ -0,0 +1,141 @@
+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import {
+  ALL_TABLE_COLUMNS,
+  getDefaultColumns,
+  getAvailableColumns,
+  parseTableColumns,
+  reorderColumn,
+  toggleColumn,
+  saveTableColumns,
+  type TableColumnId,
+} from './tableColumns';
+
+describe('tableColumns', () => {
+  beforeEach(() => {
+    localStorage.clear();
+    vi.restoreAllMocks();
+  });
+
+  it('provides all expected column definitions', () => {
+    expect(ALL_TABLE_COLUMNS.length).toBe(12);
+    const ids = ALL_TABLE_COLUMNS.map((c) => c.id);
+    expect(ids).toContain('key');
+    expect(ids).toContain('summary');
+    expect(ids).toContain('state');
+    expect(ids).toContain('priority');
+    expect(ids).toContain('assignees');
+    expect(ids).toContain('labels');
+    expect(ids).toContain('cycle');
+    expect(ids).toContain('modules');
+    expect(ids).toContain('start_date');
+    expect(ids).toContain('due_date');
+    expect(ids).toContain('created_by');
+    expect(ids).toContain('access');
+  });
+
+  it('unmounts modules when modulesEnabled is false', () => {
+    const withModules = getAvailableColumns(true);
+    expect(withModules.some((c) => c.id === 'modules')).toBe(true);
+
+    const withoutModules = getAvailableColumns(false);
+    expect(withoutModules.some((c) => c.id === 'modules')).toBe(false);
+
+    const defaultWith = getDefaultColumns(true);
+    expect(defaultWith).toContain('modules');
+
+    const defaultWithout = getDefaultColumns(false);
+    expect(defaultWithout).not.toContain('modules');
+  });
+
+  it('parses valid and default columns from localStorage', () => {
+    const custom = ['key', 'summary', 'state', 'due_date'];
+    const parsed = parseTableColumns(JSON.stringify(custom), 'KAN', true);
+    expect(parsed).toEqual(['key', 'summary', 'state', 'due_date']);
+  });
+
+  it('handles negative/security hostile corrupt values gracefully', () => {
+    // Malformed JSON string
+    expect(parseTableColumns('{corrupt}', 'KAN', true)).toEqual(
+      getDefaultColumns(true)
+    );
+
+    // Hostile prototype injection object
+    expect(parseTableColumns('{"__proto__":1}', 'KAN', true)).toEqual(
+      getDefaultColumns(true)
+    );
+
+    // Hostile scripts or invalid IDs
+    const hostile = ['<script>', 'alert(1)', 'unknown'];
+    const parsed = parseTableColumns(JSON.stringify(hostile), 'KAN', true);
+    // Locked columns are prepended
+    expect(parsed).toContain('key');
+    expect(parsed).toContain('summary');
+
+    // Modules stripped when modulesEnabled is false even if explicitly present
+    const withStaleModules = ['key', 'summary', 'modules', 'state'];
+    const parsedNoMod = parseTableColumns(
+      JSON.stringify(withStaleModules),
+      'KAN',
+      false
+    );
+    expect(parsedNoMod).not.toContain('modules');
+    expect(parsedNoMod).toEqual(['key', 'summary', 'state']);
+  });
+
+  it('reorders non-locked columns and prevents illegal moves', () => {
+    const initial: TableColumnId[] = ['key', 'summary', 'state', 'priority', 'due_date'];
+
+    // Move priority up before state
+    const movedUp = reorderColumn(initial, 'priority', 'up');
+    expect(movedUp).toEqual(['key', 'summary', 'priority', 'state', 'due_date']);
+
+    // Move priority down
+    const movedDown = reorderColumn(movedUp, 'priority', 'down');
+    expect(movedDown).toEqual(initial);
+
+    // Cannot move locked key or summary
+    expect(reorderColumn(initial, 'key', 'down')).toEqual(initial);
+    expect(reorderColumn(initial, 'summary', 'down')).toEqual(initial);
+
+    // Cannot move beyond bounds
+    expect(reorderColumn(initial, 'state', 'up')).toEqual(initial); // cannot move into index 1 (summary is locked at index 1)
+    expect(reorderColumn(initial, 'due_date', 'down')).toEqual(initial);
+
+    // Unknown column returns unchanged
+    expect(reorderColumn(initial, 'access', 'up')).toEqual(initial);
+  });
+
+  it('toggles column visibility respecting locks and modulesEnabled', () => {
+    const initial: TableColumnId[] = ['key', 'summary', 'state'];
+
+    // Toggle start_date on
+    const withStart = toggleColumn(initial, 'start_date', true);
+    expect(withStart).toContain('start_date');
+
+    // Toggle start_date off
+    const withoutStart = toggleColumn(withStart, 'start_date', false);
+    expect(withoutStart).not.toContain('start_date');
+
+    // Cannot toggle locked columns off
+    expect(toggleColumn(initial, 'key', false)).toEqual(initial);
+    expect(toggleColumn(initial, 'summary', false)).toEqual(initial);
+
+    // Cannot toggle modules on if modulesEnabled is false
+    expect(toggleColumn(initial, 'modules', true, false)).not.toContain('modules');
+
+    // Redundant toggles return current list
+    expect(toggleColumn(initial, 'state', true)).toEqual(initial);
+    expect(toggleColumn(initial, 'access', false)).toEqual(initial);
+  });
+
+  it('saves columns to localStorage and handles storage exceptions', () => {
+    const cols: TableColumnId[] = ['key', 'summary', 'state'];
+    saveTableColumns(cols, 'KAN');
+    expect(localStorage.getItem('kb.tableCols.KAN')).toBe(JSON.stringify(cols));
+
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementationOnce(() => {
+      throw new Error('QuotaExceededError');
+    });
+    expect(() => { saveTableColumns(cols, 'KAN'); }).not.toThrow();
+  });
+});
