-            )
-            return _build_elevated_response(
-                elevated,
-                principal.session_id,
-                extra_data={
-                    "credential_id": str(cred_record.id),
-                    "nickname": cred_record.nickname,
-                },
-            )
-
-    return JSONResponse(
-        content={
-            "verified": True,
-            "credential_id": str(cred_record.id),
-            "nickname": cred_record.nickname,
