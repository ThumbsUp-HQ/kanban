+  font-size: 0.8125rem;
+  font-weight: 500;
+  color: var(--fg-secondary);
+}
+
+.quick-create-input {
+  width: 100%;
+  height: 38px;
+  padding: 0 var(--space-3, 12px);
+  background: var(--bg-canvas);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md, 6px);
