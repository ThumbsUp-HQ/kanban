+++
+++export type ViewComponent = ComponentType<ViewComponentProps>;
+++
+++export const VIEW_REGISTRY: Record<string, ViewComponent> = {
+++  list: ListView as ViewComponent,
+++  table: TableView as ViewComponent,
+++};
