+/**
+ * Breathable List & Configurable Table layout styling (KB-P3-38, S6.1, S6.2, S6.4).
+ */
+
+/* ==========================================================================
+   List View Container & Section Rhythm (S6.1, S6.4)
+   ========================================================================== */
+
+.list-view {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  padding: 0;
+  box-sizing: border-box;
+  background: var(--bg-canvas);
+}
+
+.list-section {
+  display: flex;
+  flex-direction: column;
+  margin-bottom: var(--space-6, 24px);
+  background: var(--bg-surface);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg, 10px);
+  overflow: hidden;
+}
+
+.list-section:last-child {
+  margin-bottom: 0;
+}
+
+.list-section-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  height: 40px;
+  min-height: 40px;
+  padding: 0 var(--space-4, 16px);
+  background: var(--bg-surface-raised, #ffffff);
+  border-bottom: 1px solid var(--border-subtle);
+  box-sizing: border-box;
+  user-select: none;
+}
+
+.list-section-toggle {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+  background: transparent;
+  border: none;
+  padding: 0;
+  font-family: var(--font-sans);
+  font-size: 0.875rem;
+  font-weight: 600;
+  color: var(--fg-primary);
+  cursor: pointer;
+  text-align: left;
+}
+
+.list-section-toggle:focus-visible {
+  outline: 2px solid var(--focus-ring);
+  outline-offset: 2px;
+  border-radius: var(--radius-sm, 4px);
+}
+
+.list-section-toggle-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+  color: var(--fg-muted);
+  transition: transform 150ms ease;
+}
+
+.list-section-toggle[aria-expanded="false"] .list-section-toggle-icon {
+  transform: rotate(-90deg);
+}
+
+.list-section-count {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 20px;
+  height: 20px;
+  padding: 0 6px;
+  font-family: var(--font-mono);
+  font-size: 0.75rem;
+  font-weight: 500;
+  border-radius: 9999px;
+  background: var(--bg-hover);
+  color: var(--fg-secondary);
+}
+
+.list-section-new-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-1, 4px);
+  background: transparent;
+  border: 1px dashed var(--border-strong);
+  border-radius: var(--radius-sm, 4px);
+  padding: 2px 8px;
+  font-family: var(--font-sans);
+  font-size: 0.75rem;
+  font-weight: 500;
+  color: var(--fg-secondary);
+  cursor: pointer;
+}
+
+.list-section-new-btn:hover {
+  background: var(--bg-hover);
+  color: var(--fg-primary);
+}
+
+/* ==========================================================================
+   Breathable 46px List Row (S6.1, S6.4 item 2)
+   ========================================================================== */
+
+.list-rows {
+  display: flex;
+  flex-direction: column;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.list-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  min-height: var(--list-row-h, 46px);
+  height: var(--list-row-h, 46px);
+  padding: var(--space-2, 8px) var(--space-4, 16px);
+  column-gap: var(--space-3, 12px);
+  border-bottom: 1px solid var(--border-subtle);
+  background: var(--bg-surface);
+  box-sizing: border-box;
+  text-decoration: none;
+  color: inherit;
+  transition: background-color 100ms ease;
+}
+
+.list-row .emoji-hint {
+  flex-shrink: 0;
+}
+
+.list-row:last-child {
+  border-bottom: none;
+}
+
+.list-row:hover {
+  background: var(--bg-hover);
+}
+
+.list-row:focus-visible {
+  outline: 2px solid var(--focus-ring);
+  outline-offset: -2px;
+}
+
+.list-row--selected {
+  background: rgba(37, 99, 235, 0.08);
+}
+
+.list-row-left {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3, 12px);
+  min-width: 0;
+  flex: 1;
+}
+
+.list-row-checkbox-wrap {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 20px;
+  min-height: 20px;
+}
+
+.list-row-checkbox {
+  width: 16px;
+  height: 16px;
+  cursor: pointer;
+  accent-color: var(--focus-ring);
+}
+
+.list-row-key {
+  font-family: var(--font-mono);
+  font-size: 0.8125rem;
+  font-weight: 600;
+  color: var(--fg-secondary);
+  text-decoration: none;
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+.list-row-key:hover {
+  color: var(--accent-primary);
+  text-decoration: underline;
+}
+
+.list-row-summary {
+  font-family: var(--font-sans);
+  font-size: var(--text-body, 0.9375rem);
+  color: var(--fg-primary);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  min-width: 0;
+  flex: 1;
+}
+
+.list-row-right {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+  flex-shrink: 0;
+}
+
+/* ==========================================================================
+   Table View & Semantic Table Styling (S6.4 item 2, S7.2 8f)
+   ========================================================================== */
+
+.table-view-container {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  background: var(--bg-surface);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg, 10px);
+  overflow: hidden;
+}
+
+.table-toolbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  height: 44px;
+  padding: 0 var(--space-4, 16px);
+  border-bottom: 1px solid var(--border-subtle);
+  background: var(--bg-surface-raised, #ffffff);
+}
+
+.table-scroll-wrap {
+  width: 100%;
+  overflow-x: auto;
+  position: relative;
+}
+
+.issues-table {
+  width: 100%;
+  border-collapse: collapse;
+  text-align: left;
+  font-family: var(--font-sans);
+  font-size: 0.875rem;
+}
+
+.issues-table-head {
+  position: sticky;
+  top: 0;
+  z-index: 3;
+  background: var(--bg-surface-raised, #ffffff);
+}
+
+.issues-table thead tr {
+  height: 40px;
+  border-bottom: 1px solid var(--border-strong);
+}
+
+.issues-table th {
+  padding: 0 var(--space-4, 16px);
+  font-weight: 600;
+  font-size: 0.8125rem;
+  color: var(--fg-secondary);
+  white-space: nowrap;
+  background: var(--bg-surface-raised, #ffffff);
+}
+
+.issues-table th.sticky-col {
+  position: sticky;
+  left: 0;
+  z-index: 4;
+  background: var(--bg-surface-raised, #ffffff);
+  border-right: 1px solid var(--border-subtle);
+}
+
+.issues-table-sort-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-1, 4px);
+  background: transparent;
+  border: none;
+  padding: 0;
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+}
+
+.issues-table-sort-btn:focus-visible {
+  outline: 2px solid var(--focus-ring);
+  outline-offset: 2px;
+  border-radius: var(--radius-sm, 4px);
+}
+
+.issues-table-sort-icon {
+  font-size: 0.75rem;
+  color: var(--fg-muted);
+}
+
+.issues-table-body tr {
+  height: var(--list-row-h, 46px);
+  min-height: var(--list-row-h, 46px);
+  border-bottom: 1px solid var(--border-subtle);
+  background: var(--bg-surface);
+  transition: background-color 100ms ease;
+}
+
+.issues-table-body tr:last-child {
+  border-bottom: none;
+}
+
+.issues-table-body tr:hover {
+  background: var(--bg-hover);
+}
+
+.issues-table td {
+  height: var(--list-row-h, 46px);
+  padding: 0 var(--space-4, 16px);
+  color: var(--fg-primary);
+  white-space: nowrap;
+  box-sizing: border-box;
+}
+
+.issues-table td.sticky-col {
+  position: sticky;
+  left: 0;
+  z-index: 2;
+  background: var(--bg-surface);
+  border-right: 1px solid var(--border-subtle);
+}
+
+.table-key-header {
+  width: 140px;
+}
+
+.table-key-cell-content {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+}
+
+.table-key-link {
+  color: var(--fg-secondary);
+  text-decoration: none;
+  font-weight: 600;
+}
+
+.table-key-link:hover {
+  text-decoration: underline;
+}
+
+.table-priority-cell {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.table-chips-wrap {
+  display: flex;
+  gap: 4px;
+  flex-wrap: wrap;
+}
+
+.issues-table-body tr:hover td.sticky-col {
+  background: var(--bg-hover);
+}
+
+/* ==========================================================================
+   Metadata Pills & Tags (S6.2, S7.2)
+   ========================================================================== */
+
+.mono {
+  font-family: var(--font-mono);
+}
+
+.status-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 2px 8px;
+  border-radius: var(--radius-sm, 4px);
+  background: var(--bg-hover);
+  font-size: 0.75rem;
+  font-weight: 500;
+  color: var(--fg-secondary);
+}
+
+.label-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 1px 6px;
+  border-radius: var(--radius-sm, 4px);
+  background: var(--bg-hover);
+  font-size: 0.75rem;
+  color: var(--fg-secondary);
+}
+
+.label-dot {
+  width: 8px;
