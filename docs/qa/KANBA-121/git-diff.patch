-+    reader_bad_tag = asyncio.StreamReader()
-+    reader_bad_tag.feed_data(bytes([0x31, 0x02, 0x00, 0x00]))
-+    with pytest.raises(LdapProtocolError, match="expected SEQUENCE tag 0x30"):
