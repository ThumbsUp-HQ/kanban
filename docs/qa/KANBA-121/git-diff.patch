++  }),
++  Object.freeze({
++    id: 'labels',
++    label: 'Labels',
++    defaultVisible: true,
++    sortable: false,
++  }),
++  Object.freeze({
++    id: 'cycle',
++    label: 'Cycle',
++    defaultVisible: true,
++    sortable: false,
++  }),
++  Object.freeze({
++    id: 'modules',
++    label: 'Modules',
++    defaultVisible: true,
++    sortable: false,
++  }),
++  Object.freeze({
++    id: 'start_date',
++    label: 'Start date',
++    defaultVisible: false,
++    sortable: true,
++    sortField: 'start_date',
