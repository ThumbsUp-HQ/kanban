+      />
+    );
+
+    const loadMoreBtn = screen.getByRole('button', { name: /Load more/i });
+    expect(loadMoreBtn).toBeDefined();
+    fireEvent.click(loadMoreBtn);
+    expect(onLoadMore).toHaveBeenCalledTimes(1);
+
+    rerender(
+      <TableView
+        issues={FIXTURE_12_ISSUES}
