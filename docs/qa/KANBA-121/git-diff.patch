+
+  it('renders active filter chips and allows removing them', () => {
+    const handleFiltersChange = vi.fn();
+    const active: ActiveFilters = {
+      gate_status: ['pending'],
+      priority: ['urgent', 'high'],
+    };
+
+    render(
+      <FilterDisplayBar
+        activeFilters={active}
+        onFiltersChange={handleFiltersChange}
+        groupBy="state"
+        subGroupBy="none"
+        modulesEnabled={true}
