+  box-sizing: border-box;
+  background: var(--bg-surface);
+  transition: background-color 100ms ease;
+  overflow: hidden;
+}
+
+.timeline-left-row:hover {
+  background: var(--bg-hover);
+}
+
+.timeline-left-row-key {
+  font-family: var(--font-mono, monospace);
+  font-weight: 600;
+  font-size: 0.8125rem;
+  color: var(--color-primary, #2563eb);
+  text-decoration: none;
+  flex-shrink: 0;
+}
+
+.timeline-left-row-summary {
+  font-size: 0.875rem;
+  color: var(--fg-primary);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  flex: 1;
+}
+
+/* Right scrollable canvas */
+.timeline-right-canvas-wrapper {
+  flex: 1;
+  overflow-x: auto;
+  overflow-y: hidden;
+  position: relative;
+  background: var(--bg-canvas);
+}
+
+.timeline-right-canvas {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+}
+
+.timeline-scale-header {
+  height: 40px;
+  min-height: 40px;
+  display: flex;
+  border-bottom: 1px solid var(--border-subtle);
+  background: var(--bg-surface-raised, #ffffff);
+  position: sticky;
+  top: 0;
+  z-index: 3;
+}
+
+.timeline-scale-cell {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-right: 1px solid var(--border-subtle);
+  font-family: var(--font-mono, monospace);
+  font-size: 0.75rem;
+  color: var(--fg-muted);
+  box-sizing: border-box;
+  flex-shrink: 0;
+  user-select: none;
+}
+
+.timeline-scale-cell--today {
+  font-weight: 700;
+  color: var(--color-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.05);
+}
+
+.timeline-track-rows {
+  display: flex;
+  flex-direction: column;
+  position: relative;
+}
+
+.timeline-track-row {
+  height: var(--list-row-h, 46px);
+  min-height: var(--list-row-h, 46px);
+  border-bottom: 1px solid var(--border-subtle);
+  position: relative;
+  box-sizing: border-box;
+  background: var(--bg-surface);
+}
+
+.timeline-track-row:hover {
+  background: var(--bg-hover);
+}
+
+.timeline-ghost-prompt {
+  display: flex;
+  align-items: center;
+  padding-left: var(--space-4, 16px);
+  height: 46px;
+  font-size: 0.75rem;
+  color: var(--fg-subtle);
+  font-style: italic;
+  cursor: pointer;
+  user-select: none;
+}
+
+.timeline-ghost-prompt:hover {
+  color: var(--fg-muted);
+}
+
+/* Scheduled Bar */
+.timeline-bar {
+  position: absolute;
+  top: 9px;
+  height: 28px;
+  border-radius: var(--radius-md, 6px);
+  background: var(--color-primary, #2563eb);
+  color: #ffffff;
+  display: flex;
+  align-items: center;
+  padding: 0 var(--space-2, 8px);
+  font-size: 0.75rem;
+  box-sizing: border-box;
+  cursor: grab;
+  user-select: none;
+  z-index: 2;
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+.timeline-bar:active {
+  cursor: grabbing;
+}
+
+.timeline-bar:focus-visible {
+  outline: 2px solid var(--focus-ring);
+  outline-offset: 2px;
+}
+
+.timeline-bar--overdue {
+  background: var(--warn-fg, #dc2626);
+}
+
+.timeline-bar-label {
+  display: flex;
+  align-items: center;
+  gap: var(--space-1, 4px);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.timeline-bar-key {
+  font-family: var(--font-mono, monospace);
+  font-weight: 700;
+}
+
+.timeline-bar-summary {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  opacity: 0.9;
+}
+
+.timeline-bar-handle-left,
+.timeline-bar-handle-right {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 8px;
+  cursor: ew-resize;
+  touch-action: none;
+}
+
+.timeline-bar-handle-left {
+  left: 0;
+}
+
+.timeline-bar-handle-right {
+  right: 0;
+}
+
+.timeline-bar-handle-left:hover,
+.timeline-bar-handle-right:hover {
+  background: rgba(255, 255, 255, 0.3);
+}
+
+/* Milestone Diamond (single date) */
+.timeline-milestone {
+  position: absolute;
+  top: 13px;
+  width: 20px;
+  height: 20px;
+  transform: rotate(45deg);
+  background: var(--color-primary, #2563eb);
+  border-radius: 2px;
+  z-index: 2;
+  cursor: pointer;
+  box-shadow: var(--shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.1));
+}
+
+.timeline-milestone:focus-visible {
+  outline: 2px solid var(--focus-ring);
+}
+
+.timeline-milestone--overdue {
+  background: var(--warn-fg, #dc2626);
+}
+
+/* SVG Overlay for BLOCKS dependency arrows */
+.timeline-svg-overlay {
+  position: absolute;
+  top: 0;
+  left: 0;
+  pointer-events: none;
+  z-index: 1;
+}
+
+.gantt-arrow {
+  fill: none;
+  stroke: var(--color-primary, #2563eb);
+  stroke-width: 2px;
+}
+
+.gantt-arrow--conflict {
+  stroke: var(--warn-fg, #dc2626);
+  stroke-dasharray: 4 4;
+}
+
+/* Mobile Timeline (< 767px): shrink left pane to 132px key rail */
+@media (max-width: 767px) {
+  .timeline-left-pane {
+    width: 132px;
+    min-width: 132px;
+  }
+
+  .timeline-left-row .timeline-left-row-summary {
+    display: none;
+  }
+}
