+import { renderHook, act } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { patchIssueSchedule, useRescheduleIssue } from './scheduleMutation';
+
+describe('scheduleMutation', () => {
+  const originalFetch = globalThis.fetch;
+
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  afterEach(() => {
+    globalThis.fetch = originalFetch;
+  });
+
+  it('patchIssueSchedule sends PATCH request with JSON body and If-Match header', async () => {
+    const mockResponse = {
+      id: 'issue-142',
+      key: 'KAN-142',
+      summary: 'Task 142',
+      start_date: '2026-11-12',
+      due_date: '2026-11-20',
+      state: { id: 's1', name: 'Todo', group: 'unstarted' },
+      priority: { slug: 'medium', label: 'Medium' },
+    };
+
+    const mockFetch = vi.fn().mockResolvedValue({
+      ok: true,
+      status: 200,
+      json: () => Promise.resolve(mockResponse),
+    });
+    globalThis.fetch = mockFetch;
+
+    const result = await patchIssueSchedule(
+      'KAN-142',
+      { startDate: '2026-11-12', dueDate: '2026-11-20' },
+      '"etag-abc"',
+    );
+
+    expect(mockFetch).toHaveBeenCalledWith('/api/v1/issues/KAN-142', {
+      method: 'PATCH',
+      headers: {
+        'Content-Type': 'application/json',
+        Accept: 'application/json',
+        'If-Match': '"etag-abc"',
+      },
+      body: JSON.stringify({ start_date: '2026-11-12', due_date: '2026-11-20' }),
+    });
+    expect(result.due_date).toBe('2026-11-20');
+  });
+
+  it('patchIssueSchedule parses error codes from failed responses', async () => {
+    const mockFetch = vi.fn().mockResolvedValue({
+      ok: false,
+      status: 422,
+      text: () => Promise.resolve(JSON.stringify({ code: 'DATE_RANGE_INVALID' })),
+    });
+    globalThis.fetch = mockFetch;
+
+    await expect(
+      patchIssueSchedule('KAN-142', { startDate: '2026-11-25', dueDate: '2026-11-20' }),
+    ).rejects.toThrow('DATE_RANGE_INVALID');
+  });
+
+  it('useRescheduleIssue hook performs optimistic update and rolls back on failure', async () => {
+    const onOptimistic = vi.fn();
+    const onRollback = vi.fn();
+    const onSuccess = vi.fn();
+    const onError = vi.fn();
+
+    const mockFetch = vi.fn().mockResolvedValueOnce({
+      ok: false,
+      status: 412,
+      text: () => Promise.resolve(JSON.stringify({ code: 'PRECONDITION_FAILED' })),
+    });
+    globalThis.fetch = mockFetch;
+
+    const { result } = renderHook(() =>
+      useRescheduleIssue({
+        onOptimisticUpdate: onOptimistic,
+        onRollback: onRollback,
+        onSuccess: onSuccess,
+        onError: onError,
+      }),
+    );
+
+    const issue = {
+      key: 'KAN-142',
+      start_date: '2026-11-10',
+      due_date: '2026-11-18',
+    };
+
+    let success = false;
+    await act(async () => {
+      success = await result.current.reschedule(issue, { dueDate: '2026-11-22' });
+    });
+
+    expect(success).toBe(false);
+    expect(onOptimistic).toHaveBeenCalledWith('KAN-142', { dueDate: '2026-11-22' });
+    expect(onRollback).toHaveBeenCalledWith('KAN-142', {
+      startDate: '2026-11-10',
+      dueDate: '2026-11-18',
+    });
+    expect(onError).toHaveBeenCalled();
+    expect(onSuccess).not.toHaveBeenCalled();
+    expect(result.current.announcement).toContain('rolled back');
+  });
+
+  it('useRescheduleIssue announces success on valid 200 response', async () => {
+    const onSuccess = vi.fn();
+    const mockFetch = vi.fn().mockResolvedValueOnce({
+      ok: true,
+      status: 200,
+      json: () => Promise.resolve({ key: 'KAN-142', due_date: '2026-11-20' }),
+    });
+    globalThis.fetch = mockFetch;
+
+    const { result } = renderHook(() =>
+      useRescheduleIssue({
+        onSuccess,
+      }),
+    );
+
+    const issue = {
+      key: 'KAN-142',
+      start_date: '2026-11-10',
+      due_date: '2026-11-18',
+    };
+
+    let success = false;
+    await act(async () => {
+      success = await result.current.reschedule(issue, { dueDate: '2026-11-20' });
+    });
+
+    expect(success).toBe(true);
+    expect(onSuccess).toHaveBeenCalled();
+    expect(result.current.announcement).toContain('Rescheduled KAN-142 successfully');
+  });
+
+  it('supports single-target reschedule signature and non-JSON error handling', async () => {
+    // Non-JSON error
+    const mockErrorFetch = vi.fn().mockResolvedValue({
+      ok: false,
+      status: 500,
+      text: () => Promise.resolve('Internal Server Error HTML'),
+    });
+    globalThis.fetch = mockErrorFetch;
+
+    await expect(
+      patchIssueSchedule('KAN-99', { dueDate: '2026-11-20' }),
+    ).rejects.toThrow('HTTP_500');
+
+    // Single-target reschedule call with both dates
+    const mockOkFetch = vi.fn().mockResolvedValue({
+      ok: true,
+      status: 200,
+      json: () => Promise.resolve({ key: 'KAN-99', due_date: '2026-11-20' }),
+    });
+    globalThis.fetch = mockOkFetch;
+
+    const { result } = renderHook(() => useRescheduleIssue());
+    let ok = false;
+    await act(async () => {
+      ok = await result.current.reschedule({
+        issueRef: 'KAN-99',
+        startDate: '2026-11-15',
+        dueDate: '2026-11-20',
+      });
+    });
+    expect(ok).toBe(true);
+  });
+
+  it('handles issues with null dates, single-target with partial/no dates, and non-Error rejections', async () => {
+    const onError = vi.fn();
+    const onRollback = vi.fn();
+    const { result } = renderHook(() =>
+      useRescheduleIssue({
+        onError,
+        onRollback,
+      }),
+    );
+
+    // 1. Issue with null start_date and null due_date
+    const mockOkFetch = vi.fn().mockResolvedValue({
+      ok: true,
+      status: 200,
+      json: () => Promise.resolve({ key: 'KAN-NULL', due_date: '2026-11-20' }),
+    });
+    globalThis.fetch = mockOkFetch;
+
+    await act(async () => {
+      await result.current.reschedule(
+        { key: 'KAN-NULL', start_date: null, due_date: null },
+        { dueDate: '2026-11-20' },
+      );
+    });
+
+    // 2. Single-target with only startDate
+    await act(async () => {
+      await result.current.reschedule({
+        issueRef: 'KAN-PARTIAL1',
+        startDate: '2026-11-10',
+      });
+    });
+
+    // 3. Single-target with only dueDate
+    await act(async () => {
+      await result.current.reschedule({
+        issueRef: 'KAN-PARTIAL2',
+        dueDate: '2026-11-25',
+      });
+    });
+
+    // 4. Single-target with neither date
+    await act(async () => {
+      await result.current.reschedule({
+        issueRef: 'KAN-PARTIAL3',
+      });
+    });
+
+    // 5. Non-Error throw in fetch to test String(err) fallback
+    globalThis.fetch = vi.fn().mockRejectedValueOnce('raw network failure string');
+    let failResult = true;
+    await act(async () => {
+      failResult = await result.current.reschedule({
+        issueRef: 'KAN-ERR',
+        dueDate: '2026-11-25',
+      });
+    });
+
+    expect(failResult).toBe(false);
+    expect(onError).toHaveBeenCalledWith('KAN-ERR', expect.any(Error));
+    expect(onRollback).toHaveBeenCalledWith('KAN-ERR', { startDate: null, dueDate: '2026-11-25' });
+    expect(result.current.announcement).toContain('rolled back');
+  });
+});
diff --git a/kanban/web/src/features/timeline/scheduleMutation.ts b/kanban/web/src/features/timeline/scheduleMutation.ts
new file mode 100644
index 0000000..a12f57e
--- /dev/null
+++ b/kanban/web/src/features/timeline/scheduleMutation.ts
@@ -0,0 +1,161 @@
+/**
+ * Schedule mutation helper and optimistic reschedule hook (KB-P3-39, S7.2 8e).
+ * Sends PATCH /api/v1/issues/{issue_ref} and provides rollback on 412 / 422 errors.
+ */
+
+import { useCallback, useState } from 'react';
+import type { IssueItem } from '../views/viewsApi';
+
+export interface SchedulePatch {
+  startDate?: string | null;
+  dueDate?: string | null;
+}
+
+export interface UseRescheduleIssueOptions {
+  onOptimisticUpdate?: (key: string, patch: SchedulePatch) => void;
+  onRollback?: (key: string, original: { startDate: string | null; dueDate: string | null }) => void;
+  onSuccess?: (key: string, updated: IssueItem) => void;
+  onError?: (key: string, error: Error) => void;
+}
+
+/**
+ * Direct PATCH API call to update an issue's schedule dates.
+ */
+export async function patchIssueSchedule(
+  issueKey: string,
+  patch: SchedulePatch,
+  etag?: string,
+): Promise<IssueItem> {
+  const body: Record<string, string | null> = {};
+  if (patch.startDate !== undefined) {
+    body.start_date = patch.startDate;
+  }
+  if (patch.dueDate !== undefined) {
+    body.due_date = patch.dueDate;
+  }
+
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    Accept: 'application/json',
+  };
+  if (etag) {
+    headers['If-Match'] = etag;
+  }
+
+  const res = await fetch(`/api/v1/issues/${encodeURIComponent(issueKey)}`, {
+    method: 'PATCH',
+    headers,
+    body: JSON.stringify(body),
+  });
+
+  if (!res.ok) {
+    let errorText = '';
+    try {
+      errorText = await res.text();
+    } catch {
+      // ignore
+    }
+    let errorCode = `HTTP_${String(res.status)}`;
+    try {
+      const parsed = JSON.parse(errorText) as { code?: string };
+      if (parsed.code) {
+        errorCode = parsed.code;
+      }
+    } catch {
+      // Non-JSON response
+    }
+    const err = new Error(`Reschedule failed (${String(res.status)} ${errorCode}): ${errorText}`);
+    (err as unknown as { status: number; code: string }).status = res.status;
+    (err as unknown as { status: number; code: string }).code = errorCode;
+    throw err;
+  }
+
+  return (await res.json()) as IssueItem;
+}
+
+/**
+ * Hook providing optimistic reschedule execution with live announcement and rollback on failure.
+ */
+export function useRescheduleIssue(options: UseRescheduleIssueOptions = {}) {
+  const [announcement, setAnnouncement] = useState<string>('');
+  const [isPending, setIsPending] = useState<boolean>(false);
+
+  const reschedule = useCallback(
+    async (
+      issueOrTarget:
+        | (Pick<IssueItem, 'key' | 'start_date' | 'due_date'> & { etag?: string })
+        | {
+            issueRef: string;
+            dueDate?: string | null | undefined;
+            startDate?: string | null | undefined;
+            etag?: string | undefined;
+          },
+      optionalPatch?: SchedulePatch,
+    ): Promise<boolean> => {
+      let key: string;
+      let patch: SchedulePatch;
+      let originalDates: { startDate: string | null; dueDate: string | null };
+      let etag: string | undefined;
+
+      if (optionalPatch) {
+        const iss = issueOrTarget as Pick<IssueItem, 'key' | 'start_date' | 'due_date'> & {
+          etag?: string;
+        };
+        key = iss.key;
+        patch = optionalPatch;
+        originalDates = {
+          startDate: iss.start_date ?? null,
+          dueDate: iss.due_date ?? null,
+        };
+        etag = iss.etag;
+      } else {
+        const target = issueOrTarget as {
+          issueRef: string;
+          dueDate?: string | null;
+          startDate?: string | null;
+          etag?: string;
+        };
+        key = target.issueRef;
+        patch = {};
+        if (target.startDate !== undefined) {
+          patch.startDate = target.startDate;
+        }
+        if (target.dueDate !== undefined) {
+          patch.dueDate = target.dueDate;
+        }
+        originalDates = {
+          startDate: target.startDate ?? null,
+          dueDate: target.dueDate ?? null,
+        };
+        etag = target.etag;
+      }
+
+      // 1. Optimistic apply
+      options.onOptimisticUpdate?.(key, patch);
+      setIsPending(true);
+
+      try {
+        const updated = await patchIssueSchedule(key, patch, etag);
+        setAnnouncement(`Rescheduled ${key} successfully.`);
+        options.onSuccess?.(key, updated);
+        return true;
+      } catch (err) {
+        // 2. Rollback on failure (412 ETag mismatch, 422 date validation error, etc.)
+        options.onRollback?.(key, originalDates);
+        const errorMsg = err instanceof Error ? err.message : String(err);
+        setAnnouncement(`Reschedule failed for ${key}, rolled back to previous schedule.`);
+        options.onError?.(key, err instanceof Error ? err : new Error(errorMsg));
+        return false;
+      } finally {
+        setIsPending(false);
+      }
+    },
+    [options],
+  );
+
+  return {
+    reschedule,
+    announcement,
+    isPending,
+  };
+}
diff --git a/kanban/web/src/features/timeline/timelineGeometry.test.ts b/kanban/web/src/features/timeline/timelineGeometry.test.ts
