-+async def test_asn1_ber_coverage() -> None:
-+    """Test ASN.1 BER framing and decoding edge cases."""
-+    import asyncio
-+
-+    from kanban.auth.ldap.asn1_ber import (
-+        LdapProtocolError,
-+        build_search_request,
