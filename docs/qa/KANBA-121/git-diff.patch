-+
-+-- Function 5: webauthn_credentials_for_principal
-+CREATE OR REPLACE FUNCTION kb_auth.webauthn_credentials_for_principal(p_principal_id UUID)
-+RETURNS TABLE (
-+    id UUID,
-+    principal_id UUID,
