-        parts = raw.split("|", 1)
-        if len(parts) == _CURSOR_PARTS_COUNT:
-            ts = datetime.fromisoformat(parts[0])
-            sid = uuid.UUID(parts[1])
-            return ts, sid
-    except Exception as exc:
-        raise ProblemException(
-            code="INVALID_CURSOR",
-            status=422,
-            title="Invalid Cursor",
-            detail="The provided pagination cursor is invalid.",
-        ) from exc
-    raise ProblemException(
-        code="INVALID_CURSOR",
-        status=422,
-        title="Invalid Cursor",
-        detail="The provided pagination cursor is invalid.",
-    )
