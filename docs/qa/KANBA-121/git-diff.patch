-+def encode_activity_cursor(
-+    scope_id: uuid.UUID,
-+    tab: str,
-+    order: str,
-+    recorded_at: datetime,
-+    record_id: uuid.UUID,
-+) -> str:
-+    """Encode keyset pagination parameters into an opaque URL-safe base64 HMAC token."""
