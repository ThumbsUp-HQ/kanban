-def _get_cursor_secret() -> bytes:
-    """Return HMAC secret key for cursor signing."""
-    val = os.environ.get("KB_CURSOR_SECRET")
-    if val:
-        return val.encode("utf-8")
-    return _DEFAULT_CURSOR_SECRET
