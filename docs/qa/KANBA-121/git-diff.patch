-+"""LDAP group synchronization into workspace groups and closure (S3.1, KB-P2-07)."""
-+
-+from __future__ import annotations
-+
-+from typing import TYPE_CHECKING
-+from uuid import uuid4
-+
-+from sqlalchemy import delete, select
