+++/**
+++ * Typed views API interfaces and fetch helpers (KB-P3-38, KB-P3-11, S6.4).
+++ */
+++
+++export interface StateSummary {
+++  id: string;
+++  name: string;
+++  group: string;
+++  sort_order?: number;
+++}
+++
+++export interface PrioritySummary {
