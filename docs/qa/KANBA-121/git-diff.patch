-                display_name=principal.display_name,
-            )
-        else:
-            slug = obj_map.get(aid) or principal.display_name.split()[0].lower()
-            actors[aid] = NormalActorSummary(
-                id=principal.id,
-                type="AGENT",
-                slug=slug,
-                display_name=principal.display_name,
-            )
-
-    return actors
