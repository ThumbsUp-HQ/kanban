+  border-right: 1px solid var(--border-subtle, #333842);
+  display: flex;
+  flex-direction: column;
+  padding: var(--space-4, 16px);
+  box-sizing: border-box;
+  overflow-y: auto;
+  overflow-x: hidden;
+  transition: width 160ms ease, min-width 160ms ease, padding 160ms ease, visibility 160ms ease;
+  z-index: 20;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .kb-sidebar {
+    transition: none !important;
+  }
+}
+
+/* Desktop Collapsed */
+.kb-sidebar.kb-sidebar-collapsed {
+  width: 0 !important;
+  min-width: 0 !important;
+  padding: 0 !important;
+  border-right: none;
+  visibility: hidden;
+  overflow: hidden;
+}
+
+.kb-sidebar-header {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3, 12px);
+  margin-bottom: var(--space-6, 24px);
+}
+
+.kb-workspace-switcher {
