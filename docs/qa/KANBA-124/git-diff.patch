+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+
+describe('DeleteBlastRadiusModal (KB-P3-43, S7.2 8q)', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('does not render when open is false', () => {
+    const onClose = vi.fn();
+    renderComponent({ open: false, onClose });
+    expect(screen.queryByTestId('delete-blast-radius-modal')).toBeNull();
