+}
+
+.btn-danger {
+  min-height: 36px;
+  padding: 0 var(--space-3, 12px);
+  font-size: var(--text-sm, 13px);
+  font-weight: 500;
+  color: #ffffff;
+  background: var(--color-danger, #e11d48);
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm, 6px);
+  cursor: pointer;
+}
+
+.btn-danger:hover:not(:disabled) {
+  background: #be123c;
+}
+
+.btn-danger:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* --- Mobile Viewport (<= 767px): 44px Coarse Touch Hit Targets --- */
+
+@media (max-width: 767px) {
+  .drawer-action-btn {
+    min-height: 44px;
+    height: 44px;
+    padding: 0 var(--space-3, 12px);
+  }
+
+  .subscribe-mute-trigger {
+    min-width: 44px;
+    min-height: 44px;
+  }
+
+  .overflow-menu__item {
+    min-height: 44px;
+    padding: var(--space-3, 12px);
+  }
+
+  .modal-card {
+    padding: 24px;
+  }
+
+  .btn-secondary,
+  .btn-primary,
+  .btn-danger {
+    min-height: 44px;
+    padding: 0 var(--space-4, 16px);
+  }
+}
