+  height: 32px;
+  border-radius: var(--radius-full, 9999px);
+  background: var(--color-brand-primary, #3b82f6);
+  color: #ffffff;
+  border: 2px solid transparent;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 13px;
+  font-weight: 600;
+  padding: 0;
+  outline: none;
+}
+
+.kb-avatar-button:hover,
