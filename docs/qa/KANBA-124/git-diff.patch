+    expect(document.documentElement.dataset.theme).toBe('dark');
+
+    fireEvent.change(input, { target: { value: 'Theme: Light' } });
+    const lightOpt = screen.getByRole('option', { name: /Theme: Light/ });
+    act(() => {
