+    expect(document.documentElement.dataset.theme).toBe('light');
+
+    fireEvent.change(input, { target: { value: 'Theme: System' } });
+    const sysOpt = screen.getByRole('option', { name: /Theme: System/ });
+    act(() => {
+      sysOpt.click();
