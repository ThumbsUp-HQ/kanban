+  padding: 0 var(--space-3, 12px);
+  font-size: var(--text-sm, 13px);
+  font-weight: 500;
+  color: #0f172a;
+  background: var(--color-primary, #38bdf8);
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm, 6px);
+  cursor: pointer;
+}
+
+.btn-primary:hover:not(:disabled) {
