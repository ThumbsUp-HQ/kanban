+export interface CreateDefaultWorkflowHookPayload {
+  name: string;
+  scope_kind: DefaultHookScopeKind;
+  workspace_id?: string | null;
+  from_state_name?: string | null;
+  to_state_name: string;
+  hook_kind?: string;
