+    assert test_stickies_count == 0
+
+    # Querying KAN project rows under KAN credential boundary succeeds
+    kan_issues_count = (
+        await db_session.execute(
+            text("SELECT count(*) FROM issues WHERE project_id = :p"),
+            {"p": proj_kan_id},
