+
+    # Mismatched hook set -> 422 REORDER_SET_MISMATCH
+    bad_reorder = await client.post(
+        "/api/v1/projects/WFAPI/workflow-hooks/reorder",
+        json={
+            "transition": {"from_state": None, "to_state": "Done"},
+            "ordered_hook_ids": [h1_id],  # Missing h2_id!
