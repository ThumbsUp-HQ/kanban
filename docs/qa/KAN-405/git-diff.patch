+        value: COOKIE_VAL,
+        url: `http://127.0.0.1:${PORT}/`,
+        httpOnly: true,
+        sameSite: 'Lax',
+      },
+      {
+        name: 'kb_csrf',
+        value: CSRF_TOKEN,
+        url: `http://127.0.0.1:${PORT}/`,
