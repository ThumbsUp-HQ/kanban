++class OidcCompanionServer:
++    def __init__(self, cert_dir: Path | None = None) -> None:
++        global _GLOBAL_STATE
++        if cert_dir is None:
++            cert_dir = Path("/tmp/kan418-oidc-certs")
++        self.state = OidcCompanionState(cert_dir)
++        _GLOBAL_STATE = self.state
