+        json={
+            "issue_key": issue_key,
+            "tier": "nsjail",
+            "output_format": "text",
+            "script_source": "print('hello')",
+        },
+    )
+    assert resp_nsjail.status_code in (200, 422, 503)
+
+    # 5. Rate limit loop on test-execute
+    limited_resp = None
