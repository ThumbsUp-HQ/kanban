+      rebalance_scheduled: false,
+      gate_status: 'pending',
+      execution_id: 'exec-101',
+      hook_name: 'Security Gate',
+      from_state_id: null, // triggers fallback to previousIssues.find
+      to_state_id: 'st-done',
+      status_code: 202,
+    });
+
+    const initialIssues: BoardIssue[] = [
+      {
+        id: 'i1',
