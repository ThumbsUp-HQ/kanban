+
+        # 5. Role Bindings
+        await s.execute(
+            text(
+                "INSERT INTO role_bindings (workspace_id, principal_id, role, scope_type) "
+                "VALUES (:ws_id, :p_id, 'SERVER_ADMIN', 'server'), (:ws_id, :p_id, 'WORKSPACE_ADMIN', 'workspace')"
+            ),
