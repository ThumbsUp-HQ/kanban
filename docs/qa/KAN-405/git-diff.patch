+const mockStates: BoardWorkflowState[] = [
+  { id: 'st-backlog', name: 'Backlog', group: 'backlog', sort_order: 1 },
+  { id: 'st-todo', name: 'To Do', group: 'unstarted', sort_order: 2 },
