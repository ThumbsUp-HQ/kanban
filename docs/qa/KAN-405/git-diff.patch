++@pytest.fixture
++def dummy_dist(tmp_path: Path) -> Path:
++    """Fixture providing minimal dist directory with index.html."""
++    dist_dir = tmp_path / "web_dist"
++    dist_dir.mkdir()
++    (dist_dir / "index.html").write_text("<!doctype html><html></html>", encoding="utf-8")
++    return dist_dir
++
