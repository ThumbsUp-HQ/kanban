+        await add_role_binding(session, ws_id, admin_id, "PROJECT_ADMIN", scope_type="project", project_id=proj1_id)
+        await add_role_binding(session, ws_id, admin_id, "PROJECT_ADMIN", scope_type="project", project_id=proj2_id)
