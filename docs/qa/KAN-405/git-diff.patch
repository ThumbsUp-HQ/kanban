+APP_URL = f"postgresql+asyncpg://kanban_app@/{DB_NAME}?host={SOCKET_DIR}"
+
+SESSION_HMAC_KEY = b"s" * 32
+MASTER_KEK = b"k" * 32
+AUTH_PEPPER = b"p" * 32
+
+
+def _b64(b: bytes) -> str:
+    return base64.urlsafe_b64encode(b).decode("ascii").rstrip("=")
