+        ),
+        {"u_id": user_id, "p_id": parent_grp.id},
+    )
+    assert closure_depth is not None
+    assert closure_depth >= 2
+
+    # Second sync: idempotent, doesn't duplicate
+    matched2 = await sync_ldap_groups(
+        db_session,
+        ws_id,
+        user_id,
+        [child_dn],
+        group_map,
+        group_parent_map=parent_map,
