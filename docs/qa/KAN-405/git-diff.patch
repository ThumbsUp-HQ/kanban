+    group_map = {
+        child_dn: "Subteam Group",
+        parent_dn: "Parent Group",
+    }
+    parent_map = {
+        child_dn: [parent_dn],
+    }
+
+    # User is only member of child group directly
+    matched = await sync_ldap_groups(
