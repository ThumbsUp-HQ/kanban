+
+        # 7. Agent Definitions:
+        # Agent 1: QA Gatekeeper with custom instructions and 180s timeout
+        agent1_id = uuid.uuid4()
+        instructions = (
+            "# Mandatory QA Gatekeeper Instructions\n\n"
