+                workout_transcript_lines.append("-" * 50)
+            except Exception as e:
+                workout_transcript_lines.append(f"[{label}] (logging exception: {e})")
+
+        return httpx.Client(
+            base_url=base_url,
+            cookies=cookies,
+            headers=headers,
+            timeout=15.0,
+            event_hooks={"response": [on_response]},
