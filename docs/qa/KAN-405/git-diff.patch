+        print("[Screenshot Prep] Playwright execution complete with code:", res.returncode)
+    finally:
+        print("[Screenshot Prep] Shutting down Uvicorn...")
+        uv_proc.terminate()
+        try:
+            uv_proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            uv_proc.kill()
+        uv_log.close()
+
+if __name__ == "__main__":
+    main()
