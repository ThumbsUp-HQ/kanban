+                await ws.send(hb.model_dump_json())
+                await asyncio.sleep(0.1)
+                return ack.type
+
+        ack_type = await ws_handshake()
+        assert ack_type == "hello_ack"
+
+        # Verify last_heartbeat_at was updated
