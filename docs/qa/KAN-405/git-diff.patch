+os.environ["KANBAN_MASTER_KEK"] = base64.urlsafe_b64encode(b"m" * 32).decode()
+os.environ["KANBAN_AUTH_PEPPER"] = base64.urlsafe_b64encode(b"p" * 32).decode()
