-+
-+export function ComposeExportTab({
-+  initialData = null,
-+}: ComposeExportTabProps): JSX.Element {
-+  const [data, setData] = useState<ComposeExportData | null>(initialData);
-+  const [isLoading, setIsLoading] = useState<boolean>(!initialData);
