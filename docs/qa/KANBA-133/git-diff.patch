-+def encrypt_backup(
-+    data: bytes,
-+    *,
-+    passphrase: str | None = None,
-+    master_kek: bytes | None = None,
-+) -> bytes:
-+    """Encrypt raw database dump bytes into a self-describing .kbkp envelope.
