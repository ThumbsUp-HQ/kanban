-    exempt_keys = set(pre_cutover_exempt_keys or [])
-
-    # Check 1: entity_count_and_key_parity
-    c1_res, ws_id, proj_id = await _check_key_parity(
-        session, bundle_dir, workspace_slug, project_identifier
-    )
