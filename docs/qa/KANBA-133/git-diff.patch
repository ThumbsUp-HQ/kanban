-+// ----------------------------------------------------------------------------
-+
-+export async function fetchAuthCards(): Promise<AuthCardsResponse> {
-+  const result = await apiFetch('GET', '/api/v1/auth/cards' as never);
-+  return result as AuthCardsResponse;
