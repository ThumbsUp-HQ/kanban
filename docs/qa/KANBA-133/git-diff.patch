et\n\n  mcp-server:\n    image: thumbs-up-kanban:latest\n    container_name: kanban-mcp\n    restart: unless-stopped\n    depends_on:\n      - kanban\n    command: [\"uv\", \"run\", \"python\", \"-m\", \"kanban.mcp.server\"]\n    environment:\n      KANBAN_API_BASE_URL: \"http://kanban:8080\"\n      KANBAN_MASTER_KEK: \"${MASTER_KEK}\"\n    networks:\n      - app_net\n\n  sandbox:\n    image: thumbs-up-kanban:sandbox\n    container_name: kanban-sandbox\n    restart: unless-stopped\n    security_opt:\n      - seccomp:unconfined\n    cap_add:\n      - SYS_ADMIN\n    networks:\n      - sandbox_net\n\nnetworks:\n  edge_net:\n    driver: bridge\n  app_net:\n    internal: true\n  data_net:\n    internal: true\n  sandbox_net:\n    internal: true\n  egress_llm_net:\n    driver: bridge\n\nvolumes:\n  kanban_db_data:\n",
