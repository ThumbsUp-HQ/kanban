index 0000000..abe0d70
--- /dev/null
+++ b/kanban/custom_fields/schemas/output-format-metadata-v1.json
@@ -0,0 +1,317 @@
+{
+  "$defs": {
+    "BadgeFormatMetadata": {
+      "additionalProperties": false,
+      "description": "Configuration for colored badge custom field output.",
+      "properties": {
+        "allowed_labels": {
+          "anyOf": [
+            {
+              "items": {
+                "type": "string"
+              },
+              "maxItems": 32,
+              "type": "array"
