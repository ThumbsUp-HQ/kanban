+            "SELECT id FROM project_priorities WHERE project_id = $1 AND slug = 'medium'",
+            kan_proj_id
+        )
+        disp_prio_id = await conn.fetchval(
+            "SELECT id FROM project_priorities WHERE project_id = $1 AND slug = 'medium'",
+            disp_proj_id
+        )
+
+        # 7. Seed items in DISP for Blast Radius test
+        for i in range(1, 4):
