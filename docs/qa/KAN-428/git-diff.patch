+        await conn.execute(
+            "SELECT register_object('user'::object_kind, $1, NULL, 'admin1', 'Admin One', $2, $2)",
+            ws_id, admin1_id
+        )
+        await conn.execute(
+            "INSERT INTO users (id, object_type, principal_type, workspace_id, email) "
+            "VALUES ($1, 'user', 'USER', $2, 'admin1@local.kanban')",
