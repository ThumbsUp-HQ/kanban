+        if playwright_res.returncode != 0:
+            logger.error(f"Playwright failed with code {playwright_res.returncode}")
+            sys.exit(playwright_res.returncode)
+    finally:
+        stop_server(server_proc)
+
+
+if __name__ == "__main__":
+    main()
