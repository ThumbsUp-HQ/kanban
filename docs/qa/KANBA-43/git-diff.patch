+    id2 = ev2.scalar_one()
+
+    ev3 = await db_session.execute(
+        text(
+            "SELECT append_activity("
+            "  :ws_id, NULL, NULL, NULL, 'LOCAL_ADMIN_LOGIN_FAILED', :payload"
