+        {
+            "ws_id": ws_id,
+            "actor_id": user_id,
+            "payload": json.dumps({"auth_provider": "local_admin"}),
+        },
+    )
+    id4 = ev4.scalar_one()
+
+    ev5 = await db_session.execute(
+        text(
+            "SELECT append_activity("
+            "  :ws_id, :obj_id, 'issue', :actor_id, 'CREATOR_OVERRIDDEN', :payload"
+            ")"
