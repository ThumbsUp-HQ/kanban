+    # 2. Query all 5 rows and assert chain structure
+    rows = await db_session.execute(
+        text(
+            "SELECT chain_seq, prev_hash, row_hash FROM activity_records "
+            "WHERE workspace_id = :ws_id ORDER BY chain_seq ASC"
+        ),
