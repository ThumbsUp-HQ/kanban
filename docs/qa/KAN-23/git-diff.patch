+    // Screenshot 3: Post-save Display Name preserved without reload (Light & Dark)
+    await applyTheme(page, 'light');
+    await page.screenshot({
+      path: resolve(SCREENSHOT_DIR, `kan-23-display-name-preserved-light-${projectName}.png`),
