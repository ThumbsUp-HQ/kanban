+    });
+
+    const { unmount } = render(<AvatarCropModal file={file} onSave={onSave} onClose={onClose} />);
+    await waitFor(() => {
+      expect(screen.getByTestId('avatar-crop-save-btn')).toBeDefined();
+    });
+
+    fireEvent.click(screen.getByTestId('avatar-crop-save-btn'));
