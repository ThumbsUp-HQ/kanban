+    assert len(p_sg1) == 1
+    assert len(p_sg2) == 1
+    assert len(p_sg3) == 1
+
+    # priority
+    p_pr1 = compile_predicate_string(f"priority:{uuid.uuid4()}", project=p_uuid)
