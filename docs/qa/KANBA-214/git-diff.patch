diff --git a/kanban/web/src/features/drawer/IssueSurface.css b/kanban/web/src/features/drawer/IssueSurface.css
index 3ce7e37..c828ef8 100644
--- a/kanban/web/src/features/drawer/IssueSurface.css
+++ b/kanban/web/src/features/drawer/IssueSurface.css
@@ -402,3 +402,78 @@
   white-space: nowrap;
   border: 0;
 }
+
+/* Conflict / Optimistic Locking Banner (412 / 428) */
+.surface__conflict-banner {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 12px 16px;
+  background: var(--bg-warning-subtle, rgba(234, 179, 8, 0.12));
+  border: 1px solid var(--border-warning, #eab308);
+  border-radius: var(--radius-md, 6px);
+  color: var(--fg-primary, #f8fafc);
+  margin-bottom: 12px;
+}
+
+.conflict-banner__message {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.4;
+}
+
+.conflict-banner__icon {
+  font-size: 16px;
+  flex-shrink: 0;
+}
+
+.conflict-banner__actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.conflict-banner__reload-btn,
+.conflict-banner__overwrite-btn,
+.conflict-banner__discard-btn {
+  padding: 4px 10px;
+  font-size: 12px;
+  font-weight: 500;
+  border-radius: var(--radius-sm, 4px);
+  cursor: pointer;
+  transition: background 100ms ease, opacity 100ms ease;
+}
+
+.conflict-banner__reload-btn {
+  background: #2563eb;
+  color: #ffffff;
+  border: 1px solid #1d4ed8;
+}
+
+.conflict-banner__reload-btn:hover {
+  background: #1d4ed8;
+}
+
+.conflict-banner__overwrite-btn {
+  background: #eab308;
+  color: #1e293b;
+  border: 1px solid #ca8a04;
+}
+
+.conflict-banner__overwrite-btn:hover {
+  background: #ca8a04;
+}
+
+.conflict-banner__discard-btn {
+  background: transparent;
+  color: var(--fg-secondary, #cbd5e1);
+  border: 1px solid var(--border-subtle, #475569);
+}
+
+.conflict-banner__discard-btn:hover {
+  background: var(--bg-hover, rgba(255, 255, 255, 0.08));
+}
+
