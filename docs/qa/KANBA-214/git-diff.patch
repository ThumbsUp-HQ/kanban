++  const lines = sticky.body_markdown.split('\n');
++  const firstHeading = lines.find((l) => l.startsWith('#'))?.replace(/^#+\s*/, '').trim();
++  return firstHeading ?? lines[0]?.trim().slice(0, 80) ?? 'Promoted Specification';
++}
