+    assert "gemini" in _ALLOWED_PROVIDER_KINDS
+    assert "ollama" in _ALLOWED_PROVIDER_KINDS
+    assert "fixture" in _ALLOWED_PROVIDER_KINDS
+    assert "untrusted_custom_cloud" not in _ALLOWED_PROVIDER_KINDS
