+-+-+    # 5. Raw UTF-8 bytes encoding lone surrogate (e.g. \xed\xa0\x80 for U+D800)
+-+-+    raw_surrogate_bytes = b'{"raw": "' + b"\xed\xa0\x80" + b'"}'
