+
+    hanging_task = asyncio.create_task(_long_running())
+    drain_hub._ping_task = hanging_task
+    await drain_hub.drain(timeout_seconds=0.01)
+    hanging_task.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await hanging_task
