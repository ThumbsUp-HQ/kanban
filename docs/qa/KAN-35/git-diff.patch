+-+-+
+-+-+export interface PublicKeyCredentialCreationOptionsJSON {
+-+-+  rp: { name: string; id?: string };
+-+-+  user: { id: string; name: string; displayName: string };
+-+-+  challenge: string;
+-+-+  pubKeyCredParams: { alg: number; type: string }[];
+-+-+  timeout?: number;
