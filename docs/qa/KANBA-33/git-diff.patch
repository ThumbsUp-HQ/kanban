+        """Case 3: Contract parity: CassetteTransport reproduces identical exchange as httpx."""
+        cassette_data = {
+            "http_exchanges": [
+                {
+                    "request": {
+                        "method": "POST",
+                        "path": "/api/test",
+                        "json_contains": {"query": "hello"},
