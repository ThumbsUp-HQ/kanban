+}
+
+.kb-runner-card-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: flex-end;
+  gap: var(--space-2, 8px);
+  padding-top: var(--space-3, 12px);
+  margin-top: var(--space-3, 12px);
+  border-top: 1px solid var(--kb-color-border-subtle, #e5e7eb);
+}
+
+[data-theme='dark'] .kb-runner-card-actions {
+  border-color: #374151;
+}
+
+/* Single-Reveal Token Banner */
+.kb-single-reveal-alert {
+  background-color: #eff6ff;
+  border: 1px solid #bfdbfe;
+  color: #1e40af;
+  border-radius: var(--radius-md, 8px);
+  padding: var(--space-4, 16px);
+  margin-bottom: var(--space-4, 16px);
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+[data-theme='dark'] .kb-single-reveal-alert {
+  background-color: #1e3a8a;
+  border-color: #1d4ed8;
+  color: #dbeafe;
+}
+
+.kb-token-display-box {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  background-color: #111827;
+  color: #34d399;
