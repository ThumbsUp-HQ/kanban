+      {/* Token Budget Modal */}
+      <AiBudgetModal
+        isOpen={selectedBudgetProvider !== null}
+        onClose={() => { setSelectedBudgetProvider(null); }}
+        provider={selectedBudgetProvider}
+        onBudgetUpdated={refreshData}
+      />
