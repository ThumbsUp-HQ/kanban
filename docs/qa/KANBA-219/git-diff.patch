+  border-radius: var(--radius-lg, 12px);
+  padding: var(--space-6, 24px);
+  max-width: 540px;
+  width: 100%;
+  box-shadow: var(--shadow-xl, 0 20px 25px -5px rgba(0, 0, 0, 0.1));
+  box-sizing: border-box;
+  max-height: 90vh;
+  overflow-y: auto;
+}
+
+[data-theme='dark'] .kb-modal-card {
+  background-color: #1f2937;
+  color: #f9fafb;
+  border: 1px solid #374151;
+}
+
+.kb-modal-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: var(--space-4, 16px);
+}
+
+.kb-modal-header h2 {
+  font-size: var(--text-xl, 18px);
+  font-weight: 700;
+  margin: 0;
+}
+
+.kb-form-group {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1, 4px);
+  margin-bottom: var(--space-4, 16px);
+}
+
+.kb-form-label {
+  font-size: var(--text-sm, 14px);
+  font-weight: 600;
+  color: var(--kb-color-text-primary, #111827);
+}
+
+[data-theme='dark'] .kb-form-label {
+  color: #f9fafb;
+}
+
+.kb-form-input,
+.kb-form-select,
+.kb-form-textarea {
+  padding: 8px 12px;
+  border-radius: 6px;
+  border: 1px solid var(--kb-color-border-subtle, #d1d5db);
+  background-color: var(--kb-color-bg-surface, #ffffff);
+  color: var(--kb-color-text-primary, #111827);
+  font-size: var(--text-sm, 14px);
+  width: 100%;
+  box-sizing: border-box;
+  min-height: 44px;
+}
+
+[data-theme='dark'] .kb-form-input,
+[data-theme='dark'] .kb-form-select,
+[data-theme='dark'] .kb-form-textarea {
+  background-color: #374151;
+  border-color: #4b5563;
+  color: #f9fafb;
+}
+
+.kb-form-input:focus,
+.kb-form-select:focus,
+.kb-form-textarea:focus {
+  outline: 2px solid var(--accent-primary, #2563eb);
+  outline-offset: 1px;
+}
+
+.kb-form-hint {
+  font-size: var(--text-xs, 12px);
+  color: var(--kb-color-text-secondary, #6b7280);
+}
+
+[data-theme='dark'] .kb-form-hint {
+  color: #9ca3af;
+}
+
+.kb-modal-footer {
+  display: flex;
+  justify-content: flex-end;
+  gap: var(--space-3, 12px);
+  margin-top: var(--space-6, 24px);
+  flex-wrap: wrap;
+}
+
+/* Ledger and Progress Bar */
+.kb-budget-progress-container {
+  margin: var(--space-3, 12px) 0;
+}
+
+.kb-budget-progress-bar-bg {
+  width: 100%;
+  height: 8px;
+  background-color: var(--bg-secondary, #e5e7eb);
+  border-radius: 9999px;
+  overflow: hidden;
+}
+
+[data-theme='dark'] .kb-budget-progress-bar-bg {
+  background-color: #374151;
+}
+
+.kb-budget-progress-bar-fill {
+  height: 100%;
+  background-color: var(--accent-primary, #2563eb);
+  border-radius: 9999px;
+  transition: width 0.3s ease;
+}
+
+.kb-budget-progress-bar-fill--warning {
+  background-color: #f59e0b;
+}
+
+.kb-budget-progress-bar-fill--danger {
+  background-color: #ef4444;
+}
+
+.kb-budget-stats-row {
+  display: flex;
+  justify-content: space-between;
+  font-size: 12px;
+  color: var(--kb-color-text-secondary, #4b5563);
+  margin-top: 4px;
+}
+
+[data-theme='dark'] .kb-budget-stats-row {
+  color: #9ca3af;
+}
+
+/* Responsive adjustments */
+@media (max-width: 768px) {
+  .kb-ai-studio {
+    padding: var(--space-4, 16px);
+  }
+
+  .kb-providers-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .kb-ai-studio-header {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .kb-modal-footer {
+    flex-direction: column-reverse;
+  }
+
+  .kb-modal-footer button {
+    width: 100%;
+    min-height: 44px;
+  }
+}
