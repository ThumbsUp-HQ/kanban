+
+.kb-token-display-box span {
+  flex: 1;
+}
+
+/* Responsive adjustments */
+@media (max-width: 768px) {
+  .kb-runner-studio {
+    padding: var(--space-4, 16px);
+  }
+
+  .kb-runners-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .kb-runner-studio-header {
+    flex-direction: column;
+    align-items: stretch;
+  }
+}
