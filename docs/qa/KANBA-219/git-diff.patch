+
+.kb-runner-studio {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6, 24px);
+  padding: var(--space-6, 24px);
+  max-width: 1200px;
+  margin: 0 auto;
+  width: 100%;
+  box-sizing: border-box;
+}
+
+.kb-runner-studio-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  flex-wrap: wrap;
+  gap: var(--space-4, 16px);
+}
+
+.kb-runner-studio-title-group h1 {
+  font-size: var(--text-2xl, 24px);
+  font-weight: 700;
+  color: var(--kb-color-text-primary, #111827);
+  margin: 0 0 var(--space-1, 4px) 0;
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+}
+
+.kb-runner-studio-subtitle {
+  color: var(--kb-color-text-secondary, #4b5563);
+  font-size: var(--text-sm, 14px);
+  margin: 0;
+}
+
+/* Runner Filter Pills */
+.kb-runner-filters {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+  flex-wrap: wrap;
+}
+
+.kb-filter-pill {
+  padding: 6px 14px;
+  border-radius: 9999px;
+  font-size: 13px;
+  font-weight: 500;
+  border: 1px solid var(--kb-color-border-subtle, #d1d5db);
+  background-color: var(--kb-color-bg-surface, #ffffff);
+  color: var(--kb-color-text-secondary, #4b5563);
+  cursor: pointer;
+  min-height: 36px;
+  display: inline-flex;
+  align-items: center;
+}
+
+[data-theme='dark'] .kb-filter-pill {
+  background-color: #1f2937;
+  border-color: #374151;
+  color: #9ca3af;
+}
+
+.kb-filter-pill--active {
+  background-color: var(--accent-primary, #2563eb);
+  color: #ffffff;
+  border-color: var(--accent-primary, #2563eb);
+}
+
+[data-theme='dark'] .kb-filter-pill--active {
+  background-color: var(--accent-primary, #2563eb);
+  color: #ffffff;
+  border-color: var(--accent-primary, #2563eb);
+}
+
+/* Runners Grid & Cards */
+.kb-runners-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
+  gap: var(--space-4, 16px);
+  width: 100%;
+}
+
+.kb-runner-card {
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  background-color: var(--kb-color-bg-surface, #ffffff);
+  border: 1px solid var(--kb-color-border-subtle, #e5e7eb);
+  border-radius: var(--radius-lg, 12px);
+  padding: var(--space-5, 20px);
+  box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
+  box-sizing: border-box;
+  transition: border-color 0.15s ease, box-shadow 0.15s ease;
+}
+
+[data-theme='dark'] .kb-runner-card {
+  background-color: #1f2937;
+  border-color: #374151;
+}
+
+.kb-runner-card:hover {
+  border-color: var(--border-strong, #9ca3af);
+  box-shadow: var(--shadow-md, 0 4px 6px -1px rgba(0, 0, 0, 0.1));
+}
+
+.kb-runner-card-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: var(--space-2, 8px);
+  margin-bottom: var(--space-2, 8px);
+}
