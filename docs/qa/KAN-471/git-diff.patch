+    const draftsHintBtn = screen.getByRole('button', { name: /Local Browser Drafts/i });
+    act(() => {
+      draftsHintBtn.focus();
+    });
+    const popover = screen.getByRole('dialog', { name: 'Local Browser Drafts' });
+    expect(popover).toBeDefined();
