+    expect(moreInfoLink?.textContent).toContain('More info');
+
+    act(() => {
+      fireEvent.keyDown(draftsHintBtn, { key: 'Escape' });
+    });
+    expect(screen.queryByRole('dialog', { name: 'Local Browser Drafts' })).toBeNull();
+
     uDrafts();
   });
 
