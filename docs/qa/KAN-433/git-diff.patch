+
+function getMocks(): MockHandlers {
+  const me = loadFixture<Record<string, unknown>>('me-adam');
+  const projectKan = loadFixture<Record<string, unknown>>('project-kan');
+
+  const adminUser = {
+    ...me,
+    id: '01918a22-0000-7000-8000-000000000001',
