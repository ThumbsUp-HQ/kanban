++async def add_assignee(
++    session: AsyncSession,
++    caller: PrincipalContext,
++    issue_ref: str,
++    body: AssigneeCreate,
++) -> AssigneeResponse:
++    """Assign an eligible project viewer or free-text label to an issue."""
