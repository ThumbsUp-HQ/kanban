++                        handle=row["handle"] or "",
++                        display_name=row["display_name"] or "",
++                        type=row["principal_type"] or "USER",
++                    ),
++                )
++            )
++        else:
++            result.append(
++                FreeTextAssigneeResponse(
++                    id=row["id"],
++                    kind="free_text",
++                    free_text=row["free_text_assignee"] or "",
++                    notify=False,
++                    hint=FREE_TEXT_HINT,
++                )
++            )
