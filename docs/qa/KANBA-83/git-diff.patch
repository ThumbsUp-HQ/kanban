+    """Test Case 1: Positive assign by @handle, issue GET lists assignee, ASSIGNEE_ADDED."""
+    admin = await make_user("admin", workspace_role="WORKSPACE_ADMIN")
+    viewer = await make_user("viewer")
+    await make_project(
+        "PRJ1",
