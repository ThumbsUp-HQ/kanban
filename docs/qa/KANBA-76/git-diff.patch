+    )
+    assert weak_304.status_code == 304
+
+    # GET 200 with non-matching If-None-Match
+    mismatch_resp = await client.get(
+        "/api/v1/issues/POS-1", headers={"If-None-Match": '"some-other-etag"'}
+    )
