-+    authorized_mentions: list[ResolvedMention] = []
-+    unnotified_mentions: list[ResolvedMention] = []
-+    newly_acknowledged_pids: list[uuid.UUID] = []
-+
-+    seen_resolved_pids: set[uuid.UUID] = set()
