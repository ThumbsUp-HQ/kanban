+        "/api/v1/projects/SEC1/modules",
+        json={"name": "Mod Inactive", "lead_principal_id": str(inactive_user.id)},
+    )
+    assert r_lead_inactive.status_code == 422
+    assert r_lead_inactive.json()["code"] == "LEAD_NOT_ELIGIBLE"
