+    data = dict(raw)
+    key_val = str(data.get("key") or data.get("issue_key") or "")
+    data["key"] = key_val
+    data["issue_key"] = key_val
+    data["sequence_number"] = extract_issue_sequence(data, key_val)
+    return data
