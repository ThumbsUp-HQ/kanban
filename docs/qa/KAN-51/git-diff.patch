+
+def extract_issue_sequence(raw: dict[str, Any] | None = None, key: str | None = None) -> int:
+    """Extract or parse sequence_number as int from raw dict or issue key."""
+    if raw is not None:
+        for field in ("sequence_number", "sequence_id"):
+            val = raw.get(field)
+            if val is not None:
