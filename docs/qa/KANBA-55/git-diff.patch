+        email="eng@example.com",
+    )
+    await db_session.execute(
+        text(
+            "INSERT INTO principals (id, principal_type, workspace_id, display_name) "
+            "VALUES (:id, 'USER', :ws_id, 'Test Engineer')"
+        ),
+        {"id": u_id, "ws_id": ws_id},
+    )
+    db_session.add(user)
+    await db_session.flush()
+
+    p_id = uuid.uuid4()
+    p_obj = ObjectRecord(
+        id=p_id,
