+
+        # 4.2 Non-Root enrollment into isolated XDG state dir
+        state_dir = Path(tempfile.mkdtemp(prefix="kan413-runner-state-"))
+        os.chmod(state_dir, 0o700)
+
+        enroll_cmd = [
+            "uv",
+            "run",
