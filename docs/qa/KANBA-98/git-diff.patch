+    *,
+    num_users: int = 1,
+) -> tuple[uuid.UUID, list[tuple[uuid.UUID, uuid.UUID]], uuid.UUID, uuid.UUID]:
+    """Provision workspace, users, sessions, and cards for testing."""
+    ws_id = uuid.uuid4()
+    card_oidc_id = uuid.uuid4()
+    card_ldap_id = uuid.uuid4()
