+        }),
+      ).rejects.toThrow('probeStyles element not found: "#does-not-exist"');
+    });
+  });
+});
diff --git a/kanban/web/e2e/support/test.ts b/kanban/web/e2e/support/test.ts
new file mode 100644
index 0000000..a2204be
--- /dev/null
+++ b/kanban/web/e2e/support/test.ts
@@ -0,0 +1,125 @@
+import { test as baseTest, expect } from '@playwright/test';
+import { mockApi, loadFixture, type MockRecorder } from './mockApi';
+import type { Page } from '@playwright/test';
+
+declare global {
+  interface Window {
+    __cspViolations?: { violatedDirective: string; blockedURI: string }[];
+  }
+}
+
+export interface TestFixtures {
+  mockRecorder: MockRecorder;
+}
+
+/**
+ * Auto-fixture function that sets up CSP violation listeners,
+ * error collectors, off-origin request blocking, and default API mocks.
+ */
+export async function testGuardFixture(
+  { page }: { page: Page },
+  use: (r: MockRecorder) => Promise<void>,
+): Promise<void> {
+  // 1. Register CSP violation listener before any scripts run
+  await page.addInitScript(() => {
+    window.__cspViolations = [];
+    document.addEventListener('securitypolicyviolation', (e) => {
+      window.__cspViolations?.push({
+        violatedDirective: e.violatedDirective,
+        blockedURI: e.blockedURI,
+      });
+    });
+  });
+
+  // 2. Track console errors and unhandled page errors
+  const consoleErrors: string[] = [];
+  const pageErrors: Error[] = [];
+
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') {
+      const text = msg.text();
+      // Ignore browser CSP parser warnings for S5.4 MIME-scoped data: sources
+      if (text.startsWith('The source list for the Content Security Policy directive')) {
+        return;
+      }
+      consoleErrors.push(text);
+    }
+  });
+
+  page.on('pageerror', (err) => {
+    pageErrors.push(err);
+  });
+
+  // 3. Block all off-origin network requests
+  const offOriginRequests: string[] = [];
+  await page.route('**', (route) => {
+    const urlStr = route.request().url();
+    if (
+      urlStr.startsWith('http://127.0.0.1:4173') ||
+      urlStr.startsWith('http://localhost:4173')
+    ) {
+      return route.continue();
+    }
+    offOriginRequests.push(urlStr);
+    return route.abort();
+  });
+
+  // 4. Default API mock handlers
+  const recorder = await mockApi(page, {
+    'GET /api/v1/me': loadFixture('me-adam'),
+    'GET /api/v1/system/status': loadFixture('system-status-prod'),
+  });
+
+  // Run test
+  // eslint-disable-next-line react-hooks/rules-of-hooks
+  await use(recorder);
+
+  // 5. Post-test assertions verifying zero violations
+  let cspViolations: { violatedDirective: string; blockedURI: string }[] = [];
+  try {
+    cspViolations = await page.evaluate(() => window.__cspViolations ?? []);
+  } catch {
+    // Page was closed before evaluation
+  }
+
+  const issues: string[] = [];
+  if (cspViolations.length > 0) {
+    issues.push(
+      `CSP violations detected (${String(cspViolations.length)}): ${cspViolations
+        .map((v) => `${v.violatedDirective} (${v.blockedURI})`)
+        .join(', ')}`,
+    );
+  }
+  if (consoleErrors.length > 0) {
+    issues.push(
+      `Console errors detected (${String(consoleErrors.length)}): ${consoleErrors.join('; ')}`,
+    );
+  }
+  if (pageErrors.length > 0) {
+    issues.push(
+      `Page errors detected (${String(pageErrors.length)}): ${pageErrors.map((e) => e.message).join('; ')}`,
+    );
+  }
+  if (offOriginRequests.length > 0) {
+    issues.push(
+      `Off-origin requests blocked (${String(offOriginRequests.length)}): ${offOriginRequests.join(', ')}`,
+    );
+  }
+  if (recorder.unmatchedCalls.length > 0) {
+    issues.push(
+      `Unmatched API calls detected (${String(recorder.unmatchedCalls.length)}): ${recorder.unmatchedCalls
+        .map((c) => `${c.method} ${c.path}`)
+        .join(', ')}`,
+    );
+  }
+
+  if (issues.length > 0) {
+    throw new Error(`Test guard verification failure:\n${issues.join('\n')}`);
+  }
+}
+
+export const test = baseTest.extend<TestFixtures>({
+  mockRecorder: [testGuardFixture, { auto: true }],
+});
+
+export { expect };
diff --git a/kanban/web/e2e/support/testGuard.unit.test.ts b/kanban/web/e2e/support/testGuard.unit.test.ts
new file mode 100644
index 0000000..7b2c958
--- /dev/null
+++ b/kanban/web/e2e/support/testGuard.unit.test.ts
@@ -0,0 +1,175 @@
+import { describe, it, expect, vi } from 'vitest';
+import { testGuardFixture } from './test';
+import type { Page, Route, Request, ConsoleMessage } from '@playwright/test';
+
+describe('testGuardFixture', () => {
+  it('passes cleanly when zero violations occur', async () => {
+    const addInitScriptMock = vi.fn().mockImplementation((fn: () => void) => {
+      fn();
+      // Dispatch synthetic securitypolicyviolation event to verify handler
+      const event = new Event('securitypolicyviolation');
+      Object.assign(event, { violatedDirective: 'none', blockedURI: '' });
+      document.dispatchEvent(event);
+      window.__cspViolations = []; // clear so it passes cleanly
+      return Promise.resolve();
+    });
+
+    const fakePage = {
+      addInitScript: addInitScriptMock,
+      on: vi.fn(),
+      route: vi.fn().mockResolvedValue(undefined),
+      evaluate: vi.fn().mockImplementation((fn: () => unknown) => {
+        return Promise.resolve(typeof fn === 'function' ? fn() : fn);
+      }),
+    } as unknown as Page;
+
+    let useCalled = false;
+    await testGuardFixture({ page: fakePage }, async (recorder) => {
+      useCalled = true;
+      expect(recorder).toBeDefined();
+      await Promise.resolve();
+    });
+
+    expect(useCalled).toBe(true);
+    expect(addInitScriptMock).toHaveBeenCalled();
+  });
+
+  it('fails when CSP violations are recorded', async () => {
+    window.__cspViolations = [
+      { violatedDirective: "style-src 'self'", blockedURI: '' },
+    ];
+    const fakePage = {
+      addInitScript: vi.fn().mockResolvedValue(undefined),
+      on: vi.fn(),
+      route: vi.fn().mockResolvedValue(undefined),
+      evaluate: vi.fn().mockImplementation((fn: () => unknown) => {
+        return Promise.resolve(typeof fn === 'function' ? fn() : fn);
+      }),
+    } as unknown as Page;
+
+    try {
+      await expect(
+        testGuardFixture({ page: fakePage }, async () => {
+          // do nothing
+        }),
+      ).rejects.toThrow('CSP violations detected');
+    } finally {
+      delete window.__cspViolations;
+    }
+  });
+
+  it('fails when console errors or page errors occur', async () => {
+    delete window.__cspViolations;
+    const listeners: Record<string, (arg: unknown) => void> = {};
+    const fakePage = {
+      addInitScript: vi.fn().mockResolvedValue(undefined),
+      on: vi.fn().mockImplementation((event: string, cb: (arg: unknown) => void) => {
+        listeners[event] = cb;
+      }),
+      route: vi.fn().mockResolvedValue(undefined),
+      evaluate: vi.fn().mockImplementation((fn: () => unknown) => {
+        return Promise.resolve(typeof fn === 'function' ? fn() : fn);
+      }),
+    } as unknown as Page;
+
+    await expect(
+      testGuardFixture({ page: fakePage }, async () => {
+        const fakeMsg = {
+          type: () => 'error',
+          text: () => 'Simulated console error',
+        } as unknown as ConsoleMessage;
+        listeners.console?.(fakeMsg);
+        listeners.pageerror?.(new Error('Simulated page crash'));
+        await Promise.resolve();
+      }),
+    ).rejects.toThrow('Console errors detected');
+  });
+
+  it('blocks and fails on off-origin requests', async () => {
+    let globalRouteHandler: ((route: Route) => Promise<void>) | undefined;
+    const fakePage = {
+      addInitScript: vi.fn().mockResolvedValue(undefined),
+      on: vi.fn(),
+      route: vi.fn().mockImplementation((pattern: string, handler: (route: Route) => Promise<void>) => {
+        if (pattern === '**') {
+          globalRouteHandler = handler;
+        }
+        return Promise.resolve();
+      }),
+      evaluate: vi.fn().mockResolvedValue([]),
+    } as unknown as Page;
+
+    await expect(
+      testGuardFixture({ page: fakePage }, async () => {
+        const abortMock = vi.fn().mockResolvedValue(undefined);
+        const continueMock = vi.fn().mockResolvedValue(undefined);
+
+        const localReq = {
+          url: () => 'http://127.0.0.1:4173/assets/test.js',
+        } as unknown as Request;
+        const localRoute = {
+          request: () => localReq,
+          continue: continueMock,
+          abort: abortMock,
+        } as unknown as Route;
+        if (globalRouteHandler) {
+          await globalRouteHandler(localRoute);
+        }
+        expect(continueMock).toHaveBeenCalled();
+
+        const evilReq = {
+          url: () => 'http://evil.com/tracker.js',
+        } as unknown as Request;
+        const evilRoute = {
+          request: () => evilReq,
+          continue: continueMock,
+          abort: abortMock,
+        } as unknown as Route;
+        if (globalRouteHandler) {
+          await globalRouteHandler(evilRoute);
+        }
+        expect(abortMock).toHaveBeenCalled();
+      }),
+    ).rejects.toThrow('Off-origin requests blocked');
+  });
+
+  it('ignores non-error console messages and handles page closed during teardown', async () => {
+    const listeners: Record<string, (arg: unknown) => void> = {};
+    const fakePage = {
+      addInitScript: vi.fn().mockResolvedValue(undefined),
+      on: vi.fn().mockImplementation((event: string, cb: (arg: unknown) => void) => {
+        listeners[event] = cb;
+      }),
+      route: vi.fn().mockResolvedValue(undefined),
+      evaluate: vi.fn().mockRejectedValue(new Error('Target page, context or browser has been closed')),
+    } as unknown as Page;
+
+    await testGuardFixture({ page: fakePage }, async () => {
+      listeners.console?.({
+        type: () => 'info',
+        text: () => 'non-error info',
+      });
+      listeners.console?.({
+        type: () => 'error',
+        text: () => 'The source list for the Content Security Policy directive ...',
+      });
+      await Promise.resolve();
+    });
+  });
+
+  it('fails when unmatched API calls are recorded', async () => {
+    const fakePage = {
+      addInitScript: vi.fn().mockResolvedValue(undefined),
+      on: vi.fn(),
+      route: vi.fn().mockResolvedValue(undefined),
+      evaluate: vi.fn().mockResolvedValue([]),
+    } as unknown as Page;
+
+    await expect(
+      testGuardFixture({ page: fakePage }, async (recorder) => {
+        recorder.unmatchedCalls.push({ method: 'GET', path: '/api/v1/unknown' });
+        await Promise.resolve();
+      }),
+    ).rejects.toThrow('Unmatched API calls detected');
+  });
+});
