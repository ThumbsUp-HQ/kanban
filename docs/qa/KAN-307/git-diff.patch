+        val: Any,
+        source: Literal["env", "default"],
+        is_secret: bool,
+        notes: str,
+        server_only: bool = False,
+    ) -> None:
+        if (server_only and not is_server_admin) or is_secret:
+            display_val = "[REDACTED]"
+            redacted = True
+        else:
+            display_val = val
+            redacted = False
+        items.append(
+            ConfigSettingItem(
+                key=key,
+                subsystem=subsystem,
+                value=display_val,
+                source=source,
+                redacted=redacted,
+                notes=notes,
+            )
+        )
+
+    # Auth & AAL2
+    _add(
+        "session_idle_timeout_minutes",
+        "Auth & AAL2",
+        getattr(settings, "session_idle_timeout_minutes", 60),
+        "default",
