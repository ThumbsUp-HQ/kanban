-+        while ((m = nodeDefRegex.exec(trimmed)) !== null) {
-+          const id = m[1];
-+          if (id && !RESERVED_TOKENS.has(id) && !/^\d+$/.test(id)) {
-+            nodeSet.add(id);
-+          }
-+        }
-+        break;
-+      }
-+      case 'sequenceDiagram': {
