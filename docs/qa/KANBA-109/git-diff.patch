++@dataclass(frozen=True, slots=True)
++class WebauthnCredentialRecord:
++    """Internal representation of a persisted WebAuthn credential."""
++
++    id: uuid.UUID
++    principal_id: uuid.UUID
++    credential_id: bytes
++    public_key: bytes
++    sign_count: int
++    aaguid: uuid.UUID | None
