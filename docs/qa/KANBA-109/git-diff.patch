-+    // Immediately terminate the unresponsive worker per S5.3
-+    if (this.worker) {
-+      try {
-+        this.worker.terminate();
-+      } catch {
-+        // Ignored
-+      }
-+      this.worker = null;
-+    }
-+
-+    clearTimeout(job.timer);
-+    this.pendingJobs.delete(requestId);
-+    this.inFlight.delete(job.cacheKey);
