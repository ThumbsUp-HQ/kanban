++RETURNS BOOLEAN
++LANGUAGE plpgsql
++SECURITY DEFINER
++SET search_path = pg_catalog, public
++AS $$
++BEGIN
++    UPDATE webauthn_credentials
++    SET suspect_clone_at = clock_timestamp()
++    WHERE credential_id = p_credential_id;
++
++    RETURN FOUND;
++END;
++$$;
