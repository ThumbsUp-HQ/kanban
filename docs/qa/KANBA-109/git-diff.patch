+) -> None:
+    """Test Case 10: Admin last factor -> 409 LAST_FACTOR; stale AAL2 -> 403 AAL2_STALE."""
+    factory = RLSSessionFactory(pg_worker_db)
+    rate_limiter = PgRateLimiter(pg_worker_db)
+    ws_id, p_id, _ = await _setup_test_admin(
+        factory,
