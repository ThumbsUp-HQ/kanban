+            "/api/v1/setup/claim",
+            json={
+                "token": t2,
+                "username": "t2admin",
+                "display_name": "T2 Admin",
+                "password": "PasswordRotation123!",
+            },
+            headers={CSRF_HEADER_NAME: csrf_token},
