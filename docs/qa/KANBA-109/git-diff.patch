+def _sync_cookies(client: httpx.AsyncClient, response: httpx.Response) -> None:
+    """Sync response cookies into AsyncClient cookie jar."""
+    for c in response.cookies.jar:
+        client.cookies.set(c.name, c.value or "")
+
