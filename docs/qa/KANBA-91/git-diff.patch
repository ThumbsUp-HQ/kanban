+
+    created_keys: list[str] = []
+    for i in range(4):
+        iss = await _create_api_test_issue(member_client, "WIP2", f"WIP Issue {i + 1}")
+        created_keys.append(iss["key"])
+
+    # Move 3 cards into target_state
