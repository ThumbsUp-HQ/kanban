{
  "description": "Captured HTTP contract samples for KANBA-186 persistent sessions, plain HTTP fallback cookies, and CSRF token stability",
  "scenarios": [
    {
      "name": "login_persistent_true",
      "request": {
        "method": "POST",
        "url": "/api/v1/auth/local/login",
        "body": {
          "username": "admin",
          "password": "[REDACTED]",
          "remember_me": true
        }
      },
      "response": {
        "status": 200,
        "set_cookie_headers": [
          "__Host-kb_session=v1.AAAA...; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=2592000; Expires=Thu, 17 Dec 2026 23:00:00 GMT",
          "__Host-kb_csrf=csrf-token-abc...; Path=/; Secure; SameSite=Lax",
          "kb_session=v1.AAAA...; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000; Expires=Thu, 17 Dec 2026 23:00:00 GMT",
          "kb_csrf=csrf-token-abc...; Path=/; SameSite=Lax"
        ],
        "body": {
          "status": "authenticated"
        }
      }
    },
    {
      "name": "login_persistent_false",
      "request": {
        "method": "POST",
        "url": "/api/v1/auth/local/login",
        "body": {
          "username": "admin",
          "password": "[REDACTED]",
          "remember_me": false
        }
      },
      "response": {
        "status": 200,
        "set_cookie_headers": [
          "__Host-kb_session=v1.BBBB...; Path=/; HttpOnly; Secure; SameSite=Lax",
          "__Host-kb_csrf=csrf-token-def...; Path=/; Secure; SameSite=Lax",
          "kb_session=v1.BBBB...; Path=/; HttpOnly; SameSite=Lax",
          "kb_csrf=csrf-token-def...; Path=/; SameSite=Lax"
        ],
        "body": {
          "status": "authenticated"
        }
      }
    },
    {
      "name": "get_session_stability_with_existing_csrf",
      "request": {
        "method": "GET",
        "url": "/api/v1/auth/session",
        "headers": {
          "Cookie": "__Host-kb_session=v1.AAAA...; __Host-kb_csrf=csrf-token-abc..."
        }
      },
      "response": {
        "status": 200,
        "set_cookie_headers": [],
        "body": {
          "authenticated": true,
          "principal_id": "11111111-1111-1111-1111-111111111111",
          "workspace_id": "22222222-2222-2222-2222-222222222222",
          "aal_level": 2,
          "mfa_pending": false,
          "csrf_token": "csrf-token-abc...",
          "remember_me": true,
          "idle_expires_at": "2026-11-24T23:00:00Z",
          "absolute_expires_at": "2026-12-17T23:00:00Z"
        }
      }
    }
  ]
}
