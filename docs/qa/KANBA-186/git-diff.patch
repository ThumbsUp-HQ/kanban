+        start_params = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(start_loc).query))
+
+        # Extract browser binding cookie
+        binding_val = ""
+        for cookie_hdr in start_res.headers.get_list("set-cookie"):
