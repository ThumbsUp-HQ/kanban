+-- 4. Restore p2_02 session_rotate
+CREATE OR REPLACE FUNCTION kb_auth.session_rotate(
+    p_old_id UUID,
+    p_new_token_sha256 BYTEA,
+    p_aal SMALLINT
+)
+RETURNS UUID
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public
