+BEGIN
+    UPDATE sessions
+    SET revoked_at = v_now
+    WHERE id = p_old_id
+      AND revoked_at IS NULL
+    RETURNING * INTO v_old;
+
+    IF NOT FOUND THEN
+        RAISE EXCEPTION 'session_not_found_or_revoked: %', p_old_id
+            USING ERRCODE = 'P0002';
+    END IF;
+
+    IF p_aal = 2 THEN
+        v_aal2_at := v_now;
+    END IF;
+
+    v_idle_interval := v_old.idle_expires_at - v_old.last_seen_at;
+
+    INSERT INTO sessions (
+        id,
+        token_sha256,
+        principal_id,
+        workspace_id,
+        auth_card_id,
+        aal_level,
+        aal2_verified_at,
+        mfa_pending,
+        created_at,
+        last_seen_at,
+        idle_expires_at,
+        absolute_expires_at,
+        rotated_from_id
+    ) VALUES (
+        v_new_id,
+        p_new_token_sha256,
