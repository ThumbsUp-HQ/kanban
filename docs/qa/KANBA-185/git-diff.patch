+
+/* Google OAuth JSON Importer (KB-AUTH-JSON) */
+.auth-google-json-section {
+  margin-top: var(--space-4, 16px);
+  margin-bottom: var(--space-4, 16px);
+  padding: var(--space-3, 12px) var(--space-4, 16px);
+  background: var(--bg-canvas);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md, 6px);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3, 12px);
+}
+
+.auth-google-json-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.auth-google-json-title {
+  font-size: var(--text-sm, 0.8125rem);
+  font-weight: var(--font-semibold, 600);
+  color: var(--fg-primary);
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+}
+
+.auth-google-json-dropzone {
+  border: 2px dashed var(--border-strong);
+  border-radius: var(--radius-md, 6px);
+  padding: var(--space-4, 16px);
+  text-align: center;
+  background: var(--bg-surface);
+  cursor: pointer;
+  transition: border-color 0.15s ease, background 0.15s ease;
+}
+
+.auth-google-json-dropzone--active {
+  border-color: var(--focus-ring);
+  background: var(--bg-hover);
+}
+
+.auth-google-json-dropzone p {
+  margin: 0;
+  font-size: var(--text-sm, 0.8125rem);
+  color: var(--fg-secondary);
+}
+
+.auth-google-json-dropzone span {
+  font-size: var(--text-xs, 0.75rem);
+  color: var(--fg-muted);
+}
+
+.auth-google-json-paste-box {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2, 8px);
+  margin-top: var(--space-2, 8px);
+}
+
+.auth-google-json-textarea {
+  width: 100%;
+  box-sizing: border-box;
+  font-family: var(--font-mono, monospace);
+  font-size: var(--text-xs, 0.75rem);
+  padding: var(--space-2, 8px);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius-sm, 4px);
+  background: var(--bg-surface);
+  color: var(--fg-primary);
+  min-height: 80px;
+  resize: vertical;
+}
+
+.auth-google-json-status {
+  padding: var(--space-2, 8px) var(--space-3, 12px);
+  border-radius: var(--radius-sm, 4px);
+  font-size: var(--text-xs, 0.75rem);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1, 4px);
+}
+
+.auth-google-json-status--ok {
+  background: var(--bg-surface-raised);
+  border: 1px solid var(--ok-fg);
+  color: var(--ok-fg);
+}
+
+.auth-google-json-status--warning {
+  background: var(--warn-bg);
+  border: 1px solid var(--warn-fg);
+  color: var(--warn-fg);
+}
+
+.auth-google-json-uris-list {
+  margin: 4px 0 0 16px;
+  padding: 0;
+  font-family: var(--font-mono, monospace);
+  font-size: 11px;
+}
