+        if host == "secure-llm.example.com":
+            return ["93.184.216.34"]
+        return ["127.0.0.1"]
+
+    # Test HTTPS: connects to pinned_ip URL with Host and sni_hostname
+    with mock.patch.object(httpx.AsyncClient, "get", new_callable=mock.AsyncMock) as mock_get:
