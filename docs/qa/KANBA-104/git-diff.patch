+import { describe, it, expect, vi } from 'vitest';
+import { render, screen, act } from '@testing-library/react';
+import React from 'react';
+import {
+  ShellPanelsProvider,
+  useShellPanels,
+  registerShellPanel,
+} from './shellPanels';
+import * as RealtimeStatusModule from '../api/RealtimeStatus';
+
+describe('shellPanels', () => {
+  it('throws when useShellPanels is used outside ShellPanelsProvider', () => {
+    function InvalidConsumer() {
+      useShellPanels();
+      return null;
+    }
+    expect(() => render(<InvalidConsumer />)).toThrow(
+      'useShellPanels must be used within a ShellPanelsProvider',
+    );
+  });
+
+  it('calls announce("Panel not available yet") when opening an unregistered panel', () => {
+    const announceSpy = vi
+      .spyOn(RealtimeStatusModule, 'announce')
+      .mockImplementation(() => {
+        /* noop */
+      });
+
+    function Consumer() {
+      const { openPanel } = useShellPanels();
+      return (
+        <button type="button" onClick={() => { openPanel('unregistered-panel'); }}>
+          Open
+        </button>
+      );
+    }
+
+    render(
+      <ShellPanelsProvider>
+        <Consumer />
+      </ShellPanelsProvider>,
+    );
+
+    const btn = screen.getByRole('button', { name: 'Open' });
+    act(() => {
+      btn.click();
+    });
+
+    expect(announceSpy).toHaveBeenCalledWith('Panel not available yet');
+    announceSpy.mockRestore();
+  });
+
+  it('opens and closes registered panel successfully', () => {
+    function DummyPanel({ onClose, arg }: { onClose: () => void; arg?: unknown }) {
+      return (
+        <div data-testid="dummy-panel">
+          <span>Payload: {String(arg)}</span>
+          <button type="button" onClick={onClose}>
+            Close Panel
+          </button>
+        </div>
+      );
+    }
+
+    const unregister = registerShellPanel('dummy', DummyPanel);
+
+    function Consumer() {
+      const { openPanel } = useShellPanels();
+      return (
+        <button type="button" onClick={() => { openPanel('dummy', 'test-payload'); }}>
+          Open Dummy
+        </button>
+      );
+    }
+
+    render(
+      <ShellPanelsProvider>
+        <Consumer />
+      </ShellPanelsProvider>,
+    );
+
+    const openBtn = screen.getByRole('button', { name: 'Open Dummy' });
+    act(() => {
+      openBtn.click();
+    });
+
+    const panel = screen.getByTestId('dummy-panel');
+    expect(panel).toBeDefined();
+    expect(panel.textContent).toContain('Payload: test-payload');
+
+    const closeBtn = screen.getByRole('button', { name: 'Close Panel' });
+    act(() => {
+      closeBtn.click();
+    });
+
+    expect(screen.queryByTestId('dummy-panel')).toBeNull();
+    unregister();
+  });
+
+  it('returns null if registered panel is removed while open', () => {
+    function TempPanel(): React.JSX.Element {
+      return <div data-testid="temp-panel">Temp</div>;
+    }
+    const unregister = registerShellPanel('temp', TempPanel);
+    let openTemp: () => void = () => {
+      /* noop */
+    };
+    function Consumer(): React.JSX.Element {
+      const { openPanel } = useShellPanels();
+      openTemp = () => {
+        openPanel('temp');
+      };
+      return <div />;
+    }
+    const { rerender } = render(
+      <ShellPanelsProvider>
+        <Consumer />
+      </ShellPanelsProvider>,
+    );
+    act(() => {
+      openTemp();
+    });
+    expect(screen.getByTestId('temp-panel')).toBeDefined();
+    act(() => {
+      unregister();
+    });
+    rerender(
+      <ShellPanelsProvider>
+        <Consumer />
+      </ShellPanelsProvider>,
+    );
+    expect(screen.queryByTestId('temp-panel')).toBeNull();
+  });
+});
diff --git a/kanban/web/src/app/shellPanels.tsx b/kanban/web/src/app/shellPanels.tsx
new file mode 100644
index 0000000..2932191
--- /dev/null
+++ b/kanban/web/src/app/shellPanels.tsx
@@ -0,0 +1,105 @@
+/**
+ * Shell Drawer and Modal Panel Registry (KB-P3-34, S6.3).
+ * Decoupled panel invocation with accessibility announcement fallback.
+ */
+
+import React, {
+  createContext,
+  useCallback,
+  useContext,
+  useState,
+  type ComponentType,
+  type JSX,
+  type ReactNode,
+} from 'react';
+import { announce } from '../api/RealtimeStatus';
+
+export type ShellPanelComponent = ComponentType<{
+  arg?: unknown;
+  onClose: () => void;
+}>;
+
+const panelRegistry = new Map<string, ShellPanelComponent>();
+
+/**
+ * Registers a drawer or modal panel implementation by identifier.
+ * Returns an unregister callback.
+ */
+export function registerShellPanel(
+  id: string,
+  component: ShellPanelComponent,
+): () => void {
+  panelRegistry.set(id, component);
+  return () => {
+    panelRegistry.delete(id);
+  };
+}
+
+export interface ShellPanelsContextValue {
+  openPanel: (id: string, arg?: unknown) => void;
+  closePanel: () => void;
+  activePanel: { id: string; arg?: unknown } | null;
+}
+
+const ShellPanelsContext = createContext<ShellPanelsContextValue | null>(null);
+
+export interface ShellPanelsProviderProps {
+  children: ReactNode;
+}
+
+/**
+ * Context provider coordinating drawer/dialog panels hosted within the AppShell.
+ */
+function renderActivePanel(
+  activePanel: { id: string; arg?: unknown } | null,
+  closePanel: () => void,
+): React.ReactNode {
+  if (!activePanel) {
+    return null;
+  }
+  const Component = panelRegistry.get(activePanel.id);
+  if (!Component) {
+    return null;
+  }
+  return <Component arg={activePanel.arg} onClose={closePanel} />;
+}
+
+export function ShellPanelsProvider({
+  children,
+}: ShellPanelsProviderProps): JSX.Element {
+  const [activePanel, setActivePanel] = useState<{
+    id: string;
+    arg?: unknown;
+  } | null>(null);
+
+  const openPanel = useCallback((id: string, arg?: unknown): void => {
+    const Component = panelRegistry.get(id);
+    if (!Component) {
+      announce('Panel not available yet');
+      return;
+    }
+    setActivePanel({ id, arg });
+  }, []);
+
+  const closePanel = useCallback((): void => {
+    setActivePanel(null);
+  }, []);
+
+  return (
+    <ShellPanelsContext.Provider value={{ openPanel, closePanel, activePanel }}>
+      {children}
+      {renderActivePanel(activePanel, closePanel)}
+    </ShellPanelsContext.Provider>
+  );
+}
+
+/**
+ * Accesses shell panel activation controls.
+ */
+export function useShellPanels(): ShellPanelsContextValue {
+  const ctx = useContext(ShellPanelsContext);
+  if (!ctx) {
+    throw new Error('useShellPanels must be used within a ShellPanelsProvider');
+  }
+  return ctx;
+}
