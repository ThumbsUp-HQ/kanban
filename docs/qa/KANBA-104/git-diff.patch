+
+.kb-theme-radiogroup {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.kb-theme-radio {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  padding: 6px 8px;
+  border-radius: var(--radius-sm, 4px);
+  border: none;
+  background: transparent;
+  color: var(--fg-secondary, #cbd5e1);
+  font-size: 13px;
+  cursor: pointer;
+  text-align: left;
+}
+
+.kb-theme-radio[aria-checked="true"],
+.kb-theme-radio:hover {
+  background: var(--bg-hover, #2c313a);
+  color: var(--fg-primary, #f8fafc);
+}
+
+/* Tablet & Mobile Breakpoints */
+@media (max-width: 1279px) {
+  .kb-topbar-hamburger {
+    display: inline-flex;
+  }
+}
+
+@media (max-width: 767px) {
+  .kb-topbar {
+    padding: 0 16px;
+    gap: 8px;
+  }
+  .kb-search-trigger {
+    min-width: unset;
+    width: 44px;
+    height: 44px;
+    padding: 0;
+    justify-content: center;
+  }
+  .kb-search-trigger-text,
+  .kb-search-kbd {
+    display: none;
+  }
+}
