+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, act } from '@testing-library/react';
+import React from 'react';
+import { MemoryRouter } from 'react-router';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { Topbar } from './Topbar';
+import { ThemeProvider } from '../theme/ThemeProvider';
+import { ShellPanelsProvider } from './shellPanels';
+
+describe('Topbar', () => {
+  let queryClient: QueryClient;
+
+  beforeEach(() => {
+    queryClient = new QueryClient({
+      defaultOptions: { queries: { retry: false } },
+    });
+  });
+
+  it('renders breadcrumb, search trigger, header pills, and avatar menu', () => {
+    const onOpenPalette = vi.fn();
+    const onToggleSidebar = vi.fn();
+
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <ShellPanelsProvider>
+            <MemoryRouter initialEntries={['/projects/KAN/issues']}>
+              <Topbar
+                onOpenPalette={onOpenPalette}
+                onToggleSidebar={onToggleSidebar}
+                projectKey="KAN"
+                projectName="kanban"
+                currentSection="Work Items"
+                issueCount={7}
+              />
+            </MemoryRouter>
+          </ShellPanelsProvider>
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    // Breadcrumb
+    expect(screen.getByText('kanban')).toBeDefined();
+    expect(screen.getByText('Work Items')).toBeDefined();
+    expect(screen.getByText('(7)')).toBeDefined();
+
+    // Search trigger
+    const searchBtn = screen.getByRole('button', { name: 'Search or run command' });
+    expect(searchBtn).toBeDefined();
+    act(() => {
+      searchBtn.click();
+    });
+    expect(onOpenPalette).toHaveBeenCalledTimes(1);
+
+    // Hamburger button
+    const hamburger = screen.getByRole('button', { name: 'Open navigation' });
+    act(() => {
+      hamburger.click();
+    });
+    expect(onToggleSidebar).toHaveBeenCalledTimes(1);
+
+    // Layout switcher rendered on issues route
+    expect(screen.getByRole('radiogroup', { name: 'Layout' })).toBeDefined();
+  });
+
+  it('toggles avatar menu and sets theme via radiogroup', () => {
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <ShellPanelsProvider>
+            <MemoryRouter>
+              <Topbar />
+            </MemoryRouter>
+          </ShellPanelsProvider>
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    const avatarBtn = screen.getByRole('button', { name: 'User profile and settings' });
+    act(() => {
+      avatarBtn.click();
+    });
+
+    const themeRadiogroup = screen.getByRole('radiogroup', { name: 'Theme' });
+    expect(themeRadiogroup).toBeDefined();
+
+    const darkRadio = screen.getByRole('radio', { name: /Dark/ });
+    act(() => {
+      darkRadio.click();
+    });
+
+    expect(document.documentElement.dataset.theme).toBe('dark');
+
+    // Click inside avatarRef does not close
+    act(() => {
+      avatarBtn.click();
+    });
+    expect(screen.getByRole('radiogroup', { name: 'Theme' })).toBeDefined();
+
+    act(() => {
+      themeRadiogroup.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
+    });
+    expect(screen.getByRole('radiogroup', { name: 'Theme' })).toBeDefined();
+
+    // Click outside to close
+    act(() => {
+      document.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
+    });
+    expect(screen.queryByRole('radiogroup', { name: 'Theme' })).toBeNull();
+  });
+
+  it('omits layout switcher on non-issues routes or when explicitly disabled', () => {
+    const { unmount } = render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <ShellPanelsProvider>
+            <MemoryRouter initialEntries={['/projects/KAN/overview']}>
+              <Topbar />
+            </MemoryRouter>
+          </ShellPanelsProvider>
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    expect(screen.queryByRole('radiogroup', { name: 'Layout' })).toBeNull();
+    unmount();
+
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <ShellPanelsProvider>
+            <MemoryRouter initialEntries={['/projects/KAN/issues']}>
+              <Topbar showLayoutSwitcher={false} />
+            </MemoryRouter>
+          </ShellPanelsProvider>
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    expect(screen.queryByRole('radiogroup', { name: 'Layout' })).toBeNull();
+  });
+
+  it('omits layout switcher on issue detail route /projects/:key/issues/:id', () => {
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <ShellPanelsProvider>
+            <MemoryRouter initialEntries={['/projects/KAN/issues/KAN-123']}>
+              <Topbar />
+            </MemoryRouter>
+          </ShellPanelsProvider>
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    expect(screen.queryByRole('radiogroup', { name: 'Layout' })).toBeNull();
+  });
+
+  it('renders default breadcrumb and avatar menu with minimal props', () => {
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <ShellPanelsProvider>
+            <MemoryRouter>
+              <Topbar />
+            </MemoryRouter>
+          </ShellPanelsProvider>
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    const avatarBtn = screen.getByRole('button', { name: 'User profile and settings' });
+    expect(avatarBtn).toBeDefined();
+  });
+});
diff --git a/kanban/web/src/app/Topbar.tsx b/kanban/web/src/app/Topbar.tsx
new file mode 100644
index 0000000..cd42e71
--- /dev/null
+++ b/kanban/web/src/app/Topbar.tsx
@@ -0,0 +1,180 @@
+/**
+ * Topbar Component (KB-P3-34, S6.3).
+ * 52px calm header with breadcrumb, Cmd+K trigger, emoji pills, layout switcher, and avatar theme menu.
+ */
+
+import React, {
+  useEffect,
+  useRef,
+  useState,
+  type JSX,
+} from 'react';
+import { useLocation } from 'react-router';
+import { Breadcrumb } from './Breadcrumb';
+import { HeaderPills, type AccessManifestData } from './HeaderPills';
+import { LayoutSwitcher } from './LayoutSwitcher';
+import { useTheme, type Theme } from '../theme/ThemeProvider';
+import { type SystemStatus } from './useSystemStatus';
+import './Topbar.css';
+
+export interface TopbarProps {
+  isSidebarOpen?: boolean | undefined;
+  onToggleSidebar?: (() => void) | undefined;
+  onOpenPalette?: (() => void) | undefined;
+  projectKey?: string | undefined;
+  projectName?: string | undefined;
+  currentSection?: string | undefined;
+  issueCount?: number | null | undefined;
+  showLayoutSwitcher?: boolean | undefined;
+  accessManifest?: AccessManifestData | null | undefined;
+  systemStatus?: SystemStatus | null | undefined;
+}
+
+const THEME_OPTIONS: readonly { id: Theme; label: string; icon: string }[] = [
+  { id: 'light', label: 'Light', icon: '☀️' },
+  { id: 'dark', label: 'Dark', icon: '🌙' },
+  { id: 'system', label: 'System', icon: '💻' },
+] as const;
+
+export function Topbar({
+  isSidebarOpen = true,
+  onToggleSidebar,
+  onOpenPalette,
+  projectKey = 'KAN',
+  projectName = 'kanban',
+  currentSection = 'Work Items',
+  issueCount,
+  showLayoutSwitcher: showLayoutOverride,
+  accessManifest,
+  systemStatus,
+}: TopbarProps): JSX.Element {
+  const loc = useLocation();
+  const locationPathname = loc.pathname;
+
+  const isIssuesRoute =
+    showLayoutOverride ??
+    (locationPathname.includes('/issues') && !(/\/issues\/[A-Z0-9]+-[0-9]+/.exec(locationPathname)));
+
+  const [avatarMenuOpen, setAvatarMenuOpen] = useState(false);
+  const avatarRef = useRef<HTMLDivElement>(null);
+  const themeContext = useTheme();
+
+  // Close avatar menu on outside click
+  useEffect(() => {
+    if (!avatarMenuOpen) return;
+    const handleOutside = (e: MouseEvent): void => {
+      if (avatarRef.current && !avatarRef.current.contains(e.target as Node)) {
+        setAvatarMenuOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleOutside);
+    return () => { document.removeEventListener('mousedown', handleOutside); };
+  }, [avatarMenuOpen]);
+
+  const activeTheme = themeContext.theme;
+
+  return (
+    <header className="kb-topbar">
+      {/* Left: Hamburger & Breadcrumb */}
+      <div className="kb-topbar-left">
+        <button
+          type="button"
+          className="kb-topbar-hamburger"
+          aria-label="Open navigation"
+          aria-expanded={isSidebarOpen}
+          onClick={onToggleSidebar}
+        >
+          ☰
+        </button>
+        <Breadcrumb
+          projectKey={projectKey}
+          projectName={projectName}
+          currentSection={currentSection}
+          issueCount={issueCount}
+        />
+      </div>
+
+      {/* Center: Search Trigger Styled as Input */}
+      <div className="kb-topbar-center">
+        <button
+          type="button"
+          className="kb-search-trigger"
+          aria-label="Search or run command"
+          aria-keyshortcuts="Meta+K Control+K"
+          onClick={onOpenPalette}
+        >
+          <div className="kb-search-trigger-content">
+            <span aria-hidden="true">🔍</span>
+            <span className="kb-search-trigger-text">Search / Cmd+K...</span>
+          </div>
+          <kbd className="kb-search-kbd">Cmd+K</kbd>
+        </button>
+      </div>
+
+      {/* Right: Header Pills, Layout Switcher & Avatar Menu */}
+      <div className="kb-topbar-right">
+        <HeaderPills
+          projectId={projectKey}
+          projectName={projectName}
+          accessManifest={accessManifest}
+          systemStatus={systemStatus}
+        />
+
+        {isIssuesRoute && <LayoutSwitcher />}
+
+        <div ref={avatarRef} className="kb-avatar-wrapper">
+          <button
+            type="button"
+            className="kb-avatar-button"
+            aria-label="User profile and settings"
+            aria-haspopup="menu"
+            aria-expanded={avatarMenuOpen}
+            onClick={() => { setAvatarMenuOpen(!avatarMenuOpen); }}
+          >
+            A
+          </button>
+
+          {avatarMenuOpen && (
+            <div
+              className="kb-avatar-menu"
+              role="menu"
+              aria-label="User settings"
+            >
+              <div className="kb-theme-menu-title">Theme</div>
+              <div
+                className="kb-theme-radiogroup"
+                role="radiogroup"
+                aria-label="Theme"
+              >
+                {THEME_OPTIONS.map((opt) => {
+                  const isChecked = activeTheme === opt.id;
+                  return (
+                    <button
+                      key={opt.id}
+                      type="button"
+                      role="radio"
+                      aria-checked={isChecked}
+                      className="kb-theme-radio"
+                      onClick={() => {
+                        themeContext.setTheme(opt.id);
+                        setAvatarMenuOpen(false);
+                      }}
+                    >
+                      <span>
+                        <span aria-hidden="true" style={{ marginRight: '8px' }}>
+                          {opt.icon}
+                        </span>
+                        {opt.label}
+                      </span>
+                      {isChecked && <span aria-hidden="true">✓</span>}
+                    </button>
+                  );
+                })}
+              </div>
+            </div>
+          )}
+        </div>
+      </div>
+    </header>
+  );
+}
diff --git a/kanban/web/src/app/routes.test.tsx b/kanban/web/src/app/routes.test.tsx
new file mode 100644
index 0000000..7640a33
--- /dev/null
+++ b/kanban/web/src/app/routes.test.tsx
@@ -0,0 +1,258 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent } from '@testing-library/react';
+import React from 'react';
+import { RouterProvider } from 'react-router';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { createAppRouter, PROJECT_KEY_REGEX, ISSUE_KEY_REGEX } from './routes';
+import { ThemeProvider } from '../theme/ThemeProvider';
+
+describe('routes and AppShell integration', () => {
+  let queryClient: QueryClient;
+
+  beforeEach(() => {
+    queryClient = new QueryClient({
+      defaultOptions: { queries: { retry: false } },
+    });
+    vi.restoreAllMocks();
+  });
+
+  it('validates projectKey and issueKey regexes strictly', () => {
+    expect(PROJECT_KEY_REGEX.test('KAN')).toBe(true);
+    expect(PROJECT_KEY_REGEX.test('KB1')).toBe(true);
+    expect(PROJECT_KEY_REGEX.test('P10')).toBe(true);
+    expect(PROJECT_KEY_REGEX.test('kan')).toBe(false); // Lowercase rejected
+    expect(PROJECT_KEY_REGEX.test('1KAN')).toBe(false); // Leading digit rejected
+    expect(PROJECT_KEY_REGEX.test('')).toBe(false);
+    expect(PROJECT_KEY_REGEX.test('TOOLONGPROJECTKEY')).toBe(false);
+
+    expect(ISSUE_KEY_REGEX.test('KAN-1')).toBe(true);
+    expect(ISSUE_KEY_REGEX.test('KAN-142')).toBe(true);
+    expect(ISSUE_KEY_REGEX.test('KAN-1x')).toBe(false); // Suffix character rejected
+    expect(ISSUE_KEY_REGEX.test('kan-142')).toBe(false);
+    expect(ISSUE_KEY_REGEX.test('KAN-')).toBe(false);
+  });
+
+  it('renders AppShell with sidebar items, breadcrumb, and layout=board selection', () => {
+    const router = createAppRouter(['/projects/KAN/issues?layout=board']);
+
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <RouterProvider router={router} />
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    // Sidebar items
+    expect(screen.getByText(/👍kanban/)).toBeDefined();
+    expect(screen.getByRole('link', { name: /Work Items/ })).toBeDefined();
+    expect(screen.getByRole('link', { name: /Cycles/ })).toBeDefined();
+    expect(screen.getByRole('link', { name: /Modules/ })).toBeDefined();
+    expect(screen.getByRole('link', { name: /Views/ })).toBeDefined();
+    expect(screen.getByRole('link', { name: /Docs \(Pages\)/ })).toBeDefined();
+
+    // Breadcrumb
+    expect(screen.getByRole('navigation', { name: 'Breadcrumb' })).toBeDefined();
+
+    // Layout switcher has Board selected
+    const boardRadio = screen.getByRole('radio', { name: 'Board' });
+    expect(boardRadio.getAttribute('aria-checked')).toBe('true');
+
+    // Route placeholder rendered inside shell
+    expect(screen.getByTestId('route-placeholder')).toBeDefined();
+  });
+
+  it('normalizes ?layout=<script> to list via navigate replace', async () => {
+    const router = createAppRouter(['/projects/KAN/issues?layout=<script>alert(1)</script>']);
+
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <RouterProvider router={router} />
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    // After normalization, List should be checked
+    const listRadio = await screen.findByRole('radio', { name: 'List' });
+    expect(listRadio.getAttribute('aria-checked')).toBe('true');
+  });
+
+  it('renders "Not found or no access" for invalid projectKey or issueKey without fetch calls', () => {
+    const fetchSpy = vi.spyOn(window, 'fetch');
+
+    const routerInvalidProj = createAppRouter(['/projects/kan/issues']);
+    const { unmount } = render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <RouterProvider router={routerInvalidProj} />
+        </ThemeProvider>
+      </QueryClientProvider>,
+    );
+
+    expect(screen.getByText('Not found or no access')).toBeDefined();
+    expect(fetchSpy).not.toHaveBeenCalled();
+
+    unmount();
+
+    const routerInvalidIssue = createAppRouter(['/projects/KAN/issues/KAN-1x']);
+    render(
+      <QueryClientProvider client={queryClient}>
+        <ThemeProvider>
+          <RouterProvider router={routerInvalidIssue} />
