-+BANNED_FLAGS: Final[frozenset[str]] = frozenset(
-+    {
-+        "--yolo",
-+        "--dangerously-bypass-approvals-and-sandbox",
-+        "--dangerously-skip-permissions",
-+        "--full-auto",
-+        "--allow-all-tools",
-+    }
-+)
