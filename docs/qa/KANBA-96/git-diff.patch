-def to_base62(num: int) -> str:
-    """Encode a positive integer into base62."""
-    if num < 0:
-        msg = "num must be non-negative"
-        raise ValueError(msg)
-    if num == 0:
-        return "0"
-    digits: list[str] = []
-    n = num
-    while n > 0:
-        digits.append(BASE62_ALPHABET[n % 62])
-        n //= 62
-    return "".join(reversed(digits))
