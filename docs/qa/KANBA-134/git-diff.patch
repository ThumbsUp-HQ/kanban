+}: AuthCardEditorDrawerProps): JSX.Element | null {
+  const isEdit = Boolean(card);
+  const drawerRef = useRef<HTMLDivElement | null>(null);
+
+  // Common metadata
+  const [prevCard, setPrevCard] = useState<AdminAuthCard | null>(card);
