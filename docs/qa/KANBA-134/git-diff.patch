+        {
+          selector: '.auth-editor-prop-row',
+          label: 'Property Row Height',
+          note: '38px min-height',
+        },
+      ],
+    });
+  });
+
+  test('04-lockout-prevented-banner: disabling Local Administrator triggers 409 alert banner and switch rollback', async ({
+    page,
+  }, testInfo) => {
+    await mockApi(page, {
+      ...getBaseShellMocks(),
