++            aria-label={
++              isPinned
++                ? 'Local Admin always appears in the break-glass disclosure'
++                : `Move ${card.display_name} up`
++            }
++          >
++            ▲
++          </button>
++          <button
++            type="button"
++            className="auth-reorder-btn"
++            disabled={!canMoveDown}
++            onClick={() => onMoveDown?.(card)}
++            aria-label={
++              isPinned
++                ? 'Local Admin always appears in the break-glass disclosure'
++                : `Move ${card.display_name} down`
++            }
