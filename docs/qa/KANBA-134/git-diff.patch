++  onTestHandshake: (card: AdminAuthCard) => void;
++  onEdit: (card: AdminAuthCard) => void;
++  onDelete: (card: AdminAuthCard) => void;
++  onDragStart?: (e: React.DragEvent<HTMLLIElement>, index: number) => void;
