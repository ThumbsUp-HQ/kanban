+/**
+ * Styles for Admin Auth Studio (KB-P3-36, S6.1, S6.2, S4.1, S4.3).
+ * Zero inline styles allowed. All measurements use CSS custom properties.
+ */
+
+.auth-studio-page {
+  padding: 24px 32px;
+  max-width: 1200px;
+  margin: 0 auto;
+}
+
+.auth-studio-header {
+  margin-bottom: var(--section-gap, 32px);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 16px;
+}
+
+.auth-studio-title-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.auth-studio-title {
+  margin: 0;
+  font-size: 1.5rem;
+  font-weight: 600;
+  color: var(--fg-default);
+}
+
+.auth-studio-add-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 16px;
+  font-size: 0.875rem;
+  font-weight: 500;
+  border-radius: var(--radius-md, 6px);
+  background: var(--brand-primary, #2563eb);
+  color: #fff;
+  border: none;
+  cursor: pointer;
+  min-height: 36px;
+  transition: opacity 0.15s ease;
+}
+
+.auth-studio-add-btn:hover:not(:disabled) {
+  opacity: 0.9;
+}
+
+.auth-studio-add-btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* Card List */
+.auth-studio-list {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  row-gap: var(--card-gap, 12px);
+}
+
+.auth-card-row {
+  padding: var(--card-pad, 16px 18px);
+  background: var(--bg-surface);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg, 10px);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  transition: box-shadow 0.15s ease, border-color 0.15s ease;
+}
+
+.auth-card-row:hover {
+  border-color: var(--border-default);
+}
+
+.auth-card-row--dragging {
+  opacity: 0.4;
+  border-style: dashed;
+}
+
+.auth-card-row--drag-over {
