+}
+
+.auth-card-right {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-shrink: 0;
+}
+
+/* Health status chip */
+.auth-health-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 0.8rem;
+  font-weight: 500;
+  padding: 3px 8px;
+  border-radius: var(--radius-sm, 4px);
+}
+
+.auth-health-chip--healthy {
+  color: var(--ok-fg, #15803d);
+  background: var(--ok-subtle, rgba(21, 128, 61, 0.1));
+}
+
+.auth-health-chip--unverified {
+  color: var(--fg-muted, #6b7280);
+  background: var(--bg-hover, rgba(107, 114, 128, 0.1));
+}
+
+.auth-health-chip--failed {
