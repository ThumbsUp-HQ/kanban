+}
+
+const SLUG_REGEX = /^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$/;
+const SPKI_REGEX = /^[A-Fa-f0-9]{64}$/;
+
+export function AuthCardEditorDrawer({
+  isOpen,
