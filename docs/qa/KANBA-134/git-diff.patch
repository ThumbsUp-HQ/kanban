+
+    // Capture annotated screenshot 03
+    await annotatedScreenshot(page, testInfo, {
+      name: '03-edit-drawer-write-only',
+      annotations: [
+        {
+          selector: '.auth-badge--pkce',
+          label: 'PKCE Badge',
