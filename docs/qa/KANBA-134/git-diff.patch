+
+.auth-toggle-input:checked + .auth-toggle-track::after {
+  transform: translateX(16px);
+}
+
+.auth-toggle-input:focus-visible + .auth-toggle-track {
+  outline: 2px solid var(--brand-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.auth-toggle-input:disabled + .auth-toggle-track {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
