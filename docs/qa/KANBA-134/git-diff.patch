+}
+
+.auth-card-row--pinned {
+  background: var(--bg-canvas, #f9fafb);
+  border-style: dashed;
+}
+
+.auth-card-left {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 0;
+}
+
+.auth-card-drag-handle {
+  cursor: grab;
+  color: var(--fg-muted);
+  user-select: none;
+  font-size: 1rem;
+  padding: 4px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 24px;
+  min-height: 24px;
+}
