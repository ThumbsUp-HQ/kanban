+
+export interface AuthCardEditorDrawerProps {
+  isOpen: boolean;
+  card: AdminAuthCard | null; // null = create new card
+  onClose: () => void;
+  onSave: (
+    payload: CreateAuthCardPayload | UpdateAuthCardPayload,
+    isEdit: boolean,
