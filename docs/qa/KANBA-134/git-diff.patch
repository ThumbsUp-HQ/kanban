++          type="button"
++          className="auth-btn-secondary auth-btn-danger"
++          onClick={() => { onDelete(card); }}
++          disabled={isPinned}
++          aria-label={
++            isPinned
++              ? 'Local Admin cannot be deleted'
++              : `Delete ${card.display_name}`
++          }
++        >
++          Delete
++        </button>
++      </div>
++    </li>
++  );
++}
