+
+/* Mobile Responsiveness & Hit Target Bounds */
+@media (max-width: 767px) {
+  .auth-studio-page {
+    padding: 16px;
+  }
+
+  .auth-card-row {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+
+  .auth-card-right {
+    width: 100%;
+    justify-content: space-between;
