diff --git a/kanban/web/src/features/admin-auth/adminAuthApi.ts b/kanban/web/src/features/admin-auth/adminAuthApi.ts
new file mode 100644
index 0000000..80e05f6
--- /dev/null
+++ b/kanban/web/src/features/admin-auth/adminAuthApi.ts
@@ -0,0 +1,189 @@
+/**
+ * Typed API client wrappers and validation helpers for Admin Auth Studio (KB-P3-36, S4.1, S4.2, S4.3).
+ */
+
+import { apiFetch } from '../../api/client';
+
+export type ProviderKind = 'OIDC' | 'OAUTH2' | 'LDAP' | 'LOCAL_ADMIN';
+
+export type HealthStatus = 'HEALTHY' | 'FAILED' | 'UNVERIFIED';
+
+export interface OidcPublicConfig {
+  issuer_url: string;
+  client_id: string;
+  scopes?: string[];
+  pkce_method?: 'S256';
+  token_auth_method?: 'client_secret_basic' | 'private_key_jwt';
+}
+
+export interface LdapPublicConfig {
+  server_url: string;
+  bind_dn: string;
+  base_dn: string;
+  user_filter?: string;
+  start_tls?: boolean;
+  ca_pem?: string;
+  spki_sha256_pin?: string;
+}
+
+export interface LocalAdminPublicConfig {
+  recovery_policy?: string;
+}
+
+export interface AdminAuthCard {
+  id: string;
+  provider_kind: ProviderKind;
+  slug: string;
+  display_name: string;
+  button_subtext: string | null;
+  icon_preset: string;
+  is_enabled: boolean;
+  sort_rank: string;
+  auto_provision_users: boolean;
+  allowed_email_domains: string[];
+  has_secret: boolean;
+  dek_kid: string | null;
+  last_health_status: HealthStatus;
+  last_handshake_at: string | null;
+  check_summary: string | null;
+  latency_ms: number | null;
+  public_config: Record<string, unknown>;
+}
+
+export interface AdminAuthCardsResponse {
+  cards: AdminAuthCard[];
+}
+
+export interface CreateAuthCardPayload {
+  provider_kind: ProviderKind;
+  slug: string;
+  display_name: string;
+  button_subtext?: string | null;
+  icon_preset: string;
+  auto_provision_users: boolean;
+  allowed_email_domains: string[];
+  public_config: Record<string, unknown>;
+  secret_input?: string;
+}
+
+export interface UpdateAuthCardPayload {
+  display_name?: string;
+  button_subtext?: string | null;
+  icon_preset?: string;
+  auto_provision_users?: boolean;
+  allowed_email_domains?: string[];
+  public_config?: Record<string, unknown>;
+  secret_input?: string;
+}
+
+export interface ReorderAuthCardPayload {
+  before_card_id: string | null;
+  after_card_id: string | null;
+  sort_rank: string;
+}
+
+export interface TestHandshakeResult {
+  last_health_status: 'HEALTHY' | 'FAILED';
+  latency_ms: number;
+  check_summary: string;
+}
+
+const FORBIDDEN_SECRET_KEYS = [
+  'client_secret',
+  'bind_dn_password',
+  'encrypted_secret_blob',
+  'wrapped_dek',
+] as const;
+
+/**
+ * Defensively strips raw secrets from auth card responses (Security Invariant KB-P3-36).
+ */
+export function sanitizeAdminAuthCard(card: AdminAuthCard): AdminAuthCard {
+  const sanitizedRecord: Record<string, unknown> = { ...card };
+  for (const key of FORBIDDEN_SECRET_KEYS) {
+    Reflect.deleteProperty(sanitizedRecord, key);
+  }
+  const config: Record<string, unknown> = { ...card.public_config };
+  for (const key of FORBIDDEN_SECRET_KEYS) {
+    Reflect.deleteProperty(config, key);
+  }
+  return {
+    ...sanitizedRecord,
+    public_config: config,
+  } as unknown as AdminAuthCard;
+}
+
+export async function fetchAdminAuthCards(): Promise<AdminAuthCardsResponse> {
+  const result = (await apiFetch(
+    'GET',
+    '/api/v1/admin/auth-cards' as never,
+  )) as Partial<AdminAuthCardsResponse>;
+  return {
+    cards: (result.cards ?? []).map(sanitizeAdminAuthCard),
+  };
+}
+
+export async function createAdminAuthCard(
+  payload: CreateAuthCardPayload,
+): Promise<AdminAuthCard> {
+  const result = (await apiFetch(
+    'POST',
+    '/api/v1/admin/auth-cards' as never,
+    { body: payload },
+  )) as AdminAuthCard;
+  return sanitizeAdminAuthCard(result);
+}
+
+export async function updateAdminAuthCard(
+  cardId: string,
+  payload: UpdateAuthCardPayload,
+): Promise<AdminAuthCard> {
+  const result = (await apiFetch(
+    'PATCH',
+    `/api/v1/admin/auth-cards/${encodeURIComponent(cardId)}` as never,
+    { body: payload },
+  )) as AdminAuthCard;
+  return sanitizeAdminAuthCard(result);
+}
+
+export async function toggleAdminAuthCardEnabled(
+  cardId: string,
+  isEnabled: boolean,
+): Promise<AdminAuthCard> {
+  const result = (await apiFetch(
+    'PATCH',
+    `/api/v1/admin/auth-cards/${encodeURIComponent(cardId)}/enabled` as never,
+    { body: { is_enabled: isEnabled } },
+  )) as AdminAuthCard;
+  return sanitizeAdminAuthCard(result);
+}
+
+export async function reorderAdminAuthCard(
+  cardId: string,
+  payload: ReorderAuthCardPayload,
+): Promise<AdminAuthCard> {
+  const result = (await apiFetch(
+    'POST',
+    `/api/v1/admin/auth-cards/${encodeURIComponent(cardId)}/reorder` as never,
+    { body: payload },
+  )) as AdminAuthCard;
+  return sanitizeAdminAuthCard(result);
+}
+
+export async function testAuthCardHandshake(
+  cardId: string,
+): Promise<TestHandshakeResult> {
+  const result = (await apiFetch(
+    'POST',
+    `/api/v1/admin/auth-cards/${encodeURIComponent(cardId)}/test-handshake` as never,
+    { body: {} },
+  )) as TestHandshakeResult;
+  return result;
+}
+
+export async function deleteAdminAuthCard(cardId: string): Promise<void> {
+  await apiFetch(
+    'DELETE',
+    `/api/v1/admin/auth-cards/${encodeURIComponent(cardId)}` as never,
+  );
+}
diff --git a/kanban/web/src/features/admin-auth/cardRank.test.ts b/kanban/web/src/features/admin-auth/cardRank.test.ts
new file mode 100644
index 0000000..d909aa8
--- /dev/null
+++ b/kanban/web/src/features/admin-auth/cardRank.test.ts
@@ -0,0 +1,113 @@
+import { describe, it, expect } from 'vitest';
+import { midpointRank } from './cardRank';
+
+describe('cardRank (KB-P3-36)', () => {
+  it('returns default rank when both bounds are null', () => {
+    expect(midpointRank(null, null)).toBe('V');
+  });
+
+  it('computes rank smaller than next when prev is null', () => {
+    const next = 'V';
+    const rank = midpointRank(null, next);
+    expect(rank < next).toBe(true);
+  });
+
+  it('computes rank greater than prev when next is null', () => {
+    const prev = 'V';
+    const rank = midpointRank(prev, null);
+    expect(rank > prev).toBe(true);
+  });
+
+  it('computes rank strictly between two adjacent ranks', () => {
+    const prev = '1';
+    const next = '2';
+    const mid = midpointRank(prev, next);
+    expect(prev < mid && mid < next).toBe(true);
+  });
+
+  it('computes rank when prev is a prefix of next', () => {
+    const prev = 'A';
+    const next = 'AV';
+    const mid = midpointRank(prev, next);
+    expect(prev < mid && mid < next).toBe(true);
+  });
+
+  it('computes rank when distance between characters is greater than 1', () => {
+    const prev = '1';
+    const next = '5';
+    const mid = midpointRank(prev, next);
+    expect(prev < mid && mid < next).toBe(true);
+    expect(mid).toBe('3');
+  });
+
+  it('handles edge case when inserting before rank 0', () => {
+    const next = '0';
+    const rank = midpointRank(null, next);
+    expect(rank).toBe('00V');
+  });
+
+  it('handles edge case when inserting after max character rank z', () => {
+    const prev = 'z';
+    const rank = midpointRank(prev, null);
+    expect(rank > prev).toBe(true);
+  });
+
+  it('maintains strict a < b ASCII COLLATE "C" ordering across 100 sequential insertions at top (Mandatory Test Case 6)', () => {
+    const ranks = ['V'];
+    for (let i = 0; i < 100; i++) {
+      const top = ranks[0];
+      if (!top) break;
+      const newRank = midpointRank(null, top);
+      expect(newRank < top).toBe(true);
+      ranks.unshift(newRank);
+    }
+
+    // Verify all 101 elements are strictly increasing
+    for (let i = 0; i < ranks.length - 1; i++) {
+      const current = ranks[i];
+      const next = ranks[i + 1];
+      if (current && next) {
+        expect(current < next).toBe(true);
+      }
+    }
+  });
+
+  it('maintains strict ordering across 100 sequential insertions at bottom', () => {
+    const ranks = ['V'];
+    for (let i = 0; i < 100; i++) {
+      const bottom = ranks[ranks.length - 1];
+      if (!bottom) break;
+      const newRank = midpointRank(bottom, null);
+      expect(newRank > bottom).toBe(true);
+      ranks.push(newRank);
+    }
+
+    for (let i = 0; i < ranks.length - 1; i++) {
+      const current = ranks[i];
+      const next = ranks[i + 1];
+      if (current && next) {
+        expect(current < next).toBe(true);
+      }
+    }
+  });
+
+  it('maintains strict ordering across 100 middle insertions between adjacent items', () => {
+    const ranks = ['1', '2'];
+    for (let i = 0; i < 100; i++) {
+      const r0 = ranks[0];
+      const r1 = ranks[1];
+      if (!r0 || !r1) break;
+      const newRank = midpointRank(r0, r1);
+      expect(r0 < newRank && newRank < r1).toBe(true);
+      ranks.splice(1, 0, newRank);
+    }
+
+    for (let i = 0; i < ranks.length - 1; i++) {
+      const current = ranks[i];
+      const next = ranks[i + 1];
+      if (current && next) {
+        expect(current < next).toBe(true);
+      }
+    }
+  });
+});
diff --git a/kanban/web/src/features/admin-auth/cardRank.ts b/kanban/web/src/features/admin-auth/cardRank.ts
