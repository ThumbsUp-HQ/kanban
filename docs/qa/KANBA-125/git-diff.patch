@@ -0,0 +1,694 @@
+/* Activity & Comments Styling (KB-P3-44, S7.1, S6.1, S7.2 8j/8k) */
+
+.activity-section {
+  display: flex;
+  flex-direction: column;
+  row-gap: var(--space-4, 16px);
+  padding-top: var(--section-gap, 32px);
+  border-top: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
+}
+
+.activity-section__header {
+  display: flex;
+  flex-direction: column;
+  row-gap: var(--space-3, 12px);
+}
+
+.activity-section__title {
+  font-size: var(--text-h2, 1.125rem);
+  font-weight: 600;
+  margin: 0;
+  color: var(--fg-primary, #f8fafc);
+}
+
+/* 4-Tab Bar */
+.activity-tablist {
+  display: flex;
+  align-items: center;
+  column-gap: var(--space-1, 4px);
+  border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
+  padding-bottom: 2px;
+}
+
+.activity-tab {
+  background: transparent;
+  border: none;
+  color: var(--fg-secondary, #94a3b8);
+  font-size: 14px;
+  font-weight: 500;
+  padding: 8px 12px;
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  column-gap: 6px;
+  transition: color 150ms ease, background 150ms ease;
+}
+
+.activity-tab:hover {
+  color: var(--fg-primary, #f8fafc);
+  background: var(--bg-hover, rgba(255, 255, 255, 0.04));
+}
+
+.activity-tab:focus-visible {
+  outline: 2px solid var(--color-brand-primary, #3b82f6);
+  outline-offset: 2px;
+}
+
+.activity-tab--active {
+  color: var(--fg-primary, #f8fafc);
+  font-weight: 600;
+  border-bottom: 2px solid var(--color-brand-primary, #3b82f6);
+  border-radius: var(--radius-md, 6px) var(--radius-md, 6px) 0 0;
+}
+
+.activity-tab__badge {
+  font-size: 12px;
+  color: var(--fg-muted, #64748b);
+}
+
+.activity-tab--active .activity-tab__badge {
+  color: var(--color-brand-primary, #3b82f6);
+}
+
+/* Activity Feed Container */
+.activity-feed {
+  display: flex;
+  flex-direction: column;
+  row-gap: var(--space-4, 16px);
+}
+
+.activity-feed__empty {
+  padding: var(--space-6, 24px);
+  text-align: center;
+  color: var(--fg-muted, #64748b);
+  font-size: 14px;
+}
+
+.activity-feed__loading {
+  padding: var(--space-4, 16px);
+  color: var(--fg-muted, #64748b);
+  font-size: 14px;
+}
+
+.activity-feed__load-older {
+  align-self: center;
+  margin-top: var(--space-2, 8px);
+  background: var(--bg-subtle, rgba(255, 255, 255, 0.04));
+  border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
+  color: var(--fg-secondary, #94a3b8);
+  font-size: 13px;
+  padding: 6px 14px;
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+}
+
+.activity-feed__load-older:hover {
+  color: var(--fg-primary, #f8fafc);
+  background: var(--bg-hover, rgba(255, 255, 255, 0.08));
+}
+
+/* Event Row Styling */
+.activity-event-row {
+  display: flex;
+  align-items: flex-start;
+  column-gap: var(--space-3, 12px);
+  font-size: 13px;
+  color: var(--fg-secondary, #94a3b8);
+  line-height: 1.5;
+  padding: 6px 0;
+}
+
+.event-row__bullet {
+  color: var(--fg-muted, #64748b);
+  font-size: 16px;
+  line-height: 1;
+  padding-top: 2px;
+}
+
+.event-row__content {
+  display: inline-flex;
+  flex-wrap: wrap;
+  align-items: center;
+  column-gap: 6px;
+}
+
+.event-row__actor {
+  font-weight: 600;
+  color: var(--fg-primary, #f8fafc);
+}
+
+.event-row__summary {
+  color: var(--fg-secondary, #94a3b8);
+}
+
+.event-row__jump-link {
+  background: none;
+  border: none;
+  padding: 0;
+  color: var(--color-brand-primary, #3b82f6);
