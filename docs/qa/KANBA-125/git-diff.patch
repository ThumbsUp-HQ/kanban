+/**
+ * Comment Composer with formatting toolbar, @mention autocomplete, and 409 safe-mention warning (KB-P3-44, S7.1, S7.2 8k).
+ */
+
+import React, {
+  useState,
+  useRef,
+  useEffect,
+  type JSX,
+  type KeyboardEvent,
+  type ChangeEvent,
+} from 'react';
+import {
+  createComment,
+  patchComment,
+  fetchAssigneeSuggestions,
+  type CommentResponse,
+  type AssigneeSuggestion,
+  type MentionAccessWarning,
+} from './activityApi';
+import { ApiProblem } from '../../api/problem';
+
+export const MAX_COMMENT_BYTES = 262144;
+
+export interface CommentComposerProps {
+  readonly issueKey: string;
+  readonly projectKey: string;
+  readonly parentCommentId?: string | null | undefined;
+  readonly initialValue?: string | undefined;
+  readonly commentId?: string | undefined;
+  readonly etag?: string | undefined;
+  readonly isEditing?: boolean | undefined;
+  readonly onSuccess?: ((comment: CommentResponse) => void) | undefined;
+  readonly onCancel?: (() => void) | undefined;
+  readonly placeholder?: string | undefined;
+}
+
+export function getUtf8ByteLength(str: string): number {
+  return new TextEncoder().encode(str).length;
+}
+
+export function isCursorInsideCode(text: string, cursorPos: number): boolean {
+  const before = text.slice(0, cursorPos);
+  // Check fenced code block: odd number of ``` before cursor means inside block
+  const backtickTriples = (before.match(/```/g) ?? []).length;
+  if (backtickTriples % 2 === 1) {
+    return true;
+  }
+  // Check inline code: odd number of ` on the current line before cursor
+  const currentLine = before.split('\n').pop() ?? '';
+  const inlineTicks = (currentLine.match(/`/g) ?? []).length;
+  return inlineTicks % 2 === 1;
+}
+
+export function extractMentionPrefix(text: string, cursorPos: number): string | null {
+  if (isCursorInsideCode(text, cursorPos)) {
+    return null;
+  }
+  const before = text.slice(0, cursorPos);
+  const match = /(?:^|\s)@([a-zA-Z0-9_-]*)$/.exec(before);
+  if (!match) {
+    return null;
+  }
+  return match[1] ?? '';
+}
+
+export function formatMentionWarning(unauthorized: readonly { readonly handle: string }[]): string {
+  const handles = unauthorized.map((m) => `@${m.handle.replace(/^@/, '')}`);
+  if (handles.length === 1) {
+    const handle = handles[0] ?? '';
+    return `${handle} cannot view this issue. Posting will NOT grant access or send a notification to ${handle}.`;
+  }
+  return `${handles.join(', ')} cannot view this issue. Posting will NOT grant access or send notifications to them.`;
+}
+
+export function CommentComposer({
+  issueKey,
+  projectKey,
+  parentCommentId = null,
+  initialValue = '',
+  commentId,
+  etag,
+  isEditing = false,
+  onSuccess,
+  onCancel,
+  placeholder = 'Write a comment... (Markdown, HTML, Mermaid, SVG auto-clean)',
+}: CommentComposerProps): JSX.Element {
+  const [draft, setDraft] = useState(initialValue);
+  const [errorText, setErrorText] = useState<string | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  // 409 safe-mention warning state
+  const [mentionWarning, setMentionWarning] = useState<MentionAccessWarning | null>(null);
+  // 412 conflict error
+  const [conflictError, setConflictError] = useState(false);
+
+  // @mention autocomplete state
+  const [suggestions, setSuggestions] = useState<readonly AssigneeSuggestion[]>([]);
+  const [suggestionPrefix, setSuggestionPrefix] = useState<string | null>(null);
+  const [cursorPosition, setCursorPosition] = useState<number>(0);
+  const [selectedSuggestionIdx, setSelectedSuggestionIdx] = useState(0);
+
+  const textareaRef = useRef<HTMLTextAreaElement | null>(null);
+  const alertRef = useRef<HTMLDivElement | null>(null);
+
+  useEffect(() => {
+    if (mentionWarning && alertRef.current) {
+      alertRef.current.focus();
+    }
+  }, [mentionWarning]);
+
+  const insertTextAtCursor = (beforeInsert: string, afterInsert = '', placeholderText = ''): void => {
+    const textarea = textareaRef.current;
+    if (!textarea) return;
+
+    const start = textarea.selectionStart;
+    const end = textarea.selectionEnd;
+    const selected = draft.slice(start, end) || placeholderText;
+    const replacement = `${beforeInsert}${selected}${afterInsert}`;
+    const nextDraft = draft.slice(0, start) + replacement + draft.slice(end);
+
+    setDraft(nextDraft);
+    setErrorText(null);
+
+    // Restore focus and selection
+    setTimeout(() => {
+      textarea.focus();
+      const newCursor = start + beforeInsert.length + selected.length;
+      textarea.setSelectionRange(newCursor, newCursor);
+    }, 0);
+  };
+
+  const handleTextChange = async (e: ChangeEvent<HTMLTextAreaElement>): Promise<void> => {
+    const val = e.target.value;
+    setDraft(val);
+    setErrorText(null);
+    setConflictError(false);
+
+    // Check for @mention trigger
+    const cursorPos = e.target.selectionStart;
+    setCursorPosition(cursorPos);
+    const prefix = extractMentionPrefix(val, cursorPos);
+    setSuggestionPrefix(prefix);
+
+    if (prefix !== null) {
+      try {
+        const resp = await fetchAssigneeSuggestions(projectKey, prefix);
+        setSuggestions(resp.items);
+        setSelectedSuggestionIdx(0);
+      } catch {
+        setSuggestions([]);
+      }
+    } else {
+      setSuggestions([]);
+    }
+  };
+
+  const applyMention = (handle: string): void => {
+    const textarea = textareaRef.current;
+    if (!textarea || suggestionPrefix === null) return;
+
+    const cursorPos = textarea.selectionStart > 0 ? textarea.selectionStart : (cursorPosition > 0 ? cursorPosition : draft.length);
+    const before = draft.slice(0, cursorPos);
+    const after = draft.slice(cursorPos);
+
+    // Replace @prefix with @handle + space
+    const atIndex = before.lastIndexOf('@');
+    if (atIndex !== -1) {
+      const cleanHandle = handle.replace(/^@/, '');
+      const newBefore = `${before.slice(0, atIndex)}@${cleanHandle} `;
+      const next = newBefore + after;
+      setDraft(next);
+      setSuggestions([]);
+      setSuggestionPrefix(null);
+
+      setTimeout(() => {
+        textarea.focus();
+        textarea.setSelectionRange(newBefore.length, newBefore.length);
+      }, 0);
+    }
+  };
+
+  const handleSubmit = async (acknowledgedPrincipals?: readonly string[]): Promise<void> => {
+    const trimmed = draft.trim();
+    if (!trimmed) {
+      setErrorText('Comment cannot be empty.');
+      return;
+    }
+
+    const byteLen = getUtf8ByteLength(trimmed);
+    if (byteLen > MAX_COMMENT_BYTES) {
+      setErrorText('Comment exceeds maximum size of 262,144 bytes.');
+      return;
+    }
+
+    setIsSubmitting(true);
+    setErrorText(null);
+
+    try {
+      let result: CommentResponse;
+      if (isEditing && commentId) {
+        result = await patchComment(
+          commentId,
+          {
+            body_markdown: trimmed,
+            acknowledge_mentions: acknowledgedPrincipals,
+          },
+          etag,
+        );
+      } else {
+        result = await createComment(issueKey, {
+          body_markdown: trimmed,
+          parent_comment_id: parentCommentId,
+          acknowledge_mentions: acknowledgedPrincipals,
+        });
+      }
+
+      setDraft('');
+      setMentionWarning(null);
+      setConflictError(false);
+      onSuccess?.(result);
+    } catch (err: unknown) {
+      if (err instanceof ApiProblem) {
+        const problemData = err.data as Record<string, unknown> | undefined;
+        if (err.status === 409 && problemData?.code === 'MENTION_ACCESS_WARNING') {
+          setMentionWarning(problemData as unknown as MentionAccessWarning);
+        } else if (err.status === 412) {
+          setConflictError(true);
+        } else {
+          setErrorText(err.message !== '' ? err.message : 'Failed to submit comment.');
+        }
+      } else {
+        const errorObj = err as Error;
+        setErrorText(errorObj.message !== '' ? errorObj.message : 'Failed to submit comment.');
+      }
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const handleKeyDown = (e: KeyboardEvent<HTMLTextAreaElement>): void => {
+    // Autocomplete navigation
+    if (suggestions.length > 0) {
+      if (e.key === 'ArrowDown') {
+        e.preventDefault();
+        setSelectedSuggestionIdx((prev) => (prev + 1) % suggestions.length);
+        return;
+      }
+      if (e.key === 'ArrowUp') {
+        e.preventDefault();
+        setSelectedSuggestionIdx((prev) => (prev - 1 + suggestions.length) % suggestions.length);
+        return;
+      }
+      if (e.key === 'Enter' || e.key === 'Tab') {
+        e.preventDefault();
+        const chosen = suggestions[selectedSuggestionIdx];
+        if (chosen) {
+          applyMention(chosen.handle);
+        }
+        return;
+      }
+      if (e.key === 'Escape') {
+        e.preventDefault();
+        setSuggestions([]);
+        return;
+      }
+    }
+
+    // Submit with Cmd+Enter or Ctrl+Enter
+    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
+      e.preventDefault();
+      void handleSubmit();
+    }
+  };
+
+  return (
+    <div className={`comment-composer${isEditing ? ' comment-composer--editing' : ''}`}>
+      {/* Toolbar */}
+      <div className="comment-composer__toolbar" role="toolbar" aria-label="Comment formatting">
+        <button
+          type="button"
+          className="composer-tool-btn"
+          aria-label="Bold text"
+          onClick={() => { insertTextAtCursor('**', '**', 'bold text'); }}
+        >
+          <strong>B</strong>
+        </button>
+        <button
+          type="button"
+          className="composer-tool-btn"
+          aria-label="Italic text"
+          onClick={() => { insertTextAtCursor('*', '*', 'italic text'); }}
+        >
+          <em>I</em>
+        </button>
+        <button
+          type="button"
+          className="composer-tool-btn"
+          aria-label="Insert code"
+          onClick={() => { insertTextAtCursor('```\n', '\n```', 'code'); }}
+        >
+          <code>&lt;/&gt;</code>
+        </button>
+        <button
+          type="button"
+          className="composer-tool-btn"
+          aria-label="Insert link"
+          onClick={() => { insertTextAtCursor('[', '](https://example.com)', 'link text'); }}
+        >
+          🔗
+        </button>
+        <button
+          type="button"
+          className="composer-tool-btn"
+          aria-label="Attach media or SVG"
+          onClick={() => { insertTextAtCursor('![', '](https://example.com/media.png)', 'alt text'); }}
+        >
+          📎
+        </button>
+        <button
+          type="button"
+          className="composer-tool-btn"
+          aria-label="Insert Mermaid diagram"
+          onClick={() => { insertTextAtCursor('```mermaid\ngraph TD;\n  ', '\n```', 'A-->B;'); }}
+        >
+          📊
+        </button>
+      </div>
+
+      {/* Editor Box */}
+      <div className="comment-composer__input-wrapper">
+        <textarea
+          ref={textareaRef}
+          className="comment-composer__textarea"
+          aria-label="Write a comment"
+          placeholder={placeholder}
+          value={draft}
+          onChange={(e) => { void handleTextChange(e); }}
+          onKeyDown={handleKeyDown}
+          rows={3}
+        />
+
+        {/* @mention autocomplete listbox */}
+        {suggestions.length > 0 && (
+          <ul
+            className="comment-composer__suggestions"
+            role="listbox"
+            aria-label="Mention suggestions"
+          >
+            {suggestions.map((item, idx) => (
+              <li
+                key={item.id}
+                role="option"
+                aria-selected={idx === selectedSuggestionIdx}
+                className={`composer-suggestion${idx === selectedSuggestionIdx ? ' composer-suggestion--active' : ''}`}
+                onMouseDown={(e) => {
+                  e.preventDefault();
+                  applyMention(item.handle);
+                }}
+                onClick={() => {
+                  applyMention(item.handle);
+                }}
+              >
+                <span className="composer-suggestion__handle">
+                  {item.is_agent ? '🤖 ' : '@'}
+                  {item.handle.replace(/^@/, '')}
+                </span>
+                <span className="composer-suggestion__name">{item.display_name}</span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+
+      {/* 409 MENTION_ACCESS_WARNING Banner */}
+      {mentionWarning && (
+        <div
+          ref={alertRef}
+          tabIndex={-1}
+          role="alert"
+          className="comment-composer__warning-banner"
+          aria-live="assertive"
+        >
+          <div className="warning-banner__text">
+            {formatMentionWarning(mentionWarning.unauthorized_mentions)}
+          </div>
+          <div className="warning-banner__actions">
+            <button
+              type="button"
+              className="warning-btn warning-btn--secondary"
+              onClick={() => {
+                setMentionWarning(null);
+                textareaRef.current?.focus();
+              }}
+            >
+              Edit comment
+            </button>
+            <button
+              type="button"
+              className="warning-btn warning-btn--primary"
+              onClick={() => {
+                const ids = mentionWarning.unauthorized_mentions.map((m) => m.principal_id);
+                void handleSubmit(ids);
+              }}
+            >
+              Post without granting access
+            </button>
+          </div>
+        </div>
+      )}
+
+      {/* 412 Precondition Failed Conflict Alert */}
+      {conflictError && (
+        <div role="alert" className="comment-composer__conflict-banner">
+          <span>This comment was edited elsewhere. Copy your changes and reload.</span>
+        </div>
+      )}
+
+      {/* Standard Error Alert */}
+      {errorText && (
+        <div role="alert" className="comment-composer__error-alert">
+          {errorText}
+        </div>
+      )}
+
+      {/* Action Footer */}
+      <div className="comment-composer__footer">
+        {onCancel && (
+          <button
+            type="button"
+            className="composer-cancel-btn"
+            onClick={onCancel}
+            disabled={isSubmitting}
+          >
+            Cancel
+          </button>
+        )}
+        <button
+          type="button"
+          className="composer-submit-btn"
+          onClick={() => { void handleSubmit(); }}
+          disabled={isSubmitting}
+        >
+          {isSubmitting ? 'Saving...' : isEditing ? 'Save Changes' : parentCommentId ? 'Reply' : 'Comment'}
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/kanban/web/src/features/activity/SafeMarkdownPreview.test.tsx b/kanban/web/src/features/activity/SafeMarkdownPreview.test.tsx
new file mode 100644
index 0000000..376709d
--- /dev/null
+++ b/kanban/web/src/features/activity/SafeMarkdownPreview.test.tsx
@@ -0,0 +1,126 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { render, screen } from '@testing-library/react';
+import React from 'react';
+import {
+  SafeMarkdownPreview,
+  registerCommentBodyRenderer,
+  getCommentBodyRenderer,
+} from './SafeMarkdownPreview';
+
+describe('SafeMarkdownPreview', () => {
+  beforeEach(() => {
+    registerCommentBodyRenderer(null);
+  });
+
+  describe('Test Case 5: Negative / security & rendering', () => {
+    it('neutralizes HTML tags (<script>, <img>) by rendering them as escaped text without DOM nodes', () => {
+      const malicious = '<script>alert(1)</script><img src="x" onerror="alert(1)" />';
+      const { container } = render(<SafeMarkdownPreview markdown={malicious} />);
+
+      expect(container.querySelector('script')).toBeNull();
+      expect(container.querySelector('img')).toBeNull();
+      expect(container.textContent).toContain('<script>alert(1)</script>');
+    });
+
+    it('strips javascript: and vbscript: URIs to plain text without creating clickable links', () => {
+      const maliciousLinks = '[click me](javascript:alert(1)) and [vbs](vbscript:evil())';
+      const { container } = render(<SafeMarkdownPreview markdown={maliciousLinks} />);
+
+      const links = container.querySelectorAll('a');
+      expect(links.length).toBe(0);
+      expect(container.textContent).toContain('click me and vbs');
+    });
+
+    it('renders safe https: and mailto: links with noopener noreferrer', () => {
+      const markdown = 'Visit [Google](https://google.com) or email [Support](mailto:support@example.com)';
+      render(<SafeMarkdownPreview markdown={markdown} />);
+
+      const link = screen.getByRole('link', { name: 'Google' });
+      expect(link.getAttribute('href')).toBe('https://google.com');
+      expect(link.getAttribute('rel')).toBe('noopener noreferrer');
+
+      const mailLink = screen.getByRole('link', { name: 'Support' });
+      expect(mailLink.getAttribute('href')).toBe('mailto:support@example.com');
+    });
+
+    it('renders fenced code blocks and inline code safely', () => {
+      const markdown = 'Here is inline `const x = 42;` and a block:\n\n```typescript\nfunction hello() {\n  return "world";\n}\n```';
+      const { container } = render(<SafeMarkdownPreview markdown={markdown} />);
+
+      const inlineCode = screen.getByText('const x = 42;');
+      expect(inlineCode.tagName.toLowerCase()).toBe('code');
+
+      const pre = container.querySelector('pre');
+      expect(pre).not.toBeNull();
+      expect(pre?.textContent).toContain('function hello()');
+    });
+
+    it('renders unordered lists with bullet markers', () => {
+      const markdown = '- First item\n- Second item\n* Third item';
+      const { container } = render(<SafeMarkdownPreview markdown={markdown} />);
+
+      const listItems = container.querySelectorAll('li');
+      expect(listItems.length).toBe(3);
+      expect(screen.getByText('First item')).toBeDefined();
+      expect(screen.getByText('Second item')).toBeDefined();
+      expect(screen.getByText('Third item')).toBeDefined();
+    });
+
+    it('renders ordered numbered lists with numbers', () => {
+      const markdown = '1. First ordered item\n2. Second ordered item';
+      const { container } = render(<SafeMarkdownPreview markdown={markdown} />);
+
+      const listItems = container.querySelectorAll('ol li');
+      expect(listItems.length).toBe(2);
+      expect(screen.getByText('First ordered item')).toBeDefined();
+      expect(screen.getByText('Second ordered item')).toBeDefined();
+    });
+
+    it('exposes getCommentBodyRenderer', () => {
+      expect(getCommentBodyRenderer()).toBeNull();
+    });
+
+    it('handles empty paragraphs and multiline whitespace gracefully', () => {
+      const { container } = render(<SafeMarkdownPreview markdown={"\n\n   \n\nParagraph 1\n\n\n\nParagraph 2\n\n"} />);
+      const paragraphs = container.querySelectorAll('p');
+      expect(paragraphs.length).toBe(2);
+    });
+
+    it('renders bold and italic formatting', () => {
+      const markdown = 'This is **bold** and *italic* text.';
+      render(<SafeMarkdownPreview markdown={markdown} />);
+
+      const boldEl = screen.getByText('bold');
+      expect(boldEl.tagName.toLowerCase()).toBe('strong');
+
+      const italicEl = screen.getByText('italic');
+      expect(italicEl.tagName.toLowerCase()).toBe('em');
+    });
+
+    it('supports pluggable custom renderer via registerCommentBodyRenderer', () => {
+      registerCommentBodyRenderer((md) => {
+        if (md.startsWith('CUSTOM:')) {
+          return <div data-testid="custom-rendered">{md.slice(7)}</div>;
+        }
+        return null;
+      });
+
+      try {
+        const { unmount } = render(<SafeMarkdownPreview markdown="CUSTOM:Hello Custom" />);
+        expect(screen.getByTestId('custom-rendered').textContent).toBe('Hello Custom');
+        unmount();
+
+        // Default markdown still falls back
+        render(<SafeMarkdownPreview markdown="Regular text" />);
+        expect(screen.getByText('Regular text')).toBeDefined();
+      } finally {
+        registerCommentBodyRenderer(null);
+      }
+
+      // After unregister, custom prefix renders as standard markdown
+      render(<SafeMarkdownPreview markdown="CUSTOM:Hello Custom 2" />);
+      expect(screen.queryByTestId('custom-rendered')).toBeNull();
+      expect(screen.getByText(/CUSTOM:Hello Custom 2/)).toBeDefined();
+    });
+  });
+});
diff --git a/kanban/web/src/features/activity/SafeMarkdownPreview.tsx b/kanban/web/src/features/activity/SafeMarkdownPreview.tsx
new file mode 100644
index 0000000..18304bb
--- /dev/null
+++ b/kanban/web/src/features/activity/SafeMarkdownPreview.tsx
@@ -0,0 +1,195 @@
+/**
+ * Deterministic zero-HTML safe Markdown preview renderer for comments (KB-P3-44, S5.1).
+ * Supports paragraphs, inline code, fenced code blocks, lists, and safe links (http/https/mailto).
+ * Exposes registerCommentBodyRenderer for future Phase 3C rich extensions.
+ */
+
+import React, { type JSX, type ReactNode } from 'react';
+
+export type CommentBodyRenderer = (markdown: string) => ReactNode;
+
+let customRenderer: CommentBodyRenderer | null = null;
+
+export function registerCommentBodyRenderer(renderer: CommentBodyRenderer | null): void {
+  customRenderer = renderer;
+}
+
+export function getCommentBodyRenderer(): CommentBodyRenderer | null {
+  return customRenderer;
+}
+
+interface SafeMarkdownPreviewProps {
+  readonly markdown: string;
+  readonly className?: string;
+}
+
+function isSafeUrl(url: string): boolean {
+  const lower = url.trim().toLowerCase();
+  return lower.startsWith('https://') || lower.startsWith('http://') || lower.startsWith('mailto:');
+}
+
+export function renderInlineContent(text: string, keyPrefix: string): ReactNode[] {
+  const nodes: ReactNode[] = [];
+  // Tokenize code spans `...`, links [text](url), bold **...**, italic *...*
+  const pattern = /(`[^`]+`)|(\[([^\]]+)\]\(((?:[^()]+|\([^()]*\))*)\))|(\*\*([^*]+)\*\*)|(\*([^*]+)\*)/g;
+  let lastIndex = 0;
+  let match: RegExpExecArray | null;
+  let tokenIdx = 0;
+
+  while ((match = pattern.exec(text)) !== null) {
+    if (match.index > lastIndex) {
+      nodes.push(text.slice(lastIndex, match.index));
+    }
+
+    const [, codeSpan, linkMatch, linkText, linkUrl, , boldText, , italicText] = match;
+
+    if (codeSpan) {
+      nodes.push(
+        <code key={`${keyPrefix}-code-${String(tokenIdx)}`} className="safe-md__inline-code">
+          {codeSpan.slice(1, -1)}
+        </code>,
+      );
+    } else if (linkMatch && linkText && linkUrl) {
+      if (isSafeUrl(linkUrl)) {
+        nodes.push(
+          <a
+            key={`${keyPrefix}-link-${String(tokenIdx)}`}
+            href={linkUrl}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="safe-md__link"
+          >
+            {linkText}
+          </a>,
+        );
+      } else {
+        // Strip unsafe schemes like javascript: to plain text
+        nodes.push(linkText);
+      }
+    } else if (boldText !== undefined) {
+      nodes.push(<strong key={`${keyPrefix}-b-${String(tokenIdx)}`}>{boldText}</strong>);
+    } else if (italicText !== undefined) {
+      nodes.push(<em key={`${keyPrefix}-i-${String(tokenIdx)}`}>{italicText}</em>);
+    }
+
+    tokenIdx += 1;
+    lastIndex = pattern.lastIndex;
+  }
+
+  if (lastIndex < text.length) {
+    nodes.push(text.slice(lastIndex));
+  }
+
+  return nodes;
+}
+
+export function SafeMarkdownPreview({
+  markdown,
+  className = 'safe-md-preview',
+}: SafeMarkdownPreviewProps): JSX.Element {
+  if (customRenderer) {
+    const customResult = customRenderer(markdown);
+    if (customResult !== null && customResult !== undefined) {
+      return <div className={className}>{customResult}</div>;
+    }
+  }
+
+  // Parse blocks: fenced code blocks vs standard blocks
+  const blocks: ReactNode[] = [];
+  const lines = markdown.split('\n');
+  let inCodeBlock = false;
+  let codeLang = '';
+  let codeLines: string[] = [];
+  let textLines: string[] = [];
+  let blockIdx = 0;
+
+  const flushTextLines = (): void => {
+    if (textLines.length === 0) return;
+    const text = textLines.join('\n').trim();
+    textLines = [];
+    if (!text) return;
+
+    // Check if it's a list
+    const sublines = text.split('\n');
+    const isBulletList = sublines.every((l) => l.trim().startsWith('- ') || l.trim().startsWith('* '));
+    const isNumberedList = sublines.every((l) => /^\d+\.\s/.test(l.trim()));
+
+    if (isBulletList) {
+      blocks.push(
+        <ul key={`ul-${String(blockIdx++)}`} className="safe-md__ul">
+          {sublines.map((l, i) => (
+            <li key={`li-${String(i)}`}>
+              {renderInlineContent(l.trim().replace(/^[-*]\s+/, ''), `ul-${String(blockIdx)}-${String(i)}`)}
+            </li>
+          ))}
+        </ul>,
+      );
+    } else if (isNumberedList) {
+      blocks.push(
+        <ol key={`ol-${String(blockIdx++)}`} className="safe-md__ol">
+          {sublines.map((l, i) => (
+            <li key={`li-${String(i)}`}>
+              {renderInlineContent(l.trim().replace(/^\d+\.\s+/, ''), `ol-${String(blockIdx)}-${String(i)}`)}
+            </li>
+          ))}
+        </ol>,
+      );
+    } else {
+      // Split into paragraphs by blank lines
+      const paragraphs = text.split(/\n\s*\n/);
+      paragraphs.forEach((p, pIdx) => {
+        if (p.trim()) {
+          blocks.push(
+            <p key={`p-${String(blockIdx++)}-${String(pIdx)}`} className="safe-md__p">
+              {renderInlineContent(p.trim(), `p-${String(blockIdx)}-${String(pIdx)}`)}
+            </p>,
+          );
+        }
+      });
+    }
+  };
+
+  for (const line of lines) {
+    const trimmed = line.trim();
+
+    if (trimmed.startsWith('```')) {
+      if (inCodeBlock) {
+        // Closing code block
+        blocks.push(
+          <pre key={`code-${String(blockIdx++)}`} className="safe-md__code-block">
+            <code className={codeLang ? `language-${codeLang}` : undefined}>
+              {codeLines.join('\n')}
+            </code>
+          </pre>,
+        );
+        inCodeBlock = false;
+        codeLang = '';
+        codeLines = [];
+      } else {
+        // Opening code block
+        flushTextLines();
+        inCodeBlock = true;
+        codeLang = trimmed.slice(3).trim();
+        codeLines = [];
+      }
+    } else if (inCodeBlock) {
+      codeLines.push(line);
+    } else {
+      textLines.push(line);
+    }
+  }
+
+  if (inCodeBlock) {
+    blocks.push(
+      <pre key={`code-${String(blockIdx++)}`} className="safe-md__code-block">
+        <code className={codeLang ? `language-${codeLang}` : undefined}>
+          {codeLines.join('\n')}
+        </code>
+      </pre>,
+    );
+  } else {
+    flushTextLines();
+  }
+
+  return <div className={className}>{blocks}</div>;
+}
diff --git a/kanban/web/src/features/activity/activity.css b/kanban/web/src/features/activity/activity.css
