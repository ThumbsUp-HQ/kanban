+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import React from 'react';
+import {
+  CommentComposer,
+  isCursorInsideCode,
+  extractMentionPrefix,
+  formatMentionWarning,
+  getUtf8ByteLength,
+  MAX_COMMENT_BYTES,
