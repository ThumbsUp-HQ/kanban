-+        },
-+    )
-+
-+    await session.execute(
-+        text(
-+            "INSERT INTO principals (id, principal_type, workspace_id, display_name, status) "
-+            "VALUES (:id, 'USER', :ws_id, 'Boundary User', 'ACTIVE')"
-+        ),
