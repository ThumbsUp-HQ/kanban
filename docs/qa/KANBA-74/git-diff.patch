-      badgeRef.current.style.display = 'none';
-    }
-  }, [view, containerRef]);
-
-  useEffect(() => {
-    if (!view) return;
-
-    updatePosition();
-
-    let animId: number;
-    const checkState = (): void => {
-      updatePosition();
