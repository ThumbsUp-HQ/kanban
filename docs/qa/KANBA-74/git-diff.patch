-+            b"Content-Length: 8\r\n\r\n"
-+            b"\x89PNG\r\n\x1a\n"
-+        )
-+        reader.feed_eof()
-+        writer_mock = MagicMock()
-+        writer_mock.write = MagicMock()
-+        writer_mock.close = MagicMock()
-+        writer_mock.drain = AsyncMock()
-+        writer_mock.wait_closed = AsyncMock()
