-+export type SparkleEvent =
-+  | {
-+      type: 'TYPE_CHAR';
-+      char?: string;
-+      isPrintable?: boolean;
-+      isCollapsed: boolean;
-+    }
-+  | { type: 'DEBOUNCE_PAUSE' }
-+  | {
-+      type: 'FETCH_COMPLETION';
-+      text: string;
-+      requestId?: string;
-+    }
-+  | {
-+      type: 'FETCH_FAIL';
-+      status?: SparkleDoneStatus | 'error';
-+      error?: string;
-+    }
-+  | { type: 'ACCEPT' }
-+  | {
-+      type: 'DISMISS';
-+      reason?: 'escape' | 'cursor_move' | 'selection_expanded' | 'typing_mismatch';
