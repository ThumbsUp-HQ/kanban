+        >
+          Members & Access
+        </button>
+        <button
+          type="button"
+          role="tab"
+          aria-selected={activeTab === 'integrations'}
+          data-testid="tab-integrations"
+          className={`kb-settings-tab ${activeTab === 'integrations' ? 'kb-settings-tab-active' : ''}`}
+          onClick={() => { setActiveTab('integrations'); }}
+        >
