+
+            <div className="kb-form-group">
+              <label htmlFor="proj-auto-archive-input">Auto-Archive Days (optional)</label>
+              <input
+                id="proj-auto-archive-input"
+                type="number"
+                data-testid="project-auto-archive-input"
+                className="kb-input"
+                min="1"
