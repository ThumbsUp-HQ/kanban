+      } catch (err: unknown) {
+        const errObj = err as { message?: string };
+        setDangerError(errObj.message ?? 'Failed to initiate project deletion.');
+      }
+    })();
+  };
+
+  const handleExecuteDelete = () => {
+    if (!destructiveToken) return;
+    setDangerError(null);
+    setDangerStage('executing');
+    void (async () => {
