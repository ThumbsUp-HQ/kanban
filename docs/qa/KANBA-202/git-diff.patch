+            </form>
+
+            <div className="kb-members-table-wrapper">
+              <h3>Current Project Members</h3>
+              <table className="kb-table" data-testid="members-table">
+                <thead>
+                  <tr>
+                    <th>Member</th>
+                    <th>Role</th>
+                    <th>Actions</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {members.length === 0 ? (
+                    <tr>
+                      <td colSpan={3} className="kb-empty-cell">No explicit project role bindings found.</td>
+                    </tr>
