+    "ALLOWED_SKILL_SLUGS",
+    "MAX_LLMS_FULL_BYTES",
+    "MAX_LLMS_TXT_BYTES",
+    "MAX_SKILL_BYTES",
+    "ONBOARDING_PROMPT_TEMPLATE",
