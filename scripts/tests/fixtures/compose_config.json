{
  "name": "kb-wt-kanba-30",
  "networks": {
    "app_net": {
      "name": "kb-wt-kanba-30_app_net",
      "ipam": {},
      "internal": true
    },
    "data_net": {
      "name": "kb-wt-kanba-30_data_net",
      "ipam": {},
      "internal": true
    },
    "edge_net": {
      "name": "kb-wt-kanba-30_edge_net",
      "driver": "bridge",
      "ipam": {}
    },
    "egress_llm_net": {
      "name": "kb-wt-kanba-30_egress_llm_net",
      "driver": "bridge",
      "ipam": {}
    },
    "sandbox_net": {
      "name": "kb-wt-kanba-30_sandbox_net",
      "ipam": {},
      "internal": true
    }
  },
  "secrets": {
    "master_kek": {
      "name": "kb-wt-kanba-30_master_kek",
      "file": "/tmp/kb-wt-KANBA-30/deploy/secrets/master_kek.txt"
    },
    "postgres_password": {
      "name": "kb-wt-kanba-30_postgres_password",
      "file": "/tmp/kb-wt-KANBA-30/deploy/secrets/postgres_password.txt"
    }
  },
  "services": {
    "agent-runtime": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "python",
        "-m",
        "kanban.agent_placeholder"
      ],
      "entrypoint": null,
      "image": "kanban:runtime-slim",
      "mem_limit": "1073741824",
      "networks": {
        "app_net": null,
        "egress_llm_net": null
      },
      "pids_limit": 100,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "65532:65532"
    },
    "kanban-api": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "uvicorn",
        "kanban.app:create_app",
        "--factory",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--proxy-headers",
        "--forwarded-allow-ips=*"
      ],
      "entrypoint": null,
      "image": "kanban:runtime-slim",
      "mem_limit": "536870912",
      "networks": {
        "app_net": null,
        "data_net": null
      },
      "pids_limit": 200,
      "read_only": true,
      "secrets": [
        {
          "source": "postgres_password",
          "target": "/run/secrets/postgres_password"
        },
        {
          "source": "master_kek",
          "target": "/run/secrets/master_kek"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "65532:65532",
      "build": {
        "context": "/tmp/kb-wt-KANBA-30",
        "dockerfile": "Dockerfile",
        "target": "runtime-slim"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      }
    },
    "mcp-server": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "python",
        "-m",
        "kanban.mcp_placeholder"
      ],
      "entrypoint": null,
      "image": "kanban:runtime-slim",
      "mem_limit": "536870912",
      "networks": {
        "app_net": null
      },
      "pids_limit": 100,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "65532:65532"
    },
    "outbox-relay": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "python",
        "-m",
        "kanban.relay_placeholder"
      ],
      "entrypoint": null,
      "image": "kanban:runtime-slim",
      "mem_limit": "268435456",
      "networks": {
        "data_net": null
      },
      "pids_limit": 100,
      "read_only": true,
      "secrets": [
        {
          "source": "postgres_password",
          "target": "/run/secrets/postgres_password"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "65532:65532"
    },
    "postgres": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "kanban",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres_password",
        "POSTGRES_USER": "postgres"
      },
      "image": "pgvector/pgvector:pg16@sha256:0dd3149a06e4579a0d70d8fef9945636cd514005e7237deb27f9b67886f8dc4f",
      "mem_limit": "1073741824",
      "networks": {
        "data_net": null
      },
      "pids_limit": 200,
      "read_only": true,
      "secrets": [
        {
          "source": "postgres_password",
          "target": "/run/secrets/postgres_password"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/var/run/postgresql"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 5
      }
    },
    "reverse-proxy": {
      "restart": "unless-stopped",
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "KB_DOMAIN": "localhost"
      },
      "image": "caddy:2.8-alpine@sha256:af32e97399febea808609119bb21544d0265c58a02836576e32a2d082c262c17",
      "mem_limit": "268435456",
      "networks": {
        "app_net": null,
        "edge_net": null
      },
      "pids_limit": 100,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/var/run"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "caddy_data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "caddy_config",
          "target": "/config",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "web_dist",
          "target": "/srv/www",
          "read_only": true,
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/tmp/kb-wt-KANBA-30/deploy/caddy/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {}
        }
      ],
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "udp"
        }
      ]
    },
    "script-sandbox": {
      "profiles": [
        "sandbox"
      ],
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "image": "kanban:sandbox",
      "mem_limit": "268435456",
      "networks": {
        "sandbox_net": null
      },
      "pids_limit": 50,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ]
    },
    "valkey": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "image": "valkey/valkey:8.0-alpine@sha256:19f0b3d350f5e6de618086d79ecdc9c474ab159bebb16ed95a92e4211562fee5",
      "mem_limit": "268435456",
      "networks": {
        "data_net": null
      },
      "pids_limit": 100,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "valkeydata",
          "target": "/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "valkey-cli",
          "ping"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 5
      }
    }
  },
  "volumes": {
    "caddy_config": {
      "name": "kb-wt-kanba-30_caddy_config"
    },
    "caddy_data": {
      "name": "kb-wt-kanba-30_caddy_data"
    },
    "pgdata": {
      "name": "kb-wt-kanba-30_pgdata"
    },
    "valkeydata": {
      "name": "kb-wt-kanba-30_valkeydata"
    },
    "web_dist": {
      "name": "kb-wt-kanba-30_web_dist"
    }
  }
}
