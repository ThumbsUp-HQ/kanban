{
	servers {
		protocols h1 h2 h3
	}
}

{$KB_DOMAIN:localhost} {
	tls {
		protocols tls1.3
	}

	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' wss:; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types kanban-sanitizer dompurify;"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	@internal_routes path /internal/* /api/v1/internal/*
	respond @internal_routes 404

	handle /llms* {
		reverse_proxy kanban-api:8000
	}

	handle /.well-known/oauth-* {
		reverse_proxy kanban-api:8000 {
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle /.well-known/openid-configuration* {
		reverse_proxy kanban-api:8000 {
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle /oauth/* {
		reverse_proxy kanban-api:8000 {
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle /api/* {
		reverse_proxy kanban-api:8000 {
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle /ws {
		reverse_proxy kanban-api:8000 {
			flush_interval -1
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle /sse* {
		reverse_proxy kanban-api:8000 {
			flush_interval -1
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle /mcp/* {
		reverse_proxy mcp-server:8000 {
			flush_interval -1
			header_up -X-Client-Cert-Pem
			header_up -X-Client-Cert-Der-B64
			header_up -X-Client-Cert-CN
			header_up -X-SSL-Client-Cert
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
	}
}

:8444 {
	tls {
		protocols tls1.3
		client_auth {
			mode require
		}
	}

	@runner_ws path /api/v1/agent-runners/ws /api/v1/agent-runners/ws/*
	handle @runner_ws {
		reverse_proxy kanban-api:8000 {
			flush_interval -1
			header_up X-Client-Cert-Pem {http.request.tls.client.certificate_pem}
			header_up X-Client-Cert-Der-B64 {http.request.tls.client.certificate_der_base64}
			header_up -X-KB-Service-Principal
			header_up -X-KB-Internal-Auth
			header_up -X-KB-Internal-Timestamp
			header_up -X-KB-Internal-Signature
		}
	}

	respond 404
}
