{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanban.hackedyour.info/schemas/kb-sparkle-report-v1.json",
  "title": "SparkleValidationReport",
  "description": "Validation report emitted by kanban-agent validate-sparkle CLI.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "rendered_context",
    "tool_trace",
    "metrics",
    "schema_status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kb-sparkle-report/v1"
    },
    "command": {
      "type": "string",
      "const": "validate-sparkle"
    },
    "rendered_context": {
      "type": "string"
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "args", "result"],
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "result": {
            "type": "object"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["total_latency_ms", "prompt_tokens", "completion_tokens", "route_trace"],
      "additionalProperties": false,
      "properties": {
        "ttft_ms": {
          "type": ["number", "null"]
        },
        "total_latency_ms": {
          "type": "number"
        },
        "prompt_tokens": {
          "type": "integer"
        },
        "completion_tokens": {
          "type": "integer"
        },
        "route_trace": {
          "type": "array"
        },
        "iterations": {
          "type": ["integer", "null"]
        },
        "p50_latency_ms": {
          "type": ["number", "null"]
        },
        "p90_latency_ms": {
          "type": ["number", "null"]
        },
        "p95_latency_ms": {
          "type": ["number", "null"]
        },
        "p99_latency_ms": {
          "type": ["number", "null"]
        }
      }
    },
    "schema_status": {
      "type": "object",
      "required": ["valid", "status"],
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "error_code": {
          "type": ["string", "null"]
        },
        "detail": {
          "type": ["string", "null"]
        }
      }
    },
    "qa_verdict": {
      "type": ["null", "object"]
    },
    "sparkle_details": {
      "type": ["null", "object"]
    }
  }
}
